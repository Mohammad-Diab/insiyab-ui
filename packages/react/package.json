{
  "name": "@insiyab/react",
  "version": "0.6.0",
  "description": "React components for Insiyab: thin covers over its classes and attributes, with the core script doing the behaviour.",
  "keywords": [
    "react",
    "insiyab",
    "rtl",
    "arabic",
    "ui",
    "components",
    "glassmorphism"
  ],
  "license": "MIT",
  "author": "Mohammad Diab",
  "homepage": "https://github.com/Mohammad-Diab/insiyab-ui/tree/main/packages/react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mohammad-Diab/insiyab-ui.git",
    "directory": "packages/react"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepublishOnly": "node build.mjs",
    "test": "node build.mjs && node ../../test/run.mjs react"
  },
  "peerDependencies": {
    "insiyab": "^0.6.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "insiyab": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
