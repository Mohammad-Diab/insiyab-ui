  <StyleInclude Source="avares://Insiyab.Avalonia/Themes/Panel.axaml" />
  <StyleInclude Source="avares://Insiyab.Avalonia/Themes/Button.axaml" />
  <StyleInclude Source="avares://Insiyab.Avalonia/Themes/TextBox.axaml" />
  <StyleInclude Source="avares://Insiyab.Avalonia/Themes/CheckBox.axaml" />
  <StyleInclude Source="avares://Insiyab.Avalonia/Themes/ToggleSwitch.axaml" />
  <StyleInclude Source="avares://Insiyab.Avalonia/Themes/Buttons.axaml" />
  <StyleInclude Source="avares://Insiyab.Avalonia/Themes/Inputs.axaml" />
  <StyleInclude Source="avares://Insiyab.Avalonia/Themes/Pickers.axaml" />
  <StyleInclude Source="avares://Insiyab.Avalonia/Themes/Menus.axaml" />
  <StyleInclude Source="avares://Insiyab.Avalonia/Themes/Shell.axaml" />
  <StyleInclude Source="avares://Insiyab.Avalonia/Themes/Disclosure.axaml" />
  <StyleInclude Source="avares://Insiyab.Avalonia/Themes/Feedback.axaml" />
  <StyleInclude Source="avares://Insiyab.Avalonia/Themes/Overlays.axaml" />
  <StyleInclude Source="avares://Insiyab.Avalonia/Themes/Data.axaml" />
  <StyleInclude Source="avares://Insiyab.Avalonia/Themes/Content.axaml" />
  <StyleInclude Source="avares://Insiyab.Avalonia/Themes/Plugins.axaml" />
