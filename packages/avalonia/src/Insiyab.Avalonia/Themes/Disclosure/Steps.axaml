<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ins="using:Insiyab.Avalonia.Controls">

  <Styles.Resources>
    <ResourceDictionary>

      <LinearGradientBrush x:Key="InsStepsDoneFill" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="{DynamicResource InsPrimaryColor}" />
        <GradientStop Offset="1" Color="{DynamicResource InsPrimaryDarkColor}" />
      </LinearGradientBrush>

      <ControlTheme x:Key="{x:Type ins:Steps}" TargetType="ins:Steps">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Margin" Value="0,0,0,24" />
        <Setter Property="FontSize" Value="{DynamicResource InsFsXs}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource InsLabel}" />
        <Setter Property="ItemsPanel">
          <ItemsPanelTemplate>
            <ins:StepsPanel />
          </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
          <ControlTemplate>
            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
          </ControlTemplate>
        </Setter>
        <Style Selector="^.dots">
          <Setter Property="Margin" Value="0,0,0,17.6" />
          <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="6.4" HorizontalAlignment="Center" />
            </ItemsPanelTemplate>
          </Setter>
        </Style>
        <Style Selector="^.grid">
          <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
              <WrapPanel ItemSpacing="8" LineSpacing="8" />
            </ItemsPanelTemplate>
          </Setter>
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type ins:StepsItem}" TargetType="ins:StepsItem">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <ControlTemplate>
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,*">
              <Border Name="PART_LineStart" Grid.Column="0" Height="2" Margin="0,0,6,0" CornerRadius="0,1,1,0"
                      VerticalAlignment="Center" Background="{DynamicResource InsLine}" />
              <Border Name="PART_LineEnd" Grid.Column="2" Height="2" Margin="6,0,0,0" CornerRadius="1,0,0,1"
                      VerticalAlignment="Center" Background="{DynamicResource InsLine}" />
              <Panel Name="PART_Dot" Grid.Column="1" Width="32" Height="32" RenderTransformOrigin="50%,50%">
                <Border Name="PART_Circle" CornerRadius="16" BorderThickness="1"
                        BorderBrush="{DynamicResource InsCtlBd}"
                        Background="{DynamicResource InsSurface}"
                        BoxShadow="{DynamicResource InsBevelDim}" />
                <Border Name="PART_Fill" CornerRadius="16" FlowDirection="LeftToRight" Opacity="0"
                        Background="{DynamicResource InsStepsDoneFill}" />
                <TextBlock Name="PART_Number" Text="{TemplateBinding Number}"
                           FontFamily="{DynamicResource InsFontBodyEn}" FontSize="{DynamicResource InsFsSm}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource InsLabel}" />
                <Border Name="PART_FocusRing" CornerRadius="16" BoxShadow="{DynamicResource InsFocusRing}" IsVisible="False" />
                <Border Name="PART_Flag" Width="14" Height="14" CornerRadius="7" BorderThickness="2"
                        BorderBrush="{DynamicResource InsGlassStrong}" Background="{DynamicResource InsToneWarn}"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="22,-4,-4,0" IsVisible="False" />
              </Panel>
              <ContentPresenter Name="PART_ContentPresenter" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,6,0,0"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
            </Grid>
          </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ Border#PART_Circle">
          <Setter Property="Transitions">
            <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.25" Easing="0.22,1,0.36,1" />
              <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.25" Easing="0.22,1,0.36,1" />
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="^ /template/ Border#PART_Fill">
          <Setter Property="Transitions">
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="0.22,1,0.36,1" />
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="^ /template/ Panel#PART_Dot">
          <Setter Property="Transitions">
            <Transitions>
              <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
            </Transitions>
          </Setter>
        </Style>

        <Style Selector="^:first /template/ Border#PART_LineStart">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:last /template/ Border#PART_LineEnd">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:after-done /template/ Border#PART_LineStart">
          <Setter Property="Background" Value="{DynamicResource InsToneBrandSoft}" />
        </Style>
        <Style Selector="^:done">
          <Style Selector="^ /template/ Border#PART_LineEnd">
            <Setter Property="Background" Value="{DynamicResource InsToneBrandSoft}" />
          </Style>
          <Style Selector="^ /template/ Border#PART_Circle">
            <Setter Property="BorderBrush" Value="Transparent" />
          </Style>
          <Style Selector="^ /template/ Border#PART_Fill">
            <Setter Property="Opacity" Value="1" />
          </Style>
          <Style Selector="^ /template/ TextBlock#PART_Number">
            <Setter Property="Foreground" Value="{DynamicResource InsOnPrimary}" />
          </Style>
        </Style>
        <Style Selector="^:current">
          <Setter Property="Foreground" Value="{DynamicResource InsToneBrand}" />
          <Style Selector="^ /template/ Border#PART_Circle">
            <Setter Property="BorderBrush" Value="{DynamicResource InsToneBrandSoft}" />
            <Setter Property="BoxShadow" Value="{DynamicResource InsGlowRing}" />
          </Style>
          <Style Selector="^ /template/ TextBlock#PART_Number">
            <Setter Property="Foreground" Value="{DynamicResource InsToneBrand}" />
          </Style>
        </Style>
        <Style Selector="^:error">
          <Style Selector="^ /template/ Border#PART_Circle">
            <Setter Property="BorderBrush" Value="{DynamicResource InsToneBad}" />
            <Setter Property="Background" Value="{DynamicResource InsToneBadBg}" />
          </Style>
          <Style Selector="^ /template/ Border#PART_Fill">
            <Setter Property="Opacity" Value="0" />
          </Style>
          <Style Selector="^ /template/ TextBlock#PART_Number">
            <Setter Property="Foreground" Value="{DynamicResource InsToneBad}" />
          </Style>
        </Style>
        <Style Selector="^:flagged /template/ Border#PART_Flag">
          <Setter Property="IsVisible" Value="True" />
        </Style>
      </ControlTheme>

    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="ins|StepsItem > TextBlock">
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- dots: one small dot per step, done and current in the brand, current larger; names kept for screen readers only -->
  <Style Selector="ins|Steps.dots ins|StepsItem">
    <Setter Property="Width" Value="8" />
    <Style Selector="^ /template/ Border#PART_LineStart, ^ /template/ Border#PART_LineEnd, ^ /template/ TextBlock#PART_Number, ^ /template/ ContentPresenter#PART_ContentPresenter, ^ /template/ Border#PART_Flag, ^ /template/ Border#PART_Fill">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^ /template/ Panel#PART_Dot">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
    </Style>
    <Style Selector="^ /template/ Border#PART_Circle">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="{DynamicResource InsCtlBd}" />
      <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="^:done /template/ Border#PART_Circle, ^:current /template/ Border#PART_Circle">
      <Setter Property="Background" Value="{DynamicResource InsToneBrandSoft}" />
      <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="^:current /template/ Panel#PART_Dot">
      <Setter Property="RenderTransform" Value="scale(1.5)" />
    </Style>
  </Style>

  <!-- grid: numbers that wrap, no lines, each step the control for its question -->
  <Style Selector="ins|Steps.grid ins|StepsItem">
    <Setter Property="Focusable" Value="True" />
    <Setter Property="Cursor" Value="Hand" />
    <Style Selector="^ /template/ Border#PART_LineStart, ^ /template/ Border#PART_LineEnd, ^ /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^ /template/ Border#PART_Flag">
      <Setter Property="Margin" Value="23,-5,-5,0" />
    </Style>
    <Style Selector="^:not(:current):pointerover /template/ Border#PART_Circle">
      <Setter Property="BorderBrush" Value="{DynamicResource InsToneBrandSoft}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </Style>

</Styles>
