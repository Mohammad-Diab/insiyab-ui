<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ins="using:Insiyab.Avalonia.Controls">

  <Styles.Resources>
    <ResourceDictionary>

      <!-- The line look's underline: physical, like the web's linear-gradient(90deg, primary, primary-dark) -->
      <LinearGradientBrush x:Key="InsTabLineFill" StartPoint="0%,50%" EndPoint="100%,50%">
        <GradientStop Offset="0" Color="{DynamicResource InsPrimaryColor}" />
        <GradientStop Offset="1" Color="{DynamicResource InsPrimaryDarkColor}" />
      </LinearGradientBrush>
      <SolidColorBrush x:Key="InsTabLineGlow" Color="{DynamicResource InsPrimaryColor}" Opacity="0.45" />

      <ControlTheme x:Key="InsTabFace" TargetType="ContentControl">
        <Setter Property="MinHeight" Value="{DynamicResource InsCtlH}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="CornerRadius" Value="{DynamicResource InsRSm}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource InsText2}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Transitions">
          <Transitions>
            <BrushTransition Property="Foreground" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
          </Transitions>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type TabItem}" TargetType="TabItem" BasedOn="{StaticResource InsTabFace}">
        <Setter Property="Template">
          <ControlTemplate>
            <Panel>
              <Border Name="PART_LayoutRoot"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{TemplateBinding CornerRadius}"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter Name="PART_ContentPresenter"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Content="{TemplateBinding Header}"
                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                  RecognizesAccessKey="True" />
              </Border>
              <Border Name="PART_FocusRing" CornerRadius="{TemplateBinding CornerRadius}" BorderThickness="2"
                      BorderBrush="{DynamicResource InsToneBrandSoft}" IsVisible="False" IsHitTestVisible="False" />
              <Panel Name="PART_SelectedPipe" IsVisible="False" Height="3" VerticalAlignment="Bottom" Margin="10,0,10,-1"
                     RenderTransformOrigin="50%,50%" RenderTransform="scaleX(0)" IsHitTestVisible="False">
                <Border Name="PART_PipeGlow" CornerRadius="{DynamicResource InsRPill}" Background="{DynamicResource InsTabLineGlow}">
                  <Border.Effect>
                    <BlurEffect Radius="10" />
                  </Border.Effect>
                </Border>
                <Border Name="PART_Pipe" FlowDirection="LeftToRight" CornerRadius="{DynamicResource InsRPill}" Background="{DynamicResource InsTabLineFill}" />
              </Panel>
            </Panel>
          </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ Border#PART_LayoutRoot">
          <Setter Property="Transitions">
            <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
              <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="^ /template/ Panel#PART_SelectedPipe">
          <Setter Property="Transitions">
            <Transitions>
              <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
            </Transitions>
          </Setter>
        </Style>

        <Style Selector="^:pointerover">
          <Setter Property="Foreground" Value="{DynamicResource InsPrimaryDarker}" />
          <Style Selector="^ /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource InsSurfaceHover}" />
          </Style>
        </Style>
        <Style Selector="^:selected, ^:current">
          <Setter Property="Foreground" Value="{DynamicResource InsSegOnFg}" />
          <Style Selector="^ /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource InsSegOnBg}" />
            <Setter Property="BoxShadow" Value="{DynamicResource InsSegOnShadow}" />
          </Style>
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.5" />
          <Setter Property="Cursor" Value="Arrow" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type TabStripItem}" TargetType="TabStripItem" BasedOn="{StaticResource InsTabFace}">
        <Setter Property="Template">
          <ControlTemplate>
            <Panel>
              <Border Name="PART_LayoutRoot"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{TemplateBinding CornerRadius}"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter Name="PART_ContentPresenter"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  RecognizesAccessKey="True" />
              </Border>
              <Border Name="PART_FocusRing" CornerRadius="{TemplateBinding CornerRadius}" BorderThickness="2"
                      BorderBrush="{DynamicResource InsToneBrandSoft}" IsVisible="False" IsHitTestVisible="False" />
              <Panel Name="PART_SelectedPipe" IsVisible="False" Height="3" VerticalAlignment="Bottom" Margin="10,0,10,-1"
                     RenderTransformOrigin="50%,50%" RenderTransform="scaleX(0)" IsHitTestVisible="False">
                <Border Name="PART_PipeGlow" CornerRadius="{DynamicResource InsRPill}" Background="{DynamicResource InsTabLineGlow}">
                  <Border.Effect>
                    <BlurEffect Radius="10" />
                  </Border.Effect>
                </Border>
                <Border Name="PART_Pipe" FlowDirection="LeftToRight" CornerRadius="{DynamicResource InsRPill}" Background="{DynamicResource InsTabLineFill}" />
              </Panel>
            </Panel>
          </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ Border#PART_LayoutRoot">
          <Setter Property="Transitions">
            <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
              <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="^ /template/ Panel#PART_SelectedPipe">
          <Setter Property="Transitions">
            <Transitions>
              <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="^:pointerover">
          <Setter Property="Foreground" Value="{DynamicResource InsPrimaryDarker}" />
          <Style Selector="^ /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource InsSurfaceHover}" />
          </Style>
        </Style>
        <Style Selector="^:selected">
          <Setter Property="Foreground" Value="{DynamicResource InsSegOnFg}" />
          <Style Selector="^ /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource InsSegOnBg}" />
            <Setter Property="BoxShadow" Value="{DynamicResource InsSegOnShadow}" />
          </Style>
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.5" />
          <Setter Property="Cursor" Value="Arrow" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type TabControl}" TargetType="TabControl">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="{DynamicResource InsFsMd}" />
        <Setter Property="Foreground" Value="{DynamicResource InsText1}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="ins:Tabs.Keys" Value="True" />
        <Setter Property="ins:Tabs.Fly" Value="True" />
        <Setter Property="PageTransition">
          <ins:RiseTransition />
        </Setter>
        <Setter Property="ItemsPanel">
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="3" />
          </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
          <ControlTemplate>
            <DockPanel Background="{TemplateBinding Background}">
              <Border Name="PART_Strip" DockPanel.Dock="Top">
                <Panel>
                  <Canvas Name="PART_FlightLayer" IsHitTestVisible="False">
                    <Border Name="PART_Flight" IsVisible="False" />
                  </Canvas>
                  <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </Panel>
              </Border>
              <Panel>
                <ContentPresenter Name="PART_SelectedContentHost2"
                                  Margin="{TemplateBinding Padding}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                  IsVisible="False" />
                <ContentPresenter Name="PART_SelectedContentHost"
                                  Margin="{TemplateBinding Padding}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
              </Panel>
            </DockPanel>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type TabStrip}" TargetType="TabStrip">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="ins:Tabs.Keys" Value="True" />
        <Setter Property="ins:Tabs.Fly" Value="True" />
        <Setter Property="ItemsPanel">
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="3" />
          </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="PART_Strip">
              <Panel>
                <Canvas Name="PART_FlightLayer" IsHitTestVisible="False">
                  <Border Name="PART_Flight" IsVisible="False" />
                </Canvas>
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
              </Panel>
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

    </ResourceDictionary>
  </Styles.Resources>

  <!-- The strip: a recessed track with the selected tab raised out of it (.ins-tablist, .ins-seg) -->
  <Style Selector="TabControl /template/ Border#PART_Strip, TabStrip /template/ Border#PART_Strip">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource InsLineGlass}" />
    <Setter Property="CornerRadius" Value="{DynamicResource InsRMd}" />
    <Setter Property="Background" Value="{DynamicResource InsCtlBgHover}" />
  </Style>
  <Style Selector="TabControl /template/ Border#PART_Strip">
    <Setter Property="Margin" Value="0,0,0,16" />
  </Style>
  <Style Selector="TabControl > TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TabControl > TextBlock[FlowDirection=RightToLeft]">
    <Setter Property="LineHeight" Value="23.8" />
  </Style>
  <Style Selector="TabControl.seg /template/ Border#PART_Strip">
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="TabControl /template/ Border#PART_Flight, TabStrip /template/ Border#PART_Flight">
    <Setter Property="CornerRadius" Value="{DynamicResource InsRSm}" />
    <Setter Property="Background" Value="{DynamicResource InsSegOnBg}" />
    <Setter Property="BoxShadow" Value="{DynamicResource InsSegOnShadow}" />
  </Style>
  <Style Selector="TabControl.moving > TabItem:selected /template/ Border#PART_LayoutRoot, TabStrip.moving > TabStripItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BoxShadow" Value="none" />
  </Style>

  <!-- line: a row of sections over a hairline, the underline travelling to the selected one (the line modifier of .ins-tablist) -->
  <Style Selector="TabControl.line /template/ Border#PART_Strip, TabStrip.line /template/ Border#PART_Strip">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource InsLine}" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TabStrip.line">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="TabControl.line /template/ ItemsPresenter#PART_ItemsPresenter > StackPanel, TabStrip.line /template/ ItemsPresenter#PART_ItemsPresenter > StackPanel">
    <Setter Property="Spacing" Value="4" />
  </Style>
  <Style Selector="TabControl.line /template/ Border#PART_Flight, TabStrip.line /template/ Border#PART_Flight">
    <Setter Property="Height" Value="3" />
    <Setter Property="FlowDirection" Value="LeftToRight" />
    <Setter Property="CornerRadius" Value="{DynamicResource InsRPill}" />
    <Setter Property="Background" Value="{DynamicResource InsTabLineFill}" />
    <Setter Property="BoxShadow" Value="none" />
  </Style>
  <Style Selector="TabControl.line > TabItem, TabStrip.line > TabStripItem">
    <Setter Property="CornerRadius" Value="10,10,0,0" />
    <Setter Property="FontSize" Value="{DynamicResource InsFsSm}" />
    <Setter Property="Foreground" Value="{DynamicResource InsLabel}" />
  </Style>
  <Style Selector="TabControl.line > TabItem /template/ Panel#PART_SelectedPipe, TabStrip.line > TabStripItem /template/ Panel#PART_SelectedPipe">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="TabControl.line > TabItem:pointerover, TabStrip.line > TabStripItem:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource InsText1}" />
  </Style>
  <Style Selector="TabControl.line > TabItem:pointerover /template/ Border#PART_LayoutRoot, TabStrip.line > TabStripItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource InsCtlBg}" />
  </Style>
  <Style Selector="TabControl.line > TabItem:pointerover /template/ Panel#PART_SelectedPipe, TabStrip.line > TabStripItem:pointerover /template/ Panel#PART_SelectedPipe">
    <Setter Property="RenderTransform" Value="scaleX(0.35)" />
  </Style>
  <Style Selector="TabControl.line > TabItem:selected, TabControl.line > TabItem:current, TabStrip.line > TabStripItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource InsToneBrand}" />
  </Style>
  <Style Selector="TabControl.line > TabItem:selected /template/ Border#PART_LayoutRoot, TabControl.line > TabItem:current /template/ Border#PART_LayoutRoot, TabStrip.line > TabStripItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BoxShadow" Value="none" />
  </Style>
  <Style Selector="TabControl.line > TabItem:selected /template/ Panel#PART_SelectedPipe, TabControl.line > TabItem:current /template/ Panel#PART_SelectedPipe, TabStrip.line > TabStripItem:selected /template/ Panel#PART_SelectedPipe">
    <Setter Property="RenderTransform" Value="scaleX(1)" />
  </Style>
  <Style Selector="TabControl.line.moving > TabItem /template/ Panel#PART_SelectedPipe, TabStrip.line.moving > TabStripItem /template/ Panel#PART_SelectedPipe">
    <Setter Property="Opacity" Value="0" />
  </Style>

</Styles>
