<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ins="using:Insiyab.Avalonia.Controls">

  <Styles.Resources>
    <ResourceDictionary>

      <!-- The line look's underline, a small brand accent in the middle shade, as the web's -->
      <SolidColorBrush x:Key="InsTabLineFill" Color="{DynamicResource InsPrimaryMidColor}" />
      <SolidColorBrush x:Key="InsTabLineGlow" Color="{DynamicResource InsPrimaryColor}" Opacity="0.45" />

      <ControlTheme x:Key="InsTabFace" TargetType="ContentControl">
        <Setter Property="MinHeight" Value="{DynamicResource InsCtlH}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="CornerRadius" Value="{DynamicResource InsRSm}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource InsText2}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Transitions">
          <Transitions>
            <BrushTransition Property="Foreground" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
          </Transitions>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type TabItem}" TargetType="TabItem" BasedOn="{StaticResource InsTabFace}">

        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel>
              <ins:TemplateBorder Name="PART_LayoutRoot"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{TemplateBinding CornerRadius}"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter Name="PART_ContentPresenter"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Content="{TemplateBinding Header}"
                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                  RecognizesAccessKey="True" />
              </ins:TemplateBorder>
              <ins:TemplateBorder Name="PART_FocusRing" CornerRadius="{TemplateBinding CornerRadius}" BorderThickness="2"
                      BorderBrush="{DynamicResource InsToneBrandSoft}" IsVisible="False" IsHitTestVisible="False" />
              <Panel Name="PART_SelectedPipe" IsVisible="False" Height="3" VerticalAlignment="Bottom" Margin="10,0,10,-1"
                     RenderTransformOrigin="50%,50%" RenderTransform="scaleX(0)" IsHitTestVisible="False">
                <ins:TemplateBorder Name="PART_PipeGlow" CornerRadius="{DynamicResource InsRPill}" Background="{DynamicResource InsTabLineGlow}">
                  <ins:TemplateBorder.Effect>
                    <BlurEffect Radius="10" />
                  </ins:TemplateBorder.Effect>
                </ins:TemplateBorder>
                <ins:TemplateBorder Name="PART_Pipe" FlowDirection="LeftToRight" CornerRadius="{DynamicResource InsRPill}" Background="{DynamicResource InsTabLineFill}" />
              </Panel>
            </Panel>
          </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ :is(Border)#PART_LayoutRoot">
          <Setter Property="Transitions">
            <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
              <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="^ /template/ Panel#PART_SelectedPipe">
          <Setter Property="Transitions">
            <Transitions>
              <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
            </Transitions>
          </Setter>
        </Style>

        <Style Selector="^:pointerover">
          <Setter Property="Foreground" Value="{DynamicResource InsPrimaryDarker}" />
          <Style Selector="^ /template/ :is(Border)#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource InsSurfaceHover}" />
          </Style>
        </Style>
        <Style Selector="^:selected, ^:current">
          <Setter Property="Foreground" Value="{DynamicResource InsSegOnFg}" />
          <Style Selector="^ /template/ :is(Border)#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource InsSegOnBg}" />
            <Setter Property="BoxShadow" Value="{DynamicResource InsSegOnShadow}" />
          </Style>
        </Style>
        <Style Selector="^:focus-visible /template/ :is(Border)#PART_FocusRing">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.5" />
          <Setter Property="Cursor" Value="Arrow" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type TabStripItem}" TargetType="TabStripItem" BasedOn="{StaticResource InsTabFace}">

        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel>
              <ins:TemplateBorder Name="PART_LayoutRoot"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{TemplateBinding CornerRadius}"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter Name="PART_ContentPresenter"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  RecognizesAccessKey="True" />
              </ins:TemplateBorder>
              <ins:TemplateBorder Name="PART_FocusRing" CornerRadius="{TemplateBinding CornerRadius}" BorderThickness="2"
                      BorderBrush="{DynamicResource InsToneBrandSoft}" IsVisible="False" IsHitTestVisible="False" />
              <Panel Name="PART_SelectedPipe" IsVisible="False" Height="3" VerticalAlignment="Bottom" Margin="10,0,10,-1"
                     RenderTransformOrigin="50%,50%" RenderTransform="scaleX(0)" IsHitTestVisible="False">
                <ins:TemplateBorder Name="PART_PipeGlow" CornerRadius="{DynamicResource InsRPill}" Background="{DynamicResource InsTabLineGlow}">
                  <ins:TemplateBorder.Effect>
                    <BlurEffect Radius="10" />
                  </ins:TemplateBorder.Effect>
                </ins:TemplateBorder>
                <ins:TemplateBorder Name="PART_Pipe" FlowDirection="LeftToRight" CornerRadius="{DynamicResource InsRPill}" Background="{DynamicResource InsTabLineFill}" />
              </Panel>
            </Panel>
          </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ :is(Border)#PART_LayoutRoot">
          <Setter Property="Transitions">
            <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
              <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="^ /template/ Panel#PART_SelectedPipe">
          <Setter Property="Transitions">
            <Transitions>
              <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="^:pointerover">
          <Setter Property="Foreground" Value="{DynamicResource InsPrimaryDarker}" />
          <Style Selector="^ /template/ :is(Border)#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource InsSurfaceHover}" />
          </Style>
        </Style>
        <Style Selector="^:selected">
          <Setter Property="Foreground" Value="{DynamicResource InsSegOnFg}" />
          <Style Selector="^ /template/ :is(Border)#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource InsSegOnBg}" />
            <Setter Property="BoxShadow" Value="{DynamicResource InsSegOnShadow}" />
          </Style>
        </Style>
        <Style Selector="^:focus-visible /template/ :is(Border)#PART_FocusRing">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.5" />
          <Setter Property="Cursor" Value="Arrow" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type TabControl}" TargetType="TabControl">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="{DynamicResource InsFsMd}" />
        <Setter Property="Foreground" Value="{DynamicResource InsText1}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="ins:Tabs.Keys" Value="True" />
        <Setter Property="ins:Tabs.Fly" Value="True" />
        <Setter Property="PageTransition">
          <ins:RiseTransition />
        </Setter>
        <Setter Property="ItemsPanel">
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="3" />
          </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
          <ControlTemplate>
            <DockPanel Background="{TemplateBinding Background}">
              <ins:TemplateBorder Name="PART_Strip" DockPanel.Dock="Top">
                <Panel>
                  <Canvas Name="PART_FlightLayer" IsHitTestVisible="False">
                    <ins:TemplateBorder Name="PART_Flight" IsVisible="False" />
                  </Canvas>
                  <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </Panel>
              </ins:TemplateBorder>
              <Panel>
                <ContentPresenter Name="PART_SelectedContentHost2"
                                  Margin="{TemplateBinding Padding}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                  IsVisible="False" />
                <ContentPresenter Name="PART_SelectedContentHost"
                                  Margin="{TemplateBinding Padding}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
              </Panel>
            </DockPanel>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type TabStrip}" TargetType="TabStrip">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="ins:Tabs.Keys" Value="True" />
        <Setter Property="ins:Tabs.Fly" Value="True" />
        <Setter Property="ItemsPanel">
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="3" />
          </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
          <ControlTemplate>
            <ins:TemplateBorder Name="PART_Strip">
              <Panel>
                <Canvas Name="PART_FlightLayer" IsHitTestVisible="False">
                  <ins:TemplateBorder Name="PART_Flight" IsVisible="False" />
                </Canvas>
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
              </Panel>
            </ins:TemplateBorder>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <StreamGeometry x:Key="InsDocTabsBack">M15 6 l-6 6 6 6</StreamGeometry>
      <StreamGeometry x:Key="InsDocTabsForward">M9 6 l6 6 -6 6</StreamGeometry>
      <StreamGeometry x:Key="InsDocTabsPlus">M12 5 v14 M5 12 h14</StreamGeometry>

      <!-- The strip's own small buttons: the scroll arrows and the new-tab "+". -->
      <ControlTheme x:Key="InsDocTabsButton" TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource InsText2}" />
        <Setter Property="CornerRadius" Value="{DynamicResource InsRSm}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Transitions">
          <Transitions>
            <BrushTransition Property="Background" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
            <BrushTransition Property="Foreground" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
          </Transitions>
        </Setter>
        <Setter Property="Template">
          <ControlTemplate>
            <ins:TemplateBorder x:Name="PART_Face" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
              <Viewbox Width="14" Height="14">
                <ContentPresenter Content="{TemplateBinding Content}" />
              </Viewbox>
            </ins:TemplateBorder>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Background" Value="{DynamicResource InsSurfaceHover}" />
          <Setter Property="Foreground" Value="{DynamicResource InsPrimaryDarker}" />
        </Style>
        <Style Selector="^:pressed">
          <Setter Property="Background" Value="{DynamicResource InsCtlBd}" />
        </Style>
        <Style Selector="^:focus-visible /template/ :is(Border)#PART_Face">
          <Setter Property="BoxShadow" Value="{DynamicResource InsFocusRing}" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.35" />
          <Setter Property="Cursor" Value="Arrow" />
        </Style>
      </ControlTheme>

      <!-- DocumentTabs: the TabControl's strip and keys, the strip scrolling between arrows when the tabs overflow, and the "+" after the last tab. -->
      <ControlTheme x:Key="{x:Type ins:DocumentTabs}" TargetType="ins:DocumentTabs" BasedOn="{StaticResource {x:Type TabControl}}">
        <Setter Property="Template">
          <ControlTemplate>
            <DockPanel Background="{TemplateBinding Background}">
              <ins:TemplateBorder Name="PART_Strip" DockPanel.Dock="Top">
                <DockPanel>
                  <RepeatButton Name="PART_Back" DockPanel.Dock="Left" Theme="{StaticResource InsDocTabsButton}" Focusable="False" Margin="3,0,0,0">
                    <Path Width="24" Height="24" Data="{StaticResource InsDocTabsBack}" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2.2" StrokeLineCap="Round" StrokeJoin="Round" />
                  </RepeatButton>
                  <Button Name="PART_New"
                          DockPanel.Dock="Right"
                          Theme="{StaticResource InsDocTabsButton}"
                          Margin="2,0,4,0"
                          IsVisible="{TemplateBinding ShowNewButton}"
                          AutomationProperties.Name="{TemplateBinding NewLabel}">
                    <Path Width="24" Height="24" Data="{StaticResource InsDocTabsPlus}" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2.2" StrokeLineCap="Round" />
                  </Button>
                  <RepeatButton Name="PART_Forward" DockPanel.Dock="Right" Theme="{StaticResource InsDocTabsButton}" Focusable="False" Margin="0,0,3,0">
                    <Path Width="24" Height="24" Data="{StaticResource InsDocTabsForward}" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2.2" StrokeLineCap="Round" StrokeJoin="Round" />
                  </RepeatButton>
                  <ScrollViewer Name="PART_Scroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <Panel Margin="3">
                      <Canvas Name="PART_FlightLayer" IsHitTestVisible="False">
                        <ins:TemplateBorder Name="PART_Flight" IsVisible="False" />
                      </Canvas>
                      <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </Panel>
                  </ScrollViewer>
                </DockPanel>
              </ins:TemplateBorder>
              <Panel>
                <ContentPresenter Name="PART_SelectedContentHost2"
                                  Margin="{TemplateBinding Padding}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                  IsVisible="False" />
                <ContentPresenter Name="PART_SelectedContentHost"
                                  Margin="{TemplateBinding Padding}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
              </Panel>
            </DockPanel>
          </ControlTemplate>
        </Setter>
        <!-- The strip hugs its tabs, up to the width it is given; past that it scrolls. -->
        <Style Selector="^ /template/ :is(Border)#PART_Strip">
          <Setter Property="HorizontalAlignment" Value="Left" />
          <Setter Property="Padding" Value="1" />
          <Setter Property="Margin" Value="0,0,0,12" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="BorderBrush" Value="{DynamicResource InsLineGlass}" />
          <Setter Property="CornerRadius" Value="{DynamicResource InsRMd}" />
          <Setter Property="Background" Value="{DynamicResource InsCtlBgHover}" />
        </Style>
        <Style Selector="^ /template/ RepeatButton#PART_Back, ^ /template/ RepeatButton#PART_Forward">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:overflow /template/ RepeatButton#PART_Back, ^:overflow /template/ RepeatButton#PART_Forward">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^ /template/ :is(Border)#PART_Flight">
          <Setter Property="CornerRadius" Value="{DynamicResource InsRSm}" />
          <Setter Property="Background" Value="{DynamicResource InsSegOnBg}" />
          <Setter Property="BoxShadow" Value="{DynamicResource InsSegOnShadow}" />
        </Style>
      </ControlTheme>

      <!-- A DocumentTabs tab: the tab's face with a close button at its end, shown on the selected tab and under the pointer, its room kept so the tab never changes width. -->
      <ControlTheme x:Key="{x:Type ins:DocumentTab}" TargetType="ins:DocumentTab" BasedOn="{StaticResource {x:Type TabItem}}">
        <Setter Property="Padding" Value="14,6,6,6" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel Name="PART_Slide" RenderTransform="none">
              <ins:TemplateBorder Name="PART_LayoutRoot"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{TemplateBinding CornerRadius}"
                      Padding="{TemplateBinding Padding}">
                <DockPanel>
                  <Panel Name="PART_CloseHost" DockPanel.Dock="Right" Margin="6,0,0,0" VerticalAlignment="Center">
                    <Button Name="PART_Close"
                            Classes="close sm bare"
                            Focusable="False"
                            AutomationProperties.Name="{Binding $parent[ins:DocumentTabs].CloseLabel, FallbackValue={x:Null}}" />
                  </Panel>
                  <ContentPresenter Name="PART_ContentPresenter"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Header}"
                                    ContentTemplate="{TemplateBinding HeaderTemplate}"
                                    RecognizesAccessKey="True" />
                </DockPanel>
              </ins:TemplateBorder>
              <ins:TemplateBorder Name="PART_FocusRing" CornerRadius="{TemplateBinding CornerRadius}" BorderThickness="2"
                      BorderBrush="{DynamicResource InsToneBrandSoft}" IsVisible="False" IsHitTestVisible="False" />
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ Panel#PART_Slide">
          <Setter Property="Transitions">
            <Transitions>
              <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="0.22,1,0.36,1" />
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="^:dragging">
          <Setter Property="ZIndex" Value="5" />
          <Setter Property="Cursor" Value="SizeWestEast" />
          <Style Selector="^ /template/ Panel#PART_Slide">
            <Setter Property="Transitions" Value="{x:Null}" />
          </Style>
        </Style>
        <Style Selector="^ /template/ Panel#PART_CloseHost">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="IsHitTestVisible" Value="False" />
          <Setter Property="Transitions">
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="0.22,1,0.36,1" />
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="^:selected /template/ Panel#PART_CloseHost, ^:pointerover /template/ Panel#PART_CloseHost">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="^[IsClosable=False]">
          <Setter Property="Padding" Value="14,6" />
          <Style Selector="^ /template/ Panel#PART_CloseHost">
            <Setter Property="IsVisible" Value="False" />
          </Style>
        </Style>
      </ControlTheme>

    </ResourceDictionary>
  </Styles.Resources>

  <!-- The strip: a recessed track with the selected tab raised out of it (.ins-tablist, .ins-seg) -->
  <Style Selector="TabControl /template/ :is(Border)#PART_Strip, TabStrip /template/ :is(Border)#PART_Strip">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource InsLineGlass}" />
    <Setter Property="CornerRadius" Value="{DynamicResource InsRMd}" />
    <Setter Property="Background" Value="{DynamicResource InsCtlBgHover}" />
  </Style>
  <Style Selector="TabControl /template/ :is(Border)#PART_Strip">
    <Setter Property="Margin" Value="0,0,0,16" />
  </Style>
  <Style Selector="TabControl > TextBlock, TabControl > ins|TemplateText">
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TabControl > TextBlock[FlowDirection=RightToLeft], TabControl > ins|TemplateText[FlowDirection=RightToLeft]">
    <Setter Property="LineHeight" Value="23.8" />
  </Style>
  <Style Selector="TabControl.seg /template/ :is(Border)#PART_Strip">
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="TabControl /template/ :is(Border)#PART_Flight, TabStrip /template/ :is(Border)#PART_Flight">
    <Setter Property="CornerRadius" Value="{DynamicResource InsRSm}" />
    <Setter Property="Background" Value="{DynamicResource InsSegOnBg}" />
    <Setter Property="BoxShadow" Value="{DynamicResource InsSegOnShadow}" />
  </Style>
  <Style Selector="TabControl.moving > TabItem:selected /template/ :is(Border)#PART_LayoutRoot, TabStrip.moving > TabStripItem:selected /template/ :is(Border)#PART_LayoutRoot">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BoxShadow" Value="none" />
  </Style>

  <!-- line: a row of sections over a hairline, the underline travelling to the selected one (the line modifier of .ins-tablist) -->
  <Style Selector="TabControl.line /template/ :is(Border)#PART_Strip, TabStrip.line /template/ :is(Border)#PART_Strip">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource InsLine}" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TabStrip.line">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="TabControl.line /template/ ItemsPresenter#PART_ItemsPresenter > StackPanel, TabStrip.line /template/ ItemsPresenter#PART_ItemsPresenter > StackPanel">
    <Setter Property="Spacing" Value="4" />
  </Style>
  <Style Selector="TabControl.line /template/ :is(Border)#PART_Flight, TabStrip.line /template/ :is(Border)#PART_Flight">
    <Setter Property="Height" Value="3" />
    <Setter Property="FlowDirection" Value="LeftToRight" />
    <Setter Property="CornerRadius" Value="{DynamicResource InsRPill}" />
    <Setter Property="Background" Value="{DynamicResource InsTabLineFill}" />
    <Setter Property="BoxShadow" Value="none" />
  </Style>
  <Style Selector="TabControl.line > TabItem, TabStrip.line > TabStripItem">
    <Setter Property="CornerRadius" Value="10,10,0,0" />
    <Setter Property="FontSize" Value="{DynamicResource InsFsSm}" />
    <Setter Property="Foreground" Value="{DynamicResource InsLabel}" />
  </Style>
  <Style Selector="TabControl.line > TabItem /template/ Panel#PART_SelectedPipe, TabStrip.line > TabStripItem /template/ Panel#PART_SelectedPipe">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="TabControl.line > TabItem:pointerover, TabStrip.line > TabStripItem:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource InsText1}" />
  </Style>
  <Style Selector="TabControl.line > TabItem:pointerover /template/ :is(Border)#PART_LayoutRoot, TabStrip.line > TabStripItem:pointerover /template/ :is(Border)#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource InsCtlBg}" />
  </Style>
  <Style Selector="TabControl.line > TabItem:pointerover /template/ Panel#PART_SelectedPipe, TabStrip.line > TabStripItem:pointerover /template/ Panel#PART_SelectedPipe">
    <Setter Property="RenderTransform" Value="scaleX(0.35)" />
  </Style>
  <Style Selector="TabControl.line > TabItem:selected, TabControl.line > TabItem:current, TabStrip.line > TabStripItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource InsToneBrand}" />
  </Style>
  <Style Selector="TabControl.line > TabItem:selected /template/ :is(Border)#PART_LayoutRoot, TabControl.line > TabItem:current /template/ :is(Border)#PART_LayoutRoot, TabStrip.line > TabStripItem:selected /template/ :is(Border)#PART_LayoutRoot">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BoxShadow" Value="none" />
  </Style>
  <Style Selector="TabControl.line > TabItem:selected /template/ Panel#PART_SelectedPipe, TabControl.line > TabItem:current /template/ Panel#PART_SelectedPipe, TabStrip.line > TabStripItem:selected /template/ Panel#PART_SelectedPipe">
    <Setter Property="RenderTransform" Value="scaleX(1)" />
  </Style>
  <Style Selector="TabControl.line.moving > TabItem /template/ Panel#PART_SelectedPipe, TabStrip.line.moving > TabStripItem /template/ Panel#PART_SelectedPipe">
    <Setter Property="Opacity" Value="0" />
  </Style>

  <!-- The close button sized to sit inside a tab. -->
  <Style Selector="ins|DocumentTab /template/ Button#PART_Close.close">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
  </Style>
  <Style Selector="ins|DocumentTabs.moving > ins|DocumentTab:selected /template/ :is(Border)#PART_LayoutRoot">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BoxShadow" Value="none" />
  </Style>

</Styles>
