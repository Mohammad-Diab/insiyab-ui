<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:Insiyab.Avalonia.Controls">

  <Styles.Resources>
    <ResourceDictionary>
      <!-- A hovered link: toward more light, the mid brand on light and plain text on dark -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="InsLinkHover" Color="{DynamicResource InsToneBrandSoftColor}" />
          <!-- The brand as a tint takes it: the primary on light, its middle shade on dark; Bg and Bd are its soft fill and edge -->
          <SolidColorBrush x:Key="InsBrandTint" Color="{DynamicResource InsPrimaryColor}" />
          <SolidColorBrush x:Key="InsBrandTintBg" Color="{DynamicResource InsPrimaryRgbColor}" Opacity="0.12" />
          <SolidColorBrush x:Key="InsBrandTintBd" Color="{DynamicResource InsPrimaryRgbColor}" Opacity="0.20" />
          <SolidColorBrush x:Key="InsSelection" Color="{DynamicResource InsPrimaryRgbColor}" Opacity="0.22" />
          <SolidColorBrush x:Key="InsScrollbarThumb" Color="{DynamicResource InsPrimaryRgbColor}" Opacity="0.28" />
          <SolidColorBrush x:Key="InsScrollbarThumbHover" Color="{DynamicResource InsPrimaryRgbColor}" Opacity="0.40" />
          <SolidColorBrush x:Key="InsScrollbarThumbPressed" Color="{DynamicResource InsPrimaryRgbColor}" Opacity="0.50" />
          <SolidColorBrush x:Key="InsScrollbarTrack" Color="{DynamicResource InsPrimaryRgbColor}" Opacity="0.08" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="InsLinkHover" Color="{DynamicResource InsText1Color}" />
          <SolidColorBrush x:Key="InsBrandTint" Color="{DynamicResource InsPrimaryMidColor}" />
          <SolidColorBrush x:Key="InsBrandTintBg" Color="{DynamicResource InsPrimaryMidColor}" Opacity="0.20" />
          <SolidColorBrush x:Key="InsBrandTintBd" Color="{DynamicResource InsPrimaryMidColor}" Opacity="0.32" />
          <SolidColorBrush x:Key="InsSelection" Color="{DynamicResource InsPrimaryMidColor}" Opacity="0.22" />
          <SolidColorBrush x:Key="InsScrollbarThumb" Color="{DynamicResource InsPrimaryMidColor}" Opacity="0.45" />
          <SolidColorBrush x:Key="InsScrollbarThumbHover" Color="{DynamicResource InsPrimaryMidColor}" Opacity="0.65" />
          <SolidColorBrush x:Key="InsScrollbarThumbPressed" Color="{DynamicResource InsPrimaryMidColor}" Opacity="0.80" />
          <SolidColorBrush x:Key="InsScrollbarTrack" Color="{DynamicResource InsPrimaryMidColor}" Opacity="0.14" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- A link's underline under the pointer: a little below the font's own and 0.07em thick, so it clears Arabic's joining strokes -->
      <TextDecorationCollection x:Key="InsLinkUnderline">
        <TextDecoration Location="Underline" StrokeThickness="0.07" StrokeThicknessUnit="FontRenderingEmSize" StrokeOffset="0.14" StrokeOffsetUnit="FontRenderingEmSize" />
      </TextDecorationCollection>

      <!-- The web's scrollbar: 5px, no arrows, a brand-tinted thumb, the track stopping 10px short of each end. Under the pointer or while dragged it grows as Windows 11's does: 12px over the content's edge with its track showing and the thumb 8px inside it, eased (at once in a still window); its slot in the layout stays 5px, and the pointer finds it anywhere in the grown band -->
      <x:Double x:Key="InsScrollbarSize">5</x:Double>
      <x:Double x:Key="InsScrollbarHoverSize">12</x:Double>
      <Thickness x:Key="InsScrollbarThumbInsetV">2,0</Thickness>
      <Thickness x:Key="InsScrollbarThumbInsetH">0,2</Thickness>

      <ControlTheme x:Key="InsScrollbarThumbTheme" TargetType="Thumb">
        <Setter Property="Background" Value="{DynamicResource InsScrollbarThumb}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Template">
          <ControlTemplate>
            <ctl:TemplateBorder Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" />
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Background" Value="{DynamicResource InsScrollbarThumbHover}" />
        </Style>
        <Style Selector="^:pressed">
          <Setter Property="Background" Value="{DynamicResource InsScrollbarThumbPressed}" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="InsScrollbarPageTheme" TargetType="RepeatButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
          <ControlTemplate>
            <ctl:TemplateBorder Background="{TemplateBinding Background}" />
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
        <Setter Property="MinWidth" Value="{DynamicResource InsScrollbarSize}" />
        <Setter Property="MinHeight" Value="{DynamicResource InsScrollbarSize}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ClipToBounds" Value="False" />
        <Style Selector="^:vertical">
          <Setter Property="Width" Value="{DynamicResource InsScrollbarSize}" />
          <Setter Property="Template">
            <ControlTemplate>
              <!-- the band the pointer finds it in: the grown width at the bar's outer edge, over the content's edge -->
              <Panel Name="PART_Zone" Background="Transparent" Width="{DynamicResource InsScrollbarHoverSize}" HorizontalAlignment="Right" ClipToBounds="False">
                <ctl:TemplateBorder Name="PART_Rail" Width="{DynamicResource InsScrollbarSize}" HorizontalAlignment="Right" Margin="0,10"
                                    Background="{TemplateBinding Background}" CornerRadius="6">
                  <ctl:TemplateBorder.Transitions>
                    <Transitions>
                      <DoubleTransition Property="Width" Duration="0:0:0.18" Easing="0.22,1,0.36,1" />
                      <ctl:BrushFade Property="Background" Duration="0:0:0.18" Easing="0.22,1,0.36,1" />
                    </Transitions>
                  </ctl:TemplateBorder.Transitions>
                  <Track Name="PART_Track"
                         Minimum="{TemplateBinding Minimum}"
                         Maximum="{TemplateBinding Maximum}"
                         Value="{TemplateBinding Value, Mode=TwoWay}"
                         DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                         ViewportSize="{TemplateBinding ViewportSize}"
                         Orientation="{TemplateBinding Orientation}"
                         IsDirectionReversed="True">
                    <Track.DecreaseButton>
                      <RepeatButton Name="PART_PageUpButton" Classes="largeIncrease" Theme="{StaticResource InsScrollbarPageTheme}" />
                    </Track.DecreaseButton>
                    <Track.IncreaseButton>
                      <RepeatButton Name="PART_PageDownButton" Classes="largeIncrease" Theme="{StaticResource InsScrollbarPageTheme}" />
                    </Track.IncreaseButton>
                    <Thumb Name="PART_Thumb" Theme="{StaticResource InsScrollbarThumbTheme}" MinHeight="20" AutomationProperties.Name="Position">
                      <Thumb.Transitions>
                        <Transitions>
                          <ThicknessTransition Property="Margin" Duration="0:0:0.18" Easing="0.22,1,0.36,1" />
                        </Transitions>
                      </Thumb.Transitions>
                    </Thumb>
                  </Track>
                </ctl:TemplateBorder>
              </Panel>
            </ControlTemplate>
          </Setter>
          <!-- under the pointer, or while its thumb is dragged (:ins-drag, also once the pointer left the bar): grown, its track showing -->
          <Style Selector="^:pointerover /template/ ctl|TemplateBorder#PART_Rail, ^:ins-drag /template/ ctl|TemplateBorder#PART_Rail">
            <Setter Property="Width" Value="{DynamicResource InsScrollbarHoverSize}" />
            <Setter Property="Background" Value="{DynamicResource InsScrollbarTrack}" />
          </Style>
          <Style Selector="^:pointerover /template/ Thumb#PART_Thumb, ^:ins-drag /template/ Thumb#PART_Thumb">
            <Setter Property="Margin" Value="{DynamicResource InsScrollbarThumbInsetV}" />
          </Style>
        </Style>
        <Style Selector="^:horizontal">
          <Setter Property="Height" Value="{DynamicResource InsScrollbarSize}" />
          <Setter Property="Template">
            <ControlTemplate>
              <Panel Name="PART_Zone" Background="Transparent" Height="{DynamicResource InsScrollbarHoverSize}" VerticalAlignment="Bottom" ClipToBounds="False">
                <ctl:TemplateBorder Name="PART_Rail" Height="{DynamicResource InsScrollbarSize}" VerticalAlignment="Bottom" Margin="10,0"
                                    Background="{TemplateBinding Background}" CornerRadius="6">
                  <ctl:TemplateBorder.Transitions>
                    <Transitions>
                      <DoubleTransition Property="Height" Duration="0:0:0.18" Easing="0.22,1,0.36,1" />
                      <ctl:BrushFade Property="Background" Duration="0:0:0.18" Easing="0.22,1,0.36,1" />
                    </Transitions>
                  </ctl:TemplateBorder.Transitions>
                  <Track Name="PART_Track"
                         Minimum="{TemplateBinding Minimum}"
                         Maximum="{TemplateBinding Maximum}"
                         Value="{TemplateBinding Value, Mode=TwoWay}"
                         DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                         ViewportSize="{TemplateBinding ViewportSize}"
                         Orientation="{TemplateBinding Orientation}">
                    <Track.DecreaseButton>
                      <RepeatButton Name="PART_PageUpButton" Classes="largeIncrease" Theme="{StaticResource InsScrollbarPageTheme}" />
                    </Track.DecreaseButton>
                    <Track.IncreaseButton>
                      <RepeatButton Name="PART_PageDownButton" Classes="largeIncrease" Theme="{StaticResource InsScrollbarPageTheme}" />
                    </Track.IncreaseButton>
                    <Thumb Name="PART_Thumb" Theme="{StaticResource InsScrollbarThumbTheme}" MinWidth="20" AutomationProperties.Name="Position">
                      <Thumb.Transitions>
                        <Transitions>
                          <ThicknessTransition Property="Margin" Duration="0:0:0.18" Easing="0.22,1,0.36,1" />
                        </Transitions>
                      </Thumb.Transitions>
                    </Thumb>
                  </Track>
                </ctl:TemplateBorder>
              </Panel>
            </ControlTemplate>
          </Setter>
          <!-- under the pointer, or while its thumb is dragged (:ins-drag, also once the pointer left the bar): grown, its track showing -->
          <Style Selector="^:pointerover /template/ ctl|TemplateBorder#PART_Rail, ^:ins-drag /template/ ctl|TemplateBorder#PART_Rail">
            <Setter Property="Height" Value="{DynamicResource InsScrollbarHoverSize}" />
            <Setter Property="Background" Value="{DynamicResource InsScrollbarTrack}" />
          </Style>
          <Style Selector="^:pointerover /template/ Thumb#PART_Thumb, ^:ins-drag /template/ Thumb#PART_Thumb">
            <Setter Property="Margin" Value="{DynamicResource InsScrollbarThumbInsetH}" />
          </Style>
        </Style>
      </ControlTheme>

      <!-- Fluent's template, with bars that take their room as the web's do instead of floating over the content -->
      <ControlTheme x:Key="{x:Type ScrollViewer}" TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="AllowAutoHide" Value="False" />
        <Setter Property="Template">
          <ControlTemplate>
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
              <ScrollContentPresenter Name="PART_ContentPresenter"
                                      Grid.Row="0"
                                      Grid.Column="0"
                                      Background="{TemplateBinding Background}"
                                      HorizontalSnapPointsType="{TemplateBinding HorizontalSnapPointsType}"
                                      VerticalSnapPointsType="{TemplateBinding VerticalSnapPointsType}"
                                      HorizontalSnapPointsAlignment="{TemplateBinding HorizontalSnapPointsAlignment}"
                                      VerticalSnapPointsAlignment="{TemplateBinding VerticalSnapPointsAlignment}"
                                      Padding="{TemplateBinding Padding}"
                                      ScrollViewer.IsScrollInertiaEnabled="{TemplateBinding IsScrollInertiaEnabled}">
                <ScrollContentPresenter.GestureRecognizers>
                  <ScrollGestureRecognizer CanHorizontallyScroll="{Binding CanHorizontallyScroll, ElementName=PART_ContentPresenter}"
                                           CanVerticallyScroll="{Binding CanVerticallyScroll, ElementName=PART_ContentPresenter}"
                                           IsScrollInertiaEnabled="{Binding (ScrollViewer.IsScrollInertiaEnabled), ElementName=PART_ContentPresenter}"
                                           Offset="{Binding Offset, ElementName=PART_ContentPresenter}"
                                           Viewport="{Binding Viewport, ElementName=PART_ContentPresenter}"
                                           Extent="{Binding Extent, ElementName=PART_ContentPresenter}" />
                </ScrollContentPresenter.GestureRecognizers>
              </ScrollContentPresenter>
              <ScrollBar Name="PART_HorizontalScrollBar" Orientation="Horizontal" Grid.Row="1" />
              <ScrollBar Name="PART_VerticalScrollBar" Orientation="Vertical" Grid.Column="1" />
              <Panel Name="PART_ScrollBarsSeparator" Grid.Row="1" Grid.Column="1" />
            </Grid>
          </ControlTemplate>
        </Setter>
        <Style Selector="^[AllowAutoHide=True] /template/ ScrollContentPresenter#PART_ContentPresenter">
          <Setter Property="Grid.ColumnSpan" Value="2" />
          <Setter Property="Grid.RowSpan" Value="2" />
        </Style>
      </ControlTheme>

      <!-- An hr: one hairline in the rule colour, 1rem above and below; Separator.v stands between items in a row -->
      <ControlTheme x:Key="{x:Type Separator}" TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource InsHr}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Height" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0,16" />
        <Setter Property="Template">
          <ControlTemplate>
            <ctl:TemplateBorder Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}" />
          </ControlTemplate>
        </Setter>
        <Style Selector="^.v">
          <Setter Property="Width" Value="1" />
          <Setter Property="Height" Value="NaN" />
          <Setter Property="MinHeight" Value="14" />
          <Setter Property="HorizontalAlignment" Value="Center" />
          <Setter Property="VerticalAlignment" Value="Stretch" />
          <Setter Property="Margin" Value="4,0" />
        </Style>
      </ControlTheme>

      <!-- A selectable text's right-click menu: the pop menu, its word in the page's language -->
      <ctl:TextMenu x:Key="InsSelectableTextFlyout">
        <MenuItem Tag="copy" Command="{Binding $parent[SelectableTextBlock].Copy}"
                  IsEnabled="{Binding $parent[SelectableTextBlock].CanCopy}" InputGesture="{x:Static TextBox.CopyGesture}" />
      </ctl:TextMenu>

      <!-- Selected text takes the web's ::selection tint -->
      <ControlTheme x:Key="{x:Type SelectableTextBlock}" TargetType="SelectableTextBlock">
        <Setter Property="SelectionBrush" Value="{DynamicResource InsSelection}" />
        <Style Selector="^[IsEnabled=True]">
          <Setter Property="Cursor" Value="IBeam" />
          <Setter Property="ContextFlyout" Value="{StaticResource InsSelectableTextFlyout}" />
        </Style>
      </ControlTheme>

      <!-- An a: the brand's readable tone, InsLinkHover and the link underline under the pointer; the focus ring is the shared one -->
      <ControlTheme x:Key="{x:Type HyperlinkButton}" TargetType="HyperlinkButton">
        <Setter Property="Foreground" Value="{DynamicResource InsToneBrandSoft}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <ControlTemplate>
            <ContentPresenter Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              RecognizesAccessKey="True"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Foreground" Value="{DynamicResource InsLinkHover}" />
          <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Inline.TextDecorations" Value="{StaticResource InsLinkUnderline}" />
          </Style>
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.55" />
        </Style>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- A phone's scrollbars under a finger (TouchScrollbars): over the content, shown only while it scrolls, fading after; a finger never takes them -->
  <Style Selector=":is(TopLevel):ins-touch-scroll ScrollViewer">
    <Setter Property="AllowAutoHide" Value="True" />
  </Style>
  <Style Selector=":is(TopLevel):ins-touch-scroll ScrollBar">
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <!-- no band under a finger (a touch host, or a finger's last scroll): the bar stays its thin self and the content's edge stays the content's -->
  <Style Selector=":is(TopLevel):ins-touch-scroll ScrollBar /template/ Panel#PART_Zone, .touch ScrollBar /template/ Panel#PART_Zone">
    <Setter Property="Background" Value="{x:Null}" />
  </Style>
  <!-- thin-scroll on a bar, its scroller or anything round them: the bar never grows, and the content's edge stays the content's -->
  <Style Selector="ScrollBar.thin-scroll /template/ Panel#PART_Zone, .thin-scroll ScrollBar /template/ Panel#PART_Zone">
    <Setter Property="Background" Value="{x:Null}" />
  </Style>
  <Style Selector="ScrollBar.thin-scroll:vertical:pointerover /template/ ctl|TemplateBorder#PART_Rail, ScrollBar.thin-scroll:vertical:ins-drag /template/ ctl|TemplateBorder#PART_Rail, .thin-scroll ScrollBar:vertical:pointerover /template/ ctl|TemplateBorder#PART_Rail, .thin-scroll ScrollBar:vertical:ins-drag /template/ ctl|TemplateBorder#PART_Rail">
    <Setter Property="Width" Value="{DynamicResource InsScrollbarSize}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ScrollBar.thin-scroll:horizontal:pointerover /template/ ctl|TemplateBorder#PART_Rail, ScrollBar.thin-scroll:horizontal:ins-drag /template/ ctl|TemplateBorder#PART_Rail, .thin-scroll ScrollBar:horizontal:pointerover /template/ ctl|TemplateBorder#PART_Rail, .thin-scroll ScrollBar:horizontal:ins-drag /template/ ctl|TemplateBorder#PART_Rail">
    <Setter Property="Height" Value="{DynamicResource InsScrollbarSize}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ScrollBar.thin-scroll:pointerover /template/ Thumb#PART_Thumb, ScrollBar.thin-scroll:ins-drag /template/ Thumb#PART_Thumb, .thin-scroll ScrollBar:pointerover /template/ Thumb#PART_Thumb, .thin-scroll ScrollBar:ins-drag /template/ Thumb#PART_Thumb">
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector=":is(TopLevel):ins-touch-scroll ScrollBar /template/ Thumb">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.3" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector=":is(TopLevel):ins-touch-scroll ScrollBar.ins-shown /template/ Thumb">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- Menus keep their own tight rule, as Fluent sizes it -->
  <Style Selector=":is(MenuFlyoutPresenter) Separator, ContextMenu Separator, MenuItem Separator">
    <Setter Property="Margin" Value="{DynamicResource MenuFlyoutSeparatorThemePadding}" />
  </Style>

  <!-- One focus ring for everything focusable: 2px in the readable brand shade, 2px outside the control -->
  <Style Selector="AdornerLayer">
    <Setter Property="DefaultFocusAdorner">
      <FocusAdornerTemplate>
        <ctl:FocusRing BorderThickness="2" BorderBrush="{DynamicResource InsToneBrandSoft}" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>

  <!-- Text never cuts its own ink at the line box: Tajawal's Arabic letters hang below the line (ع ح ر ي م و), as the web lets them. -->
  <Style Selector=":is(TextBlock)">
    <Setter Property="ClipToBounds" Value="False" />
  </Style>

</Styles>
