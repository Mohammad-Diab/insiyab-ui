<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- .ins-kbd: a key cap, a Border around a TextBlock. Key names are words, so Inter, left to right; the heavier bottom edge is the key. -->
  <Style Selector="Border.kbd">
    <Setter Property="MinWidth" Value="21" />
    <Setter Property="Padding" Value="5.4,0.6" />
    <Setter Property="Background" Value="{DynamicResource InsCtlBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InsCtlBd}" />
    <Setter Property="BorderThickness" Value="1,1,1,2" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="FlowDirection" Value="LeftToRight" />
  </Style>
  <Style Selector="Border.kbd > TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource InsFontBodyEn}" />
    <Setter Property="FontSize" Value="{DynamicResource InsFsXs}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LineHeight" Value="19.2" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource InsText1}" />
    <Setter Property="RenderTransform" Value="none" />
  </Style>

</Styles>
