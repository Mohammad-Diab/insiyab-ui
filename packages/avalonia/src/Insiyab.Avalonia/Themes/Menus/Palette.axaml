<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ins="using:Insiyab.Avalonia.Controls">

  <Styles.Resources>
    <ResourceDictionary>

      <SolidColorBrush x:Key="InsPaletteBackdrop" Color="#0F172A" Opacity="0.38" />
      <StreamGeometry x:Key="InsPaletteSearch">M4,11 A7,7 0 1 0 18,11 A7,7 0 1 0 4,11 Z M20 20 l-3.5 -3.5</StreamGeometry>


      <SolidColorBrush x:Key="InsPaletteFocusBorder" Color="{DynamicResource InsPrimaryColor}" Opacity="0.55" />
      <SolidColorBrush x:Key="InsPaletteSelection" Color="{DynamicResource InsPrimaryColor}" Opacity="0.22" />

      <!-- The search field: the large input with the search glyph at its start, drawn here so the palette does not hang on the text box theme. -->
      <ControlTheme x:Key="InsPaletteBox" TargetType="TextBox">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource InsText1}" />
        <Setter Property="Background" Value="{DynamicResource InsCtlBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InsCtlBd}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource InsRMd}" />
        <Setter Property="CaretBrush" Value="{DynamicResource InsText1}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource InsPaletteSelection}" />
        <Setter Property="PlaceholderForeground" Value="{DynamicResource InsText3}" />
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="Padding" Value="38,0,16,0" />
        <Setter Property="FontSize" Value="{DynamicResource InsFsLg}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Template">
          <ControlTemplate TargetType="TextBox">
            <Panel>
              <ins:TemplateBorder x:Name="PART_Shadow" CornerRadius="{TemplateBinding CornerRadius}" BoxShadow="{DynamicResource InsShSubtle}" />
              <ins:TemplateBorder x:Name="PART_BorderElement"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{TemplateBinding CornerRadius}"
                      BoxShadow="{DynamicResource InsBevelDim}" />
              <ins:Icon x:Name="PART_SearchIcon"
                        Classes="palette-search"
                        Data="{StaticResource InsPaletteSearch}"
                        Size="18"
                        Margin="14,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center" />
              <ScrollViewer x:Name="PART_ScrollViewer"
                            Margin="{TemplateBinding Padding}"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Disabled"
                            VerticalAlignment="Center">
                <Panel>
                  <ins:TemplateText x:Name="PART_Placeholder"
                             Foreground="{TemplateBinding PlaceholderForeground}"
                             Text="{TemplateBinding PlaceholderText}"
                             VerticalAlignment="Center">
                    <ins:TemplateText.IsVisible>
                      <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding ElementName="PART_TextPresenter" Path="PreeditText" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Text" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                      </MultiBinding>
                    </ins:TemplateText.IsVisible>
                  </ins:TemplateText>
                  <TextPresenter x:Name="PART_TextPresenter"
                                 Text="{TemplateBinding Text, Mode=TwoWay}"
                                 CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                                 CaretIndex="{TemplateBinding CaretIndex}"
                                 SelectionStart="{TemplateBinding SelectionStart}"
                                 SelectionEnd="{TemplateBinding SelectionEnd}"
                                 TextAlignment="Start"
                                 TextWrapping="NoWrap"
                                 SelectionBrush="{TemplateBinding SelectionBrush}"
                                 SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                 CaretBrush="{TemplateBinding CaretBrush}"
                                 VerticalAlignment="Center" />
                </Panel>
              </ScrollViewer>
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover:not(:focus) /template/ :is(Border)#PART_BorderElement">
          <Setter Property="Background" Value="{DynamicResource InsCtlBgHover}" />
        </Style>
        <Style Selector="^ /template/ ins|Icon#PART_SearchIcon">
          <Setter Property="Foreground" Value="{DynamicResource InsText3}" />
          <Setter Property="RenderTransform" Value="none" />
          <Setter Property="Transitions">
            <Transitions>
              <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="0.34,1.56,0.64,1" />
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="^:focus">
          <Style Selector="^ /template/ ins|Icon#PART_SearchIcon">
            <Setter Property="Foreground" Value="{DynamicResource InsToneBrandSoft}" />
            <Setter Property="RenderTransform" Value="scale(1.12)" />
          </Style>
          <Style Selector="^ /template/ :is(Border)#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource InsGlassStrong}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InsPaletteFocusBorder}" />
          </Style>
          <Style Selector="^ /template/ :is(Border)#PART_Shadow">
            <Setter Property="BoxShadow" Value="{DynamicResource InsGlow}" />
          </Style>
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type ins:CommandPalette}" TargetType="ins:CommandPalette">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource InsText1}" />
        <Setter Property="FontFamily" Value="{DynamicResource InsFontBody}" />
        <Setter Property="Template">
          <ControlTemplate TargetType="ins:CommandPalette">
            <Panel>
              <ins:TemplateBorder x:Name="PART_Backdrop" Background="{DynamicResource InsPaletteBackdrop}" />
              <!-- High on the window rather than centred: the list grows downward as the person types, and a centred box would move its own field under them. -->
              <Panel x:Name="PART_Dialog"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Top"
                     MaxWidth="576"
                     MaxHeight="544"
                     Margin="16,96,16,16"
                     KeyboardNavigation.TabNavigation="Cycle">
                <ins:TemplateBorder CornerRadius="{DynamicResource InsRXl}" BoxShadow="{DynamicResource InsShLg}" />
                <ins:TemplateBorder FlowDirection="LeftToRight" CornerRadius="{DynamicResource InsRXl}" Background="{DynamicResource InsWash1}" />
                <ins:TemplateBorder FlowDirection="LeftToRight"
                        CornerRadius="{DynamicResource InsRXl}"
                        BorderBrush="{DynamicResource InsRim}"
                        BorderThickness="1">
                  <ins:TemplateBorder.Background>
                    <LinearGradientBrush StartPoint="20%,0%" EndPoint="80%,100%">
                      <GradientStop Offset="0" Color="{DynamicResource InsGlassStrongColor}" />
                      <GradientStop Offset="1" Color="{DynamicResource InsGlassHoverColor}" />
                    </LinearGradientBrush>
                  </ins:TemplateBorder.Background>
                </ins:TemplateBorder>
                <ins:TemplateBorder CornerRadius="{DynamicResource InsRXl}" ClipToBounds="True" Margin="1">
                  <DockPanel>
                    <ins:TemplateBorder DockPanel.Dock="Top" Padding="13,13,13,8">
                      <TextBox x:Name="PART_Input"
                               Theme="{StaticResource InsPaletteBox}"
                               PlaceholderText="{TemplateBinding PlaceholderText}" />
                    </ins:TemplateBorder>
                    <Border DockPanel.Dock="Bottom" Classes="palette-foot">
                      <WrapPanel ItemSpacing="20" LineSpacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <Border Classes="kbd"><TextBlock Classes="arrow" Text="↑" /></Border>
                          <Border Classes="kbd"><TextBlock Classes="arrow" Text="↓" /></Border>
                          <ins:TemplateText Text="{TemplateBinding MoveText}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <Border Classes="kbd"><ins:TemplateText Text="Enter" /></Border>
                          <ins:TemplateText Text="{TemplateBinding ChooseText}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <Border Classes="kbd"><ins:TemplateText Text="Esc" /></Border>
                          <ins:TemplateText Text="{TemplateBinding CloseText}" />
                        </StackPanel>
                      </WrapPanel>
                    </Border>
                    <Panel>
                      <TextBlock x:Name="PART_Empty" Classes="palette-empty" Text="{TemplateBinding EmptyText}" IsVisible="False" />
                      <ScrollViewer x:Name="PART_Scroll" HorizontalScrollBarVisibility="Disabled" Padding="8,4,8,8">
                        <ItemsControl x:Name="PART_List">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                        </ItemsControl>
                      </ScrollViewer>
                    </Panel>
                  </DockPanel>
                </ins:TemplateBorder>
              </Panel>
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ Panel#PART_Dialog">
          <Setter Property="ins:PopMotion.FromAbove" Value="False" />
        </Style>
      </ControlTheme>

    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="ins|CommandPalette TextBlock.palette-head">
    <Setter Property="Padding" Value="12,12,12,6" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource InsText3}" />
  </Style>
  <Style Selector="ins|CommandPalette[FlowDirection=LeftToRight] TextBlock.palette-head">
    <Setter Property="LetterSpacing" Value="0.44" />
  </Style>

  <!-- .ins-palette-item: one highlight, moved by the arrows and the pointer alike; the focus stays in the field. -->
  <Style Selector="ins|CommandPalette Border.palette-item">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="CornerRadius" Value="{DynamicResource InsRSm}" />
    <Setter Property="Background" Value="{DynamicResource InsPopItemRest}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource InsText1}" />
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ins|CommandPalette Border.palette-item.active">
    <Setter Property="Background" Value="{DynamicResource InsPopItemHover}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource InsPopItemHoverFg}" />
    <Setter Property="RenderTransform" Value="translateX(3px)" />
  </Style>
  <Style Selector="ins|CommandPalette TextBlock.palette-label">
    <Setter Property="FontSize" Value="{DynamicResource InsFsMd}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="ins|CommandPalette ins|Icon.palette-ico">
    <Setter Property="Foreground" Value="{DynamicResource InsText3}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ins|CommandPalette Border.palette-item.active ins|Icon.palette-ico">
    <Setter Property="Foreground" Value="{DynamicResource InsPopItemHoverFg}" />
  </Style>
  <Style Selector="ins|CommandPalette TextBlock.palette-where">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Margin" Value="8,0,0,0" />
    <Setter Property="FontSize" Value="{DynamicResource InsFsXs}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource InsText3}" />
  </Style>
  <Style Selector="ins|CommandPalette:searching TextBlock.palette-where">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <Style Selector="ins|CommandPalette TextBlock.palette-empty">
    <Setter Property="Padding" Value="16,28,16,32" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{DynamicResource InsFsSm}" />
    <Setter Property="Foreground" Value="{DynamicResource InsLabel}" />
  </Style>

  <Style Selector="ins|CommandPalette Border.palette-foot">
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="BorderBrush" Value="{DynamicResource InsLine}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="ins|CommandPalette Border.palette-foot TextBlock, ins|CommandPalette Border.palette-foot ins|TemplateText">
    <Setter Property="FontSize" Value="{DynamicResource InsFsXs}" />
    <Setter Property="Foreground" Value="{DynamicResource InsText3}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- Inter has no arrows, and the system fallback can be a colour emoji; a symbol face keeps them ink. -->
  <Style Selector="ins|CommandPalette Border.palette-foot TextBlock.arrow">
    <Setter Property="FontFamily" Value="Segoe UI Symbol, Segoe UI, Arial" />
  </Style>
  <Style Selector="ins|CommandPalette Border.palette-foot Border.kbd > TextBlock, ins|CommandPalette Border.palette-foot Border.kbd > ins|TemplateText">
    <Setter Property="Foreground" Value="{DynamicResource InsText1}" />
  </Style>

</Styles>
