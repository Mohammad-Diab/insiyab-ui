<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ins="using:Insiyab.Avalonia.Controls">

  <Styles.Resources>
    <ResourceDictionary>

      <!-- Three bars that fold into a cross while the menu is open -->
      <ControlTheme x:Key="InsNavbarToggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource InsRMd}" />
        <Setter Property="Background" Value="{DynamicResource InsCtlBg}" />
        <Setter Property="Foreground" Value="{DynamicResource InsText1}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel>
              <Border Name="PART_FocusRing" CornerRadius="{TemplateBinding CornerRadius}" BoxShadow="{DynamicResource InsFocusRing}" Opacity="0" />
              <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                <Panel Width="18" Height="14">
                  <Border Name="PART_Top" Height="2" CornerRadius="1" VerticalAlignment="Center" Background="{TemplateBinding Foreground}" RenderTransform="translateY(-6px)" />
                  <Border Name="PART_Mid" Height="2" CornerRadius="1" VerticalAlignment="Center" Background="{TemplateBinding Foreground}" />
                  <Border Name="PART_Bottom" Height="2" CornerRadius="1" VerticalAlignment="Center" Background="{TemplateBinding Foreground}" RenderTransform="translateY(6px)" />
                </Panel>
              </Border>
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ Border#PART_Top, ^ /template/ Border#PART_Bottom">
          <Setter Property="Transitions">
            <Transitions>
              <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="0.22,1,0.36,1" />
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="^ /template/ Border#PART_Mid">
          <Setter Property="Transitions">
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="0.22,1,0.36,1" />
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="^:checked">
          <Style Selector="^ /template/ Border#PART_Top">
            <Setter Property="RenderTransform" Value="rotate(45deg)" />
          </Style>
          <Style Selector="^ /template/ Border#PART_Bottom">
            <Setter Property="RenderTransform" Value="rotate(-45deg)" />
          </Style>
          <Style Selector="^ /template/ Border#PART_Mid">
            <Setter Property="Opacity" Value="0" />
          </Style>
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
          <Setter Property="Opacity" Value="1" />
        </Style>
      </ControlTheme>

      <!-- The public site's bar: a floating glass island inset from the page's edges -->
      <ControlTheme x:Key="{x:Type ins:Navbar}" TargetType="ins:Navbar">
        <Setter Property="Margin" Value="16,12" />
        <Setter Property="MaxWidth" Value="{DynamicResource InsContainer}" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Padding" Value="16,6,6,6" />
        <Setter Property="CornerRadius" Value="{DynamicResource InsRLg}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource InsRim}" />
        <Setter Property="Background" Value="{DynamicResource InsGlass}" />
        <Setter Property="Foreground" Value="{DynamicResource InsText1}" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ItemsPanel">
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="2" />
          </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="PART_Bar"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}"
                    MinHeight="{TemplateBinding MinHeight}"
                    BoxShadow="{DynamicResource InsIslandShadow}">
              <Grid Name="PART_Layout" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" VerticalAlignment="Center">
                <ContentPresenter Name="PART_Brand"
                                  VerticalAlignment="Center"
                                  Content="{TemplateBinding Brand}"
                                  FontSize="{DynamicResource InsFsLg}"
                                  FontWeight="Bold"
                                  Foreground="{DynamicResource InsText1}" />
                <Border Name="PART_Menu" Grid.Column="1" Margin="16,0,0,0" BorderBrush="{DynamicResource InsLine}">
                  <DockPanel Name="PART_MenuDock">
                    <ContentPresenter Name="PART_End"
                                      DockPanel.Dock="Right"
                                      Margin="16,0,0,0"
                                      VerticalAlignment="Center"
                                      Content="{TemplateBinding End}"
                                      IsVisible="{TemplateBinding End, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <ItemsPresenter Name="PART_ItemsPresenter" VerticalAlignment="Center" ItemsPanel="{TemplateBinding ItemsPanel}" />
                  </DockPanel>
                </Border>
                <ToggleButton Name="PART_Toggle"
                              Grid.Column="2"
                              IsVisible="False"
                              Theme="{StaticResource InsNavbarToggle}"
                              IsChecked="{Binding IsOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter>

        <!-- Folded: brand and toggle on the first row, the menu as a column under a hairline while open -->
        <Style Selector="^:collapsed">
          <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
              <StackPanel Orientation="Vertical" Spacing="2" />
            </ItemsPanelTemplate>
          </Setter>
          <Style Selector="^ /template/ ToggleButton#PART_Toggle">
            <Setter Property="IsVisible" Value="True" />
          </Style>
          <Style Selector="^ /template/ Border#PART_Menu">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="3" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Padding" Value="0,6,0,4" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
          </Style>
          <Style Selector="^ /template/ ContentPresenter#PART_End">
            <Setter Property="DockPanel.Dock" Value="Bottom" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
          </Style>
          <Style Selector="^ /template/ ItemsPresenter#PART_ItemsPresenter">
            <Setter Property="VerticalAlignment" Value="Top" />
          </Style>
        </Style>
        <Style Selector="^:collapsed:open /template/ Border#PART_Menu">
          <Setter Property="IsVisible" Value="True" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type ins:NavbarLink}" TargetType="ins:NavbarLink">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="CornerRadius" Value="{DynamicResource InsRSm}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource InsLabel}" />
        <Setter Property="FontSize" Value="{DynamicResource InsFsSm}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Transitions">
          <Transitions>
            <BrushTransition Property="Foreground" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
          </Transitions>
        </Setter>
        <Setter Property="Template">
          <ControlTemplate>
            <Panel>
              <Border Name="PART_FocusRing" CornerRadius="{TemplateBinding CornerRadius}" BoxShadow="{DynamicResource InsFocusRing}" Opacity="0" />
              <Border Name="PART_Face" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                <ContentPresenter Name="PART_ContentPresenter"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Padding="{TemplateBinding Padding}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
              </Border>
              <!-- The same brand bar as every current marker, grown from the centre -->
              <Border Name="PART_Marker"
                      Height="2"
                      Margin="12,0,12,4"
                      VerticalAlignment="Bottom"
                      CornerRadius="{DynamicResource InsRPill}"
                      Background="{DynamicResource InsToneBrandSoft}"
                      RenderTransformOrigin="50%,50%"
                      RenderTransform="scaleX(0)" />
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ Border#PART_Face">
          <Setter Property="Transitions">
            <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="^ /template/ Border#PART_Marker">
          <Setter Property="Transitions">
            <Transitions>
              <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="^:pointerover">
          <Setter Property="Background" Value="{DynamicResource InsCtlBg}" />
          <Setter Property="Foreground" Value="{DynamicResource InsText1}" />
          <Style Selector="^ /template/ Border#PART_Marker">
            <Setter Property="RenderTransform" Value="scaleX(0.35)" />
          </Style>
        </Style>
        <Style Selector="^:selected">
          <Setter Property="Foreground" Value="{DynamicResource InsToneBrand}" />
          <Style Selector="^ /template/ Border#PART_Marker">
            <Setter Property="RenderTransform" Value="scaleX(1)" />
          </Style>
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
          <Setter Property="Opacity" Value="1" />
        </Style>
      </ControlTheme>

    </ResourceDictionary>
  </Styles.Resources>

  <!-- In a column the marker would underline a whole row; the current link takes the tinted face instead -->
  <Style Selector="ins|Navbar:collapsed ins|NavbarLink /template/ Border#PART_Marker">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ins|Navbar:collapsed ins|NavbarLink:selected">
    <Setter Property="Background" Value="{DynamicResource InsToneBrandBg}" />
  </Style>

</Styles>
