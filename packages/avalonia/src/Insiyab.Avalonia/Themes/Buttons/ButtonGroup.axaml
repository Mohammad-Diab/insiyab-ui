<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ins="using:Insiyab.Avalonia.Controls">

  <Styles.Resources>
    <ResourceDictionary>
      <!-- The radius tokens split into the leading and trailing halves, for the outer corners of a group. -->
      <CornerRadius x:Key="InsBtnGroupStart">14,0,0,14</CornerRadius>
      <CornerRadius x:Key="InsBtnGroupEnd">0,14,14,0</CornerRadius>
      <CornerRadius x:Key="InsBtnGroupSmStart">10,0,0,10</CornerRadius>
      <CornerRadius x:Key="InsBtnGroupSmEnd">0,10,10,0</CornerRadius>

      <!-- btn-group: buttons joined into one object; the facing corners are squared and the borders overlap by a pixel. -->
      <ControlTheme x:Key="InsLookBtnGroup" TargetType="StackPanel" ins:ClassTheme.For="btn-group">
        <Style Selector="^.btn-group">
          <Setter Property="Orientation" Value="Horizontal" />
          <Setter Property="Spacing" Value="-1" />
          <Setter Property="HorizontalAlignment" Value="Left" />
          <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="StackPanel.btn-group > :is(Button)">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="StackPanel.btn-group > :is(Button):nth-child(1)">
    <Setter Property="CornerRadius" Value="{StaticResource InsBtnGroupStart}" />
  </Style>
  <Style Selector="StackPanel.btn-group > :is(Button):nth-last-child(1)">
    <Setter Property="CornerRadius" Value="{StaticResource InsBtnGroupEnd}" />
  </Style>
  <Style Selector="StackPanel.btn-group > :is(Button):nth-child(1):nth-last-child(1)">
    <Setter Property="CornerRadius" Value="{DynamicResource InsRMd}" />
  </Style>
  <Style Selector="StackPanel.btn-group.sm > :is(Button):nth-child(1)">
    <Setter Property="CornerRadius" Value="{StaticResource InsBtnGroupSmStart}" />
  </Style>
  <Style Selector="StackPanel.btn-group.sm > :is(Button):nth-last-child(1)">
    <Setter Property="CornerRadius" Value="{StaticResource InsBtnGroupSmEnd}" />
  </Style>
  <Style Selector="StackPanel.btn-group.sm > :is(Button):nth-child(1):nth-last-child(1)">
    <Setter Property="CornerRadius" Value="{DynamicResource InsRSm}" />
  </Style>

</Styles>
