<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ins="using:Insiyab.Avalonia.Controls">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="InsTableHeadInk" Color="{DynamicResource InsPrimaryDarkerColor}" />
          <SolidColorBrush x:Key="InsBulkbarInk" Color="{DynamicResource InsToneBrandColor}" />
          <LinearGradientBrush x:Key="InsTableFrozenShade" StartPoint="0%,50%" EndPoint="100%,50%">
            <GradientStop Offset="0" Color="#1F0F172A" />
            <GradientStop Offset="1" Color="#000F172A" />
          </LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="InsTableHeadInk" Color="{DynamicResource InsText1Color}" />
          <SolidColorBrush x:Key="InsBulkbarInk" Color="{DynamicResource InsText1Color}" />
          <LinearGradientBrush x:Key="InsTableFrozenShade" StartPoint="0%,50%" EndPoint="100%,50%">
            <GradientStop Offset="0" Color="#66000000" />
            <GradientStop Offset="1" Color="#00000000" />
          </LinearGradientBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <SolidColorBrush x:Key="InsTableRule" Color="{DynamicResource InsPrimaryRgbColor}" Opacity="0.24" />
      <SolidColorBrush x:Key="InsTableGrip" Color="{DynamicResource InsPrimaryRgbColor}" Opacity="0.45" />
      <SolidColorBrush x:Key="InsTableSortHover" Color="{DynamicResource InsPrimaryRgbColor}" Opacity="0.10" />
      <SolidColorBrush x:Key="InsTableEditRing" Color="{DynamicResource InsPrimaryRgbColor}" Opacity="0.45" />
      <StreamGeometry x:Key="InsTableSortBoth">M8 9l4-4 4 4M8 15l4 4 4-4</StreamGeometry>
      <StreamGeometry x:Key="InsTableSortUp">M12 19V5M6 11l6-6 6 6</StreamGeometry>
      <StreamGeometry x:Key="InsTableSortDown">M12 5v14M6 13l6 6 6-6</StreamGeometry>
      <StreamGeometry x:Key="InsTablePencil">M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z</StreamGeometry>

      <!-- The table: a header bar floating 8px over a rounded card of rows, in a box that scrolls sideways when it is too narrow -->
      <ControlTheme x:Key="{x:Type ins:Table}" TargetType="ins:Table">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource InsText1}" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Template">
          <ControlTemplate>
            <ScrollViewer x:Name="PART_Scroll"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
              <Panel>
              <DockPanel MinWidth="{TemplateBinding TableMinWidth}">
                <ins:TemplateBorder x:Name="PART_Head" DockPanel.Dock="Top" Margin="0,0,0,8" ZIndex="2" CornerRadius="18">
                  <ins:TemplateBorder x:Name="PART_Bar" CornerRadius="18" BorderThickness="1" MinHeight="38"
                          BorderBrush="{DynamicResource InsTableRule}">
                    <ins:TemplateBorder.Background>
                      <MultiBinding Converter="{x:Static ins:DataBrushes.Vertical}" ConverterParameter="0.20 0.12">
                        <DynamicResource ResourceKey="InsPrimaryRgbColor" />
                      </MultiBinding>
                    </ins:TemplateBorder.Background>
                    <ins:ColumnsPanel x:Name="PART_HeadCells" />
                  </ins:TemplateBorder>
                </ins:TemplateBorder>
                <ins:TemplateBorder x:Name="PART_Card" CornerRadius="{DynamicResource InsRLg}" BorderThickness="1"
                        BorderBrush="{DynamicResource InsRim}" ClipToBounds="True">
                  <Panel>
                    <ins:TableRowsPanel x:Name="PART_Rows" />
                    <!-- The selected row's marker in flight between rows -->
                    <Canvas x:Name="PART_MarkerLayer" IsHitTestVisible="False" />
                    <ContentPresenter x:Name="PART_Empty" IsVisible="False" Padding="24,44"
                                      Background="{DynamicResource InsSurface}"
                                      HorizontalContentAlignment="Center"
                                      Content="{TemplateBinding Empty}" />
                  </Panel>
                </ins:TemplateBorder>
              </DockPanel>
              <!-- The line that follows a column edge while it is dragged -->
              <ins:TemplateBorder x:Name="PART_Guide" Width="2" CornerRadius="1" HorizontalAlignment="Left" ZIndex="3"
                      IsVisible="False" IsHitTestVisible="False" Background="{DynamicResource InsPrimary}" Opacity="0.7" />
              </Panel>
            </ScrollViewer>
          </ControlTemplate>
        </Setter>

        <Style Selector="^:empty">
          <Style Selector="^ /template/ :is(Border)#PART_Head">
            <Setter Property="IsVisible" Value="False" />
          </Style>
          <Style Selector="^ /template/ ContentPresenter#PART_Empty">
            <Setter Property="IsVisible" Value="True" />
          </Style>
        </Style>

        <!-- In a panel the panel is the card: the rows lose their rim -->
        <Style Selector="^:in-panel /template/ :is(Border)#PART_Card">
          <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="^:in-panel /template/ ContentPresenter#PART_Empty">
          <Setter Property="Background" Value="{DynamicResource InsRowInner}" />
        </Style>
        <!-- In a flush panel body the corners are the panel's less the 10px inset and its rim -->
        <Style Selector="^:flush /template/ :is(Border)#PART_Card">
          <Setter Property="CornerRadius" Value="11" />
        </Style>
        <Style Selector="^:flush /template/ :is(Border)#PART_Head, ^:flush /template/ :is(Border)#PART_Bar">
          <Setter Property="CornerRadius" Value="11" />
        </Style>

        <!-- A box of its own: the long table scrolls inside a height, the header bar frosted over the rows passing under it -->
        <Style Selector="^.sticky">
          <Setter Property="MaxHeight" Value="{DynamicResource InsTableMax}" />
          <Style Selector="^ /template/ ScrollViewer#PART_Scroll">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
          </Style>
        </Style>
        <Style Selector="^.sticky /template/ :is(Border)#PART_Head, ^.pin /template/ :is(Border)#PART_Head">
          <Setter Property="Background" Value="{DynamicResource InsGlassStrong}" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type ins:TableHeader}" TargetType="ins:TableHeader">
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="{DynamicResource InsTableHeadInk}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel>
              <ins:TemplateBorder x:Name="PART_Shade" Width="10" Margin="0,0,-10,0" HorizontalAlignment="Right" IsHitTestVisible="False"
                      Background="{DynamicResource InsTableFrozenShade}" IsVisible="False" />
              <Panel x:Name="PART_Clip" ClipToBounds="True">
                <ins:TemplateBorder x:Name="PART_Fill" CornerRadius="17,0,0,17" Background="{TemplateBinding Background}" />
                <ins:TemplateBorder x:Name="PART_Back" CornerRadius="17,0,0,17" />
                <ContentPresenter x:Name="PART_ContentPresenter"
                                  Padding="{TemplateBinding Padding}" TextBlock.TextTrimming="CharacterEllipsis"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                <ins:TemplateBorder x:Name="PART_Grip" Width="10" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWestEast" IsVisible="False">
                  <ins:TemplateBorder x:Name="PART_GripLine" Width="1" Height="18" CornerRadius="1.5" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Background="{DynamicResource InsTableGrip}">
                    <ins:TemplateBorder.Transitions>
                      <Transitions>
                        <DoubleTransition Property="Width" Duration="0:0:0.15" Easing="0.22,1,0.36,1" />
                        <DoubleTransition Property="Height" Duration="0:0:0.15" Easing="0.22,1,0.36,1" />
                        <ins:BrushFade Property="Background" Duration="0:0:0.15" Easing="0.22,1,0.36,1" />
                      </Transitions>
                    </ins:TemplateBorder.Transitions>
                  </ins:TemplateBorder>
                </ins:TemplateBorder>
              </Panel>
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:check">
          <Setter Property="Padding" Value="16,7,4,7" />
        </Style>
        <Style Selector="^.num">
          <Setter Property="FlowDirection" Value="LeftToRight" />
          <Setter Property="HorizontalContentAlignment" Value="Right" />
          <Setter Property="FontFamily" Value="{DynamicResource InsFontBodyEn}" />
          <Setter Property="FontWeight" Value="SemiBold" />
          <Setter Property="TextElement.FontFeatures" Value="+tnum" />
        </Style>
        <Style Selector="^:resizable /template/ :is(Border)#PART_Grip">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <!-- Every resizable edge shows a divider at rest; under the pointer or while dragged it becomes a brand bar -->
        <Style Selector="^ /template/ :is(Border)#PART_Grip:pointerover > :is(Border)#PART_GripLine, ^:resizing /template/ :is(Border)#PART_GripLine">
          <Setter Property="Width" Value="3" />
          <Setter Property="Height" Value="24" />
          <Setter Property="Background" Value="{DynamicResource InsPrimary}" />
        </Style>
        <Style Selector="^:grip-flip /template/ :is(Border)#PART_Grip">
          <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="^:grip-flip /template/ :is(Border)#PART_GripLine">
          <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <!-- The last frozen heading casts its shade over the headings scrolling under it -->
        <Style Selector="^:pin-edge">
          <Setter Property="ClipToBounds" Value="False" />
          <Style Selector="^ /template/ :is(Border)#PART_Shade">
            <Setter Property="IsVisible" Value="True" />
          </Style>
        </Style>
        <Style Selector="^:pin-edge:pin-flip /template/ :is(Border)#PART_Shade">
          <Setter Property="HorizontalAlignment" Value="Left" />
          <Setter Property="Margin" Value="-10,0,0,0" />
          <Setter Property="RenderTransform" Value="scaleX(-1)" />
        </Style>
        <!-- The pinned heading keeps the bar's tint over an opaque fill, so the headings sliding under it do not show -->
        <Style Selector="^:pinned /template/ :is(Border)#PART_Back">
          <Setter Property="Background">
            <MultiBinding Converter="{x:Static ins:DataBrushes.Vertical}" ConverterParameter="0.20 0.12">
              <DynamicResource ResourceKey="InsPrimaryRgbColor" />
            </MultiBinding>
          </Setter>
        </Style>
        <Style Selector="^:pinned">
          <Setter Property="Background" Value="{DynamicResource InsGlassStrong}" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type ins:TableSortButton}" TargetType="ins:TableSortButton">

        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Margin" Value="-6,-4" />
        <Setter Property="CornerRadius" Value="{DynamicResource InsRXs}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
          <ControlTemplate>
            <ins:TemplateBorder x:Name="PART_Back" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" VerticalAlignment="Center" />
                <ins:Icon x:Name="PART_Arrow" Size="14" StrokeThickness="2.5" Opacity="0.4" VerticalAlignment="Center"
                          Data="{StaticResource InsTableSortBoth}" />
              </StackPanel>
            </ins:TemplateBorder>
          </ControlTemplate>
        </Setter>
        <Setter Property="Transitions">
          <Transitions>
            <ins:BrushFade Property="Background" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
          </Transitions>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Background" Value="{DynamicResource InsTableSortHover}" />
        </Style>
        <Style Selector="^:focus-visible /template/ :is(Border)#PART_Back">
          <Setter Property="BoxShadow" Value="{DynamicResource InsFocusRing}" />
        </Style>
        <Style Selector="^:ascending /template/ ins|Icon#PART_Arrow">
          <Setter Property="Data" Value="{StaticResource InsTableSortUp}" />
          <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:descending /template/ ins|Icon#PART_Arrow">
          <Setter Property="Data" Value="{StaticResource InsTableSortDown}" />
          <Setter Property="Opacity" Value="1" />
        </Style>
      </ControlTheme>

      <!-- A row: its fill, an overlay for the stripe or the brand tint, its hairline, and the selected marker on its leading edge -->
      <ControlTheme x:Key="{x:Type ins:TableRow}" TargetType="ins:TableRow">
        <Setter Property="Background" Value="{DynamicResource InsSurface}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel>
              <ins:TemplateBorder x:Name="PART_Fill" Background="{TemplateBinding Background}" />
              <ins:TemplateBorder x:Name="PART_Tint" />
              <DockPanel>
                <ins:TemplateBorder x:Name="PART_Line" DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource InsLineGlass}" />
                <ins:ColumnsPanel x:Name="PART_Cells" />
              </DockPanel>
              <ins:TemplateBorder x:Name="PART_Ring" BorderThickness="2" BorderBrush="{DynamicResource InsTableEditRing}" Opacity="0" IsHitTestVisible="False" />
              <ins:TemplateBorder x:Name="PART_Marker" Width="3" HorizontalAlignment="Left" Margin="0,8"
                      CornerRadius="{DynamicResource InsRPill}" Background="{DynamicResource InsPrimaryMid}"
                      RenderTransform="scaleY(0)" />
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ :is(Border)#PART_Fill">
          <Setter Property="Transitions">
            <Transitions>
              <ins:BrushFade Property="Background" Duration="0:0:0.18" Easing="0.22,1,0.36,1" />
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="^ /template/ :is(Border)#PART_Marker">
          <Setter Property="Transitions">
            <Transitions>
              <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="^:in-panel">
          <Setter Property="Background" Value="{DynamicResource InsRowInner}" />
        </Style>
        <Style Selector="^:stripe /template/ :is(Border)#PART_Tint">
          <Setter Property="Background" Value="{DynamicResource InsZebra}" />
        </Style>
        <Style Selector="^:last /template/ :is(Border)#PART_Line">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <!-- The keyboard ring follows the card's rounded corners on the first and last rows: the card's 22px less its 1px rim -->
        <Style Selector="^:first /template/ :is(Border)#PART_Ring">
          <Setter Property="CornerRadius" Value="21,21,0,0" />
        </Style>
        <Style Selector="^:last /template/ :is(Border)#PART_Ring">
          <Setter Property="CornerRadius" Value="0,0,21,21" />
        </Style>
        <Style Selector="^:first:last /template/ :is(Border)#PART_Ring">
          <Setter Property="CornerRadius" Value="21" />
        </Style>
        <Style Selector="^:in-panel:first /template/ :is(Border)#PART_Ring">
          <Setter Property="CornerRadius" Value="22,22,0,0" />
        </Style>
        <Style Selector="^:in-panel:last /template/ :is(Border)#PART_Ring">
          <Setter Property="CornerRadius" Value="0,0,22,22" />
        </Style>
        <Style Selector="^:in-panel:first:last /template/ :is(Border)#PART_Ring">
          <Setter Property="CornerRadius" Value="22" />
        </Style>
        <Style Selector="^:in-panel:last /template/ :is(Border)#PART_Line">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <!-- Hover is a state and outranks the stripe -->
        <Style Selector="^:pointerover">
          <Style Selector="^ /template/ :is(Border)#PART_Fill">
            <Setter Property="Background" Value="{DynamicResource InsSurfaceHover}" />
          </Style>
          <Style Selector="^ /template/ :is(Border)#PART_Tint">
            <Setter Property="Background" Value="Transparent" />
          </Style>
        </Style>
        <Style Selector="^:selected">
          <Style Selector="^ /template/ :is(Border)#PART_Fill">
            <Setter Property="Background" Value="{DynamicResource InsSurface}" />
          </Style>
          <Style Selector="^ /template/ :is(Border)#PART_Tint">
            <Setter Property="Background" Value="{DynamicResource InsToneBrandBg}" />
          </Style>
          <Style Selector="^ /template/ :is(Border)#PART_Marker">
            <Setter Property="RenderTransform" Value="scaleY(1)" />
          </Style>
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type ins:TableCell}" TargetType="ins:TableCell">
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="MinHeight" Value="43" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel>
              <ins:TemplateBorder x:Name="PART_Shade" Width="10" Margin="0,0,-10,0" HorizontalAlignment="Right" IsHitTestVisible="False"
                      Background="{DynamicResource InsTableFrozenShade}" IsVisible="False" />
              <Panel x:Name="PART_Clip" ClipToBounds="True">
                <ins:TemplateBorder x:Name="PART_Back" Background="{TemplateBinding Background}" />
                <ins:TemplateBorder x:Name="PART_Focus" BorderThickness="2" BorderBrush="{DynamicResource InsTableEditRing}" Opacity="0" />
                <DockPanel x:Name="PART_Show" LastChildFill="True"
                           Margin="{TemplateBinding Padding}"
                           HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                  <ins:Icon x:Name="PART_Pencil" DockPanel.Dock="Right" Size="14" Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="False" Opacity="0"
                            Foreground="{DynamicResource InsText3}" Data="{StaticResource InsTablePencil}" />
                  <ContentPresenter x:Name="PART_ContentPresenter" VerticalAlignment="Center" TextBlock.TextTrimming="CharacterEllipsis"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                </DockPanel>
                <Panel x:Name="PART_EditorHost" Margin="5,0" />
              </Panel>
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:check">
          <Setter Property="Padding" Value="16,6,4,6" />
        </Style>
        <Style Selector="^.num">
          <Setter Property="FlowDirection" Value="LeftToRight" />
          <Setter Property="HorizontalContentAlignment" Value="Right" />
          <Setter Property="FontFamily" Value="{DynamicResource InsFontBodyEn}" />
          <Setter Property="FontWeight" Value="SemiBold" />
          <Setter Property="TextElement.FontFeatures" Value="+tnum" />
        </Style>
        <Style Selector="^:editable">
          <Setter Property="Cursor" Value="IBeam" />
          <Style Selector="^ /template/ ins|Icon#PART_Pencil">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="Transitions">
              <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
              </Transitions>
            </Setter>
          </Style>
        </Style>
        <Style Selector="^:editable:pointerover /template/ ins|Icon#PART_Pencil">
          <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:editing /template/ DockPanel#PART_Show">
          <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^:editing /template/ :is(Border)#PART_Focus">
          <Setter Property="Opacity" Value="0" />
        </Style>
        <!-- The pinned column is opaque enough that the cells sliding under it do not show through -->
        <Style Selector="^:pinned /template/ :is(Border)#PART_Back">
          <Setter Property="Background" Value="{DynamicResource InsGlassStrong}" />
        </Style>
        <!-- The last frozen cell casts its shade over the cells scrolling under it -->
        <Style Selector="^:pin-edge">
          <Setter Property="ClipToBounds" Value="False" />
          <Style Selector="^ /template/ :is(Border)#PART_Shade">
            <Setter Property="IsVisible" Value="True" />
          </Style>
        </Style>
        <Style Selector="^:pin-edge:pin-flip /template/ :is(Border)#PART_Shade">
          <Setter Property="HorizontalAlignment" Value="Left" />
          <Setter Property="Margin" Value="-10,0,0,0" />
          <Setter Property="RenderTransform" Value="scaleX(-1)" />
        </Style>
      </ControlTheme>

      <!-- The bar a selection brings up: the count at the start, the actions at the end -->
      <ControlTheme x:Key="{x:Type ins:BulkBar}" TargetType="ins:BulkBar">
        <Setter Property="Margin" Value="0,12,0,0" />
        <Setter Property="Padding" Value="18,8,8,8" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="CornerRadius" Value="{DynamicResource InsRLg}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource InsRim}" />
        <Setter Property="Background" Value="{DynamicResource InsGlassStrong}" />
        <Setter Property="Template">
          <ControlTemplate>
            <ins:TemplateBorder x:Name="PART_Back" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
              <ins:TemplateBorder.BoxShadow>
                <MultiBinding Converter="{x:Static ins:PanelShadows.Join}">
                  <DynamicResource ResourceKey="InsShLg" />
                  <DynamicResource ResourceKey="InsBevel" />
                </MultiBinding>
              </ins:TemplateBorder.BoxShadow>
              <DockPanel>
                <ins:TemplateText x:Name="PART_Count" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0"
                           FontSize="{DynamicResource InsFsMd}" FontWeight="Bold" Foreground="{DynamicResource InsBulkbarInk}"
                           Text="{TemplateBinding CountText}" />
                <ContentPresenter x:Name="PART_ContentPresenter" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
              </DockPanel>
            </ins:TemplateBorder>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="ins|BulkBar > StackPanel">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="8" />
  </Style>

  <!-- The selected row's marker on its way to the newly selected row; meanwhile the rows' own markers hide -->
  <Style Selector="Border.table-marker-flight">
    <Setter Property="Width" Value="3" />
    <Setter Property="CornerRadius" Value="{DynamicResource InsRPill}" />
    <Setter Property="Background" Value="{DynamicResource InsPrimaryMid}" />
  </Style>
  <Style Selector="ins|Table.moving ins|TableRow /template/ :is(Border)#PART_Marker">
    <Setter Property="Opacity" Value="0" />
  </Style>

  <!-- The keyboard's place: the ring on the current row once the keyboard moves it (a click shows the tint and the marker only), or on the current cell when cells can be edited -->
  <Style Selector="ins|Table:focus:keyboard:not(:cell-cursor) ins|TableRow:current /template/ :is(Border)#PART_Ring">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="ins|Table:flush ins|TableRow:first /template/ :is(Border)#PART_Ring">
    <Setter Property="CornerRadius" Value="11,11,0,0" />
  </Style>
  <Style Selector="ins|Table:flush ins|TableRow:last /template/ :is(Border)#PART_Ring">
    <Setter Property="CornerRadius" Value="0,0,11,11" />
  </Style>
  <Style Selector="ins|Table:flush ins|TableRow:first:last /template/ :is(Border)#PART_Ring">
    <Setter Property="CornerRadius" Value="11" />
  </Style>
  <Style Selector="ins|Table:focus ins|TableCell:current /template/ :is(Border)#PART_Focus">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="ins|Table:focus ins|TableCell:current:editable /template/ ins|Icon#PART_Pencil">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- The field a cell becomes, inset from the cell's edges and as tall as a control -->
  <Style Selector="ins|TableCell TextBox.table-editor, ins|TableCell ComboBox.table-editor">
    <Setter Property="Height" Value="32" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <!-- The selection column's boxes and the empty state inside a table -->
  <Style Selector="ins|Table CheckBox.table-check">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ins|Table TextBlock.empty-title">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource InsText1}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="ins|Table TextBlock.empty-hint">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource InsText2}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

</Styles>
