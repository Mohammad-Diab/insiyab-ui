<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ins="using:Insiyab.Avalonia.Controls">

  <Styles.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="InsStatBrandBg" Color="{DynamicResource InsPrimaryRgbColor}" Opacity="0.12" />
      <StreamGeometry x:Key="InsDeltaUp">M12 19V5M5 12l7-7 7 7</StreamGeometry>
      <StreamGeometry x:Key="InsDeltaDown">M12 5v14M19 12l-7 7-7-7</StreamGeometry>
      <StreamGeometry x:Key="InsDeltaFlat">M5 12h14</StreamGeometry>

      <!-- The button around a tile that goes somewhere: no chrome of its own, a focus ring on the tile -->
      <ControlTheme x:Key="InsStatButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="CornerRadius" Value="{DynamicResource InsRMd}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel>
              <ins:TemplateBorder x:Name="PART_Focus" CornerRadius="{TemplateBinding CornerRadius}" />
              <ContentPresenter x:Name="PART_ContentPresenter" Padding="{TemplateBinding Padding}"
                                Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:focus-visible /template/ :is(Border)#PART_Focus">
          <Setter Property="BoxShadow" Value="{DynamicResource InsFocusRing}" />
        </Style>
        <Style Selector="^:pointerover">
          <Setter Property="ins:StatLook.Hot" Value="True" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type ins:Delta}" TargetType="ins:Delta">
        <Setter Property="FlowDirection" Value="LeftToRight" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="6,1,8,1" />
        <Setter Property="CornerRadius" Value="{DynamicResource InsRPill}" />
        <Setter Property="Background" Value="{DynamicResource InsToneOkBg}" />
        <Setter Property="Foreground" Value="{DynamicResource InsToneOk}" />
        <Setter Property="FontFamily" Value="{DynamicResource InsFontBodyEn}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextElement.FontFeatures" Value="+tnum" />
        <Setter Property="Template">
          <ControlTemplate>
            <ins:TemplateBorder Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
              <StackPanel Orientation="Horizontal" Spacing="3">
                <ins:Icon x:Name="PART_Arrow" Size="12" StrokeThickness="3" VerticalAlignment="Center" Data="{StaticResource InsDeltaUp}" />
                <ContentPresenter x:Name="PART_ContentPresenter" VerticalAlignment="Center"
                                  Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
              </StackPanel>
            </ins:TemplateBorder>
          </ControlTemplate>
        </Setter>
        <Style Selector="^.down">
          <Setter Property="Background" Value="{DynamicResource InsToneBadBg}" />
          <Setter Property="Foreground" Value="{DynamicResource InsToneBad}" />
          <Style Selector="^ /template/ ins|Icon#PART_Arrow">
            <Setter Property="Data" Value="{StaticResource InsDeltaDown}" />
          </Style>
        </Style>
        <Style Selector="^.up.invert">
          <Setter Property="Background" Value="{DynamicResource InsToneBadBg}" />
          <Setter Property="Foreground" Value="{DynamicResource InsToneBad}" />
        </Style>
        <Style Selector="^.down.invert">
          <Setter Property="Background" Value="{DynamicResource InsToneOkBg}" />
          <Setter Property="Foreground" Value="{DynamicResource InsToneOk}" />
        </Style>
        <Style Selector="^.flat">
          <Setter Property="Background" Value="{DynamicResource InsToneMuteBg}" />
          <Setter Property="Foreground" Value="{DynamicResource InsToneMute}" />
          <Style Selector="^ /template/ ins|Icon#PART_Arrow">
            <Setter Property="Data" Value="{StaticResource InsDeltaFlat}" />
          </Style>
        </Style>
      </ControlTheme>

      <!-- The tile's DockPanel, given by the tile: icon and body apart by the tile's size -->
      <ControlTheme x:Key="InsStatDock" TargetType="DockPanel">
        <Style Selector="^[(ins|ClassTheme.Relayed)=True]">
          <Setter Property="HorizontalSpacing" Value="12" />
          <Style Selector="^[(ins|StatLook.Size)=sm]">
            <Setter Property="HorizontalSpacing" Value="10" />
          </Style>
          <Style Selector="^[(ins|StatLook.Size)=lg]">
            <Setter Property="HorizontalSpacing" Value="14" />
          </Style>
        </Style>
      </ControlTheme>

      <!-- The stat tile: each part takes its look by class, and the tile hands its tone, size and hover down to the parts -->
      <ControlTheme x:Key="InsLookStat" TargetType="Border" ins:ClassTheme.For="stat">
        <Style Selector="^.stat">
          <Setter Property="Padding" Value="16,12" />
          <Setter Property="CornerRadius" Value="{DynamicResource InsRMd}" />
          <Setter Property="ins:ClassTheme.ChildTheme" Value="{StaticResource InsStatDock}" />
          <Style Selector="^.ok">
            <Setter Property="ins:StatLook.Tone" Value="ok" />
          </Style>
          <Style Selector="^.warn">
            <Setter Property="ins:StatLook.Tone" Value="warn" />
          </Style>
          <Style Selector="^.bad">
            <Setter Property="ins:StatLook.Tone" Value="bad" />
          </Style>
          <Style Selector="^.info">
            <Setter Property="ins:StatLook.Tone" Value="info" />
          </Style>
          <Style Selector="^.mute">
            <Setter Property="ins:StatLook.Tone" Value="mute" />
          </Style>
          <Style Selector="^.zero">
            <Setter Property="ins:StatLook.Tone" Value="zero" />
          </Style>
          <Style Selector="^.sm">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="ins:StatLook.Size" Value="sm" />
          </Style>
          <Style Selector="^.lg">
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="ins:StatLook.Size" Value="lg" />
          </Style>
          <!-- Only a tile that goes somewhere moves: its chip pops and the figure opens up a fraction -->
          <Style Selector="^.hoverable:pointerover">
            <Setter Property="ins:StatLook.Hot" Value="True" />
          </Style>
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="InsLookStatIco" TargetType="Border" ins:ClassTheme.For="stat-ico">
        <Style Selector="^.stat-ico">
          <Setter Property="DockPanel.Dock" Value="Left" />
          <Setter Property="Width" Value="38" />
          <Setter Property="Height" Value="38" />
          <Setter Property="VerticalAlignment" Value="Center" />
          <Setter Property="CornerRadius" Value="{DynamicResource InsRMd}" />
          <Setter Property="Background" Value="{DynamicResource InsStatBrandBg}" />
          <Setter Property="TextElement.Foreground" Value="{DynamicResource InsToneBrandSoft}" />
          <Setter Property="TextElement.FontSize" Value="16" />
          <Setter Property="ins:ClassTheme.ChildHorizontalAlignment" Value="Center" />
          <Setter Property="ins:ClassTheme.ChildVerticalAlignment" Value="Center" />
          <Setter Property="Transitions">
            <Transitions>
              <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="0.34,1.56,0.64,1" />
              <BrushTransition Property="Background" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
            </Transitions>
          </Setter>
          <Style Selector="^[(ins|StatLook.Tone)=ok]">
            <Setter Property="Background" Value="{DynamicResource InsToneOkBg}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource InsToneOk}" />
          </Style>
          <Style Selector="^[(ins|StatLook.Tone)=warn]">
            <Setter Property="Background" Value="{DynamicResource InsToneWarnBg}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource InsToneWarn}" />
          </Style>
          <Style Selector="^[(ins|StatLook.Tone)=bad]">
            <Setter Property="Background" Value="{DynamicResource InsToneBadBg}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource InsToneBad}" />
          </Style>
          <Style Selector="^[(ins|StatLook.Tone)=info]">
            <Setter Property="Background" Value="{DynamicResource InsToneInfoBg}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource InsToneInfo}" />
          </Style>
          <Style Selector="^[(ins|StatLook.Tone)=mute]">
            <Setter Property="Background" Value="{DynamicResource InsToneMuteBg}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource InsToneMute}" />
          </Style>
          <Style Selector="^[(ins|StatLook.Tone)=zero]">
            <Setter Property="Background" Value="{DynamicResource InsToneMuteBg}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource InsToneMute}" />
          </Style>
          <Style Selector="^[(ins|StatLook.Size)=sm]">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="TextElement.FontSize" Value="14" />
            <Setter Property="CornerRadius" Value="{DynamicResource InsRSm}" />
          </Style>
          <Style Selector="^[(ins|StatLook.Size)=lg]">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="TextElement.FontSize" Value="18" />
          </Style>
          <!-- Two attached-property tests in one selector do not parse, so stillness is a style inside the hover one -->
          <Style Selector="^[(ins|StatLook.Hot)=True]">
            <Setter Property="RenderTransform" Value="scale(1.12) rotate(-6deg)" />
            <Style Selector="^[(ins|ClassTheme.Still)=True]">
              <Setter Property="RenderTransform" Value="none" />
            </Style>
          </Style>
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="InsLookStatBody" TargetType="StackPanel" ins:ClassTheme.For="stat-body">
        <Style Selector="^.stat-body">
          <Setter Property="Spacing" Value="1" />
          <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="InsLookStatLabel" TargetType="TextBlock" ins:ClassTheme.For="stat-label">
        <Style Selector="^.stat-label">
          <Setter Property="FontSize" Value="12" />
          <Setter Property="FontWeight" Value="SemiBold" />
          <Setter Property="LineHeight" Value="15.6" />
          <Setter Property="TextWrapping" Value="Wrap" />
          <Setter Property="Foreground" Value="{DynamicResource InsText2}" />
          <Style Selector="^[(ins|StatLook.Size)=sm]">
            <Setter Property="FontSize" Value="11" />
          </Style>
          <Style Selector="^[(ins|StatLook.Size)=lg]">
            <Setter Property="FontSize" Value="13" />
          </Style>
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="InsLookStatValue" TargetType="TextBlock" ins:ClassTheme.For="stat-value">
        <Style Selector="^.stat-value">
          <Setter Property="FontSize" Value="24" />
          <Setter Property="FontWeight" Value="ExtraBold" />
          <Setter Property="LineHeight" Value="24" />
          <Setter Property="FontFamily" Value="{DynamicResource InsFontBodyEn}" />
          <Setter Property="FontFeatures" Value="+tnum" />
          <Setter Property="Foreground" Value="{DynamicResource InsToneBrandSoft}" />
          <Setter Property="Transitions">
            <Transitions>
              <DoubleTransition Property="LetterSpacing" Duration="0:0:0.25" Easing="0.22,1,0.36,1" />
            </Transitions>
          </Setter>
          <Style Selector="^[(ins|StatLook.Tone)=ok]">
            <Setter Property="Foreground" Value="{DynamicResource InsToneOk}" />
          </Style>
          <Style Selector="^[(ins|StatLook.Tone)=warn]">
            <Setter Property="Foreground" Value="{DynamicResource InsToneWarn}" />
          </Style>
          <Style Selector="^[(ins|StatLook.Tone)=bad]">
            <Setter Property="Foreground" Value="{DynamicResource InsToneBad}" />
          </Style>
          <Style Selector="^[(ins|StatLook.Tone)=info]">
            <Setter Property="Foreground" Value="{DynamicResource InsToneInfo}" />
          </Style>
          <Style Selector="^[(ins|StatLook.Tone)=mute]">
            <Setter Property="Foreground" Value="{DynamicResource InsToneMute}" />
          </Style>
          <!-- Quiet, still legible: a zero is information -->
          <Style Selector="^[(ins|StatLook.Tone)=zero]">
            <Setter Property="Foreground" Value="{DynamicResource InsText2}" />
          </Style>
          <Style Selector="^[(ins|StatLook.Size)=sm]">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="LineHeight" Value="20" />
          </Style>
          <Style Selector="^[(ins|StatLook.Size)=lg]">
            <Setter Property="FontSize" Value="32" />
            <Setter Property="LineHeight" Value="32" />
          </Style>
          <Style Selector="^[(ins|StatLook.Hot)=True]">
            <Setter Property="LetterSpacing" Value="0.12" />
          </Style>
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="InsLookStatHint" TargetType="TextBlock" ins:ClassTheme.For="stat-hint">
        <Style Selector="^.stat-hint">
          <Setter Property="FontSize" Value="11" />
          <Setter Property="Foreground" Value="{DynamicResource InsText3}" />
          <Style Selector="^[FlowDirection=RightToLeft]">
            <Setter Property="LineHeight" Value="18.7" />
          </Style>
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="InsLookStatTrend" TargetType="StackPanel" ins:ClassTheme.For="stat-trend">
        <Style Selector="^.stat-trend">
          <Setter Property="Orientation" Value="Horizontal" />
          <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
      </ControlTheme>

      <!-- What the change is measured against, after the delta -->
      <ControlTheme x:Key="InsLookDeltaRef" TargetType="TextBlock" ins:ClassTheme.For="delta-ref">
        <Style Selector="^.delta-ref">
          <Setter Property="Margin" Value="6,0,0,0" />
          <Setter Property="FontSize" Value="11" />
          <Setter Property="VerticalAlignment" Value="Center" />
          <Setter Property="Foreground" Value="{DynamicResource InsText3}" />
        </Style>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Button.stat-link">
    <Setter Property="Theme" Value="{StaticResource InsStatButton}" />
  </Style>

</Styles>
