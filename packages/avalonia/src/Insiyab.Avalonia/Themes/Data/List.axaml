<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ins="using:Insiyab.Avalonia.Controls">

  <Styles.Resources>
    <ResourceDictionary>

      <!-- The web's .ins-list: rows with dividers between them and no surface of its own; it goes in a panel or a card -->
      <ControlTheme x:Key="{x:Type ListBox}" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource InsText1}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.IsScrollChainingEnabled" Value="True" />
        <Setter Property="Template">
          <ControlTemplate>
            <ins:TemplateBorder x:Name="border"
                    ClipToBounds="{TemplateBinding ClipToBounds}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
              <Panel>
                <ScrollViewer x:Name="PART_ScrollViewer"
                              HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                              VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                              IsScrollChainingEnabled="{TemplateBinding (ScrollViewer.IsScrollChainingEnabled)}"
                              AllowAutoHide="{TemplateBinding (ScrollViewer.AllowAutoHide)}">
                  <Panel>
                    <ItemsPresenter x:Name="PART_ItemsPresenter"
                                    ItemsPanel="{TemplateBinding ItemsPanel}"
                                    Margin="{TemplateBinding Padding}" />
                    <Canvas x:Name="PART_Flight" IsHitTestVisible="False" />
                  </Panel>
                </ScrollViewer>
                <ins:TemplateBorder x:Name="PART_Pin" VerticalAlignment="Top" IsVisible="False" IsHitTestVisible="False"
                        Background="{DynamicResource InsGlassStrongGround}" BoxShadow="{DynamicResource InsShSm}">
                  <ins:TemplateText x:Name="PART_PinText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                             FontSize="{DynamicResource InsFsXs}" FontWeight="Bold" Foreground="{DynamicResource InsToneBrand}" />
                </ins:TemplateBorder>
              </Panel>
            </ins:TemplateBorder>
          </ControlTemplate>
        </Setter>
        <!-- master: a list beside a detail pane; ruled: dividers that stay; compact: short rows; sticky-headings: the group's heading pins at the top -->
        <Style Selector="^.master">
          <Setter Property="ins:ListLook.Master" Value="True" />
          <Setter Property="ins:ListFlight.IsOn" Value="True" />
        </Style>
        <Style Selector="^.ruled">
          <Setter Property="ins:ListLook.Ruled" Value="True" />
          <Setter Property="ins:ListLook.Styled" Value="True" />
        </Style>
        <Style Selector="^.compact">
          <Setter Property="ins:ListLook.Compact" Value="True" />
          <Setter Property="ins:ListLook.Styled" Value="True" />
        </Style>
        <Style Selector="^.sticky-headings">
          <Setter Property="ins:ListPin.IsOn" Value="True" />
        </Style>
        <Style Selector="^[FlowDirection=LeftToRight] /template/ :is(TextBlock)#PART_PinText">
          <Setter Property="LetterSpacing" Value="0.96" />
        </Style>
      </ControlTheme>

      <!-- A row: a divider above it, the content, and the chevron of a destination toward the end of the line -->
      <ControlTheme x:Key="{x:Type ListBoxItem}" TargetType="ListBoxItem">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="ins:ListRows.Track" Value="True" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource InsText1}" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="CornerRadius" Value="{DynamicResource InsRMd}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel Background="Transparent">
              <ins:RowBack x:Name="PART_Back"
                      Background="{TemplateBinding Background}"
                      CornerRadius="{TemplateBinding CornerRadius}"
                      Padding="{TemplateBinding Padding}">
                <DockPanel HorizontalSpacing="12">
                  <ins:TemplateBorder x:Name="PART_Chevron" DockPanel.Dock="Right" Width="9" Height="9" VerticalAlignment="Center"
                          BorderThickness="0,2,2,0" BorderBrush="{DynamicResource InsText3}"
                          RenderTransform="rotate(45deg)" />
                  <ContentPresenter x:Name="PART_ContentPresenter"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </DockPanel>
              </ins:RowBack>
              <ins:TemplateBorder x:Name="PART_Divider" Height="1" VerticalAlignment="Top" Background="{DynamicResource InsLine}" />
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ ins|RowBack#PART_Back">
          <Setter Property="Transitions">
            <Transitions>
              <ins:BrushFade Property="Background" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="^ /template/ :is(Border)#PART_Chevron">
          <Setter Property="Transitions">
            <Transitions>
              <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="^:first /template/ :is(Border)#PART_Divider">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:pointerover, ^:selected">
          <Setter Property="Background" Value="{DynamicResource InsCtlBg}" />
          <Style Selector="^ /template/ :is(Border)#PART_Divider">
            <Setter Property="Opacity" Value="0" />
          </Style>
        </Style>
        <Style Selector="^.after-hot /template/ :is(Border)#PART_Divider">
          <Setter Property="Opacity" Value="0" />
        </Style>
        <!-- The chevron nudges toward where it points -->
        <Style Selector="^:pointerover /template/ :is(Border)#PART_Chevron">
          <Setter Property="RenderTransform" Value="translateX(2px) rotate(45deg)" />
        </Style>
        <!-- The ring is drawn inside the row, so a scrolling list never cuts it -->
        <Style Selector="^:focus-visible /template/ ins|RowBack#PART_Back">
          <Setter Property="Ring" Value="{DynamicResource InsToneBrandSoft}" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.55" />
        </Style>
        <!-- A master list: no chevron; the selection is a brand tint and a start mark, unlike the hover, and greys in an inactive window -->
        <Style Selector="^[(ins|ListLook.Master)=True]">
          <Style Selector="^ /template/ :is(Border)#PART_Chevron">
            <Setter Property="IsVisible" Value="False" />
          </Style>
          <Style Selector="^:selected">
            <Setter Property="Background" Value="{DynamicResource InsBrandTintBg}" />
            <Style Selector="^ /template/ ins|RowBack#PART_Back">
              <Setter Property="Mark" Value="{DynamicResource InsPrimaryMid}" />
            </Style>
            <Style Selector="^[(ins|WindowActivity.IsInactive)=True]">
              <Setter Property="Background" Value="{DynamicResource InsCtlBg}" />
              <Style Selector="^ /template/ ins|RowBack#PART_Back">
                <Setter Property="Transitions" Value="{x:Null}" />
                <Setter Property="Mark" Value="{DynamicResource InsToneMute}" />
              </Style>
            </Style>
          </Style>
        </Style>
        <!-- A ruled or compact list tells its rows, so the rows of a plain list skip these rules -->
        <Style Selector="^[(ins|ListLook.Styled)=True]">
          <!-- A compact list: short rows and no dividers -->
          <Style Selector="^[(ins|ListLook.Compact)=True]">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,6" />
            <Style Selector="^ /template/ :is(Border)#PART_Divider">
              <Setter Property="IsVisible" Value="False" />
            </Style>
          </Style>
          <!-- A ruled list: the dividers stay through hover and selection, 3px clear of the fill -->
          <Style Selector="^[(ins|ListLook.Ruled)=True]">
            <Style Selector="^ /template/ ins|RowBack#PART_Back">
              <Setter Property="Margin" Value="0,3" />
            </Style>
            <Style Selector="^ /template/ :is(Border)#PART_Divider">
              <Setter Property="Opacity" Value="1" />
            </Style>
          </Style>
        </Style>
        <!-- A group heading: the eyebrow look, never chosen or reached by the keys, no divider around it -->
        <Style Selector="^[(ins|ListRow.IsHeading)=True]">
          <Setter Property="IsEnabled" Value="False" />
          <Setter Property="Focusable" Value="False" />
          <Setter Property="IsHitTestVisible" Value="False" />
          <Setter Property="Opacity" Value="1" />
          <Setter Property="Cursor" Value="Arrow" />
          <Setter Property="MinHeight" Value="0" />
          <Setter Property="Padding" Value="12,14,12,6" />
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="FontSize" Value="{DynamicResource InsFsXs}" />
          <Setter Property="FontWeight" Value="Bold" />
          <Setter Property="Foreground" Value="{DynamicResource InsToneBrand}" />
          <Style Selector="^ /template/ :is(Border)#PART_Chevron">
            <Setter Property="IsVisible" Value="False" />
          </Style>
          <Style Selector="^ /template/ :is(Border)#PART_Divider">
            <Setter Property="IsVisible" Value="False" />
          </Style>
          <Style Selector="^[FlowDirection=LeftToRight]">
            <Setter Property="LetterSpacing" Value="0.96" />
          </Style>
        </Style>
        <Style Selector="^:after-heading /template/ :is(Border)#PART_Divider">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <!-- A row's place in time: past rows are quieter, the current one wears the brand's start mark -->
        <Style Selector="^[(ins|ListRow.State)=Past]">
          <Setter Property="Foreground" Value="{DynamicResource InsText2}" />
          <Setter Property="ins:ListLook.Past" Value="True" />
        </Style>
        <Style Selector="^[(ins|ListRow.State)=Current] /template/ ins|RowBack#PART_Back">
          <Setter Property="Mark" Value="{DynamicResource InsPrimaryMid}" />
        </Style>
      </ControlTheme>

      <!-- The slots of a row: a leading chip or avatar, the text, and the trailing end -->
      <ControlTheme x:Key="InsLookListText" TargetType="StackPanel" ins:ClassTheme.For="list-text">
        <Style Selector="^.list-text">
          <Setter Property="Spacing" Value="2" />
          <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="InsLookListTitle" TargetType="TextBlock" ins:ClassTheme.For="list-title">
        <Style Selector="^.list-title">
          <Setter Property="FontSize" Value="{DynamicResource InsFsMd}" />
          <Setter Property="FontWeight" Value="Bold" />
          <Setter Property="TextTrimming" Value="CharacterEllipsis" />
          <Setter Property="Foreground" Value="{DynamicResource InsText1}" />
          <!-- Arabic takes the web's 1.7 line height; Latin keeps the font's own, as the browser's normal does -->
          <Style Selector="^[FlowDirection=RightToLeft]">
            <Setter Property="LineHeight" Value="23.8" />
          </Style>
          <Style Selector="^[(ins|ListLook.Past)=True]"><Setter Property="Foreground" Value="{DynamicResource InsText2}" /></Style>
          <Style Selector="^[(ins|ListLook.Selected)=True]">
            <Style Selector="^[(ins|ListLook.Static)=False]">
              <Setter Property="Foreground" Value="{DynamicResource InsToneBrand}" />
            </Style>
          </Style>
          <!-- A window that is not the active one: the selected row's brand goes back to the text colour -->
          <Style Selector="^[(ins|WindowActivity.IsInactive)=True]">
            <Setter Property="Foreground" Value="{DynamicResource InsText1}" />
          </Style>
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="InsLookListDesc" TargetType="TextBlock" ins:ClassTheme.For="list-desc">
        <Style Selector="^.list-desc">
          <Setter Property="FontSize" Value="{DynamicResource InsFsXs}" />
          <Setter Property="Foreground" Value="{DynamicResource InsLabel}" />
          <Style Selector="^[FlowDirection=RightToLeft]">
            <Setter Property="LineHeight" Value="20.4" />
          </Style>
          <Style Selector="^[(ins|ListLook.Past)=True]"><Setter Property="Foreground" Value="{DynamicResource InsText3}" /></Style>
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="InsLookListEndText" TargetType="TextBlock" ins:ClassTheme.For="list-end">
        <Style Selector="^.list-end">
          <Setter Property="VerticalAlignment" Value="Center" />
          <Setter Property="TextElement.FontSize" Value="{DynamicResource InsFsXs}" />
          <Setter Property="TextElement.Foreground" Value="{DynamicResource InsLabel}" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="InsLookListEnd" TargetType="StackPanel" ins:ClassTheme.For="list-end">
        <Style Selector="^.list-end">
          <Setter Property="VerticalAlignment" Value="Center" />
          <Setter Property="TextElement.FontSize" Value="{DynamicResource InsFsXs}" />
          <Setter Property="TextElement.Foreground" Value="{DynamicResource InsLabel}" />
          <Setter Property="Orientation" Value="Horizontal" />
          <Setter Property="Spacing" Value="8" />
        </Style>
      </ControlTheme>

    </ResourceDictionary>
  </Styles.Resources>

  <!-- Concentric with the panel: its radius less the insets between the two edges -->
  <Style Selector="Border.panel > ListBox > ListBoxItem, Border.panel > ListBox ListBoxItem">
    <Setter Property="CornerRadius" Value="17" />
  </Style>
  <Style Selector="Border.panel-body.flush > ListBox ListBoxItem">
    <Setter Property="CornerRadius" Value="7" />
  </Style>

  <!-- A display-only list is not a tab stop, and tells its rows' parts -->
  <Style Selector="ListBox.static">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="ins:ListLook.Static" Value="True" />
  </Style>

  <!-- A selected row tells its parts, so its title takes the brand colour -->
  <Style Selector="ListBoxItem:selected">
    <Setter Property="ins:ListLook.Selected" Value="True" />
  </Style>

  <!-- Rows that go nowhere: the web's plain <li> rows -->
  <Style Selector="ListBox.static ListBoxItem">
    <Setter Property="Cursor" Value="Arrow" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.static ListBoxItem /template/ :is(Border)#PART_Chevron">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ListBox.static ListBoxItem /template/ :is(Border)#PART_Divider">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- The row's slots sit apart by the same gap everywhere but the sidebar -->
  <Style Selector="ListBox:not(.shell-nav):not(.nav) ListBoxItem > DockPanel">
    <Setter Property="HorizontalSpacing" Value="12" />
  </Style>

</Styles>
