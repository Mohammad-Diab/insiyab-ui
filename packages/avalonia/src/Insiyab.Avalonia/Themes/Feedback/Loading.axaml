<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:Insiyab.Avalonia.Controls">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="InsSpinnerTrack" Color="{DynamicResource InsPrimaryColor}" Opacity="0.18" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="InsSpinnerTrack" Color="{DynamicResource InsPrimaryMidColor}" Opacity="0.18" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- Skeleton: the ins-skel sweep, 1.8s with the CSS default ease, one of the two loops the library allows -->
      <ControlTheme x:Key="{x:Type ctl:Skeleton}" TargetType="ctl:Skeleton">
        <Setter Property="Base" Value="{DynamicResource InsSkelBase}" />
        <Setter Property="Highlight" Value="{DynamicResource InsSkelHi}" />
        <Setter Property="CornerRadius" Value="{DynamicResource InsRSm}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <!-- Running only while someone can see it: a style with a condition also keeps one instance per control -->
        <Style Selector="^:ins-seen">
          <Style.Animations>
            <Animation Duration="0:0:1.8" IterationCount="Infinite" Easing="0.25,0.1,0.25,1">
              <KeyFrame Cue="0%">
                <Setter Property="Phase" Value="0" />
              </KeyFrame>
              <KeyFrame Cue="100%">
                <Setter Property="Phase" Value="1" />
              </KeyFrame>
            </Animation>
          </Style.Animations>
        </Style>
        <Style Selector="^.text">
          <Setter Property="Height" Value="12" />
          <Setter Property="Margin" Value="0,6" />
        </Style>
        <!-- A paragraph's last line is short, or the lines read as a table of bars; the skeleton marks itself :last-line -->
        <Style Selector="^.text:last-line">
          <Setter Property="FillWidth" Value="0.6" />
        </Style>
        <Style Selector="^.title">
          <Setter Property="Height" Value="20" />
          <Setter Property="FillWidth" Value="0.4" />
        </Style>
        <Style Selector="^.circle">
          <Setter Property="Width" Value="40" />
          <Setter Property="Height" Value="40" />
          <Setter Property="CornerRadius" Value="999" />
          <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="^.block">
          <Setter Property="Height" Value="128" />
          <Setter Property="CornerRadius" Value="{DynamicResource InsRMd}" />
        </Style>
      </ControlTheme>

      <!-- Spinner: .7s a turn, linear, and a fade-in so a fast response never flashes a wheel -->
      <ControlTheme x:Key="{x:Type ctl:LoadingSpinner}" TargetType="ctl:LoadingSpinner">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Thickness" Value="3" />
        <Setter Property="Arc" Value="{DynamicResource InsPrimaryMid}" />
        <Setter Property="Track" Value="{DynamicResource InsSpinnerTrack}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <!-- Running only while someone can see it: a style with a condition also keeps one instance per control -->
        <Style Selector="^:ins-seen">
          <Style.Animations>
            <Animation Duration="0:0:0.7" IterationCount="Infinite">
              <KeyFrame Cue="0%">
                <Setter Property="Angle" Value="0" />
              </KeyFrame>
              <KeyFrame Cue="100%">
                <Setter Property="Angle" Value="360" />
              </KeyFrame>
            </Animation>
            <Animation Duration="0:0:0.28" Easing="0.22,1,0.36,1">
              <KeyFrame Cue="0%">
                <Setter Property="Opacity" Value="0" />
              </KeyFrame>
              <KeyFrame Cue="100%">
                <Setter Property="Opacity" Value="1" />
              </KeyFrame>
            </Animation>
          </Style.Animations>
        </Style>
        <Style Selector="^.sm">
          <Setter Property="Width" Value="15" />
          <Setter Property="Height" Value="15" />
          <Setter Property="Thickness" Value="2" />
        </Style>
      </ControlTheme>

      <!-- Ring: the arc on a 6px band, clockwise from twelve, the label in tabular Inter -->
      <ControlTheme x:Key="{x:Type ctl:ProgressRing}" TargetType="ctl:ProgressRing">
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="52" />
        <Setter Property="Thickness" Value="6" />
        <Setter Property="Track" Value="{DynamicResource InsCtlBgHover}" />
        <Setter Property="Fill" Value="{DynamicResource InsPrimaryMid}" />
        <Setter Property="Foreground" Value="{DynamicResource InsText1}" />
        <Setter Property="FontSize" Value="{DynamicResource InsFsXs}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
          <ControlTemplate>
            <ctl:TemplateText x:Name="PART_Label" Text="{TemplateBinding Label}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontFamily="{DynamicResource InsFontBodyEn}" FontFeatures="+tnum" />
          </ControlTemplate>
        </Setter>
        <Style Selector="^.sm">
          <Setter Property="Width" Value="24" />
          <Setter Property="Height" Value="24" />
          <Setter Property="Thickness" Value="3" />
          <Style Selector="^ /template/ :is(TextBlock)#PART_Label">
            <Setter Property="IsVisible" Value="False" />
          </Style>
        </Style>
        <Style Selector="^:crowded /template/ :is(TextBlock)#PART_Label">
          <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^.lg">
          <Setter Property="Width" Value="80" />
          <Setter Property="Height" Value="80" />
          <Setter Property="FontSize" Value="{DynamicResource InsFsLg}" />
        </Style>
      </ControlTheme>

      <!-- Progress icon: the icon shrinks to 60% inside a 2px ring 4px outside its box (taking no room), or the spinner's arc while waiting; both ease -->
      <ControlTheme x:Key="{x:Type ctl:ProgressIcon}" TargetType="ctl:ProgressIcon">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel>
              <ctl:ProgressRing Name="PART_Ring" Template="{x:Null}" Width="NaN" Height="NaN" Margin="-4" Thickness="2"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" RenderTransformOrigin="50%,50%" IsHitTestVisible="False" />
              <ctl:LoadingSpinner Name="PART_Spinner" Width="NaN" Height="NaN" Margin="-4" Thickness="2"
                                  Arc="{DynamicResource InsPrimaryMid}" Track="{DynamicResource InsCtlBgHover}"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False" />
              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                RenderTransformOrigin="50%,50%" />
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="RenderTransform" Value="scale(1)" />
          <Setter Property="Transitions">
            <Transitions>
              <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.28" Easing="0.22,1,0.36,1" />
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="^ /template/ ctl|ProgressRing#PART_Ring">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="RenderTransform" Value="scale(0.8)" />
          <Setter Property="Transitions">
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.28" Easing="0.22,1,0.36,1" />
              <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.28" Easing="0.22,1,0.36,1" />
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="^ /template/ ctl|LoadingSpinner#PART_Spinner">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:busy /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="RenderTransform" Value="scale(0.6)" />
        </Style>
        <Style Selector="^:progress /template/ ctl|ProgressRing#PART_Ring">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>
        <Style Selector="^:waiting /template/ ctl|LoadingSpinner#PART_Spinner">
          <Setter Property="IsVisible" Value="True" />
        </Style>
      </ControlTheme>

      <!-- .ins-loading: a waiting area that keeps a sensible height, its spinner in the middle -->
      <ControlTheme x:Key="InsLookLoading" TargetType="Border" ctl:ClassTheme.For="loading">
        <Style Selector="^.loading">
          <Setter Property="MinHeight" Value="200" />
          <Setter Property="ctl:ClassTheme.ChildHorizontalAlignment" Value="Center" />
          <Setter Property="ctl:ClassTheme.ChildVerticalAlignment" Value="Center" />
        </Style>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- In a button the spinner takes the button's text colour, its ring at 28% -->
  <Style Selector="Button ctl|LoadingSpinner">
    <Setter Property="Arc" Value="{x:Null}" />
    <Setter Property="Track" Value="{x:Null}" />
  </Style>

</Styles>
