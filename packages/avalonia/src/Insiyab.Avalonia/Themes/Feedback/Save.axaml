<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:Insiyab.Avalonia.Controls">

  <Styles.Resources>
    <ResourceDictionary>
      <StreamGeometry x:Key="InsSaveIconSaved">M20 6 9 17l-5-5</StreamGeometry>
      <StreamGeometry x:Key="InsSaveIconError">M3,12 A9,9 0 1 0 21,12 A9,9 0 1 0 3,12 Z M12 8v5M12 16.5v.5</StreamGeometry>

      <!-- The save glyph's ring: the status turns it only while saving -->
      <ControlTheme x:Key="InsSaveSpinner" TargetType="ctl:LoadingSpinner">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Thickness" Value="2" />
        <Setter Property="ArcLength" Value="270" />
        <Setter Property="Track" Value="Transparent" />
      </ControlTheme>

      <!-- .ins-save: a 14px glyph and the words, quiet until it has something to report -->
      <ControlTheme x:Key="{x:Type ctl:SaveStatus}" TargetType="ctl:SaveStatus">
        <Setter Property="Foreground" Value="{DynamicResource InsText3}" />
        <Setter Property="FontSize" Value="{DynamicResource InsFsXs}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Transitions">
          <Transitions>
            <BrushTransition Property="Foreground" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
          </Transitions>
        </Setter>
        <Setter Property="Template">
          <ControlTemplate>
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Panel Width="14" Height="14" VerticalAlignment="Center">
                <ctl:LoadingSpinner x:Name="PART_Spinner" Theme="{StaticResource InsSaveSpinner}" Opacity="0" />
                <ctl:Icon x:Name="PART_Glyph" Size="14" StrokeThickness="3" IsVisible="False" />
              </Panel>
              <ctl:TemplateText x:Name="PART_Text" Text="{TemplateBinding DisplayText}" VerticalAlignment="Center" LineHeight="20" />
            </StackPanel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:idle">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="^:saving /template/ ctl|LoadingSpinner#PART_Spinner">
          <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:saving /template/ ctl|LoadingSpinner#PART_Spinner:ins-seen">
          <Style.Animations>
            <Animation Duration="0:0:0.7" IterationCount="Infinite">
              <KeyFrame Cue="0%">
                <Setter Property="Angle" Value="0" />
              </KeyFrame>
              <KeyFrame Cue="100%">
                <Setter Property="Angle" Value="360" />
              </KeyFrame>
            </Animation>
          </Style.Animations>
        </Style>
        <Style Selector="^:saved">
          <Setter Property="Foreground" Value="{DynamicResource InsToneOk}" />
        </Style>
        <Style Selector="^:saved /template/ ctl|Icon#PART_Glyph">
          <Setter Property="IsVisible" Value="True" />
          <Setter Property="Data" Value="{StaticResource InsSaveIconSaved}" />
        </Style>
        <Style Selector="^:error">
          <Setter Property="Foreground" Value="{DynamicResource InsToneBad}" />
        </Style>
        <Style Selector="^:error /template/ ctl|Icon#PART_Glyph">
          <Setter Property="IsVisible" Value="True" />
          <Setter Property="Data" Value="{StaticResource InsSaveIconError}" />
          <Setter Property="StrokeThickness" Value="2.5" />
        </Style>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>

</Styles>
