<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:Insiyab.Avalonia.Controls">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="InsPillBrandInk" Color="{DynamicResource InsToneBrandColor}" />
          <SolidColorBrush x:Key="InsBadgeInk" Color="{DynamicResource InsToneBrandColor}" />
          <SolidColorBrush x:Key="InsBadgeOkInk" Color="{DynamicResource InsToneOkColor}" />
          <SolidColorBrush x:Key="InsBadgeWarnInk" Color="{DynamicResource InsToneWarnColor}" />
          <SolidColorBrush x:Key="InsBadgeBadInk" Color="{DynamicResource InsToneBadColor}" />
          <SolidColorBrush x:Key="InsBadgeMuteInk" Color="{DynamicResource InsToneMuteColor}" />
          <SolidColorBrush x:Key="InsAvatarMoreBg" Color="{DynamicResource InsToneMuteBgColor}" />
          <SolidColorBrush x:Key="InsAvatarMoreInk" Color="{DynamicResource InsText2Color}" />
          <SolidColorBrush x:Key="InsDateBadgeFilledInk" Color="#FFFFFFFF" />
          <LinearGradientBrush x:Key="InsAvatarFill" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="{DynamicResource InsPrimaryColor}" />
            <GradientStop Offset="1" Color="{DynamicResource InsPrimaryDarkColor}" />
          </LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="InsPillBrandInk" Color="{DynamicResource InsText1Color}" />
          <SolidColorBrush x:Key="InsBadgeInk" Color="{DynamicResource InsText1Color}" />
          <SolidColorBrush x:Key="InsBadgeOkInk" Color="{DynamicResource InsText1Color}" />
          <SolidColorBrush x:Key="InsBadgeWarnInk" Color="{DynamicResource InsText1Color}" />
          <SolidColorBrush x:Key="InsBadgeBadInk" Color="{DynamicResource InsText1Color}" />
          <SolidColorBrush x:Key="InsBadgeMuteInk" Color="{DynamicResource InsText1Color}" />
          <SolidColorBrush x:Key="InsAvatarMoreBg" Color="#1FFFFFFF" />
          <SolidColorBrush x:Key="InsAvatarMoreInk" Color="{DynamicResource InsText1Color}" />
          <SolidColorBrush x:Key="InsDateBadgeFilledInk" Color="#FF0F172A" />
          <LinearGradientBrush x:Key="InsAvatarFill" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="{DynamicResource InsPrimaryColor}" />
            <GradientStop Offset="1" Color="{DynamicResource InsPrimaryDarkColor}" />
          </LinearGradientBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- Pill: 3px/12px, a 5px gap, .75rem at 700; sm sits inside a line of text; an empty dot pill is the dot alone; dot peek opens over its neighbours -->
      <ControlTheme x:Key="{x:Type ctl:Pill}" TargetType="ctl:Pill">
        <Setter Property="Background" Value="{DynamicResource InsToneMuteBg}" />
        <Setter Property="Foreground" Value="{DynamicResource InsToneMute}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InsToneMuteBd}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource InsRPill}" />
        <Setter Property="Padding" Value="12,3" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
          <ControlTemplate>
            <ctl:PillPeek x:Name="PART_Peek">
              <!-- the ground under the face: nothing for a plain pill; for dot peek the solid glass ground, so the face's see-through tint never shows what it opens over -->
              <Border x:Name="PART_Ground" CornerRadius="{TemplateBinding CornerRadius}">
                <ctl:TemplateBorder x:Name="PART_Face"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <Ellipse x:Name="PART_Dot" Width="7" Height="7" VerticalAlignment="Center" IsVisible="False"
                             Fill="{TemplateBinding Foreground}" />
                    <ctl:Icon x:Name="PART_Glyph" Data="{TemplateBinding Icon}" Size="12" VerticalAlignment="Center" IsVisible="False"
                              Foreground="{TemplateBinding Foreground}" />
                    <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Opacity="{Binding $parent[ctl:PillPeek].Words}"
                                      VerticalAlignment="Center" LineHeight="18" />
                    <Ellipse x:Name="PART_DotEnd" Width="8" Height="8" VerticalAlignment="Center" IsVisible="False"
                             Fill="{TemplateBinding Foreground}" />
                    <ctl:Icon x:Name="PART_GlyphEnd" Data="{TemplateBinding Icon}" Size="12" VerticalAlignment="Center" IsVisible="False"
                              Foreground="{TemplateBinding Foreground}" />
                  </StackPanel>
                </ctl:TemplateBorder>
              </Border>
              <!-- dot peek at rest: a ring of the tone around the dot, the only part the pointer finds until the pill opens; the dot stays put as it grows -->
              <Border x:Name="PART_Ring" IsVisible="False" Width="16" Height="16"
                      CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" />
              <Panel x:Name="PART_RingMark" IsVisible="False" IsHitTestVisible="False">
                <Ellipse x:Name="PART_RingDot" Width="8" Height="8" Fill="{TemplateBinding Foreground}" />
                <ctl:Icon x:Name="PART_RingGlyph" Data="{TemplateBinding Icon}" Size="12" IsVisible="False" Foreground="{TemplateBinding Foreground}" />
              </Panel>
            </ctl:PillPeek>
          </ControlTemplate>
        </Setter>
        <Style Selector="^.dot /template/ Ellipse#PART_Dot">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <!-- an icon takes the dot's place, at the start, or at the end for peek back -->
        <Style Selector="^.dot:icon">
          <Style Selector="^ /template/ Ellipse#PART_Dot">
            <Setter Property="IsVisible" Value="False" />
          </Style>
          <Style Selector="^ /template/ Ellipse#PART_RingDot">
            <Setter Property="IsVisible" Value="False" />
          </Style>
          <Style Selector="^ /template/ ctl|Icon#PART_Glyph">
            <Setter Property="IsVisible" Value="True" />
          </Style>
          <Style Selector="^ /template/ ctl|Icon#PART_RingGlyph">
            <Setter Property="IsVisible" Value="True" />
          </Style>
        </Style>
        <Style Selector="^.sm">
          <Setter Property="Padding" Value="7,1" />
          <Setter Property="FontSize" Value="10" />
          <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="LineHeight" Value="14" />
          </Style>
          <Style Selector="^ /template/ Ellipse#PART_Dot">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
          </Style>
        </Style>
        <Style Selector="^.mute">
          <Setter Property="Background" Value="{DynamicResource InsToneMuteBg}" />
          <Setter Property="Foreground" Value="{DynamicResource InsToneMute}" />
          <Setter Property="BorderBrush" Value="{DynamicResource InsToneMuteBd}" />
        </Style>
        <!-- Categories, not states: a soft fill, an ink that reads on it, and the solid hue for the dot -->
        <Style Selector="^.cat1">
          <Setter Property="Background" Value="{DynamicResource InsCat1Bg}" />
          <Setter Property="Foreground" Value="{DynamicResource InsCat1Ink}" />
          <Setter Property="BorderBrush" Value="{DynamicResource InsCat1Bg}" />
          <Style Selector="^ /template/ Ellipse">
            <Setter Property="Fill" Value="{DynamicResource InsCat1}" />
          </Style>
        </Style>
        <Style Selector="^.cat2">
          <Setter Property="Background" Value="{DynamicResource InsCat2Bg}" />
          <Setter Property="Foreground" Value="{DynamicResource InsCat2Ink}" />
          <Setter Property="BorderBrush" Value="{DynamicResource InsCat2Bg}" />
          <Style Selector="^ /template/ Ellipse">
            <Setter Property="Fill" Value="{DynamicResource InsCat2}" />
          </Style>
        </Style>
        <Style Selector="^.cat3">
          <Setter Property="Background" Value="{DynamicResource InsCat3Bg}" />
          <Setter Property="Foreground" Value="{DynamicResource InsCat3Ink}" />
          <Setter Property="BorderBrush" Value="{DynamicResource InsCat3Bg}" />
          <Style Selector="^ /template/ Ellipse">
            <Setter Property="Fill" Value="{DynamicResource InsCat3}" />
          </Style>
        </Style>
        <Style Selector="^.cat4">
          <Setter Property="Background" Value="{DynamicResource InsCat4Bg}" />
          <Setter Property="Foreground" Value="{DynamicResource InsCat4Ink}" />
          <Setter Property="BorderBrush" Value="{DynamicResource InsCat4Bg}" />
          <Style Selector="^ /template/ Ellipse">
            <Setter Property="Fill" Value="{DynamicResource InsCat4}" />
          </Style>
        </Style>
        <Style Selector="^.cat5">
          <Setter Property="Background" Value="{DynamicResource InsCat5Bg}" />
          <Setter Property="Foreground" Value="{DynamicResource InsCat5Ink}" />
          <Setter Property="BorderBrush" Value="{DynamicResource InsCat5Bg}" />
          <Style Selector="^ /template/ Ellipse">
            <Setter Property="Fill" Value="{DynamicResource InsCat5}" />
          </Style>
        </Style>
        <Style Selector="^.cat6">
          <Setter Property="Background" Value="{DynamicResource InsCat6Bg}" />
          <Setter Property="Foreground" Value="{DynamicResource InsCat6Ink}" />
          <Setter Property="BorderBrush" Value="{DynamicResource InsCat6Bg}" />
          <Style Selector="^ /template/ Ellipse">
            <Setter Property="Fill" Value="{DynamicResource InsCat6}" />
          </Style>
        </Style>
        <Style Selector="^.cat7">
          <Setter Property="Background" Value="{DynamicResource InsCat7Bg}" />
          <Setter Property="Foreground" Value="{DynamicResource InsCat7Ink}" />
          <Setter Property="BorderBrush" Value="{DynamicResource InsCat7Bg}" />
          <Style Selector="^ /template/ Ellipse">
            <Setter Property="Fill" Value="{DynamicResource InsCat7}" />
          </Style>
        </Style>
        <Style Selector="^.cat8">
          <Setter Property="Background" Value="{DynamicResource InsCat8Bg}" />
          <Setter Property="Foreground" Value="{DynamicResource InsCat8Ink}" />
          <Setter Property="BorderBrush" Value="{DynamicResource InsCat8Bg}" />
          <Style Selector="^ /template/ Ellipse">
            <Setter Property="Fill" Value="{DynamicResource InsCat8}" />
          </Style>
        </Style>
        <!-- Warn reads orange at dot size; its words keep the brown -->
        <Style Selector="^.warn /template/ Ellipse">
          <Setter Property="Fill" Value="{DynamicResource InsToneWarnSignal}" />
        </Style>
        <Style Selector="^.outline /template/ :is(Border)#PART_Face">
          <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- An empty dot pill is the dot alone, 8px, in its tone -->
        <Style Selector="^.dot:empty">
          <Style Selector="^ /template/ :is(Border)#PART_Face">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
          </Style>
          <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="IsVisible" Value="False" />
          </Style>
          <Style Selector="^ /template/ Ellipse#PART_Dot">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
          </Style>
        </Style>
        <Style Selector="^.brand.dot:empty /template/ Ellipse#PART_Dot">
          <Setter Property="Fill" Value="{DynamicResource InsToneBrandSoft}" />
        </Style>
        <!-- dot peek: only the dot takes room; pointer or keyboard focus opens the whole pill over its neighbours -->
        <Style Selector="^.peek">
          <Setter Property="ClipToBounds" Value="False" />
          <Setter Property="Focusable" Value="True" />
          <Setter Property="FocusAdorner" Value="{x:Null}" />
          <Setter Property="AutomationProperties.Name" Value="{Binding $self.Content}" />
          <!-- the pill grows out of the ring and then its words fade in; closing, the words go first and it shrinks back (PillPeek runs both) -->
          <Style Selector="^ /template/ ctl|PillPeek#PART_Peek">
            <Setter Property="IsPeek" Value="True" />
          </Style>
          <!-- the face's own dot keeps its room but the ring's dot is the one drawn, so the dot never moves -->
          <Style Selector="^ /template/ Ellipse#PART_Dot, ^ /template/ Ellipse#PART_DotEnd">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Opacity" Value="0" />
          </Style>
          <Style Selector="^ /template/ Border#PART_Ring">
            <Setter Property="IsVisible" Value="True" />
          </Style>
          <Style Selector="^ /template/ Panel#PART_RingMark">
            <Setter Property="IsVisible" Value="True" />
          </Style>
          <Style Selector="^ /template/ ctl|Icon#PART_Glyph, ^ /template/ ctl|Icon#PART_GlyphEnd">
            <Setter Property="Opacity" Value="0" />
          </Style>
          <Style Selector="^ /template/ Border#PART_Ground">
            <Setter Property="Background" Value="{DynamicResource InsGlassGround}" />
          </Style>
          <!-- the face clips its words to its capsule while it grows and shrinks -->
          <Style Selector="^ /template/ :is(Border)#PART_Face">
            <Setter Property="ClipToBounds" Value="True" />
          </Style>
          <Style Selector="^:not(:pointerover):not(:focus-visible) /template/ Border#PART_Ground">
            <Setter Property="IsHitTestVisible" Value="False" />
          </Style>
          <Style Selector="^:pointerover, ^:focus-visible">
            <Setter Property="ZIndex" Value="1" />
            <Style Selector="^ /template/ ctl|PillPeek#PART_Peek">
              <Setter Property="IsOpen" Value="True" />
            </Style>
          </Style>
          <Style Selector="^:focus-visible /template/ :is(Border)#PART_Face">
            <Setter Property="BoxShadow" Value="{DynamicResource InsFocusRing}" />
          </Style>
        </Style>
        <Style Selector="^.peek.back">
          <Style Selector="^ /template/ ctl|PillPeek#PART_Peek">
            <Setter Property="Back" Value="True" />
          </Style>
          <Style Selector="^ /template/ Ellipse#PART_Dot">
            <Setter Property="IsVisible" Value="False" />
          </Style>
          <Style Selector="^ /template/ Ellipse#PART_DotEnd">
            <Setter Property="IsVisible" Value="True" />
          </Style>
        </Style>
        <!-- a peeking pill with an icon: the glyph in its ring (bigger, to hold it) and in the face's place for it, never a dot -->
        <Style Selector="^.peek:icon">
          <Style Selector="^ /template/ Border#PART_Ring">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
          </Style>
          <Style Selector="^ /template/ Ellipse#PART_Dot">
            <Setter Property="IsVisible" Value="False" />
          </Style>
          <Style Selector="^ /template/ Ellipse#PART_DotEnd">
            <Setter Property="IsVisible" Value="False" />
          </Style>
        </Style>
        <Style Selector="^.peek.back:icon">
          <Style Selector="^ /template/ ctl|Icon#PART_Glyph">
            <Setter Property="IsVisible" Value="False" />
          </Style>
          <Style Selector="^ /template/ ctl|Icon#PART_GlyphEnd">
            <Setter Property="IsVisible" Value="True" />
          </Style>
        </Style>
      </ControlTheme>

      <!-- A pressable pill lifts a pixel under the pointer and its dot grows; a read-only Pill stays still -->
      <ControlTheme x:Key="InsPillButton" TargetType="Button">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Background" Value="{DynamicResource InsToneMuteBg}" />
        <Setter Property="Foreground" Value="{DynamicResource InsToneMute}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InsToneMuteBd}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource InsRPill}" />
        <Setter Property="Padding" Value="12,3" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="RenderTransform" Value="none" />
        <Setter Property="Transitions">
          <Transitions>
            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
          </Transitions>
        </Setter>
        <Setter Property="Template">
          <ControlTemplate>
            <Panel x:Name="PART_Press">
              <ctl:TemplateBorder x:Name="PART_Face"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{TemplateBinding CornerRadius}"
                      Padding="{TemplateBinding Padding}">
                <ctl:TemplateBorder.Transitions>
                  <Transitions>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
                  </Transitions>
                </ctl:TemplateBorder.Transitions>
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Ellipse x:Name="PART_Dot" Width="7" Height="7" VerticalAlignment="Center" IsVisible="False"
                           Fill="{TemplateBinding Foreground}" RenderTransformOrigin="50%,50%" RenderTransform="none">
                    <Ellipse.Transitions>
                      <Transitions>
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="0.34,1.56,0.64,1" />
                      </Transitions>
                    </Ellipse.Transitions>
                  </Ellipse>
                  <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    VerticalAlignment="Center" LineHeight="18" RecognizesAccessKey="True" />
                </StackPanel>
              </ctl:TemplateBorder>
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ Panel#PART_Press">
          <Setter Property="ctl:PressDip.Depth" Value="0.96" />
        </Style>
        <Style Selector="^.dot /template/ Ellipse#PART_Dot">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^.sm">
          <Setter Property="Padding" Value="7,1" />
          <Setter Property="FontSize" Value="10" />
          <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="LineHeight" Value="14" />
          </Style>
          <Style Selector="^ /template/ Ellipse#PART_Dot">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
          </Style>
        </Style>
        <Style Selector="^.mute">
          <Setter Property="Background" Value="{DynamicResource InsToneMuteBg}" />
          <Setter Property="Foreground" Value="{DynamicResource InsToneMute}" />
          <Setter Property="BorderBrush" Value="{DynamicResource InsToneMuteBd}" />
        </Style>
        <Style Selector="^.outline /template/ :is(Border)#PART_Face">
          <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="^.warn /template/ Ellipse#PART_Dot">
          <Setter Property="Fill" Value="{DynamicResource InsToneWarnSignal}" />
        </Style>
        <Style Selector="^:pointerover">
          <Setter Property="RenderTransform" Value="translateY(-1px)" />
        </Style>
        <Style Selector="^:pointerover /template/ :is(Border)#PART_Face">
          <Setter Property="BoxShadow" Value="{DynamicResource InsShSm}" />
        </Style>
        <Style Selector="^:pointerover /template/ Ellipse#PART_Dot">
          <Setter Property="RenderTransform" Value="scale(1.35)" />
        </Style>
        <Style Selector="^:pressed">
          <Setter Property="RenderTransform" Value="scale(0.96)" />
        </Style>
        <Style Selector="^:focus-visible /template/ :is(Border)#PART_Face">
          <Setter Property="BoxShadow" Value="{DynamicResource InsFocusRing}" />
        </Style>
      </ControlTheme>

      <!-- Badge: a count, not a status, so no border and no dot -->
      <ControlTheme x:Key="{x:Type ctl:Badge}" TargetType="ctl:Badge">
        <Setter Property="Background" Value="{DynamicResource InsToneBrandBg}" />
        <Setter Property="Foreground" Value="{DynamicResource InsBadgeInk}" />
        <Setter Property="CornerRadius" Value="{DynamicResource InsRPill}" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="MinWidth" Value="22" />
        <Setter Property="FontFeatures" Value="+tnum" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="Template">
          <ControlTemplate>
            <ctl:TemplateBorder Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
              <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                FontFamily="{DynamicResource InsFontBodyEn}" LineHeight="15.4" />
            </ctl:TemplateBorder>
          </ControlTemplate>
        </Setter>
        <Style Selector="^.ok">
          <Setter Property="Background" Value="{DynamicResource InsToneOkBg}" />
          <Setter Property="Foreground" Value="{DynamicResource InsBadgeOkInk}" />
        </Style>
        <Style Selector="^.warn">
          <Setter Property="Background" Value="{DynamicResource InsToneWarnBg}" />
          <Setter Property="Foreground" Value="{DynamicResource InsBadgeWarnInk}" />
        </Style>
        <Style Selector="^.bad">
          <Setter Property="Background" Value="{DynamicResource InsToneBadBg}" />
          <Setter Property="Foreground" Value="{DynamicResource InsBadgeBadInk}" />
        </Style>
        <Style Selector="^.mute">
          <Setter Property="Background" Value="{DynamicResource InsToneMuteBg}" />
          <Setter Property="Foreground" Value="{DynamicResource InsBadgeMuteInk}" />
        </Style>
        <Style Selector="^.cat1">
          <Setter Property="Background" Value="{DynamicResource InsCat1Bg}" />
          <Setter Property="Foreground" Value="{DynamicResource InsCat1Ink}" />
        </Style>
        <Style Selector="^.cat2">
          <Setter Property="Background" Value="{DynamicResource InsCat2Bg}" />
          <Setter Property="Foreground" Value="{DynamicResource InsCat2Ink}" />
        </Style>
        <Style Selector="^.cat3">
          <Setter Property="Background" Value="{DynamicResource InsCat3Bg}" />
          <Setter Property="Foreground" Value="{DynamicResource InsCat3Ink}" />
        </Style>
        <Style Selector="^.cat4">
          <Setter Property="Background" Value="{DynamicResource InsCat4Bg}" />
          <Setter Property="Foreground" Value="{DynamicResource InsCat4Ink}" />
        </Style>
        <Style Selector="^.cat5">
          <Setter Property="Background" Value="{DynamicResource InsCat5Bg}" />
          <Setter Property="Foreground" Value="{DynamicResource InsCat5Ink}" />
        </Style>
        <Style Selector="^.cat6">
          <Setter Property="Background" Value="{DynamicResource InsCat6Bg}" />
          <Setter Property="Foreground" Value="{DynamicResource InsCat6Ink}" />
        </Style>
        <Style Selector="^.cat7">
          <Setter Property="Background" Value="{DynamicResource InsCat7Bg}" />
          <Setter Property="Foreground" Value="{DynamicResource InsCat7Ink}" />
        </Style>
        <Style Selector="^.cat8">
          <Setter Property="Background" Value="{DynamicResource InsCat8Bg}" />
          <Setter Property="Foreground" Value="{DynamicResource InsCat8Ink}" />
        </Style>
      </ControlTheme>

      <!-- Avatar: a brand-gradient disc; the gradient is physical, so the face is an LTR layer under the content -->
      <ControlTheme x:Key="{x:Type ctl:Avatar}" TargetType="ctl:Avatar">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Background" Value="{DynamicResource InsAvatarFill}" />
        <Setter Property="Foreground" Value="{DynamicResource InsOnPrimary}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel>
              <Ellipse x:Name="PART_Ring" Margin="-2" Fill="{DynamicResource InsGlassStrong}" IsVisible="False" />
              <ctl:TemplateBorder x:Name="PART_Face" FlowDirection="LeftToRight" Background="{TemplateBinding Background}" CornerRadius="999" />
              <ctl:TemplateBorder CornerRadius="999" ClipToBounds="True">
                <ContentPresenter x:Name="PART_ContentPresenter"
                                  Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
              </ctl:TemplateBorder>
            </Panel>
          </ControlTemplate>
        </Setter>
        <!-- In a group each avatar is ringed in the surface colour, so two that overlap keep a gap -->
        <Style Selector="^:grouped /template/ Ellipse#PART_Ring">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^.sm">
          <Setter Property="Width" Value="30" />
          <Setter Property="Height" Value="30" />
          <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="^.lg">
          <Setter Property="Width" Value="46" />
          <Setter Property="Height" Value="46" />
          <Setter Property="FontSize" Value="18" />
        </Style>
        <Style Selector="^.xl">
          <Setter Property="Width" Value="64" />
          <Setter Property="Height" Value="64" />
          <Setter Property="FontSize" Value="24" />
        </Style>
        <Style Selector="^.xxl">
          <Setter Property="Width" Value="100" />
          <Setter Property="Height" Value="100" />
          <Setter Property="FontSize" Value="36" />
        </Style>
        <Style Selector="^.cat1">
          <Setter Property="Background" Value="{DynamicResource InsCat1Bg}" />
          <Setter Property="Foreground" Value="{DynamicResource InsCat1Ink}" />
        </Style>
        <Style Selector="^.cat2">
          <Setter Property="Background" Value="{DynamicResource InsCat2Bg}" />
          <Setter Property="Foreground" Value="{DynamicResource InsCat2Ink}" />
        </Style>
        <Style Selector="^.cat3">
          <Setter Property="Background" Value="{DynamicResource InsCat3Bg}" />
          <Setter Property="Foreground" Value="{DynamicResource InsCat3Ink}" />
        </Style>
        <Style Selector="^.cat4">
          <Setter Property="Background" Value="{DynamicResource InsCat4Bg}" />
          <Setter Property="Foreground" Value="{DynamicResource InsCat4Ink}" />
        </Style>
        <Style Selector="^.cat5">
          <Setter Property="Background" Value="{DynamicResource InsCat5Bg}" />
          <Setter Property="Foreground" Value="{DynamicResource InsCat5Ink}" />
        </Style>
        <Style Selector="^.cat6">
          <Setter Property="Background" Value="{DynamicResource InsCat6Bg}" />
          <Setter Property="Foreground" Value="{DynamicResource InsCat6Ink}" />
        </Style>
        <Style Selector="^.cat7">
          <Setter Property="Background" Value="{DynamicResource InsCat7Bg}" />
          <Setter Property="Foreground" Value="{DynamicResource InsCat7Ink}" />
        </Style>
        <Style Selector="^.cat8">
          <Setter Property="Background" Value="{DynamicResource InsCat8Bg}" />
          <Setter Property="Foreground" Value="{DynamicResource InsCat8Ink}" />
        </Style>
        <!-- "+4", not "4+": the count is its own LTR run -->
        <Style Selector="^.more">
          <Setter Property="Background" Value="{DynamicResource InsAvatarMoreBg}" />
          <Setter Property="Foreground" Value="{DynamicResource InsAvatarMoreInk}" />
          <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="^.more /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="FontFamily" Value="{DynamicResource InsFontBodyEn}" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type ctl:AvatarGroup}" TargetType="ctl:AvatarGroup">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </ControlTheme>

      <!-- DateBadge: a day over its month in a small tile; tones as the pill's, filled for a solid tile -->
      <ControlTheme x:Key="{x:Type ctl:DateBadge}" TargetType="ctl:DateBadge">
        <Setter Property="Background" Value="{DynamicResource InsToneMuteBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InsToneMuteBd}" />
        <Setter Property="Foreground" Value="{DynamicResource InsText1}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource InsRSm}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="MinWidth" Value="48" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
          <ControlTemplate>
            <ctl:TemplateBorder x:Name="PART_Face"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ctl:TemplateText x:Name="PART_Day" Text="{TemplateBinding DayText}" HorizontalAlignment="Center"
                           FlowDirection="LeftToRight" FontFamily="{DynamicResource InsFontBodyEn}" FontFeatures="+tnum"
                           FontSize="20" FontWeight="ExtraBold" LineHeight="24" />
                <ctl:TemplateText x:Name="PART_Month" Text="{TemplateBinding MonthText}" HorizontalAlignment="Center"
                           FontSize="11" FontWeight="Bold" LineHeight="15" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </ctl:TemplateBorder>
          </ControlTemplate>
        </Setter>
        <Style Selector="^.ok">
          <Setter Property="Background" Value="{DynamicResource InsToneOkBg}" />
          <Setter Property="BorderBrush" Value="{DynamicResource InsToneOkBd}" />
          <Setter Property="Foreground" Value="{DynamicResource InsToneOk}" />
        </Style>
        <Style Selector="^.warn">
          <Setter Property="Background" Value="{DynamicResource InsToneWarnBg}" />
          <Setter Property="BorderBrush" Value="{DynamicResource InsToneWarnBd}" />
          <Setter Property="Foreground" Value="{DynamicResource InsToneWarn}" />
        </Style>
        <Style Selector="^.bad">
          <Setter Property="Background" Value="{DynamicResource InsToneBadBg}" />
          <Setter Property="BorderBrush" Value="{DynamicResource InsToneBadBd}" />
          <Setter Property="Foreground" Value="{DynamicResource InsToneBad}" />
        </Style>
        <Style Selector="^.info">
          <Setter Property="Background" Value="{DynamicResource InsToneInfoBg}" />
          <Setter Property="BorderBrush" Value="{DynamicResource InsToneInfoBd}" />
          <Setter Property="Foreground" Value="{DynamicResource InsToneInfo}" />
        </Style>
        <Style Selector="^.brand">
          <Setter Property="Background" Value="{DynamicResource InsBrandTintBg}" />
          <Setter Property="BorderBrush" Value="{DynamicResource InsBrandTintBd}" />
          <Setter Property="Foreground" Value="{DynamicResource InsPillBrandInk}" />
        </Style>
        <Style Selector="^.filled">
          <Setter Property="Background" Value="{DynamicResource InsToneMute}" />
          <Setter Property="BorderBrush" Value="Transparent" />
          <Setter Property="Foreground" Value="{DynamicResource InsDateBadgeFilledInk}" />
        </Style>
        <Style Selector="^.filled.ok"><Setter Property="Background" Value="{DynamicResource InsToneOk}" /></Style>
        <Style Selector="^.filled.warn"><Setter Property="Background" Value="{DynamicResource InsToneWarn}" /></Style>
        <Style Selector="^.filled.bad"><Setter Property="Background" Value="{DynamicResource InsToneBad}" /></Style>
        <Style Selector="^.filled.info"><Setter Property="Background" Value="{DynamicResource InsToneInfo}" /></Style>
        <Style Selector="^.filled.brand">
          <Setter Property="Background" Value="{DynamicResource InsPrimaryMid}" />
          <Setter Property="Foreground" Value="{DynamicResource InsOnPrimaryMid}" />
        </Style>
        <Style Selector="^.sm">
          <Setter Property="MinWidth" Value="40" />
          <Setter Property="Padding" Value="6,3" />
          <Setter Property="CornerRadius" Value="{DynamicResource InsRXs}" />
          <Style Selector="^ /template/ :is(TextBlock)#PART_Day"><Setter Property="FontSize" Value="16" /><Setter Property="LineHeight" Value="19" /></Style>
          <Style Selector="^ /template/ :is(TextBlock)#PART_Month"><Setter Property="FontSize" Value="10" /><Setter Property="LineHeight" Value="13" /></Style>
        </Style>
        <Style Selector="^.lg">
          <Setter Property="MinWidth" Value="60" />
          <Setter Property="Padding" Value="10,7" />
          <Setter Property="CornerRadius" Value="{DynamicResource InsRMd}" />
          <Style Selector="^ /template/ :is(TextBlock)#PART_Day"><Setter Property="FontSize" Value="26" /><Setter Property="LineHeight" Value="30" /></Style>
          <Style Selector="^ /template/ :is(TextBlock)#PART_Month"><Setter Property="FontSize" Value="12" /><Setter Property="LineHeight" Value="16" /></Style>
        </Style>
      </ControlTheme>

      <!-- Money: the figure semibold in tabular Inter, the unit .68 of it in a quieter colour -->
      <ControlTheme x:Key="{x:Type ctl:Money}" TargetType="ctl:Money">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
          <ControlTemplate>
            <StackPanel Orientation="Horizontal">
              <ctl:TemplateText x:Name="PART_Value" Text="{TemplateBinding Value}" FlowDirection="LeftToRight"
                         FontFamily="{DynamicResource InsFontBodyEn}" FontWeight="SemiBold" FontFeatures="+tnum"
                         VerticalAlignment="Bottom" />
              <ctl:TemplateText x:Name="PART_Currency" Text="{TemplateBinding Currency}"
                         FontSize="{TemplateBinding CurrencyFontSize}" FontWeight="Medium"
                         Foreground="{DynamicResource InsText2}" VerticalAlignment="Bottom" />
            </StackPanel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ :is(TextBlock)#PART_Currency">
          <Setter Property="Margin" Value="4,0,0,1" />
        </Style>
        <Style Selector="^.pos /template/ :is(TextBlock)#PART_Value">
          <Setter Property="Foreground" Value="{DynamicResource InsToneOk}" />
        </Style>
        <Style Selector="^.neg /template/ :is(TextBlock)#PART_Value">
          <Setter Property="Foreground" Value="{DynamicResource InsToneBad}" />
        </Style>
      </ControlTheme>

      <!-- Empty state: a faded glyph, not a tinted chip -->
      <ControlTheme x:Key="{x:Type ctl:EmptyState}" TargetType="ctl:EmptyState">
        <Setter Property="Padding" Value="24,44" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
          <ControlTemplate>
            <StackPanel Margin="{TemplateBinding Padding}" Spacing="10" HorizontalAlignment="Center">
              <ctl:Icon x:Name="PART_Icon" Data="{TemplateBinding Icon}" Size="32" Opacity="0.35"
                        Foreground="{DynamicResource InsText3}" HorizontalAlignment="Center"
                        IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <ctl:TemplateText x:Name="PART_Title" Text="{TemplateBinding Title}" FontSize="15" FontWeight="Bold" LineHeight="25.5"
                         Foreground="{DynamicResource InsText1}" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"
                         IsVisible="{TemplateBinding Title, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <ctl:TemplateText x:Name="PART_Hint" Text="{TemplateBinding Hint}" FontSize="{DynamicResource InsFsSm}" LineHeight="22.1"
                         MaxWidth="240" Foreground="{DynamicResource InsText2}" TextAlignment="Center" TextWrapping="Wrap"
                         HorizontalAlignment="Center"
                         IsVisible="{TemplateBinding Hint, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Center"
                                IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Button.pill">
    <Setter Property="Theme" Value="{StaticResource InsPillButton}" />
  </Style>

  <Style Selector="ctl|Pill.ok, Button.pill.ok">
    <Setter Property="Background" Value="{DynamicResource InsToneOkBg}" />
    <Setter Property="Foreground" Value="{DynamicResource InsToneOk}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InsToneOkBd}" />
  </Style>
  <Style Selector="ctl|Pill.warn, Button.pill.warn">
    <Setter Property="Background" Value="{DynamicResource InsToneWarnBg}" />
    <Setter Property="Foreground" Value="{DynamicResource InsToneWarn}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InsToneWarnBd}" />
  </Style>
  <Style Selector="ctl|Pill.bad, Button.pill.bad">
    <Setter Property="Background" Value="{DynamicResource InsToneBadBg}" />
    <Setter Property="Foreground" Value="{DynamicResource InsToneBad}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InsToneBadBd}" />
  </Style>
  <Style Selector="ctl|Pill.info, Button.pill.info">
    <Setter Property="Background" Value="{DynamicResource InsToneInfoBg}" />
    <Setter Property="Foreground" Value="{DynamicResource InsToneInfo}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InsToneInfoBd}" />
  </Style>
  <Style Selector="ctl|Pill.brand, Button.pill.brand">
    <Setter Property="Background" Value="{DynamicResource InsToneBrandBg}" />
    <Setter Property="Foreground" Value="{DynamicResource InsPillBrandInk}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InsToneBrandBd}" />
  </Style>

  <Style Selector="ctl|Avatar.more TextBlock, ctl|Avatar.more ctl|TemplateText">
    <Setter Property="FlowDirection" Value="LeftToRight" />
  </Style>


</Styles>
