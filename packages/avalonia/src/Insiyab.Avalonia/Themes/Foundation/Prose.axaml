<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:Insiyab.Avalonia.Controls">

  <Styles.Resources>
    <ResourceDictionary>
      <!-- The text a pre block gives its own child: pinned to the left in either direction -->
      <ControlTheme x:Key="InsProsePreText" TargetType="TextBlock">
        <Style Selector="^[(ctl|ClassTheme.Relayed)=True]">
          <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
      </ControlTheme>

      <!-- The boxed chip for code outside running text -->
      <ControlTheme x:Key="InsLookProseCode" TargetType="Border" ctl:ClassTheme.For="code">
        <Style Selector="^.code">
          <Setter Property="FlowDirection" Value="LeftToRight" />
          <Setter Property="Padding" Value="5.25,1.75" />
          <Setter Property="CornerRadius" Value="5" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="BorderBrush" Value="{DynamicResource InsLine}" />
          <Setter Property="Background" Value="{DynamicResource InsCtlBg}" />
          <Setter Property="TextElement.FontFamily" Value="{DynamicResource InsFontMono}" />
          <Setter Property="TextElement.FontSize" Value="14" />
          <Setter Property="TextBlock.LineHeight" Value="NaN" />
        </Style>
      </ControlTheme>

      <!-- A code block starts at the left in either direction -->
      <ControlTheme x:Key="InsLookProsePre" TargetType="Border" ctl:ClassTheme.For="pre">
        <Style Selector="^.pre">
          <Setter Property="FlowDirection" Value="LeftToRight" />
          <Setter Property="Padding" Value="16.25,13" />
          <Setter Property="CornerRadius" Value="{DynamicResource InsRMd}" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="BorderBrush" Value="{DynamicResource InsCtlBd}" />
          <Setter Property="Background" Value="{DynamicResource InsCtlBg}" />
          <Setter Property="TextElement.FontFamily" Value="{DynamicResource InsFontMono}" />
          <Setter Property="TextElement.FontSize" Value="{DynamicResource InsFsSm}" />
          <Setter Property="TextBlock.LineHeight" Value="20.8" />
          <Setter Property="TextBlock.TextWrapping" Value="NoWrap" />
          <Setter Property="ctl:ClassTheme.ChildTheme" Value="{StaticResource InsProsePreText}" />
        </Style>
      </ControlTheme>

      <!-- The quote's bar is on the start edge and its rounding on the end edge, both mirroring with the page -->
      <ControlTheme x:Key="InsLookProseQuote" TargetType="Border" ctl:ClassTheme.For="blockquote">
        <Style Selector="^.blockquote">
          <Setter Property="Padding" Value="20,12" />
          <Setter Property="BorderThickness" Value="3,0,0,0" />
          <Setter Property="BorderBrush" Value="{DynamicResource InsPrimaryMid}" />
          <Setter Property="CornerRadius" Value="0,10,10,0" />
          <Setter Property="Background" Value="{DynamicResource InsToneBrandBg}" />
        </Style>
      </ControlTheme>

      <!-- The cells of a plain table in an article -->
      <ControlTheme x:Key="InsLookProseCell" TargetType="Border" ctl:ClassTheme.For="th td">
        <Style Selector="^.th, ^.td">
          <Setter Property="Padding" Value="10.5,7" />
          <Setter Property="BorderThickness" Value="0,0,0,1" />
          <Setter Property="BorderBrush" Value="{DynamicResource InsLine}" />
        </Style>
        <Style Selector="^.th">
          <Setter Property="BorderBrush" Value="{DynamicResource InsCtlBd}" />
          <Setter Property="TextElement.FontWeight" Value="Bold" />
          <Setter Property="TextElement.Foreground" Value="{DynamicResource InsLabel}" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="InsLookProseTerm" TargetType="TextBlock" ctl:ClassTheme.For="dt dd">
        <Style Selector="^.dt">
          <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="^.dd">
          <Setter Property="Foreground" Value="{DynamicResource InsLabel}" />
          <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- The labelled divider: the word between two hairlines, or after one with .start -->
  <Style Selector="ctl|Divider">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Margin" Value="0,16" />
    <Setter Property="FontSize" Value="{DynamicResource InsFsXs}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource InsLabel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InsHr}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12">
          <ctl:TemplateBorder Name="PART_Start" Grid.Column="0" Height="1" VerticalAlignment="Center" Background="{TemplateBinding BorderBrush}" />
          <ContentPresenter Name="PART_ContentPresenter" Grid.Column="1"
                            Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            VerticalAlignment="Center" />
          <ctl:TemplateBorder Name="PART_End" Grid.Column="2" Height="1" VerticalAlignment="Center" Background="{TemplateBinding BorderBrush}" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ctl|Divider.start">
    <Setter Property="Template">
      <ControlTemplate>
        <DockPanel>
          <ContentPresenter Name="PART_ContentPresenter" DockPanel.Dock="Left" Margin="0,0,12,0"
                            Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            VerticalAlignment="Center" />
          <ctl:TemplateBorder Name="PART_End" Height="1" VerticalAlignment="Center" Background="{TemplateBinding BorderBrush}" />
        </DockPanel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ctl|Divider:empty">
    <Setter Property="Template">
      <ControlTemplate>
        <ctl:TemplateBorder Name="PART_End" Height="1" VerticalAlignment="Center" Background="{TemplateBinding BorderBrush}" />
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- Long-form text: Prose stacks the blocks, these set each one as .ins-prose does -->
  <Style Selector="ctl|Prose">
    <Setter Property="FontSize" Value="{DynamicResource InsFsLg}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource InsText1}" />
  </Style>
  <Style Selector="ctl|Prose TextBlock, ctl|Prose ctl|TemplateText">
    <Setter Property="LineHeight" Value="28.8" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="ctl|Prose[FlowDirection=LeftToRight] TextBlock, ctl|Prose[FlowDirection=LeftToRight] ctl|TemplateText">
    <Setter Property="LineHeight" Value="26.4" />
  </Style>
  <!-- Prose spaces a rule itself, 2em each side -->
  <Style Selector="ctl|Prose > Separator">
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="ctl|Prose TextBlock.h1">
    <Setter Property="LineHeight" Value="36.4" />
  </Style>
  <Style Selector="ctl|Prose TextBlock.h2">
    <Setter Property="LineHeight" Value="28.6" />
  </Style>
  <Style Selector="ctl|Prose TextBlock.h3">
    <Setter Property="LineHeight" Value="23.4" />
  </Style>
  <Style Selector="ctl|Prose TextBlock.h4">
    <Setter Property="LineHeight" Value="20.8" />
  </Style>

  <!-- Emphasis is colour, never a slant; a link is underlined clear of the Arabic dots -->
  <Style Selector="Run.em, Span.em">
    <Setter Property="Foreground" Value="{DynamicResource InsToneBrand}" />
  </Style>
  <Style Selector="Run.strong, Span.strong">
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Run.mark, Span.mark">
    <Setter Property="Background" Value="{DynamicResource InsToneBrandBg}" />
  </Style>
  <Style Selector="Run.a, Span.a">
    <Setter Property="Foreground" Value="{DynamicResource InsPrimaryDarker}" />
    <Setter Property="TextDecorations">
      <TextDecorationCollection>
        <TextDecoration Location="Underline" StrokeThickness="1" StrokeThicknessUnit="Pixel"
                        StrokeOffset="4.8" StrokeOffsetUnit="Pixel" Stroke="{DynamicResource InsToneBrandBd}" />
      </TextDecorationCollection>
    </Setter>
  </Style>

  <!-- Code in a sentence: a Run keeps the sentence's bidi order (wrap its text in U+2066 and U+2069 to isolate it); Border.code is the boxed chip for use outside running text -->
  <Style Selector="Run.code, Span.code">
    <Setter Property="FontFamily" Value="{DynamicResource InsFontMono}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Background" Value="{DynamicResource InsCtlBg}" />
  </Style>
  <!-- Inside prose the generic text rules outrank a block's inherited values, so the block's text rules are repeated under it -->
  <Style Selector="ctl|Prose Border.code > TextBlock, ctl|Prose Border.code > ctl|TemplateText">
    <Setter Property="LineHeight" Value="NaN" />
  </Style>
  <Style Selector="ctl|Prose Border.pre TextBlock, ctl|Prose Border.pre ctl|TemplateText">
    <Setter Property="LineHeight" Value="20.8" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <Style Selector="ctl|ProseList">
    <Setter Property="MarkerBrush" Value="{DynamicResource InsToneBrandSoft}" />
  </Style>
  <Style Selector="ctl|ProseList ctl|ProseList">
    <Setter Property="Margin" Value="0,6,0,0" />
  </Style>

  <!-- A plain table in an article: rules and alignment, no glass -->
  <Style Selector="Grid.table">
    <Setter Property="TextElement.FontSize" Value="{DynamicResource InsFsMd}" />
  </Style>
  <Style Selector="Grid.table TextBlock, Grid.table ctl|TemplateText">
    <Setter Property="LineHeight" Value="25.2" />
  </Style>
  <Style Selector="ctl|Prose[FlowDirection=LeftToRight] Grid.table TextBlock, ctl|Prose[FlowDirection=LeftToRight] Grid.table ctl|TemplateText">
    <Setter Property="LineHeight" Value="23.1" />
  </Style>

</Styles>
