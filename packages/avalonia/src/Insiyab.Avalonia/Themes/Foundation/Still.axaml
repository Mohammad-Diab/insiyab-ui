<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ins="using:Insiyab.Avalonia.Controls">

  <!-- The web's effects-off hovers and presses: the movement goes, the colour change stays, so what is under the pointer still shows -->
  <Style Selector=":is(TopLevel):ins-still :is(Button):pointerover, :is(TopLevel):ins-still :is(Button):pressed">
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <Style Selector=":is(TopLevel):ins-still :is(Button):pressed /template/ Panel#PART_Root, :is(TopLevel):ins-still :is(Button).lift:pointerover /template/ Panel#PART_Root">
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <Style Selector=":is(TopLevel):ins-still :is(Button).icon:pointerover /template/ ContentPresenter#PART_ContentPresenter, :is(TopLevel):ins-still :is(Button):pointerover /template/ Ellipse#PART_Dot">
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <Style Selector=":is(TopLevel):ins-still ListBoxItem:pointerover, :is(TopLevel):ins-still ListBoxItem:selected, :is(TopLevel):ins-still MenuItem:selected, :is(TopLevel):ins-still ComboBoxItem:pointerover, :is(TopLevel):ins-still ComboBoxItem:focus-visible, :is(TopLevel):ins-still :is(Button).pop-item:focus-visible, :is(TopLevel):ins-still ins|PaletteBorder.palette-item.active">
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <Style Selector=":is(TopLevel):ins-still ListBox.shell-nav ListBoxItem:pointerover ins|Icon, :is(TopLevel):ins-still ListBox.nav ListBoxItem:pointerover ins|Icon, :is(TopLevel):ins-still Button.shell-link:pointerover ins|Icon">
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <Style Selector=":is(TopLevel):ins-still :is(Button):pointerover ins|Icon.toolbar-icon, :is(TopLevel):ins-still :is(Button):pressed ins|Icon.toolbar-icon">
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <Style Selector=":is(TopLevel):ins-still TextBox:focus-within /template/ Panel#PART_Field, :is(TopLevel):ins-still ComboBox:focus-within /template/ Panel#PART_Field, :is(TopLevel):ins-still ComboBox:dropdownopen /template/ Panel#PART_Field, :is(TopLevel):ins-still NumericUpDown:focus-within /template/ Panel#PART_Field, :is(TopLevel):ins-still ins|DateTimeGroup:focus-within">
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <Style Selector=":is(TopLevel):ins-still Slider:pointerover /template/ Thumb, :is(TopLevel):ins-still Slider /template/ Thumb:pressed">
    <Setter Property="RenderTransform" Value="none" />
  </Style>

  <!-- The system's reduced motion is one switch with the app's here, so the day/night sky changes at once -->
  <Style Selector=":is(TopLevel):ins-still ins|DayNight /template/ :is(Control)">
    <Setter Property="Transitions" Value="{x:Null}" />
  </Style>

  <!-- A progress icon shrinks and shows its ring at once -->
  <Style Selector=":is(TopLevel):ins-still ins|ProgressIcon /template/ :is(Control)">
    <Setter Property="Transitions" Value="{x:Null}" />
  </Style>

  <!-- A busy button with no icon swaps its content for the spinner at once -->
  <Style Selector=":is(TopLevel):ins-still :is(Button) /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions" Value="{x:Null}" />
  </Style>

  <!-- A split button's keyboard press, and the tabs a dragged document tab passes, move at once -->
  <Style Selector=":is(TopLevel):ins-still SplitButton:pressed /template/ Panel#PART_Root">
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <Style Selector=":is(TopLevel):ins-still ins|DocumentTab /template/ Panel#PART_Slide">
    <Setter Property="Transitions" Value="{x:Null}" />
  </Style>

  <!-- The sidebar opens, closes and collapses at once, as does the drawer with its scrim -->
  <Style Selector=":is(TopLevel):ins-still SplitView /template/ Panel#PART_PaneRoot, :is(TopLevel):ins-still SplitView /template/ :is(Border)#PART_PaneChrome, :is(TopLevel):ins-still SplitView /template/ Rectangle#LightDismissLayer">
    <Setter Property="Transitions" Value="{x:Null}" />
  </Style>

  <!-- A tooltip shows where it lands, without rising in -->
  <Style Selector=":is(TopLevel):ins-still ToolTip">
    <Setter Property="Transitions" Value="{x:Null}" />
    <Setter Property="RenderTransform" Value="none" />
  </Style>

  <!-- A switch's thumb lands on its side at once; the track's colour still eases -->
  <Style Selector=":is(TopLevel):ins-still ToggleSwitch">
    <Setter Property="KnobTransitions" Value="{x:Null}" />
  </Style>

  <!-- A tick, a radio dot, a tile's mark and a menu item's check mark appear at their size, without the overshoot -->
  <Style Selector=":is(TopLevel):ins-still CheckBox /template/ Path#CheckGlyph, :is(TopLevel):ins-still RadioButton /template/ Ellipse#CheckGlyph, :is(TopLevel):ins-still :is(ToggleButton).tile /template/ Panel#TileMark, :is(TopLevel):ins-still MenuItem /template/ Viewbox#PART_Mark">
    <Setter Property="Transitions" Value="{x:Null}" />
  </Style>

  <!-- The palette's search icon takes its focus colour without growing -->
  <Style Selector=":is(TopLevel):ins-still TextBox:focus /template/ ins|Icon#PART_SearchIcon">
    <Setter Property="RenderTransform" Value="none" />
  </Style>

  <!-- The soft shadows set in templates rather than tokens drop too: toned buttons, TOC links, a field's halo, the knobs and the day/night orb -->
  <Style Selector=":is(TopLevel):ins-still :is(Button) /template/ :is(Border)#PART_Shadow, :is(TopLevel):ins-still SplitButton /template/ :is(Border)#PART_Shadow, :is(TopLevel):ins-still ins|TocLink /template/ :is(Border)#PART_Shadow">
    <Setter Property="BoxShadow" Value="none" />
  </Style>
  <Style Selector=":is(TopLevel):ins-still :is(TemplatedControl) /template/ :is(Border)#PART_Halo">
    <Setter Property="BoxShadow" Value="none" />
  </Style>
  <Style Selector=":is(TopLevel):ins-still Slider /template/ Thumb /template/ :is(Border)#PART_Face, :is(TopLevel):ins-still ToggleSwitch /template/ :is(Border)#SwitchKnob, :is(TopLevel):ins-still ins|DayNight /template/ :is(Border)#PART_OrbFace">
    <Setter Property="BoxShadow" Value="none" />
  </Style>

</Styles>
