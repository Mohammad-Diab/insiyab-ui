<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ins="using:Insiyab.Avalonia.Controls">

  <Styles.Resources>
    <ResourceDictionary>

      <LinearGradientBrush x:Key="InsButtonPrimaryFill" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="{DynamicResource InsPrimaryColor}" />
        <GradientStop Offset="1" Color="{DynamicResource InsPrimaryDarkColor}" />
      </LinearGradientBrush>
      <SolidColorBrush x:Key="InsButtonGhostBorder" Color="{DynamicResource InsPrimaryColor}" Opacity="0.45" />
      <SolidColorBrush x:Key="InsButtonGhostHover" Color="{DynamicResource InsPrimaryColor}" Opacity="0.12" />
      <SolidColorBrush x:Key="InsButtonGhostPressed" Color="{DynamicResource InsPrimaryColor}" Opacity="0.22" />
      <SolidColorBrush x:Key="InsButtonToggleOn" Color="{DynamicResource InsPrimaryColor}" Opacity="0.14" />
      <SolidColorBrush x:Key="InsButtonToggleOnBorder" Color="{DynamicResource InsPrimaryColor}" Opacity="0.40" />
      <BoxShadows x:Key="InsButtonToggleOnShadow">inset 0 1 3 0 #1F0F172A</BoxShadows>

      <LinearGradientBrush x:Key="InsButtonSuccessFill" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#22C55E" />
        <GradientStop Offset="1" Color="#15803D" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="InsButtonDangerFill" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#EF4444" />
        <GradientStop Offset="1" Color="#B91C1C" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="InsButtonWarningFill" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#F59E0B" />
        <GradientStop Offset="1" Color="#B45309" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="InsButtonInfoFill" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#3B82F6" />
        <GradientStop Offset="1" Color="#1D4ED8" />
      </LinearGradientBrush>

      <!-- The sweep: the shimmer and shimmer-dark tokens, parked off the trailing edge (Rest) or past the leading one (Hover). -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <LinearGradientBrush x:Key="InsButtonSweepRest" StartPoint="110%,50%" EndPoint="210%,50%">
            <GradientStop Offset="0" Color="#00FFFFFF" />
            <GradientStop Offset="0.5" Color="#4DFFFFFF" />
            <GradientStop Offset="1" Color="#00FFFFFF" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="InsButtonSweepHover" StartPoint="-110%,50%" EndPoint="-10%,50%">
            <GradientStop Offset="0" Color="#00FFFFFF" />
            <GradientStop Offset="0.5" Color="#4DFFFFFF" />
            <GradientStop Offset="1" Color="#00FFFFFF" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="InsButtonSweepDarkRest" StartPoint="110%,50%" EndPoint="210%,50%">
            <GradientStop Offset="0" Color="#000F172A" />
            <GradientStop Offset="0.5" Color="#120F172A" />
            <GradientStop Offset="1" Color="#000F172A" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="InsButtonSweepDarkHover" StartPoint="-110%,50%" EndPoint="-10%,50%">
            <GradientStop Offset="0" Color="#000F172A" />
            <GradientStop Offset="0.5" Color="#120F172A" />
            <GradientStop Offset="1" Color="#000F172A" />
          </LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <LinearGradientBrush x:Key="InsButtonSweepRest" StartPoint="110%,50%" EndPoint="210%,50%">
            <GradientStop Offset="0" Color="#00FFFFFF" />
            <GradientStop Offset="0.5" Color="#24FFFFFF" />
            <GradientStop Offset="1" Color="#00FFFFFF" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="InsButtonSweepHover" StartPoint="-110%,50%" EndPoint="-10%,50%">
            <GradientStop Offset="0" Color="#00FFFFFF" />
            <GradientStop Offset="0.5" Color="#24FFFFFF" />
            <GradientStop Offset="1" Color="#00FFFFFF" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="InsButtonSweepDarkRest" StartPoint="110%,50%" EndPoint="210%,50%">
            <GradientStop Offset="0" Color="#00FFFFFF" />
            <GradientStop Offset="0.5" Color="#17FFFFFF" />
            <GradientStop Offset="1" Color="#00FFFFFF" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="InsButtonSweepDarkHover" StartPoint="-110%,50%" EndPoint="-10%,50%">
            <GradientStop Offset="0" Color="#00FFFFFF" />
            <GradientStop Offset="0.5" Color="#17FFFFFF" />
            <GradientStop Offset="1" Color="#00FFFFFF" />
          </LinearGradientBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource InsText1}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource InsRMd}" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="MinHeight" Value="{DynamicResource InsCtlH}" />
        <Setter Property="FontSize" Value="{DynamicResource InsFsMd}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
          <Transitions>
            <BrushTransition Property="Foreground" Duration="0:0:0.18" Easing="0.22,1,0.36,1" />
            <BrushTransition Property="Background" Duration="0:0:0.18" Easing="0.22,1,0.36,1" />
            <BrushTransition Property="BorderBrush" Duration="0:0:0.18" Easing="0.22,1,0.36,1" />
          </Transitions>
        </Setter>

        <Setter Property="Template">
          <ControlTemplate>
            <!-- The press, lift and turn move PART_Root, not the button (a transform set in the template survives styles that animate every panel child); PART_Press carries only the quick-click dip, so the two add up. -->
            <Panel x:Name="PART_Press">
              <Panel x:Name="PART_Root" RenderTransformOrigin="50%,50%" RenderTransform="none">
                <Border x:Name="PART_Shadow" CornerRadius="{TemplateBinding CornerRadius}" />
                <Border x:Name="PART_FocusRing"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        BoxShadow="{DynamicResource InsFocusRing}"
                        Opacity="0" />
                <Border x:Name="PART_Outline"
                        Margin="-4"
                        BorderThickness="2"
                        BorderBrush="{DynamicResource InsToneBrandSoft}"
                        CornerRadius="14"
                        IsVisible="False" />
                <Border x:Name="PART_Face" CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
                  <Panel>
                    <!-- Gradients are physical on the web, so only the fill stays LTR; the corners, the sweep and the content follow the button. -->
                    <Border x:Name="PART_Fill" FlowDirection="LeftToRight" Background="{TemplateBinding Background}" />
                    <Border x:Name="PART_Sweep" IsHitTestVisible="False" Background="{DynamicResource InsButtonSweepRest}" />
                    <Panel x:Name="PART_CrossHost" IsVisible="False" IsHitTestVisible="False">
                      <Grid x:Name="PART_Cross"
                            ColumnDefinitions="28*,44*,28*"
                            IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNull}}">
                        <Border Grid.Column="1" Height="2" CornerRadius="2" Background="{TemplateBinding Foreground}" RenderTransform="rotate(45deg)" />
                        <Border Grid.Column="1" Height="2" CornerRadius="2" Background="{TemplateBinding Foreground}" RenderTransform="rotate(-45deg)" />
                      </Grid>
                    </Panel>
                    <ContentPresenter x:Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      RecognizesAccessKey="True"
                                      RenderTransform="none"
                                      LineHeight="18.9"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                  </Panel>
                </Border>
                <Border x:Name="PART_Border"
                        IsHitTestVisible="False"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}" />
              </Panel>
            </Panel>
          </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ Panel#PART_Press">
          <Setter Property="ins:PressDip.Depth" Value="0.97" />
        </Style>
        <Style Selector="^.bare /template/ Panel#PART_Press, ^.close /template/ Panel#PART_Press">
          <Setter Property="ins:PressDip.Depth" Value="0" />
        </Style>
        <Style Selector="^ /template/ Panel#PART_Root">
          <Setter Property="Transitions">
            <Transitions>
              <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="0.22,1,0.36,1" />
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Transitions">
            <Transitions>
              <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="0.34,1.56,0.64,1" />
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="^.icon:pointerover:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="RenderTransform" Value="scale(1.15)" />
        </Style>
        <Style Selector="^ /template/ Border#PART_Shadow">
          <Setter Property="Transitions">
            <Transitions>
              <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.25" Easing="0.22,1,0.36,1" />
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="^ /template/ Border#PART_FocusRing">
          <Setter Property="Transitions">
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="0.22,1,0.36,1" />
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="^ /template/ Border#PART_Sweep">
          <Setter Property="Transitions">
            <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.6" Easing="0.22,1,0.36,1" />
            </Transitions>
          </Setter>
        </Style>

        <Style Selector="^:pointerover /template/ Border#PART_Sweep">
          <Setter Property="Background" Value="{DynamicResource InsButtonSweepHover}" />
        </Style>

        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
          <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="^:pressed">
          <Style Selector="^ /template/ Panel#PART_Root">
            <Setter Property="RenderTransform" Value="scale(0.97)" />
          </Style>
        </Style>

        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.5" />
          <Setter Property="Cursor" Value="No" />
          <Style Selector="^ /template/ Border#PART_Sweep">
            <Setter Property="IsVisible" Value="False" />
          </Style>
        </Style>

        <Style Selector="^.sm">
          <Setter Property="MinHeight" Value="{DynamicResource InsCtlSmH}" />
          <Setter Property="Padding" Value="10,4" />
          <Setter Property="FontSize" Value="{DynamicResource InsFsSm}" />
          <Setter Property="CornerRadius" Value="{DynamicResource InsRSm}" />
          <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="LineHeight" Value="17.55" />
          </Style>
        </Style>
        <Style Selector="^.lg">
          <Setter Property="MinHeight" Value="48" />
          <Setter Property="Padding" Value="24,10" />
          <Setter Property="FontSize" Value="{DynamicResource InsFsLg}" />
          <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="LineHeight" Value="21.6" />
          </Style>
        </Style>
        <Style Selector="^.icon">
          <Setter Property="Width" Value="{DynamicResource InsCtlH}" />
          <Setter Property="Padding" Value="0,6" />
        </Style>
        <Style Selector="^.icon.sm">
          <Setter Property="Width" Value="{DynamicResource InsCtlSmH}" />
          <Setter Property="Padding" Value="0,4" />
        </Style>
        <Style Selector="^.full">
          <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="^.lift:pointerover:not(:disabled), ^.lift:pressed">
          <Style Selector="^ /template/ Panel#PART_Root">
            <Setter Property="RenderTransform" Value="translateY(-2px)" />
          </Style>
        </Style>

        <Style Selector="^.primary">
          <Setter Property="Background" Value="{DynamicResource InsButtonPrimaryFill}" />
          <Setter Property="Foreground" Value="{DynamicResource InsOnPrimary}" />
          <Style Selector="^ /template/ Border#PART_Shadow">
            <Setter Property="BoxShadow" Value="{DynamicResource InsShBrandMd}" />
          </Style>
          <Style Selector="^ /template/ Border#PART_Fill">
            <Setter Property="BoxShadow" Value="{DynamicResource InsBevelDim}" />
          </Style>
          <Style Selector="^:pointerover:not(:disabled) /template/ Border#PART_Shadow, ^:focus-visible /template/ Border#PART_Shadow">
            <Setter Property="BoxShadow" Value="{DynamicResource InsShBrandLg}" />
          </Style>
        </Style>

        <!-- filled tones: the ink never changes, only the face -->
        <Style Selector="^.success, ^.danger, ^.warning, ^.info">
          <Setter Property="Foreground" Value="#FFFFFF" />
          <Style Selector="^ /template/ Border#PART_Fill">
            <Setter Property="BoxShadow" Value="{DynamicResource InsBevelDim}" />
          </Style>
        </Style>
        <Style Selector="^.success">
          <Setter Property="Background" Value="{DynamicResource InsButtonSuccessFill}" />
          <Style Selector="^ /template/ Border#PART_Shadow">
            <Setter Property="BoxShadow" Value="0 8 24 0 #4722C55E" />
          </Style>
        </Style>
        <Style Selector="^.danger">
          <Setter Property="Background" Value="{DynamicResource InsButtonDangerFill}" />
          <Style Selector="^ /template/ Border#PART_Shadow">
            <Setter Property="BoxShadow" Value="0 8 24 0 #42EF4444" />
          </Style>
        </Style>
        <Style Selector="^.warning">
          <Setter Property="Background" Value="{DynamicResource InsButtonWarningFill}" />
          <Style Selector="^ /template/ Border#PART_Shadow">
            <Setter Property="BoxShadow" Value="0 8 24 0 #42F59E0B" />
          </Style>
        </Style>
        <Style Selector="^.info">
          <Setter Property="Background" Value="{DynamicResource InsButtonInfoFill}" />
          <Style Selector="^ /template/ Border#PART_Shadow">
            <Setter Property="BoxShadow" Value="0 8 24 0 #423B82F6" />
          </Style>
        </Style>

        <!-- the neutral and ghost sets share the control fill, the subtle drop and the dark sweep; a button with no variant class looks like secondary -->
        <Style Selector="^.secondary, ^.ghost, ^.ghost-danger, ^.ghost-success, ^.ghost-warning, ^.ghost-info, ^:not(.primary):not(.success):not(.danger):not(.warning):not(.info):not(.ghost):not(.ghost-danger):not(.ghost-success):not(.ghost-warning):not(.ghost-info):not(.bare):not(.close)">
          <Setter Property="Background" Value="{DynamicResource InsCtlBg}" />
          <Style Selector="^ /template/ Border#PART_Shadow">
            <Setter Property="BoxShadow" Value="{DynamicResource InsShSubtle}" />
          </Style>
          <Style Selector="^ /template/ Border#PART_Fill">
            <Setter Property="BoxShadow" Value="{DynamicResource InsBevelDim}" />
          </Style>
          <Style Selector="^ /template/ Border#PART_Sweep">
            <Setter Property="Background" Value="{DynamicResource InsButtonSweepDarkRest}" />
          </Style>
          <Style Selector="^:pointerover /template/ Border#PART_Sweep">
            <Setter Property="Background" Value="{DynamicResource InsButtonSweepDarkHover}" />
          </Style>
        </Style>

        <Style Selector="^.secondary, ^:not(.primary):not(.success):not(.danger):not(.warning):not(.info):not(.ghost):not(.ghost-danger):not(.ghost-success):not(.ghost-warning):not(.ghost-info):not(.bare):not(.close)">
          <Setter Property="BorderBrush" Value="{DynamicResource InsCtlBd}" />
          <Style Selector="^:pointerover:not(:disabled), ^:focus-visible">
            <Setter Property="Background" Value="{DynamicResource InsCtlBgHover}" />
          </Style>
          <Style Selector="^:pressed">
            <Setter Property="Background" Value="{DynamicResource InsCtlBd}" />
          </Style>
        </Style>

        <Style Selector="^.ghost">
          <Setter Property="BorderBrush" Value="{DynamicResource InsButtonGhostBorder}" />
          <Setter Property="Foreground" Value="{DynamicResource InsPrimaryDarker}" />
          <Style Selector="^:pointerover:not(:disabled), ^:focus-visible">
            <Setter Property="Background" Value="{DynamicResource InsButtonGhostHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InsToneBrandSoft}" />
          </Style>
          <Style Selector="^:pressed">
            <Setter Property="Background" Value="{DynamicResource InsButtonGhostPressed}" />
          </Style>
        </Style>

        <Style Selector="^.ghost-danger">
          <Setter Property="BorderBrush" Value="{DynamicResource InsToneBadBd}" />
          <Setter Property="Foreground" Value="{DynamicResource InsToneBad}" />
          <Style Selector="^:pointerover:not(:disabled), ^:focus-visible">
            <Setter Property="Background" Value="{DynamicResource InsToneBadBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InsToneBad}" />
          </Style>
          <Style Selector="^:pressed">
            <Setter Property="Background" Value="{DynamicResource InsToneBadBd}" />
          </Style>
        </Style>
        <Style Selector="^.ghost-success">
          <Setter Property="BorderBrush" Value="{DynamicResource InsToneOkBd}" />
          <Setter Property="Foreground" Value="{DynamicResource InsToneOk}" />
          <Style Selector="^:pointerover:not(:disabled), ^:focus-visible">
            <Setter Property="Background" Value="{DynamicResource InsToneOkBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InsToneOk}" />
          </Style>
          <Style Selector="^:pressed">
            <Setter Property="Background" Value="{DynamicResource InsToneOkBd}" />
          </Style>
        </Style>
        <Style Selector="^.ghost-warning">
          <Setter Property="BorderBrush" Value="{DynamicResource InsToneWarnBd}" />
          <Setter Property="Foreground" Value="{DynamicResource InsToneWarn}" />
          <Style Selector="^:pointerover:not(:disabled), ^:focus-visible">
            <Setter Property="Background" Value="{DynamicResource InsToneWarnBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InsToneWarn}" />
          </Style>
          <Style Selector="^:pressed">
            <Setter Property="Background" Value="{DynamicResource InsToneWarnBd}" />
          </Style>
        </Style>
        <Style Selector="^.ghost-info">
          <Setter Property="BorderBrush" Value="{DynamicResource InsToneInfoBd}" />
          <Setter Property="Foreground" Value="{DynamicResource InsToneInfo}" />
          <Style Selector="^:pointerover:not(:disabled), ^:focus-visible">
            <Setter Property="Background" Value="{DynamicResource InsToneInfoBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InsToneInfo}" />
          </Style>
          <Style Selector="^:pressed">
            <Setter Property="Background" Value="{DynamicResource InsToneInfoBd}" />
          </Style>
        </Style>

        <!-- bare: an action that is a word, with no face in any state -->
        <Style Selector="^.bare">
          <Setter Property="Foreground" Value="{DynamicResource InsText2}" />
          <Setter Property="FontWeight" Value="Bold" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="MinHeight" Value="0" />
          <Style Selector="^ /template/ Border#PART_Sweep">
            <Setter Property="IsVisible" Value="False" />
          </Style>
          <Style Selector="^:pointerover:not(:disabled), ^:focus-visible">
            <Setter Property="Foreground" Value="{DynamicResource InsText1}" />
          </Style>
          <Style Selector="^:pressed">
            <Style Selector="^ /template/ Panel#PART_Root">
              <Setter Property="RenderTransform" Value="none" />
            </Style>
          </Style>
        </Style>

        <!-- close: draws its own cross, and turns under the pointer -->
        <Style Selector="^.close">
          <Setter Property="Width" Value="{DynamicResource InsCtlSmH}" />
          <Setter Property="Height" Value="{DynamicResource InsCtlSmH}" />
          <Setter Property="MinHeight" Value="0" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="CornerRadius" Value="{DynamicResource InsRSm}" />
          <Setter Property="Background" Value="{DynamicResource InsCtlBg}" />
          <Setter Property="Foreground" Value="{DynamicResource InsText2}" />
          <Setter Property="Transitions">
            <Transitions>
              <BrushTransition Property="Foreground" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
              <BrushTransition Property="Background" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
              <DoubleTransition Property="Opacity" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
            </Transitions>
          </Setter>
          <Style Selector="^ /template/ Panel#PART_CrossHost">
            <Setter Property="IsVisible" Value="True" />
          </Style>
          <Style Selector="^ /template/ Panel#PART_Root">
            <Setter Property="Transitions">
              <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="0.34,1.56,0.64,1" />
              </Transitions>
            </Setter>
          </Style>
          <Style Selector="^ /template/ Border#PART_Sweep">
            <Setter Property="IsVisible" Value="False" />
          </Style>
          <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="Opacity" Value="0" />
          </Style>
          <Style Selector="^:focus-visible /template/ Border#PART_Outline">
            <Setter Property="IsVisible" Value="True" />
          </Style>
          <Style Selector="^:pressed">
            <Style Selector="^ /template/ Panel#PART_Root">
              <Setter Property="RenderTransform" Value="none" />
            </Style>
          </Style>
          <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource InsCtlBgHover}" />
            <Setter Property="Foreground" Value="{DynamicResource InsText1}" />
            <Style Selector="^ /template/ Panel#PART_Root">
              <Setter Property="RenderTransform" Value="rotate(90deg)" />
            </Style>
          </Style>
        </Style>
        <Style Selector="^.close.sm">
          <Setter Property="Width" Value="24" />
          <Setter Property="Height" Value="24" />
        </Style>
        <Style Selector="^.close.bare">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="Foreground" Value="{Binding $parent[Control].(TextElement.Foreground)}" />
          <Setter Property="Opacity" Value="0.6" />
          <Style Selector="^:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding $parent[Control].(TextElement.Foreground)}" />
            <Setter Property="Opacity" Value="1" />
          </Style>
        </Style>

        <!-- in a button group the face under the pointer or the focus is drawn over its neighbours -->
        <Style Selector="^:pointerover, ^:focus-within">
          <Setter Property="ZIndex" Value="2" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type RepeatButton}" TargetType="RepeatButton" BasedOn="{StaticResource {x:Type Button}}" />

      <!-- Off, any toggle is the neutral grey button; on, it takes its own style's colour (the brand for secondary, plain and bare). -->
      <ControlTheme x:Key="{x:Type ToggleButton}" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type Button}}">
        <Style Selector="^:not(:checked):not(.bare):not(.close)">
          <Setter Property="Background" Value="{DynamicResource InsCtlBg}" />
          <Setter Property="BorderBrush" Value="{DynamicResource InsCtlBd}" />
          <Setter Property="Foreground" Value="{DynamicResource InsText1}" />
          <Style Selector="^ /template/ Border#PART_Shadow">
            <Setter Property="BoxShadow" Value="{DynamicResource InsShSubtle}" />
          </Style>
          <Style Selector="^ /template/ Border#PART_Fill">
            <Setter Property="BoxShadow" Value="{DynamicResource InsBevelDim}" />
          </Style>
          <Style Selector="^ /template/ Border#PART_Sweep">
            <Setter Property="Background" Value="{DynamicResource InsButtonSweepDarkRest}" />
          </Style>
          <Style Selector="^:pointerover /template/ Border#PART_Sweep">
            <Setter Property="Background" Value="{DynamicResource InsButtonSweepDarkHover}" />
          </Style>
          <Style Selector="^:pointerover:not(:disabled), ^:focus-visible">
            <Setter Property="Background" Value="{DynamicResource InsCtlBgHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InsCtlBd}" />
          </Style>
          <Style Selector="^:pressed">
            <Setter Property="Background" Value="{DynamicResource InsCtlBd}" />
          </Style>
        </Style>
        <Style Selector="^:checked.bare">
          <Setter Property="Foreground" Value="{DynamicResource InsPrimaryDarker}" />
        </Style>
        <Style Selector="^:checked:not(.primary):not(.success):not(.danger):not(.warning):not(.info):not(.ghost):not(.ghost-danger):not(.ghost-success):not(.ghost-warning):not(.ghost-info):not(.bare):not(.close)">
          <Setter Property="Background" Value="{DynamicResource InsButtonToggleOn}" />
          <Setter Property="BorderBrush" Value="{DynamicResource InsButtonToggleOnBorder}" />
          <Setter Property="Foreground" Value="{DynamicResource InsPrimaryDarker}" />
          <Style Selector="^ /template/ Border#PART_Shadow">
            <Setter Property="BoxShadow" Value="none" />
          </Style>
          <Style Selector="^ /template/ Border#PART_Fill">
            <Setter Property="BoxShadow" Value="{StaticResource InsButtonToggleOnShadow}" />
          </Style>
        </Style>
      </ControlTheme>

      <!-- A link in the shape of a button: <HyperlinkButton Theme="{StaticResource InsLinkButton}" Classes="primary" NavigateUri="…"> -->
      <ControlTheme x:Key="InsLinkButton" TargetType="HyperlinkButton" BasedOn="{StaticResource {x:Type Button}}" />

      <StreamGeometry x:Key="InsDropChevron">M6 9 l6 6 6-6</StreamGeometry>

      <!-- DropDownButton: the button with a chevron at its trailing end, which turns over while its menu is open. -->
      <ControlTheme x:Key="{x:Type DropDownButton}" TargetType="DropDownButton" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Template">
          <ControlTemplate>
            <Panel x:Name="PART_Press">
              <Panel x:Name="PART_Root" RenderTransformOrigin="50%,50%" RenderTransform="none">
                <Border x:Name="PART_Shadow" CornerRadius="{TemplateBinding CornerRadius}" />
                <Border x:Name="PART_FocusRing"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        BoxShadow="{DynamicResource InsFocusRing}"
                        Opacity="0" />
                <Border x:Name="PART_Face" CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
                  <Panel>
                    <Border x:Name="PART_Fill" FlowDirection="LeftToRight" Background="{TemplateBinding Background}" />
                    <Border x:Name="PART_Sweep" IsHitTestVisible="False" Background="{DynamicResource InsButtonSweepRest}" />
                    <DockPanel Margin="{TemplateBinding Padding}">
                      <Viewbox x:Name="PART_Chevron" DockPanel.Dock="Right" VerticalAlignment="Center" RenderTransform="none">
                        <Viewbox.Transitions>
                          <Transitions>
                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
                          </Transitions>
                        </Viewbox.Transitions>
                        <Path Width="24" Height="24"
                              Data="{StaticResource InsDropChevron}"
                              Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="2.4"
                              StrokeLineCap="Round"
                              StrokeJoin="Round" />
                      </Viewbox>
                      <ContentPresenter x:Name="PART_ContentPresenter"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        RecognizesAccessKey="True"
                                        RenderTransform="none"
                                        LineHeight="18.9"
                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </DockPanel>
                  </Panel>
                </Border>
                <Border x:Name="PART_Border"
                        IsHitTestVisible="False"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}" />
              </Panel>
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ Viewbox#PART_Chevron">
          <Setter Property="Width" Value="12" />
          <Setter Property="Height" Value="12" />
          <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style Selector="^:flyout-open /template/ Viewbox#PART_Chevron">
          <Setter Property="RenderTransform" Value="rotate(180deg)" />
        </Style>
        <Style Selector="^.sm /template/ Viewbox#PART_Chevron">
          <Setter Property="Width" Value="10" />
          <Setter Property="Height" Value="10" />
          <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style Selector="^.lg /template/ Viewbox#PART_Chevron">
          <Setter Property="Width" Value="14" />
          <Setter Property="Height" Value="14" />
          <Setter Property="Margin" Value="10,0,0,0" />
        </Style>
        <!-- An icon with its chevron needs more than the square of an icon button. -->
        <Style Selector="^.icon">
          <Setter Property="Width" Value="NaN" />
          <Setter Property="Padding" Value="10,6" />
          <Style Selector="^ /template/ Viewbox#PART_Chevron">
            <Setter Property="Margin" Value="4,0,0,0" />
          </Style>
        </Style>
      </ControlTheme>

    </ResourceDictionary>
  </Styles.Resources>

  <!-- An icon beside a label nudges toward the trailing edge; a logical margin, so it mirrors with the page. -->
  <Style Selector=":is(Button) ins|Icon">
    <Setter Property="Transitions">
      <Transitions>
        <ThicknessTransition Property="Margin" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector=":is(Button):pointerover:not(.icon):not(:disabled) ins|Icon">
    <Setter Property="Margin" Value="2,0,-2,0" />
  </Style>
</Styles>
