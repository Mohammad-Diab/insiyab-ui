<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ins="using:Insiyab.Avalonia.Controls">

  <Styles.Resources>
    <ResourceDictionary>

      <BoxShadows x:Key="InsTocActiveShadow">0 4 12 0 #0F0F172A</BoxShadows>

      <!-- An entry drawn the way the sidebar's links are: rounded, raised when current. -->
      <ControlTheme x:Key="{x:Type ins:TocLink}" TargetType="ins:TocLink">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource InsText2}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="CornerRadius" Value="{DynamicResource InsRMd}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="RenderTransform" Value="none" />
        <Setter Property="Transitions">
          <Transitions>
            <BrushTransition Property="Background" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
            <BrushTransition Property="Foreground" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
          </Transitions>
        </Setter>
        <Setter Property="Template">
          <ControlTemplate TargetType="ins:TocLink">
            <Panel>
              <Border x:Name="PART_Shadow" CornerRadius="{TemplateBinding CornerRadius}">
                <Border.Transitions>
                  <Transitions>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
                  </Transitions>
                </Border.Transitions>
              </Border>
              <Border x:Name="PART_Face" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"
                      BorderBrush="Transparent" BorderThickness="0,1,0,0">
                <ContentPresenter x:Name="PART_ContentPresenter"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Foreground="{TemplateBinding Foreground}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Margin="0,-1,0,0" />
              </Border>
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^.sub">
          <Setter Property="Padding" Value="22,7,10,7" />
          <Setter Property="MinHeight" Value="34" />
          <Setter Property="FontSize" Value="{DynamicResource InsFsXs}" />
        </Style>
        <!-- The page's line height is 1.7 in Arabic and 1.6 in Latin, which sets the rows' height. -->
        <Style Selector="^[FlowDirection=LeftToRight]">
          <Setter Property="MinHeight" Value="35" />
          <Style Selector="^.sub">
            <Setter Property="MinHeight" Value="33" />
          </Style>
        </Style>
        <!-- The hover nudge, toward the content: mirrored with the page. -->
        <Style Selector="^:pointerover">
          <Setter Property="Background" Value="{DynamicResource InsGlassInner}" />
          <Setter Property="Foreground" Value="{DynamicResource InsPrimaryDarker}" />
          <Setter Property="RenderTransform" Value="translateX(2px)" />
        </Style>
        <Style Selector="^:active">
          <Setter Property="Background" Value="{DynamicResource InsSurfaceHover}" />
          <Setter Property="Foreground" Value="{DynamicResource InsPrimaryDarker}" />
          <Setter Property="FontWeight" Value="Bold" />
          <Style Selector="^ /template/ Border#PART_Shadow">
            <Setter Property="BoxShadow" Value="{StaticResource InsTocActiveShadow}" />
          </Style>
          <Style Selector="^ /template/ Border#PART_Face">
            <Setter Property="BorderBrush" Value="{DynamicResource InsRimTop}" />
          </Style>
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_Shadow">
          <Setter Property="BoxShadow" Value="{DynamicResource InsFocusRing}" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type ins:Toc}" TargetType="ins:Toc">
        <Setter Property="Background" Value="{DynamicResource InsGlass}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InsRim}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource InsRLg}" />
        <Setter Property="Padding" Value="9" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="ItemsPanel">
          <ItemsPanelTemplate>
            <StackPanel Spacing="2" />
          </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
          <ControlTemplate TargetType="ins:Toc">
            <Panel>
              <Border CornerRadius="{TemplateBinding CornerRadius}" BoxShadow="{DynamicResource InsShBubble}" />
              <Border Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{TemplateBinding CornerRadius}"
                      BoxShadow="{DynamicResource InsBevel}" />
              <!-- The rim's brighter top edge. -->
              <Border BorderBrush="{DynamicResource InsRimTop}" BorderThickness="0,1,0,0" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
              <DockPanel Margin="{TemplateBinding Padding}">
                <TextBlock x:Name="PART_Title" DockPanel.Dock="Top" Text="{TemplateBinding Title}" Padding="10,4,10,6" FontSize="11" LineHeight="18.7" FontWeight="Bold"
                           Foreground="{DynamicResource InsText3}" IsVisible="{TemplateBinding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <Panel>
                  <ItemsPresenter x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                  <Border x:Name="PART_Marker" Width="3" Height="0" CornerRadius="999" Background="{DynamicResource InsToneBrandSoft}"
                          HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Opacity="0" RenderTransformOrigin="50%,50%">
                    <Border.Transitions>
                      <Transitions>
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
                        <DoubleTransition Property="Height" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
                      </Transitions>
                    </Border.Transitions>
                  </Border>
                </Panel>
              </DockPanel>
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^[FlowDirection=LeftToRight] /template/ TextBlock#PART_Title">
          <Setter Property="LetterSpacing" Value="0.44" />
          <Setter Property="LineHeight" Value="17.6" />
        </Style>
      </ControlTheme>

    </ResourceDictionary>
  </Styles.Resources>

</Styles>
