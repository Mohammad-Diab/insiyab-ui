<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ins="using:Insiyab.Avalonia.Controls">

  <Styles.Resources>
    <ResourceDictionary>

      <SolidColorBrush x:Key="InsColorChipBorder" Color="#2E0F172A" />
      <BoxShadows x:Key="InsColorChipRing">inset 0 0 0 1 #59FFFFFF</BoxShadows>

      <!-- The swatch in front of the hex: the colour itself, or a slash through an empty chip. -->
      <ControlTheme x:Key="InsColorSwatch" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource InsColorChipBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource InsRXs}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="RenderTransform" Value="none" />
        <Setter Property="Transitions">
          <Transitions>
            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="0.34,1.56,0.64,1" />
          </Transitions>
        </Setter>
        <Setter Property="Template">
          <ControlTemplate TargetType="Button">
            <Panel>
              <Border x:Name="PART_Empty" CornerRadius="{TemplateBinding CornerRadius}" Background="{DynamicResource InsCtlBg}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" ClipToBounds="True" IsVisible="False">
                <Line StartPoint="0,28" EndPoint="28,0" Stroke="{DynamicResource InsToneBad}" StrokeThickness="2" />
              </Border>
              <Border x:Name="PART_Chip"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{TemplateBinding CornerRadius}"
                      BoxShadow="{StaticResource InsColorChipRing}" />
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="RenderTransform" Value="scale(1.08)" />
        </Style>
        <Style Selector="^.empty /template/ Border#PART_Empty">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^.empty /template/ Border#PART_Chip">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.55" />
          <Setter Property="RenderTransform" Value="none" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type ins:ColorPreset}" TargetType="ins:ColorPreset">
        <Setter Property="BorderBrush" Value="{DynamicResource InsColorChipBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="RenderTransform" Value="none" />
        <Setter Property="Transitions">
          <Transitions>
            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="0.34,1.56,0.64,1" />
          </Transitions>
        </Setter>
        <Setter Property="Template">
          <ControlTemplate TargetType="ins:ColorPreset">
            <Border Background="{TemplateBinding Brush}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    BoxShadow="{StaticResource InsColorChipRing}" />
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="RenderTransform" Value="scale(1.12)" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type ins:ColorContrastLine}" TargetType="ins:ColorContrastLine">
        <Setter Property="FontSize" Value="{DynamicResource InsFsXs}" />
        <Setter Property="Foreground" Value="{DynamicResource InsText3}" />
        <Setter Property="Template">
          <ControlTemplate TargetType="ins:ColorContrastLine">
            <DockPanel>
              <Border DockPanel.Dock="Left" Width="28" Height="20" Margin="0,0,8,0" CornerRadius="5" BorderThickness="1"
                      BorderBrush="{DynamicResource InsLine}" Background="{TemplateBinding SampleBackground}">
                <TextBlock Text="Aa" FontFamily="{DynamicResource InsFontBodyEn}" FontWeight="ExtraBold" FontSize="{TemplateBinding FontSize}"
                           Foreground="{TemplateBinding SampleForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock x:Name="PART_Verdict" DockPanel.Dock="Right" MinWidth="88" Margin="8,0,0,0" TextAlignment="Right" FontWeight="Bold"
                         Text="{TemplateBinding Verdict}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
              <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" FlowDirection="LeftToRight" FontFamily="{DynamicResource InsFontBodyEn}" FontWeight="Bold"
                         Text="{TemplateBinding Ratio}" Foreground="{DynamicResource InsText1}" VerticalAlignment="Center" />
              <TextBlock Text="{TemplateBinding Where}" Foreground="{DynamicResource InsText2}" VerticalAlignment="Center" />
            </DockPanel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pass">
          <Setter Property="Foreground" Value="{DynamicResource InsToneOk}" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type ins:ColorPickerPanel}" TargetType="ins:ColorPickerPanel">
        <Setter Property="Foreground" Value="{DynamicResource InsText1}" />
        <Setter Property="Template">
          <ControlTemplate TargetType="ins:ColorPickerPanel">
            <StackPanel Spacing="10">
              <ins:ColorArea x:Name="PART_Area" Height="152" CornerRadius="{DynamicResource InsRSm}" />
              <ins:ColorHueSlider x:Name="PART_Hue" />
              <UniformGrid x:Name="PART_Swatches" Columns="8" ColumnSpacing="6" RowSpacing="6" HorizontalAlignment="Stretch" UseLayoutRounding="False" />
              <Border BorderBrush="{DynamicResource InsLine}" BorderThickness="0,1,0,0" Padding="0,8,0,0"
                      IsVisible="{TemplateBinding HexText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <StackPanel Spacing="5">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{TemplateBinding ContrastLabel}" FontSize="{DynamicResource InsFsXs}" FontWeight="Bold"
                               Foreground="{DynamicResource InsText3}" VerticalAlignment="Bottom" />
                    <TextBlock Text="{TemplateBinding HexText}" FontFamily="{DynamicResource InsFontBodyEn}" FontWeight="Bold" FontSize="{DynamicResource InsFsSm}"
                               Foreground="{DynamicResource InsText1}" HorizontalAlignment="Left" />
                  </DockPanel>
                  <ins:ColorContrastLine x:Name="PART_OnWhite" />
                  <ins:ColorContrastLine x:Name="PART_OnBlack" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ ins|ColorArea#PART_Area:focus-visible">
          <Setter Property="Ring" Value="{DynamicResource InsToneBrandSoft}" />
        </Style>
        <Style Selector="^ /template/ ins|ColorHueSlider#PART_Hue:focus-visible">
          <Setter Property="Ring" Value="{DynamicResource InsToneBrandSoft}" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type ins:ColorField}" TargetType="ins:ColorField">
        <Setter Property="Foreground" Value="{DynamicResource InsText1}" />
        <Setter Property="FontSize" Value="{DynamicResource InsFsMd}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
          <ControlTemplate TargetType="ins:ColorField">
            <Panel>
              <TextBox x:Name="PART_Input" Classes="input-group" FlowDirection="LeftToRight" FontFamily="{DynamicResource InsFontBodyEn}"
                       FontSize="{TemplateBinding FontSize}" LetterSpacing="0.28" MaxLength="7" PlaceholderText="#000000" IsEnabled="{TemplateBinding IsEnabled}">
                <TextBox.InnerLeftContent>
                  <Button x:Name="PART_Swatch" Theme="{StaticResource InsColorSwatch}" Background="{Binding $parent[ins:ColorField].SwatchBrush}" />
                </TextBox.InnerLeftContent>
              </TextBox>
              <Popup x:Name="PART_Popup" PlacementTarget="{Binding #PART_Input}" Placement="BottomEdgeAlignedLeft"
                     PlacementConstraintAdjustment="SlideX,FlipY" HorizontalOffset="-40" VerticalOffset="-10"
                     ShouldUseOverlayLayer="True" IsLightDismissEnabled="True" OverlayDismissEventPassThrough="False"
                     WindowManagerAddShadowHint="False" FlowDirection="LeftToRight">
                <FlyoutPresenter Classes="pop card color" FlowDirection="{TemplateBinding FlowDirection}" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                  <ins:ColorPickerPanel x:Name="PART_Picker" Locale="{TemplateBinding Locale}" />
                </FlyoutPresenter>
              </Popup>
            </Panel>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="FlyoutPresenter.color">
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style Selector="FlyoutPresenter.color /template/ Border#LayoutRoot">
    <Setter Property="Width" Value="272" />
    <Setter Property="MaxHeight" Value="480" />
  </Style>

</Styles>
