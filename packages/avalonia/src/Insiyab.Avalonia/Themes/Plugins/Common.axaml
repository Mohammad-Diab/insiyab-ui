<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="InsPluginsHoverBorder" Color="{DynamicResource InsPrimaryColor}" Opacity="0.30" />
          <SolidColorBrush x:Key="InsPluginsFocusBorder" Color="{DynamicResource InsPrimaryColor}" Opacity="0.55" />
          <SolidColorBrush x:Key="InsPluginsTint" Color="{DynamicResource InsPrimaryColor}" Opacity="0.10" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="InsPluginsHoverBorder" Color="{DynamicResource InsPrimaryMidColor}" Opacity="0.30" />
          <SolidColorBrush x:Key="InsPluginsFocusBorder" Color="{DynamicResource InsPrimaryMidColor}" Opacity="0.55" />
          <SolidColorBrush x:Key="InsPluginsTint" Color="{DynamicResource InsPrimaryMidColor}" Opacity="0.10" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

    </ResourceDictionary>
  </Styles.Resources>

</Styles>
