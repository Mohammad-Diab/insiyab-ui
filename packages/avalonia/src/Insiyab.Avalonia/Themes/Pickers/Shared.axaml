<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ins="using:Insiyab.Avalonia.Controls">

  <Styles.Resources>
    <ResourceDictionary>

      <StreamGeometry x:Key="InsDateBtnIcon">M6 4.5h12a3 3 0 0 1 3 3v10.5a3 3 0 0 1-3 3h-12a3 3 0 0 1-3-3v-10.5a3 3 0 0 1 3-3z M3 9.5h18 M8 3v3 M16 3v3</StreamGeometry>
      <StreamGeometry x:Key="InsTimeClockIcon">M21 12a9 9 0 1 1-18 0a9 9 0 1 1 18 0Z M12 7v5l3 2</StreamGeometry>
      <StreamGeometry x:Key="InsBirthBtnIcon">M6 4h12a3 3 0 0 1 3 3v11a3 3 0 0 1-3 3h-12a3 3 0 0 1-3-3v-11a3 3 0 0 1 3-3z M8 2v4 M16 2v4 M3 10h18</StreamGeometry>
      <StreamGeometry x:Key="InsMonthArrowIcon">M9 6l6 6-6 6</StreamGeometry>
      <StreamGeometry x:Key="InsMonthArrowBackIcon">M15 6l-6 6 6 6</StreamGeometry>
      <StreamGeometry x:Key="InsPickerChevronDown">M6 9l6 6 6-6</StreamGeometry>

      <SolidColorBrush x:Key="InsPickerHoverBorder" Color="{DynamicResource InsPrimaryColor}" Opacity="0.30" />
      <SolidColorBrush x:Key="InsPickerFocusBorder" Color="{DynamicResource InsPrimaryColor}" Opacity="0.55" />
      <SolidColorBrush x:Key="InsPickerOptionHover" Color="{DynamicResource InsPrimaryColor}" Opacity="0.10" />
      <SolidColorBrush x:Key="InsPickerFocusOutline" Color="{DynamicResource InsPrimaryColor}" Opacity="0.45" />

      <!-- One copy per theme, so a dark window inside a light app gets the dark glass. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <LinearGradientBrush x:Key="InsPickerGlassFill" StartPoint="0%,0%" EndPoint="70%,100%">
            <GradientStop Offset="0" Color="{DynamicResource InsGlassStrongColor}" />
            <GradientStop Offset="1" Color="{DynamicResource InsGlassHoverColor}" />
          </LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <LinearGradientBrush x:Key="InsPickerGlassFill" StartPoint="0%,0%" EndPoint="70%,100%">
            <GradientStop Offset="0" Color="{DynamicResource InsGlassStrongColor}" />
            <GradientStop Offset="1" Color="{DynamicResource InsGlassHoverColor}" />
          </LinearGradientBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <LinearGradientBrush x:Key="InsPickerBrandFill" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="{DynamicResource InsPrimaryColor}" />
        <GradientStop Offset="1" Color="{DynamicResource InsPrimaryDarkColor}" />
      </LinearGradientBrush>

      <!-- The pop body's glass: the 145 degree glass gradient over the presenter's wash, drawn left to right whatever the page direction. -->
      <ControlTheme x:Key="InsLookPickerGlass" TargetType="Border" ins:ClassTheme.For="picker-glass">
        <Style Selector="^.picker-glass">
          <Setter Property="CornerRadius" Value="{DynamicResource InsRLg}" />
          <Setter Property="Background" Value="{DynamicResource InsPickerGlassFill}" />
          <Setter Property="FlowDirection" Value="LeftToRight" />
          <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
      </ControlTheme>

    </ResourceDictionary>
  </Styles.Resources>

  <!-- The picker card: the pop body with the calendar's larger radius, the wash under its glass, and no scroll or size caps. -->
  <Style Selector="FlyoutPresenter.picker">
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource InsRLg}" />
    <Setter Property="Background" Value="{DynamicResource InsWash1}" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
  </Style>
  <Style Selector="FlyoutPresenter.picker /template/ :is(Border)#LayoutRoot">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MaxHeight" Value="Infinity" />
  </Style>

</Styles>
