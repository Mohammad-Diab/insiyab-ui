<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ins="using:Insiyab.Avalonia.Controls">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="InsFindMatch" Color="#59FACC15" />
          <SolidColorBrush x:Key="InsFindCurrent" Color="#A6F59E0B" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="InsFindMatch" Color="#47FACC15" />
          <SolidColorBrush x:Key="InsFindCurrent" Color="#8CF59E0B" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <StreamGeometry x:Key="InsFindUp">M6 15l6-6 6 6</StreamGeometry>
      <StreamGeometry x:Key="InsFindDown">M6 9l6 6 6-6</StreamGeometry>
      <StreamGeometry x:Key="InsFindClose">M8.27,8.27 L15.73,15.73 M15.73,8.27 L8.27,15.73</StreamGeometry>

      <!-- The find bar: a frosted card at the end of the page's top, the field, the count, previous, next and close -->
      <ControlTheme x:Key="{x:Type ins:FindBar}" TargetType="ins:FindBar">
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Foreground" Value="{DynamicResource InsText2}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border x:Name="PART_Card" Padding="{TemplateBinding Padding}"
                    Background="{DynamicResource InsGlassStrong}" BorderBrush="{DynamicResource InsRim}" BorderThickness="1"
                    CornerRadius="{DynamicResource InsRMd}" BoxShadow="{DynamicResource InsShMd}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBox x:Name="PART_Field" Classes="sm" Width="220" VerticalAlignment="Center"
                         Text="{TemplateBinding Text, Mode=TwoWay}" />
                <TextBlock x:Name="PART_Count" MinWidth="64" Margin="6,0" VerticalAlignment="Center" TextAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource InsText2}" />
                <Button x:Name="PART_Prev" Classes="bare icon sm" Focusable="False">
                  <ins:Icon Data="{StaticResource InsFindUp}" Size="16" />
                </Button>
                <Button x:Name="PART_Next" Classes="bare icon sm" Focusable="False">
                  <ins:Icon Data="{StaticResource InsFindDown}" Size="16" />
                </Button>
                <Button x:Name="PART_Close" Classes="bare icon sm" Focusable="False">
                  <ins:Icon Data="{StaticResource InsFindClose}" Size="16" />
                </Button>
              </StackPanel>
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:open">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:none /template/ TextBlock#PART_Count">
          <Setter Property="Foreground" Value="{DynamicResource InsToneBad}" />
        </Style>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>
</Styles>
