<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ins="using:Insiyab.Avalonia.Controls">

  <Styles.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="InsComboOptionHover" Color="{DynamicResource InsPrimaryColor}" Opacity="0.10" />

      <!-- One suggestion: the web's .ins-combo-option. -->
      <ControlTheme x:Key="InsComboOption" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource InsText1}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="CornerRadius" Value="{DynamicResource InsRXs}" />
        <Setter Property="FontSize" Value="{DynamicResource InsFsMd}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <ControlTemplate>
            <ContentPresenter Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Foreground="{TemplateBinding Foreground}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Content="{TemplateBinding Content}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover, ^:selected">
          <Setter Property="Background" Value="{DynamicResource InsComboOptionHover}" />
          <Setter Property="Foreground" Value="{DynamicResource InsPrimaryDarker}" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.45" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="InsComboList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ItemContainerTheme" Value="{StaticResource InsComboOption}" />
        <Setter Property="Template">
          <ControlTemplate>
            <ScrollViewer Name="PART_ScrollViewer"
                          HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                          VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                          IsScrollChainingEnabled="False">
              <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
            </ScrollViewer>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type AutoCompleteBox}" TargetType="AutoCompleteBox">
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Foreground" Value="{DynamicResource InsText1}" />
        <Setter Property="PlaceholderForeground" Value="{DynamicResource InsText3}" />
        <Setter Property="MaxDropDownHeight" Value="288" />
        <Setter Property="FilterMode" Value="Custom" />
        <Setter Property="TextFilter" Value="{x:Static ins:ArabicMatch.Contains}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
          <ControlTemplate>
            <Grid Name="PART_LayoutRoot">
              <TextBox Name="PART_TextBox"
                       PlaceholderText="{TemplateBinding PlaceholderText}"
                       PlaceholderForeground="{TemplateBinding PlaceholderForeground}"
                       Foreground="{TemplateBinding Foreground}"
                       CaretIndex="{TemplateBinding CaretIndex, Mode=TwoWay}"
                       ClearSelectionOnLostFocus="{TemplateBinding ClearSelectionOnLostFocus}"
                       Margin="0"
                       DataValidationErrors.Errors="{TemplateBinding (DataValidationErrors.Errors)}"
                       MaxLength="{TemplateBinding MaxLength}"
                       InnerLeftContent="{TemplateBinding InnerLeftContent}"
                       InnerRightContent="{TemplateBinding InnerRightContent}" />
              <Popup Name="PART_Popup"
                     WindowManagerAddShadowHint="False"
                     MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                     MaxHeight="{TemplateBinding MaxDropDownHeight}"
                     IsLightDismissEnabled="True"
                     Placement="BottomEdgeAlignedLeft"
                     VerticalOffset="6"
                     PlacementTarget="{TemplateBinding}">
                <Border Name="PART_SuggestionsContainer"
                        Padding="6"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource InsRim}"
                        Background="{DynamicResource InsGlassStrong}"
                        CornerRadius="{DynamicResource InsRMd}"
                        BoxShadow="{DynamicResource InsShLg}">
                  <ListBox Name="PART_SelectingItemsControl"
                           Theme="{StaticResource InsComboList}"
                           ItemTemplate="{TemplateBinding ItemTemplate}" />
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>
</Styles>
