<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <ResourceDictionary>
      <!-- Same stacks as 02-tokens.css: Tajawal sits behind Inter and Cause so Arabic inside English text never drops to a system face -->
      <FontFamily x:Key="InsFontArabic">fonts:Insiyab#Tajawal, Segoe UI, Tahoma</FontFamily>
      <FontFamily x:Key="InsFontBodyEn">fonts:Insiyab#Inter, fonts:Insiyab#Tajawal</FontFamily>
      <FontFamily x:Key="InsFontHeadingEn">fonts:Insiyab#Cause, fonts:Insiyab#Tajawal</FontFamily>
      <FontFamily x:Key="InsFontMono">Cascadia Mono, Cascadia Code, Consolas, Courier New</FontFamily>
      <StaticResource x:Key="InsFontBody" ResourceKey="InsFontArabic" />
      <StaticResource x:Key="ContentControlThemeFontFamily" ResourceKey="InsFontBody" />
    </ResourceDictionary>
  </Styles.Resources>

  <!-- html[dir="ltr"] swaps the body face; here every templated control, the window included, follows its inherited FlowDirection -->
  <Style Selector=":is(TemplatedControl)[FlowDirection=RightToLeft]">
    <Setter Property="FontFamily" Value="{DynamicResource InsFontArabic}" />
  </Style>
  <Style Selector=":is(TemplatedControl)[FlowDirection=LeftToRight]">
    <Setter Property="FontFamily" Value="{DynamicResource InsFontBodyEn}" />
  </Style>

</Styles>
