<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Insiyab.Avalonia</RootNamespace>
    <PackageId>Insiyab.Avalonia</PackageId>
    <Version>0.2.0</Version>
    <Title>Insiyab for Avalonia</Title>
    <Authors>Mohammad Diab</Authors>
    <Copyright>Copyright 2026 Mohammad Diab</Copyright>
    <Description>Insiyab for Avalonia: the glass, RTL-first design system as Avalonia themes.</Description>
    <PackageTags>avalonia;theme;design-system;controls;rtl;arabic;ui</PackageTags>
    <PackageProjectUrl>https://github.com/Mohammad-Diab/insiyab-ui/tree/main/packages/avalonia</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Mohammad-Diab/insiyab-ui</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReleaseNotes>First public release of Insiyab for Avalonia 12 (net10.0).
- One theme in place of FluentTheme: the web library's glass, RTL-first look for Avalonia's own controls and dozens more (shell and sidebar, title bar and caption buttons, toolbar and status bar, tables with sticky headers, frozen columns, resizing and editing, tree, tabs and document tabs, dialogs, drawers, toasts, notifications, command palette, date, time, birth date, colour, phone, OTP and file fields, charts, timeline, steps, wizard and more).
- Light and dark that follow the system or the app, with a theme sweep; SetPrimary re-derives every brand colour live.
- Right to left first: mirrored layouts, Arabic-aware search and matching, caret and text direction that follow what is typed.
- Desktop conventions: keyboard paths, focus rings, context menus, Mica or acrylic windows on Windows, a taskbar badge (Dock on macOS), and motion that respects the system's effects setting.
- Trimming and Native AOT compatible; works in a single view.
- One xmlns for everything: xmlns:ins="https://github.com/Mohammad-Diab/insiyab-ui". The package README lists the API.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>mark-128.png</PackageIcon>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Insiyab.Avalonia.Tests" />
    <InternalsVisibleTo Include="PerfLab" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\..\brand\mark-128.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\..\..\NOTICE" Pack="true" PackagePath="\" Visible="false" />
    <None Include="Assets\Fonts\OFL-*.txt" Pack="true" PackagePath="fonts\" />
  </ItemGroup>

</Project>
