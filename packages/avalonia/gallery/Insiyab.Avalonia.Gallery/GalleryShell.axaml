<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ins="using:Insiyab.Avalonia.Controls"
             x:Class="Insiyab.Avalonia.Gallery.GalleryShell">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Insiyab.Avalonia.Gallery/BrandMark.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- The docs site's brand swatch: a 30px disc in a 2px surface rim; the chosen one is marked by SwatchMark, a ring that moves along the row -->
      <!-- The mark's four arcs on the diagonals, 2px clear of the coloured disc, in a 36px box centred on the swatch -->
      <StreamGeometry x:Key="SiteSwatchArcs">M33.455,22.141 A16,16 0 0 1 22.141,33.455 M13.859,33.455 A16,16 0 0 1 2.545,22.141 M2.545,13.859 A16,16 0 0 1 13.859,2.545 M22.141,2.545 A16,16 0 0 1 33.455,13.859</StreamGeometry>
      <ControlTheme x:Key="SiteSwatch" TargetType="Button">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="RenderTransform" Value="none" />
        <Setter Property="Transitions">
          <Transitions>
            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="0.34,1.56,0.64,1" />
          </Transitions>
        </Setter>
        <Setter Property="Template">
          <ControlTemplate>
            <Panel>
              <Border Name="PART_Face"
                      CornerRadius="15"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{DynamicResource InsSurface}"
                      BorderThickness="2"
                      BoxShadow="{DynamicResource InsShSm}" />
              <Border Name="PART_Focus" CornerRadius="15" BoxShadow="{DynamicResource InsFocusRing}" Opacity="0" />
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="RenderTransform" Value="scale(1.12)" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_Focus">
          <Setter Property="Opacity" Value="1" />
        </Style>
      </ControlTheme>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Border.island.site-version">
      <Setter Property="TextElement.FontWeight" Value="SemiBold" />
      <Setter Property="TextElement.FontSize" Value="13" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource InsText2}" />
    </Style>
    <Style Selector="SplitView:overlay Border.island.site-version">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.island.site-custom">
      <Setter Property="Padding" Value="10,0,14,0" />
    </Style>
    <Style Selector="Border.site-custom-dot">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Margin" Value="-2" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{DynamicResource InsSurface}" />
    </Style>
    <Style Selector="Border.site-custom-dot > Border">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource InsShellMarkFill}" />
    </Style>
    <Style Selector="ins|Icon.site-custom-chev">
      <Setter Property="Foreground" Value="{DynamicResource InsText3}" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform" Value="none" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.site-custom:flyout-open ins|Icon.site-custom-chev">
      <Setter Property="RenderTransform" Value="rotate(180deg)" />
    </Style>
    <Style Selector="SplitView.xnarrow TextBlock.site-custom-text">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Panel.site-swatches">
      <Setter Property="Margin" Value="4,4,4,12" />
      <Setter Property="ClipToBounds" Value="False" />
    </Style>
    <Style Selector="Panel.site-swatches > WrapPanel">
      <Setter Property="ItemSpacing" Value="8" />
      <Setter Property="LineSpacing" Value="8" />
      <Setter Property="ClipToBounds" Value="False" />
    </Style>
    <Style Selector="ins|Segmented.site-dir">
      <Setter Property="Margin" Value="4,0,4,8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <UniformGrid Rows="1" ColumnSpacing="3" />
        </ItemsPanelTemplate>
      </Setter>
    </Style>
    <Style Selector="ins|Segmented.site-dir > ins|SegmentedItem">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <SplitView x:Name="ShellView" IsPaneOpen="True">
    <SplitView.Pane>
      <DockPanel>
        <Border Classes="shell-brand" DockPanel.Dock="Top" ins:TitleBar.IsDragArea="True" Background="Transparent">
          <StackPanel>
            <Border Classes="shell-mark" Background="Transparent" ins:TitleBar.IsSystemMenuArea="True"><TemplatedControl Template="{StaticResource BrandMark}" /></Border>
            <StackPanel>
              <TextBlock Classes="shell-brand-name" Text="انسياب" />
              <TextBlock Classes="shell-brand-role" Text="المعرض · Avalonia" />
            </StackPanel>
          </StackPanel>
        </Border>
        <ListBox x:Name="Nav" Classes="shell-nav" AutomationProperties.Name="صفحات المعرض"
                 ins:Shell.HasFilter="True" ins:Shell.FilterPlaceholder="ابحث في الصفحات" />
      </DockPanel>
    </SplitView.Pane>
    <Panel>
      <Border Classes="topbar" VerticalAlignment="Top" ZIndex="1" ins:TitleBar.IsDragArea="True">
        <Grid ColumnDefinitions="*,Auto,*,Auto">
          <StackPanel Classes="zone start">
            <Button Classes="island icon" ins:Shell.TogglesSidebar="True" ToolTip.Tip="القائمة" AutomationProperties.Name="القائمة">
              <ins:Icon Data="{StaticResource IconMenu}" />
            </Button>
            <Border Classes="island brand">
              <StackPanel>
                <Border Classes="shell-mark" Background="Transparent" ins:TitleBar.IsSystemMenuArea="True"><TemplatedControl Template="{StaticResource BrandMark}" /></Border>
                <TextBlock Text="انسياب" />
              </StackPanel>
            </Border>
            <Border Classes="island site-version">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="الإصدار" />
                <TextBlock x:Name="VersionText" Classes="num" />
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel Classes="zone center">
            <Border Classes="island title">
              <StackPanel Classes="shell-head">
                <TextBlock x:Name="PageTitle" Classes="shell-title" />
              </StackPanel>
            </Border>
            <Button x:Name="SearchButton" Classes="island icon" ToolTip.Tip="بحث (Ctrl+K)" AutomationProperties.Name="بحث">
              <ins:Icon Data="{StaticResource IconSearch}" />
            </Button>
          </StackPanel>
          <StackPanel Classes="zone end">
            <ins:DayNight x:Name="DayNightToggle" ToolTip.Tip="الوضع الداكن" AutomationProperties.Name="الوضع الداكن" />
            <ins:Notify x:Name="NotifyBell">
              <ins:NotifyItem Icon="{StaticResource IconDownload}" Title="اكتمل التصدير" Description="الملف جاهز للتنزيل." End="الآن" IsUnread="True" />
              <ins:NotifyItem Icon="{StaticResource IconMessage}" Title="تعليق جديد على المستند" Description="على الفقرة الثانية." End="قبل ساعة" IsUnread="True" />
              <ins:NotifyItem Icon="{StaticResource IconUser}" Title="عضو جديد في الفريق" Description="انضمت سلمى إلى مساحة العمل." End="قبل ساعتين" IsUnread="True" />
              <ins:NotifyItem Icon="{StaticResource IconCheck}" Title="تم حفظ التغييرات" Description="حُفظت نسخة جديدة من الملف." End="أمس" />
              <ins:NotifyItem Icon="{StaticResource IconShare}" Title="شورك معك ملف" Description="ملف الميزانية من أحمد." End="أمس" />
            </ins:Notify>
            <Button x:Name="AppearanceButton" Classes="island site-custom" AutomationProperties.Name="تخصيص المظهر">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border x:Name="BrandDot" Classes="site-custom-dot"><Border /></Border>
                <TextBlock Classes="site-custom-text" Text="المظهر" />
                <ins:Icon Classes="site-custom-chev" Data="{StaticResource IconChevDown}" />
              </StackPanel>
              <Button.Flyout>
                <ins:PopCard IsEnd="True">
                  <StackPanel>
                    <TextBlock Classes="pop-label" Text="لون الهوية" />
                    <Panel Classes="site-swatches">
                      <WrapPanel x:Name="Swatches" />
                      <Canvas IsHitTestVisible="False" ClipToBounds="False">
                        <Path x:Name="SwatchMark" Width="36" Height="36" Stretch="None" Data="{StaticResource SiteSwatchArcs}"
                              StrokeThickness="2" StrokeLineCap="Round" Opacity="0" RenderTransformOrigin="50%,50%" />
                      </Canvas>
                    </Panel>
                    <TextBlock Classes="pop-label" Text="اتجاه الصفحة" />
                    <ins:Segmented x:Name="DirectionSeg" Classes="site-dir" SelectedIndex="0">
                      <ins:SegmentedItem Content="من اليمين · RTL" />
                      <ins:SegmentedItem Content="من اليسار · LTR" />
                    </ins:Segmented>
                    <Separator />
                    <Button x:Name="EffectsButton" Classes="pop-item" Content="تخفيف المؤثرات" />
                    <Button Classes="pop-item" ins:ThemeToggle.Mode="system" Content="اتبع وضع النظام" />
                    <Button x:Name="ResetButton" Classes="pop-item" Content="إعادة الضبط" />
                  </StackPanel>
                </ins:PopCard>
              </Button.Flyout>
            </Button>
          </StackPanel>
          <ins:CaptionButtons Grid.Column="3" />
        </Grid>
      </Border>
      <ScrollViewer x:Name="Scroller" ins:Shell.FrostsTopbar="True">
        <Border Classes="shell-content" Margin="0,72,0,0">
          <TransitioningContentControl x:Name="Host" Classes="shell-content" />
        </Border>
      </ScrollViewer>
    </Panel>
  </SplitView>
</UserControl>
