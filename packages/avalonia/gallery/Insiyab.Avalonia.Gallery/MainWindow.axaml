<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Insiyab.Avalonia.Gallery.MainWindow"
        Title="Insiyab Gallery"
        Width="1440" Height="900"
        FlowDirection="RightToLeft">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="24,12">
      <StackPanel Orientation="Horizontal" Spacing="16">
        <TextBlock Classes="h4" Text="انسياب · Avalonia" VerticalAlignment="Center" />
        <ToggleSwitch x:Name="DarkSwitch" OnContent="داكن" OffContent="فاتح" />
        <ToggleSwitch x:Name="LtrSwitch" OnContent="LTR" OffContent="RTL" />
      </StackPanel>
    </Border>
    <ScrollViewer DockPanel.Dock="Left" Width="240">
      <StackPanel x:Name="Nav" Margin="16,0,8,24" Spacing="2" />
    </ScrollViewer>
    <ScrollViewer x:Name="Scroller">
      <ContentControl x:Name="Host" Margin="8,0,24,24" />
    </ScrollViewer>
  </DockPanel>
</Window>
