<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ins="using:Insiyab.Avalonia.Controls"
             x:Class="Insiyab.Avalonia.Gallery.Pages.SavePage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Pages/FeedbackFrames.axaml" />
  </UserControl.Styles>
  <ScrollViewer>
    <StackPanel>

      <Border Classes="dx">
        <WrapPanel ItemSpacing="10" LineSpacing="10">
          <ins:SaveStatus State="Saving" />
          <ins:SaveStatus State="Saved" />
          <ins:SaveStatus State="Error" />
        </WrapPanel>
      </Border>

      <TextBlock Classes="section" Text="حالة الحفظ" />
      <Border Classes="stage">
        <ins:SaveStatus State="Saved" />
      </Border>
      <TextBlock Classes="variant" Text="بلا حالة" />
      <Border Classes="stage">
        <ins:SaveStatus />
      </Border>
      <TextBlock Classes="variant" Text="في نموذج يحفظ نفسه" />
      <Border Classes="stage wide">
        <StackPanel ins:Autosave.Delay="800" Spacing="6">
          <DockPanel>
            <ins:SaveStatus DockPanel.Dock="Right" />
            <TextBlock Classes="label" Text="ملاحظة" />
          </DockPanel>
          <TextBox AcceptsReturn="True" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
