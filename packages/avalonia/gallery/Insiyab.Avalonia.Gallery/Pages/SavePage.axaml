<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pg="using:Insiyab.Avalonia.Gallery.Playground"
             x:Class="Insiyab.Avalonia.Gallery.Pages.SavePage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Playground/PlayFrames.axaml" />
  </UserControl.Styles>

  <StackPanel>
    <TextBlock Classes="intro" Text="هل حُفظ آخر تغيير: جارٍ الحفظ، أو حُفظ، أو تعذر. ومعها نموذج يحفظ نفسه." />
    <pg:PlayExample Layout="Row" Code="{x:Static pg:SavePlay.Example}" />

    <TextBlock Classes="section" Text="حالة الحفظ" />
    <pg:PlayText Classes="p" Markup="يخبر `ins:SaveStatus` بمصير آخر تغيير: جارٍ حفظه، ثم حُفظ، أو تعذر حفظه. تضع الحالة في `State`، أو تتركها للنموذج الذي يحفظ نفسه." />
    <pg:Playground Def="{x:Static pg:SavePlay.Save}" />

    <TextBlock Classes="section" Text="الخيارات" />
    <pg:PlayText Classes="p" Markup="كل ما في حالة الحفظ من عناصر وخصائص وأحداث، في صندوق يفتح بالنقر." />
    <pg:OptionsList Defs="{x:Static pg:SavePlay.All}" />
  </StackPanel>
</UserControl>
