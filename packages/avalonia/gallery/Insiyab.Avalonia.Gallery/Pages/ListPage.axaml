<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pg="using:Insiyab.Avalonia.Gallery.Playground"
             x:Class="Insiyab.Avalonia.Gallery.Pages.ListPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Playground/PlayFrames.axaml" />
  </UserControl.Styles>

  <StackPanel>
    <TextBlock Classes="intro" Text="صفوف متتالية فيها صورة ونصان وخاتمة، ثابتة أو قابلة للنقر." />
    <pg:PlayExample Layout="Stack" Code="{x:Static pg:ListPlay.Example}" />

    <TextBlock Classes="section" Text="القائمة" />
    <pg:PlayText Classes="p" Markup="تتألف القائمة `ListBox` من صفوف `ListBoxItem`، وفي كل صف ما يبدأ به كصورة أو أيقونة، ثم نص من سطرين (`list-title` و`list-desc`)، ثم ما ينتهي به (`list-end`). وكلها اختيارية، وتجدها بشرحها في آخر الصفحة." />
    <pg:Playground Def="{x:Static pg:ListPlay.List}" />

    <TextBlock Classes="section" Text="قائمة بجانب التفاصيل" />
    <pg:PlayText Classes="p" Markup="قائمة `master` بفواصل ثابتة `ruled` وعناوين مجموعات تثبت في أعلاها وهي تتمرر `sticky-headings`، ويدفع كل عنوان ما قبله إلى الأعلى حين يصل. اختر رسالة فيطير الشريط إليها." />
    <pg:PlayExample Layout="Stack" Code="{x:Static pg:ListPlay.StickyExample}" />

    <TextBlock Classes="section" Text="صف الإعدادات" />
    <pg:PlayText Classes="p" Markup="صف الإعداد صف من قائمة `static`: نص من سطرين في `list-text`، وفي آخره `StackPanel.list-end` يحمل مفتاحًا أو قائمة اختيار أو شارة وزرًا." />
    <pg:PlayExample Layout="Stack" Code="{x:Static pg:ListPlay.SettingsExample}" />

    <TextBlock Classes="section" Text="الخيارات" />
    <pg:PlayText Classes="p" Markup="كل ما في القوائم من كلاسات وخصائص وأحداث، في صندوق يفتح بالنقر." />
    <pg:OptionsList Defs="{x:Static pg:ListPlay.All}" />
  </StackPanel>
</UserControl>
