<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pg="using:Insiyab.Avalonia.Gallery.Playground"
             x:Class="Insiyab.Avalonia.Gallery.Pages.StatsPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Playground/PlayFrames.axaml" />
  </UserControl.Styles>

  <StackPanel>
    <TextBlock Classes="intro" Text="رقم ومعناه وأيقونة، بست نبرات وثلاثة مقاسات." />
    <pg:PlayExample Layout="Stack" Code="{x:Static pg:StatsPlay.Example}" />

    <TextBlock Classes="section" Text="البطاقة" />
    <pg:PlayText Classes="p" Markup="تتألف البطاقة `Border.stat` من أيقونة في رقاقة `stat-ico`، وتسمية `stat-label`، وقيمة `stat-value`. أضف إليها `glass` فتصير سطحًا قائمًا بذاته، أو دعها بدونه وضعها داخل لوح. وتجد الخيارات كلها بشرحها في آخر الصفحة." />
    <pg:Playground Def="{x:Static pg:StatsPlay.Stat}" />

    <TextBlock Classes="section" Text="التغير" />
    <pg:PlayText Classes="p" Markup="يعرض `ins:Delta` مقدار ما تغير الرقم عن غيره، فيدل سهمه على الاتجاه، ويدل لونه على أن التغير محمود أو مذموم. ويجتمع مع `TextBlock.delta-ref` في البطاقة داخل `stat-trend` تحت القيمة." />
    <pg:Playground Def="{x:Static pg:StatsPlay.Delta}" />

    <TextBlock Classes="section" Text="في الشاشة" />
    <pg:PlayText Classes="p" Markup="ضع البطاقات في `UniformGrid` إذا أردت أعمدة متساوية، أو في `WrapPanel` لتضع منها في كل صف ما يتسع له." />

    <TextBlock Classes="section" Text="الخيارات" />
    <pg:PlayText Classes="p" Markup="كل ما في البطاقات الإحصائية من عناصر وكلاسات، لكل مكون صندوق يفتح بالنقر." />
    <pg:OptionsList Defs="{x:Static pg:StatsPlay.All}" />
  </StackPanel>
</UserControl>
