<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ins="using:Insiyab.Avalonia.Controls"
             x:Class="Insiyab.Avalonia.Gallery.Pages.StatsPage">
  <UserControl.Resources>
    <SolidColorBrush x:Key="ExampleTint" Color="{DynamicResource InsPrimaryColor}" Opacity="0.025" />
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Border.example">
      <Setter Property="Padding" Value="24" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource InsCtlBd}" />
      <Setter Property="CornerRadius" Value="{DynamicResource InsRLg}" />
      <Setter Property="Background" Value="{StaticResource ExampleTint}" />
    </Style>
    <Style Selector="TextBlock.cap">
      <Setter Property="FontSize" Value="{DynamicResource InsFsXs}" />
      <Setter Property="Foreground" Value="{DynamicResource InsText2}" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="TextBlock.h3">
      <Setter Property="Margin" Value="0,24,0,0" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Spacing="16" MaxWidth="832" HorizontalAlignment="Stretch">
      <Border Classes="example">
        <UniformGrid Columns="4" ColumnSpacing="12" RowSpacing="12" ins:Entrance.Reveal="True" ins:Entrance.RevealStep="0:0:0.07" ins:Entrance.RevealCount="8">
          <Border Classes="stat glass">
            <DockPanel>
              <Border Classes="stat-ico"><ins:Icon Data="{StaticResource IconCart}" /></Border>
              <StackPanel Classes="stat-body">
                <TextBlock Classes="stat-label" Text="الطلبات" />
                <TextBlock Classes="stat-value" Text="31" />
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Classes="stat glass ok">
            <DockPanel>
              <Border Classes="stat-ico"><ins:Icon Data="{StaticResource IconCheck}" /></Border>
              <StackPanel Classes="stat-body">
                <TextBlock Classes="stat-label" Text="مكتملة" />
                <TextBlock Classes="stat-value" Text="24" />
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Classes="stat glass warn">
            <DockPanel>
              <Border Classes="stat-ico"><ins:Icon Data="{StaticResource IconClock}" /></Border>
              <StackPanel Classes="stat-body">
                <TextBlock Classes="stat-label" Text="معلقة" />
                <TextBlock Classes="stat-value" Text="5" />
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Classes="stat glass bad">
            <DockPanel>
              <Border Classes="stat-ico"><ins:Icon Data="{StaticResource IconWarn}" /></Border>
              <StackPanel Classes="stat-body">
                <TextBlock Classes="stat-label" Text="فاشلة" />
                <TextBlock Classes="stat-value" Text="2" />
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Classes="stat glass info">
            <DockPanel>
              <Border Classes="stat-ico"><ins:Icon Data="{StaticResource IconUsers}" /></Border>
              <StackPanel Classes="stat-body">
                <TextBlock Classes="stat-label" Text="عملاء جدد" />
                <TextBlock Classes="stat-value" Text="9" />
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Classes="stat glass zero">
            <DockPanel>
              <Border Classes="stat-ico"><ins:Icon Data="{StaticResource IconInbox}" /></Border>
              <StackPanel Classes="stat-body">
                <TextBlock Classes="stat-label" Text="شكاوى" />
                <TextBlock Classes="stat-value" Text="0" />
              </StackPanel>
            </DockPanel>
          </Border>
        </UniformGrid>
      </Border>

      <TextBlock Classes="h3" Text="البطاقة" />
      <Border Classes="example">
        <StackPanel Spacing="24">
          <Border Classes="stat glass" HorizontalAlignment="Center">
            <DockPanel>
              <Border Classes="stat-ico"><ins:Icon Data="{StaticResource IconFile}" /></Border>
              <StackPanel Classes="stat-body">
                <TextBlock Classes="stat-label" Text="الملفات" />
                <TextBlock Classes="stat-value" Text="128" />
              </StackPanel>
            </DockPanel>
          </Border>
          <StackPanel>
            <TextBlock Classes="cap" Text="النبرة: نجاح، تحذير، خطر، معلومة، صفر، خافتة" />
            <WrapPanel ItemSpacing="12" LineSpacing="12">
            <Border Classes="stat glass ok">
            <DockPanel>
              <Border Classes="stat-ico"><ins:Icon Data="{StaticResource IconFile}" /></Border>
              <StackPanel Classes="stat-body">
                <TextBlock Classes="stat-label" Text="الملفات" />
                <TextBlock Classes="stat-value" Text="128" />
              </StackPanel>
            </DockPanel>
          </Border>
            <Border Classes="stat glass warn">
            <DockPanel>
              <Border Classes="stat-ico"><ins:Icon Data="{StaticResource IconFile}" /></Border>
              <StackPanel Classes="stat-body">
                <TextBlock Classes="stat-label" Text="الملفات" />
                <TextBlock Classes="stat-value" Text="128" />
              </StackPanel>
            </DockPanel>
          </Border>
            <Border Classes="stat glass bad">
            <DockPanel>
              <Border Classes="stat-ico"><ins:Icon Data="{StaticResource IconFile}" /></Border>
              <StackPanel Classes="stat-body">
                <TextBlock Classes="stat-label" Text="الملفات" />
                <TextBlock Classes="stat-value" Text="128" />
              </StackPanel>
            </DockPanel>
          </Border>
            <Border Classes="stat glass info">
            <DockPanel>
              <Border Classes="stat-ico"><ins:Icon Data="{StaticResource IconFile}" /></Border>
              <StackPanel Classes="stat-body">
                <TextBlock Classes="stat-label" Text="الملفات" />
                <TextBlock Classes="stat-value" Text="128" />
              </StackPanel>
            </DockPanel>
          </Border>
            <Border Classes="stat glass zero">
            <DockPanel>
              <Border Classes="stat-ico"><ins:Icon Data="{StaticResource IconFile}" /></Border>
              <StackPanel Classes="stat-body">
                <TextBlock Classes="stat-label" Text="الملفات" />
                <TextBlock Classes="stat-value" Text="0" />
              </StackPanel>
            </DockPanel>
          </Border>
            <Border Classes="stat glass mute">
            <DockPanel>
              <Border Classes="stat-ico"><ins:Icon Data="{StaticResource IconFile}" /></Border>
              <StackPanel Classes="stat-body">
                <TextBlock Classes="stat-label" Text="الملفات" />
                <TextBlock Classes="stat-value" Text="128" />
              </StackPanel>
            </DockPanel>
          </Border>
            </WrapPanel>
          </StackPanel>
          <StackPanel>
            <TextBlock Classes="cap" Text="المقاس: صغير، كبير" />
            <WrapPanel ItemSpacing="12" LineSpacing="12">
            <Border Classes="stat glass sm">
            <DockPanel>
              <Border Classes="stat-ico"><ins:Icon Data="{StaticResource IconFile}" /></Border>
              <StackPanel Classes="stat-body">
                <TextBlock Classes="stat-label" Text="الملفات" />
                <TextBlock Classes="stat-value" Text="128" />
              </StackPanel>
            </DockPanel>
          </Border>
            <Border Classes="stat glass lg">
            <DockPanel>
              <Border Classes="stat-ico"><ins:Icon Data="{StaticResource IconFile}" /></Border>
              <StackPanel Classes="stat-body">
                <TextBlock Classes="stat-label" Text="الملفات" />
                <TextBlock Classes="stat-value" Text="128" />
              </StackPanel>
            </DockPanel>
          </Border>
            </WrapPanel>
          </StackPanel>
          <StackPanel>
            <TextBlock Classes="cap" Text="تلميح وتغير، كبير" />
            <Border Classes="stat glass lg" HorizontalAlignment="Center">
            <DockPanel>
              <Border Classes="stat-ico"><ins:Icon Data="{StaticResource IconFile}" /></Border>
              <StackPanel Classes="stat-body">
                <TextBlock Classes="stat-label" Text="الملفات" />
                <TextBlock Classes="stat-value" Text="128" />
                <TextBlock Classes="stat-hint" Text="هذا الشهر" />
                <StackPanel Classes="stat-trend"><ins:Delta Classes="up" Content="12%" /><TextBlock Classes="delta-ref" Text="عن الشهر الماضي" /></StackPanel>
              </StackPanel>
            </DockPanel>
          </Border>
          </StackPanel>
          <StackPanel>
            <TextBlock Classes="cap" Text="رابط" />
            <Button Classes="stat-link" HorizontalAlignment="Center">
              <Border Classes="stat glass">
                <DockPanel>
                  <Border Classes="stat-ico"><ins:Icon Data="{StaticResource IconFile}" /></Border>
                  <StackPanel Classes="stat-body">
                    <TextBlock Classes="stat-label" Text="الملفات" />
                    <TextBlock Classes="stat-value" Text="128" />
                  </StackPanel>
                </DockPanel>
              </Border>
            </Button>
          </StackPanel>
          <StackPanel>
            <TextBlock Classes="cap" Text="داخل لوح، دون سطح خاص" />
            <Border Classes="panel" HorizontalAlignment="Center"><Border Classes="panel-body"><Border Classes="stat">
            <DockPanel>
              <Border Classes="stat-ico"><ins:Icon Data="{StaticResource IconFile}" /></Border>
              <StackPanel Classes="stat-body">
                <TextBlock Classes="stat-label" Text="الملفات" />
                <TextBlock Classes="stat-value" Text="128" />
              </StackPanel>
            </DockPanel>
          </Border></Border></Border>
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Classes="h3" Text="التغير" />
      <Border Classes="example">
        <StackPanel Spacing="24">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><ins:Delta Classes="up" Content="12%" /><TextBlock Classes="delta-ref" Text="عن الشهر الماضي" /></StackPanel>
          <StackPanel>
            <TextBlock Classes="cap" Text="هبوط" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><ins:Delta Classes="down" Content="12%" /><TextBlock Classes="delta-ref" Text="عن الشهر الماضي" /></StackPanel>
          </StackPanel>
          <StackPanel>
            <TextBlock Classes="cap" Text="ثبات" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><ins:Delta Classes="flat" Content="12%" /><TextBlock Classes="delta-ref" Text="عن الشهر الماضي" /></StackPanel>
          </StackPanel>
          <StackPanel>
            <TextBlock Classes="cap" Text="النقص خير: صعود، ثم هبوط" />
            <StackPanel Spacing="12"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><ins:Delta Classes="up invert" Content="12%" /><TextBlock Classes="delta-ref" Text="عن الشهر الماضي" /></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><ins:Delta Classes="down invert" Content="12%" /><TextBlock Classes="delta-ref" Text="عن الشهر الماضي" /></StackPanel></StackPanel>
          </StackPanel>
          <StackPanel>
            <TextBlock Classes="cap" Text="دون ما يقارن به" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><ins:Delta Classes="up" Content="12%" /></StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
