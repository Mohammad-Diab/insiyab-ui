<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ins="using:Insiyab.Avalonia.Controls"
             xmlns:pg="using:Insiyab.Avalonia.Gallery.Playground"
             x:Class="Insiyab.Avalonia.Gallery.Pages.TreePage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Playground/PlayFrames.axaml" />
  </UserControl.Styles>

  <StackPanel>
    <TextBlock Classes="intro" Text="قوائم متداخلة تصير شجرة: ملفات أو تصنيفات أو صلاحيات، تتنقل فيها بالأسهم، ومعها مربعات اختيار متسلسلة." />
    <pg:PlayExample Layout="Stack" Code="{x:Static pg:TreePlay.Example}" />

    <TextBlock Classes="section" Text="شجرة ملفات" />
    <pg:PlayText Classes="p" Markup="يصير `TreeView` شجرة ملفات: تسمية كل بند في `Header`، والبنود التي داخله فرعه، ويبقى مغلقًا ما لم تجعل `IsExpanded` عليه. وتجد الخيارات كلها بشرحها في آخر الصفحة." />
    <pg:Playground Def="{x:Static pg:TreePlay.Files}" />

    <TextBlock Classes="section" Text="لوحة المفاتيح" />
    <TextBlock Classes="p" Text="تصل إلى الشجرة بضغطة Tab واحدة، ثم تتنقل فيها بالأسهم كما تتنقل في شجرة الملفات:" />
    <ins:ProseList Margin="0,0,0,16">
      <TextBlock Classes="p" Margin="0" Text="↑ ↓ تنقلك بين الصفوف الظاهرة، وHome وEnd إلى أولها وآخرها." />
      <TextBlock Classes="p" Margin="0"><Bold>السهم نحو الداخل</Bold>، ← في العربية و→ في الإنجليزية، يفتح الفرع أولًا ثم يدخله.</TextBlock>
      <TextBlock Classes="p" Margin="0"><Bold>السهم نحو الخارج</Bold> يغلق الفرع المفتوح، وإلا خرج إلى البند الأب.</TextBlock>
      <TextBlock Classes="p" Margin="0" Text="* يفتح كل الفروع التي تحت البند، و+ و- في لوحة الأرقام تفتح وتغلق، وكتابة حرف تنقلك إلى أول صف يبدأ به." />
      <TextBlock Classes="p" Margin="0" Text="Enter ونقرتان تفتحان الفرع أو الملف، وSpace يختار البند، أو يحدده إن كانت الشجرة بمربعات اختيار." />
    </ins:ProseList>

    <TextBlock Classes="section" Text="التحكم من الشيفرة" />
    <pg:PlayListing Code="{x:Static pg:TreePlay.Code}" Margin="0,0,0,24" />

    <TextBlock Classes="section" Text="الخيارات" />
    <pg:PlayText Classes="p" Markup="كل ما في الشجرة من كلاسات وخصائص وأحداث، في صندوق يفتح بالنقر." />
    <pg:OptionsList Defs="{x:Static pg:TreePlay.All}" />
  </StackPanel>
</UserControl>
