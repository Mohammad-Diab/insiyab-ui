<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ins="using:Insiyab.Avalonia.Controls"
             xmlns:pg="using:Insiyab.Avalonia.Gallery.Playground"
             x:Class="Insiyab.Avalonia.Gallery.Pages.NotifyPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Playground/PlayFrames.axaml" />
  </UserControl.Styles>

  <StackPanel>
    <TextBlock Classes="intro" Text="جرس يعد ما لم يُقرأ من الإشعارات، وتحته قائمتها: يصير الإشعار مقروءًا بنقرة، ويهتز الجرس حين يصل جديد." />
    <pg:PlayExample Layout="Row" Code="{x:Static pg:NotifyPlay.Example}" />

    <TextBlock Classes="section" Text="مركز الإشعارات" />
    <pg:PlayText Classes="p" Markup="ضع صفوف `ins:NotifyItem` في `ins:Notify`، فيعد الجرس الصفوف التي عليها `IsUnread` ويكتب عددها على زاويته، ويصير الصف مقروءًا حين يُنقر. وتجد الخيارات كلها بشرحها في آخر الصفحة." />
    <pg:Playground Def="{x:Static pg:NotifyPlay.Notify}" />

    <TextBlock Classes="section" Text="متى تستعمل مركز الإشعارات" />
    <ins:ProseList>
      <TextBlock Classes="p" Margin="0" Text="لما يحدث والمستخدم بعيد عنه، ويبقى حتى يراه: اكتمل عمل طويل، أو وصل تعليق." />
      <TextBlock Classes="p" Margin="0" Text="أما تأكيد ما فعله المستخدم للتو فمكانه الرسالة العابرة، تظهر ثم تغيب." />
    </ins:ProseList>

    <TextBlock Classes="section" Text="التحكم من الشيفرة" />
    <pg:PlayText Classes="p" Markup="إذا وصل إشعار من الخادم فأضف صفه إلى `Items`، فيعده الجرس ويهتز مرة واحدة." />
    <pg:PlayListing Code="{x:Static pg:NotifyPlay.Code}" Margin="0,0,0,24" />

    <TextBlock Classes="section" Text="الخيارات" />
    <pg:PlayText Classes="p" Markup="كل ما في مركز الإشعارات من عناصر وخصائص وأحداث، في صندوق يفتح بالنقر." />
    <pg:OptionsList Defs="{x:Static pg:NotifyPlay.All}" />
  </StackPanel>
</UserControl>
