<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pg="using:Insiyab.Avalonia.Gallery.Playground"
             x:Class="Insiyab.Avalonia.Gallery.Pages.TooltipsPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Playground/PlayFrames.axaml" />
  </UserControl.Styles>

  <StackPanel>
    <TextBlock Classes="intro" Text="تلميح بخاصية تضعها على العنصر، يظهر في الطبقة العليا فلا يقصه لوح ولا جدول." />
    <pg:PlayExample Layout="Row" Code="{x:Static pg:TooltipsPlay.Example}" />

    <TextBlock Classes="section" Text="التلميح" />
    <pg:PlayText Classes="p" Markup="ضع `ToolTip.Tip` على العنصر، ولزر الأيقونة اجعله اسمه نفسه في `AutomationProperties.Name`. وتجد الخيارات كلها بشرحها في آخر الصفحة." />
    <pg:Playground Def="{x:Static pg:TooltipsPlay.Tip}" />

    <TextBlock Classes="section" Text="السلوك" />
    <pg:PlayText Classes="p" Markup="يظهر التلميح حين يقف عليه المؤشر لحظة، وفي الحال حين تنتقل من تلميح إلى جاره. ويختفي بمفتاح `Esc`، وبالضغط، وحين يغادر المؤشر العنصر." />

    <TextBlock Classes="section" Text="الخيارات" />
    <pg:PlayText Classes="p" Markup="كل ما في التلميح من خصائص، في صندوق يفتح بالنقر." />
    <pg:OptionsList Defs="{x:Static pg:TooltipsPlay.All}" />
  </StackPanel>
</UserControl>
