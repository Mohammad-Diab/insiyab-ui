<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pg="using:Insiyab.Avalonia.Gallery.Playground"
             x:Class="Insiyab.Avalonia.Gallery.Pages.QuotePage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Playground/PlayFrames.axaml" />
  </UserControl.Styles>

  <StackPanel>
    <TextBlock Classes="intro" Text="نص منقول بمصدره، وعلامة تحيل إلى مرجع، وتظليل يربط أجزاء النص بملاحظات تشرح سببها." />
    <pg:PlayExample Layout="Stack" Code="{x:Static pg:QuotePlay.Example}" />

    <TextBlock Classes="section" Text="الاقتباس ومصدره" />
    <pg:PlayText Classes="p" Markup="إذا نقلت نصًا من مكان آخر فضعه في `Border` بالكلاس `quote`، واكتب مصدره في `ContentControl` بالكلاس `quote-source`. وتجد الخيارات كلها بشرحها في آخر الصفحة." />
    <pg:Playground Def="{x:Static pg:QuotePlay.Quote}" />

    <TextBlock Classes="section" Text="علامة المرجع" />
    <pg:PlayText Classes="p" Markup="`ins:Ref` علامة صغيرة مرقمة في متن النص، تحيل إلى مصدر أو ملاحظة." />
    <pg:Playground Def="{x:Static pg:QuotePlay.Ref}" />

    <TextBlock Classes="section" Text="التظليل" />
    <pg:PlayText Classes="p" Markup="يظلل `ins:Mark` جزءًا من النص بإحدى النبرات، وتربطه `Note` بملاحظة تشرح سبب تظليله." />
    <pg:Playground Def="{x:Static pg:QuotePlay.Mark}" />

    <TextBlock Classes="section" Text="الملاحظة" />
    <pg:PlayText Classes="p" Markup="`ins:Note` تعليق على النص بنبرة من النبرات نفسها، يشير إليه التظليل أو علامة المرجع." />
    <pg:Playground Def="{x:Static pg:QuotePlay.Note}" />

    <TextBlock Classes="section" Text="الخيارات" />
    <pg:PlayText Classes="p" Markup="كل ما في الاقتباس والمرجع والتظليل من عناصر وكلاسات وخصائص، لكل مكون صندوق يفتح بالنقر." />
    <pg:OptionsList Defs="{x:Static pg:QuotePlay.All}" />
  </StackPanel>
</UserControl>
