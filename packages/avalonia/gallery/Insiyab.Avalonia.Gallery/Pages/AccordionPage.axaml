<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pg="using:Insiyab.Avalonia.Gallery.Playground"
             x:Class="Insiyab.Avalonia.Gallery.Pages.AccordionPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Playground/PlayFrames.axaml" />
  </UserControl.Styles>

  <StackPanel>
    <TextBlock Classes="intro" Text="أقسام تنطوي وتنفتح، مبنية على Expander نفسه، فتعمل بالنقر وبلوحة المفاتيح." />
    <pg:PlayExample Layout="Stack" Code="{x:Static pg:AccordionPlay.Example}" />

    <TextBlock Classes="section" Text="الأكورديون" />
    <pg:PlayText Classes="p" Markup="يجمع `StackPanel.accordion` أقسامًا من `Expander`، فتنفتح بالنقر وبلوحة المفاتيح، وتنساب وهي تنفتح. وتجد الخيارات كلها بشرحها في آخر الصفحة." />
    <pg:Playground Def="{x:Static pg:AccordionPlay.Accordion}" />

    <TextBlock Classes="section" Text="قسم منفرد" />
    <pg:PlayText Classes="p" Markup="ويصلح `Expander` وحده أيضًا، خارج الأكورديون." />
    <pg:Playground Def="{x:Static pg:AccordionPlay.Collapse}" />

    <TextBlock Classes="section" Text="الخيارات" />
    <pg:PlayText Classes="p" Markup="كل ما في الأكورديون من عناصر وكلاسات وخصائص، لكل مكون صندوق يفتح بالنقر." />
    <pg:OptionsList Defs="{x:Static pg:AccordionPlay.All}" />
  </StackPanel>
</UserControl>
