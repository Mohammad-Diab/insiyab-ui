<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pg="using:Insiyab.Avalonia.Gallery.Playground"
             x:Class="Insiyab.Avalonia.Gallery.Pages.TimelinePage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Playground/PlayFrames.axaml" />
  </UserControl.Styles>

  <StackPanel>
    <TextBlock Classes="intro" Text="ما جرى بترتيبه: مسار طلب، أو نشاط حساب، أو تاريخ ملف، وأوقات نسبية تُكتب كما تُقال." />
    <pg:PlayExample Layout="Stack" Code="{x:Static pg:TimelinePlay.Example}" />

    <TextBlock Classes="section" Text="الخط الزمني" />
    <pg:PlayText Classes="p" Markup="الخط الزمني `ins:Timeline` لكل حدث فيه نقطة، ويفصل `ins:TimelineDay` بين الأيام بعنوان. ويأخذ الحدث الجاري `IsCurrent`، والذي لم يأت بعد `IsPending`. وتجد الخيارات كلها بشرحها في آخر الصفحة." />
    <pg:Playground Def="{x:Static pg:TimelinePlay.Timeline}" />

    <TextBlock Classes="section" Text="التحكم من الشيفرة" />
    <pg:PlayListing Code="{x:Static pg:TimelinePlay.Code}" Margin="0,0,0,24" />

    <TextBlock Classes="section" Text="الخيارات" />
    <pg:PlayText Classes="p" Markup="كل ما في الخط الزمني من كلاسات وخصائص، في صندوق يفتح بالنقر." />
    <pg:OptionsList Defs="{x:Static pg:TimelinePlay.All}" />
  </StackPanel>
</UserControl>
