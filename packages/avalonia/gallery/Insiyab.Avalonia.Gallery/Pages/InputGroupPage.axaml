<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pg="using:Insiyab.Avalonia.Gallery.Playground"
             x:Class="Insiyab.Avalonia.Gallery.Pages.InputGroupPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Playground/PlayFrames.axaml" />
  </UserControl.Styles>

  <StackPanel>
    <TextBlock Classes="intro" Text="حقل وملحقاته قطعة واحدة: وحدة قياس، أو بادئة، أو زر، أو إظهار كلمة المرور." />
    <pg:PlayExample Layout="Stack" Code="{x:Static pg:InputGroupPlay.Example}" />

    <TextBlock Classes="section" Text="مجموعة الحقل" />
    <pg:PlayText Classes="p" Markup="يضم الكلاس `input-group` على `TextBox` الحقل وملحقاته في قطعة واحدة، لها إطار واحد وحلقة تركيز واحدة. والملحق `ContentControl` بالكلاس `addon` في أول الحقل أو آخره. وتجد الخيارات كلها بشرحها في آخر الصفحة." />
    <pg:Playground Def="{x:Static pg:InputGroupPlay.Group}" />

    <TextBlock Classes="section" Text="إظهار كلمة المرور" />
    <pg:PlayText Classes="p" Markup="يضع الكلاس `revealPasswordButton` زر العين في آخر حقل كلمة المرور، فتظهر أو تختفي، ويخبر قارئ الشاشة بحالته." />
    <pg:Playground Def="{x:Static pg:InputGroupPlay.Password}" />

    <TextBlock Classes="section" Text="العداد" />
    <pg:PlayText Classes="p" Markup="يحيط زران بحقل `NumericUpDown` الرقمي، فيزيدانه وينقصانه بخطوة `Increment` ولا يتجاوزان `Minimum` و`Maximum`." />
    <pg:Playground Def="{x:Static pg:InputGroupPlay.Stepper}" />

    <TextBlock Classes="section" Text="الخيارات" />
    <pg:PlayText Classes="p" Markup="كل ما في مجموعات الحقول من عناصر وكلاسات وخصائص، لكل مكون صندوق يفتح بالنقر." />
    <pg:OptionsList Defs="{x:Static pg:InputGroupPlay.All}" />
  </StackPanel>
</UserControl>
