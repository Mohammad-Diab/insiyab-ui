<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pg="using:Insiyab.Avalonia.Gallery.Playground"
             x:Class="Insiyab.Avalonia.Gallery.Pages.DialogPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Playground/PlayFrames.axaml" />
  </UserControl.Styles>

  <StackPanel>
    <TextBlock Classes="intro" Text="لوح فوق النافذة المعتمة، يحبس التركيز ما دام مفتوحًا، ويغلقه Esc ويعيد التركيز إلى الزر الذي فتحه." />
    <pg:PlayExample Layout="Row" Code="{x:Static pg:DialogPlay.Example}" />

    <TextBlock Classes="section" Text="مربع الحوار" />
    <pg:PlayText Classes="p" Markup="يفتح `ins:Dialog` زرٌ يحمل `ins:Dialog.Opens`، ويبقى التركيز محبوسًا فيه حتى يُغلق. أما النقر خارجه فلا يغلقه، حتى لا تذهب نقرة شاردة بما كتبته فيه. وتجد الخيارات كلها بشرحها في آخر الصفحة." />
    <pg:Playground Def="{x:Static pg:DialogPlay.Dialog}" />
    <pg:PlayText Classes="p" Markup="وأزرار الذيل على قاعدة واحدة في المكتبة كلها، في الحوار والدرج والتأكيد والنوافذ المنبثقة: تصطف في نهاية السطر، والزر الرئيسي آخرها وقبله زر الإلغاء، وما لا يُنهي الحوار، كالحذف أو «اليوم»، يقف وحده في أوله. وعلى الهاتف تتقاسم الأزرار العرض بارتفاع يناسب الإصبع." />
    <pg:PlayText Classes="p" Markup="وإذا فتحت حوارًا من حوار، أظلمت النافذة مرة واحدة وبقي الأول خلف الثاني. ويغلق `Esc` والنقر خارجه أعلاهما وحده، ثم يعود التركيز إلى الزر الذي فتحه. وعلى الحاسوب تفتحه `ShowAsWindowAsync` في نافذة منفصلة إن شئت." />

    <TextBlock Classes="section" Text="التأكيد" />
    <pg:PlayText Classes="p" Markup="ضع `ins:Dialog.Confirm` على زر، فيسأل المستخدم قبل أن يمضي الإجراء. وإذا كان الزر من أزرار الخطر جاء زر التأكيد أحمر تلقائيًا. ومن الشيفرة تعيد `Dialog.ConfirmAsync` القيمة `true` أو `false`." />
    <pg:Playground Def="{x:Static pg:DialogPlay.Confirm}" />

    <TextBlock Classes="section" Text="الخيارات" />
    <pg:PlayText Classes="p" Markup="كل ما في مربع الحوار والتأكيد من عناصر وكلاسات وخصائص، لكل منهما صندوق يفتح بالنقر." />
    <pg:OptionsList Defs="{x:Static pg:DialogPlay.All}" />
  </StackPanel>
</UserControl>
