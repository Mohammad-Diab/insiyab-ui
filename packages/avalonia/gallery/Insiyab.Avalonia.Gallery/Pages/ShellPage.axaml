<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pg="using:Insiyab.Avalonia.Gallery.Playground"
             x:Class="Insiyab.Avalonia.Gallery.Pages.ShellPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Playground/PlayFrames.axaml" />
  </UserControl.Styles>

  <StackPanel>
    <TextBlock Classes="intro" Text="شريط جانبي من زجاج، وشريط علوي من جزر عائمة، وهذا المعرض نفسه مبني بهما." />

    <TextBlock Classes="section" Text="البنية" />
    <pg:PlayText Classes="p" Markup="يقوم الهيكل على `SplitView`: شريط جانبي في `Pane` يضم الهوية ومجموعات الروابط، وعمود رئيسي يضم الشريط العلوي والمحتوى، ويتبعان اتجاه الواجهة. اضغط زر القائمة فيه لتطوي الشريط." />
    <pg:PlayExample Layout="Stack" Code="{x:Static pg:ShellPlay.StructureExample}" />

    <TextBlock Classes="section" Text="الشريط العلوي: جزر عائمة" />
    <pg:PlayText Classes="p" Markup="الشريط العلوي `Border.topbar` شفاف، تطفو عليه جزر زجاجية موزعة على ثلاث مناطق: `zone start` و`zone center` و`zone end`. فإذا مر المحتوى تحته عند التمرير صار زجاجًا مصنفرًا. وكل ما في الشريط جزيرة، فتتشارك الجزر الارتفاع والحد والظل، وتبدو سطرًا واحدًا من الأشياء لا شريط أدوات. وتجد الخيارات كلها بشرحها في آخر الصفحة." />
    <pg:Playground Def="{x:Static pg:ShellPlay.Topbar}" />

    <TextBlock Classes="section" Text="الشريط الجانبي" />
    <pg:PlayText Classes="p" Markup="رأس الشريط ثابت، والروابط وحدها تتمرر تحته، كما يليق بتطبيق سطح المكتب. ومع `ins:Shell.HeadScrolls` يتمرر الرأس معها، كما في الويب." />
    <pg:Playground Def="{x:Static pg:ShellPlay.Sidebar}" />

    <TextBlock Classes="section" Text="الطي والدرج" />
    <pg:PlayText Classes="p" Markup="أي زر يحمل `ins:Shell.TogglesSidebar` يطوي الشريط على الحاسوب. فإذا ضاق الهيكل عن 900 صار الشريط درجًا مغلقًا يفتحه الزر نفسه، ويغلقه النقر على الخلفية أو مفتاح `Esc`. اضغط زر القائمة في هذا الهيكل الضيق فيفتح الدرج." />
    <pg:PlayExample Layout="Row" Code="{x:Static pg:ShellPlay.DrawerExample}" />

    <TextBlock Classes="section" Text="الخيارات" />
    <pg:PlayText Classes="p" Markup="كل ما في هيكل التطبيق من عناصر وكلاسات وخصائص وأحداث، لكل جزء صندوق يفتح بالنقر." />
    <pg:OptionsList Defs="{x:Static pg:ShellPlay.All}" />
  </StackPanel>
</UserControl>
