<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ins="using:Insiyab.Avalonia.Controls"
             x:Class="Insiyab.Avalonia.Gallery.Pages.ShellPage">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="DemoViewBd" Color="#1A0F172A" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="DemoViewBd" Color="#1AFFFFFF" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <SolidColorBrush x:Key="DemoViewBg" Color="{DynamicResource InsPrimaryColor}" Opacity="0.025" />
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Border.ex">
      <Setter Property="Padding" Value="24" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource DemoViewBd}" />
      <Setter Property="CornerRadius" Value="{DynamicResource InsRLg}" />
      <Setter Property="Background" Value="{DynamicResource DemoViewBg}" />
    </Style>
    <Style Selector="Border.ex.flush">
      <Setter Property="Padding" Value="0" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.ex.play">
      <Setter Property="Padding" Value="24,64" />
    </Style>
    <Style Selector="TextBlock.h3">
      <Setter Property="Margin" Value="0,24,0,0" />
    </Style>
    <Style Selector="TextBlock.variant">
      <Setter Property="FontSize" Value="{DynamicResource InsFsXs}" />
      <Setter Property="Foreground" Value="{DynamicResource InsText2}" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="12">

    <TextBlock Classes="h3" Text="البنية" Margin="0" />
    <Border Classes="ex flush" Height="420">
      <SplitView Name="Demo" ins:Shell.DrawerWidth="600" IsPaneOpen="True">
        <SplitView.Pane>
          <DockPanel>
            <Border Classes="shell-brand" DockPanel.Dock="Top">
              <StackPanel>
                <Border Classes="shell-mark"><TextBlock Text="م" /></Border>
                <StackPanel>
                  <TextBlock Classes="shell-brand-name" Text="تطبيقي" />
                  <TextBlock Classes="shell-brand-role" Text="الإدارة" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Classes="shell-bottom" DockPanel.Dock="Bottom">
              <Button Classes="shell-link">
                <StackPanel Orientation="Horizontal">
                  <ins:Icon Data="{StaticResource IconArrow}" />
                  <TextBlock Text="خروج" />
                </StackPanel>
              </Button>
            </Border>
            <ListBox Classes="shell-nav" SelectedIndex="1">
              <ListBoxItem Classes="shell-group" Content="القسم" />
              <ListBoxItem>
                <StackPanel Orientation="Horizontal">
                  <ins:Icon Data="{StaticResource IconHome}" />
                  <TextBlock Text="الرئيسية" />
                </StackPanel>
              </ListBoxItem>
              <ListBoxItem>
                <DockPanel>
                  <ins:Icon Data="{StaticResource IconCart}" />
                  <Border Classes="shell-link-badge" DockPanel.Dock="Right"><TextBlock Text="8" /></Border>
                  <TextBlock Text="الطلبات" />
                </DockPanel>
              </ListBoxItem>
            </ListBox>
          </DockPanel>
        </SplitView.Pane>
        <Panel>
          <ScrollViewer ins:Shell.FrostsTopbar="True">
            <Border Classes="shell-content" Margin="0,72,0,0" />
          </ScrollViewer>
          <Border Classes="topbar" VerticalAlignment="Top">
            <Grid ColumnDefinitions="*,Auto,*">
              <StackPanel Classes="zone start">
                <Button Classes="island icon" ins:Shell.TogglesSidebar="True" ToolTip.Tip="القائمة">
                  <ins:Icon Data="{StaticResource IconMenu}" />
                </Button>
                <Border Classes="island brand">
                  <StackPanel>
                    <Border Classes="shell-mark"><TextBlock Text="م" /></Border>
                    <TextBlock Text="تطبيقي" />
                  </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel Classes="zone center">
                <Border Classes="island title">
                  <StackPanel Classes="shell-head">
                    <TextBlock Classes="shell-title" Text="العنوان" />
                    <TextBlock Classes="shell-sub" Text="سطر فرعي" />
                  </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel Classes="zone end">
                <Button Classes="island icon" ToolTip.Tip="الإشعارات">
                  <ins:Icon Data="{StaticResource IconBell}" />
                </Button>
                <Button Classes="island" Content="حسابي">
                  <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                      <MenuItem Header="الملف الشخصي" />
                      <MenuItem Header="الإعدادات" />
                      <Separator />
                      <MenuItem Header="خروج" />
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
              </StackPanel>
            </Grid>
          </Border>
        </Panel>
      </SplitView>
    </Border>

    <TextBlock Classes="h3" Text="الشريط العلوي: جزر عائمة" />
    <Border Classes="ex play">
      <Border Classes="topbar">
        <Grid ColumnDefinitions="*,Auto,*">
          <StackPanel Classes="zone start">
            <Button Classes="island icon" ToolTip.Tip="القائمة"><ins:Icon Data="{StaticResource IconMenu}" /></Button>
          </StackPanel>
          <StackPanel Classes="zone center">
            <Border Classes="island title">
              <StackPanel Classes="shell-head">
                <TextBlock Classes="shell-title" Text="العنوان" />
                <TextBlock Classes="shell-sub" Text="سطر فرعي" />
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel Classes="zone end">
            <Button Classes="island icon" ToolTip.Tip="الإشعارات"><ins:Icon Data="{StaticResource IconBell}" /></Button>
            <Button Classes="island" Content="حسابي" />
          </StackPanel>
        </Grid>
      </Border>
    </Border>
    <Border Classes="ex">
      <StackPanel>
        <TextBlock Classes="variant" Text="بلا سطر فرعي" />
        <Border Classes="topbar">
          <Grid ColumnDefinitions="*,Auto,*">
            <StackPanel Classes="zone start">
              <Button Classes="island icon" ToolTip.Tip="القائمة"><ins:Icon Data="{StaticResource IconMenu}" /></Button>
            </StackPanel>
            <StackPanel Classes="zone center">
              <Border Classes="island title">
                <StackPanel Classes="shell-head">
                  <TextBlock Classes="shell-title" Text="العنوان" />
                </StackPanel>
              </Border>
            </StackPanel>
            <StackPanel Classes="zone end">
              <Button Classes="island icon" ToolTip.Tip="الإشعارات"><ins:Icon Data="{StaticResource IconBell}" /></Button>
              <Button Classes="island" Content="حسابي" />
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </Border>
    <Border Classes="ex">
      <StackPanel>
        <TextBlock Classes="variant" Text="بلا زر القائمة" />
        <Border Classes="topbar">
          <Grid ColumnDefinitions="*,Auto,*">
            <StackPanel Classes="zone start" />
            <StackPanel Classes="zone center">
              <Border Classes="island title">
                <StackPanel Classes="shell-head">
                  <TextBlock Classes="shell-title" Text="العنوان" />
                  <TextBlock Classes="shell-sub" Text="سطر فرعي" />
                </StackPanel>
              </Border>
            </StackPanel>
            <StackPanel Classes="zone end">
              <Button Classes="island icon" ToolTip.Tip="الإشعارات"><ins:Icon Data="{StaticResource IconBell}" /></Button>
              <Button Classes="island" Content="حسابي" />
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </Border>
    <Border Classes="ex">
      <StackPanel>
        <TextBlock Classes="variant" Text="في آخر الشريط: شارة" />
        <Border Classes="topbar">
          <Grid ColumnDefinitions="*,Auto,*">
            <StackPanel Classes="zone start">
              <Button Classes="island icon" ToolTip.Tip="القائمة"><ins:Icon Data="{StaticResource IconMenu}" /></Button>
            </StackPanel>
            <StackPanel Classes="zone center">
              <Border Classes="island title">
                <StackPanel Classes="shell-head">
                  <TextBlock Classes="shell-title" Text="العنوان" />
                  <TextBlock Classes="shell-sub" Text="سطر فرعي" />
                </StackPanel>
              </Border>
            </StackPanel>
            <StackPanel Classes="zone end">
              <ins:Pill Classes="ok" Content="متصل" />
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </Border>
    <Border Classes="ex">
      <StackPanel>
        <TextBlock Classes="variant" Text="في آخر الشريط: زر" />
        <Border Classes="topbar">
          <Grid ColumnDefinitions="*,Auto,*">
            <StackPanel Classes="zone start">
              <Button Classes="island icon" ToolTip.Tip="القائمة"><ins:Icon Data="{StaticResource IconMenu}" /></Button>
            </StackPanel>
            <StackPanel Classes="zone center">
              <Border Classes="island title">
                <StackPanel Classes="shell-head">
                  <TextBlock Classes="shell-title" Text="العنوان" />
                  <TextBlock Classes="shell-sub" Text="سطر فرعي" />
                </StackPanel>
              </Border>
            </StackPanel>
            <StackPanel Classes="zone end">
              <Button Classes="primary" Content="حفظ" />
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </Border>
    <Border Classes="ex">
      <StackPanel>
        <TextBlock Classes="variant" Text="جزيرة لا تُنقر" />
        <Border Classes="topbar">
          <Grid ColumnDefinitions="*,Auto,*">
            <StackPanel Classes="zone start">
              <Button Classes="island icon" ToolTip.Tip="القائمة"><ins:Icon Data="{StaticResource IconMenu}" /></Button>
            </StackPanel>
            <StackPanel Classes="zone center">
              <Border Classes="island title">
                <StackPanel Classes="shell-head">
                  <TextBlock Classes="shell-title" Text="العنوان" />
                  <TextBlock Classes="shell-sub" Text="سطر فرعي" />
                </StackPanel>
              </Border>
            </StackPanel>
            <StackPanel Classes="zone end">
              <Button Classes="island icon" ToolTip.Tip="الإشعارات"><ins:Icon Data="{StaticResource IconBell}" /></Button>
              <Border Classes="island"><TextBlock Text="مسودة" /></Border>
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </Border>

    <TextBlock Classes="h3" Text="الطي والدرج" />
    <Border Classes="ex">
      <Button Classes="secondary" Content="اطوِ الشريط الجانبي" ins:Shell.TogglesSidebar="True" />
    </Border>
    <Border Classes="ex">
      <StackPanel>
        <TextBlock Classes="variant" Text="على شاشة ضيقة: الشريط درج مغلق يفتحه زر القائمة" />
        <Border Classes="ex flush" Width="390" Height="300" HorizontalAlignment="Left">
          <SplitView>
            <SplitView.Pane>
              <ListBox Classes="shell-nav" SelectedIndex="1">
                <ListBoxItem Classes="shell-group" Content="القسم" />
                <ListBoxItem>
                  <StackPanel Orientation="Horizontal">
                    <ins:Icon Data="{StaticResource IconHome}" />
                    <TextBlock Text="الرئيسية" />
                  </StackPanel>
                </ListBoxItem>
              </ListBox>
            </SplitView.Pane>
            <Border Classes="topbar" VerticalAlignment="Top">
              <Grid ColumnDefinitions="*,Auto,*">
                <StackPanel Classes="zone start">
                  <Button Classes="island icon" ins:Shell.TogglesSidebar="True" ToolTip.Tip="القائمة"><ins:Icon Data="{StaticResource IconMenu}" /></Button>
                </StackPanel>
                <StackPanel Classes="zone center">
                  <Border Classes="island title">
                    <StackPanel Classes="shell-head"><TextBlock Classes="shell-title" Text="العنوان" /></StackPanel>
                  </Border>
                </StackPanel>
              </Grid>
            </Border>
          </SplitView>
        </Border>
      </StackPanel>
    </Border>
    <Border Classes="ex">
      <StackPanel>
        <TextBlock Classes="variant" Text="والدرج مفتوحًا فوق خلفية تغطي الصفحة" />
        <Border Classes="ex flush" Width="390" Height="300" HorizontalAlignment="Left">
          <SplitView Name="OpenDrawer">
            <SplitView.Pane>
              <ListBox Classes="shell-nav" SelectedIndex="1">
                <ListBoxItem Classes="shell-group" Content="القسم" />
                <ListBoxItem>
                  <StackPanel Orientation="Horizontal">
                    <ins:Icon Data="{StaticResource IconHome}" />
                    <TextBlock Text="الرئيسية" />
                  </StackPanel>
                </ListBoxItem>
              </ListBox>
            </SplitView.Pane>
            <Border Classes="topbar" VerticalAlignment="Top">
              <Grid ColumnDefinitions="*,Auto,*">
                <StackPanel Classes="zone start">
                  <Button Classes="island icon" ins:Shell.TogglesSidebar="True" ToolTip.Tip="القائمة"><ins:Icon Data="{StaticResource IconMenu}" /></Button>
                </StackPanel>
                <StackPanel Classes="zone center">
                  <Border Classes="island title">
                    <StackPanel Classes="shell-head"><TextBlock Classes="shell-title" Text="العنوان" /></StackPanel>
                  </Border>
                </StackPanel>
              </Grid>
            </Border>
          </SplitView>
        </Border>
      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>
