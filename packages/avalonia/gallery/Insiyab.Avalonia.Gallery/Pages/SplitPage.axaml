<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pg="using:Insiyab.Avalonia.Gallery.Playground"
             x:Class="Insiyab.Avalonia.Gallery.Pages.SplitPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Playground/PlayFrames.axaml" />
    <Style Selector="Panel.demo-box">
      <Setter Property="MinHeight" Value="80" />
    </Style>
    <Style Selector="Panel.demo-box > Rectangle">
      <Setter Property="RadiusX" Value="10" />
      <Setter Property="RadiusY" Value="10" />
      <Setter Property="Fill" Value="{DynamicResource InsToneBrandBg}" />
      <Setter Property="Stroke" Value="{DynamicResource InsToneBrandBd}" />
      <Setter Property="StrokeThickness" Value="1" />
      <Setter Property="StrokeDashArray" Value="4,3" />
    </Style>
    <Style Selector="Panel.demo-box > TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="{DynamicResource InsFontBodyEn}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource InsToneBrand}" />
    </Style>
  </UserControl.Styles>

  <StackPanel>
    <TextBlock Classes="intro" Text="لوحان يتقاسمان العرض بخط تسحبه: مستند بجانب نموذجه، أو قائمة بجانب ما تفتحه منها." />
    <pg:PlayExample Layout="Stack" Code="{x:Static pg:SplitPlay.Example}" />

    <TextBlock Classes="section" Text="العرض المقسوم" />
    <pg:PlayText Classes="p" Markup="يضع `ins:Split` لوحين جنبًا إلى جنب يتقاسمان العرض، ويفصل بينهما خط تسحبه فتتبدل القسمة: مستند بجوار النموذج الخاص به، أو قائمة بجوار العنصر الذي تفتحه منها. ويتمرر كل لوح وحده، فإذا ضاق عن 640 صار اللوحان أحدهما فوق الآخر. وتجد الخيارات كلها بشرحها في آخر الصفحة." />
    <pg:Playground Def="{x:Static pg:SplitPlay.Split}" />

    <TextBlock Classes="section" Text="الخيارات" />
    <pg:PlayText Classes="p" Markup="كل ما في العرض المقسوم من عناصر وخصائص وأحداث." />
    <pg:OptionsList Defs="{x:Static pg:SplitPlay.All}" />
  </StackPanel>
</UserControl>
