<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Insiyab.Avalonia.Gallery.Pages.WindowPage">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="16" MaxWidth="640" HorizontalAlignment="Left">
      <TextBlock Text="خلفية النافذة هي نفسها خلفية الصفحة على الويب: تدرّج خفيف من لون العلامة وبقع ضوء ناعمة."
                 TextWrapping="Wrap" />

      <Grid ColumnDefinitions="Auto,16,*" RowDefinitions="Auto,8,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="مستوى الشفافية الذي منحه النظام:" />
        <TextBlock Grid.Row="0" Grid.Column="2" x:Name="Level" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
        <TextBlock Grid.Row="2" Grid.Column="0" Text="الخامة الشفافة:" />
        <TextBlock Grid.Row="2" Grid.Column="2" x:Name="State" />
      </Grid>

      <TextBlock x:Name="Explain" TextWrapping="Wrap" />

      <ToggleSwitch x:Name="MaterialSwitch" IsChecked="True"
                    OnContent="اطلب الخامة من النظام" OffContent="النافذة معتمة دائما" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
