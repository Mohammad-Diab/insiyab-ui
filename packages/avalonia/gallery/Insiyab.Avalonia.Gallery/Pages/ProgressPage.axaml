<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pg="using:Insiyab.Avalonia.Gallery.Playground"
             x:Class="Insiyab.Avalonia.Gallery.Pages.ProgressPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Playground/PlayFrames.axaml" />
  </UserControl.Styles>

  <StackPanel>
    <TextBlock Classes="intro" Text="شريط للتقدم، وحلقة للنسب المئوية." />
    <pg:PlayExample Layout="Stack" Code="{x:Static pg:ProgressPlay.Example}" />

    <TextBlock Classes="section" Text="الشريط" />
    <pg:PlayText Classes="p" Markup="يقوم الشريط على `ProgressBar` الأصلي، فيعلن قارئ الشاشة قيمته. واجعل نبرته تتبع المعنى: فالمساحة التي امتلأ أكثرها تحذير، لا لون العلامة. وتجد الخيارات كلها بشرحها في آخر الصفحة." />
    <pg:Playground Def="{x:Static pg:ProgressPlay.Bar}" />

    <TextBlock Classes="section" Text="الحلقة" />
    <pg:PlayText Classes="p" Markup="تعرض `ins:ProgressRing` النسبة حين تضيق المساحة. تضع القيمة في `Value`، فيقرؤها قارئ الشاشة وتمتلئ منها الحلقة وتُكتب في وسطها." />
    <pg:Playground Def="{x:Static pg:ProgressPlay.Ring}" />

    <TextBlock Classes="section" Text="الخيارات" />
    <pg:PlayText Classes="p" Markup="كل ما في الشريط والحلقة من كلاسات وخصائص، لكل مكون صندوق يفتح بالنقر." />
    <pg:OptionsList Defs="{x:Static pg:ProgressPlay.All}" />
  </StackPanel>
</UserControl>
