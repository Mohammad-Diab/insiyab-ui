<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pg="using:Insiyab.Avalonia.Gallery.Playground"
             x:Class="Insiyab.Avalonia.Gallery.Pages.TabsPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Playground/PlayFrames.axaml" />
  </UserControl.Styles>

  <StackPanel>
    <TextBlock Classes="intro" Text="تبويبات تبدل الألواح بالنقر وبالأسهم، في ثلاث هيئات: عادية، وبخط، وشريط مقسم." />
    <pg:PlayExample Layout="Stack" Code="{x:Static pg:TabsPlay.Example}" />

    <TextBlock Classes="section" Text="علامات التبويب" />
    <pg:PlayText Classes="p" Markup="يضم `TabControl` تبويبات `TabItem`، لكل تبويب عنوانه في `Header` ولوحه في `Content`، وتتنقل بينها أسهم لوحة المفاتيح مع اتجاه الواجهة. وتجد الخيارات كلها بشرحها في آخر الصفحة." />
    <pg:Playground Def="{x:Static pg:TabsPlay.Tabs}" />

      <TextBlock Classes="h2" Text="علامات التبويب" />

    <TextBlock Classes="section" Text="الخيارات" />
    <pg:PlayText Classes="p" Markup="كل ما في علامات التبويب من عناصر وكلاسات وخصائص وأحداث، في صندوق يفتح بالنقر." />
    <pg:OptionsList Defs="{x:Static pg:TabsPlay.All}" />
  </StackPanel>
</UserControl>
