<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ins="using:Insiyab.Avalonia.Controls"
             xmlns:pg="using:Insiyab.Avalonia.Gallery.Playground"
             x:Class="Insiyab.Avalonia.Gallery.Pages.MonthPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Playground/PlayFrames.axaml" />
  </UserControl.Styles>

  <StackPanel>
    <TextBlock Classes="intro" Text="شهر على شبكة بمواعيد كل يوم، أو أسبوع أو يوم بالساعات، ويبدأ أسبوعه كما تبدؤه لغة الواجهة." />
    <pg:PlayExample Layout="Stack" Code="{x:Static pg:MonthPlay.Example}" Stage="{x:Static pg:MonthPlay.ExampleStage}" />

    <TextBlock Classes="section" Text="شهر بمواعيده" />
    <pg:PlayText Classes="p" Markup="اجعل في `ins:MonthCalendar` الشهر `Month`، ومواعيده في `Events`، لكل موعد يومه. ومنها يرسم الشهر جدول أسابيع يميز اليوم الحالي، وعلى الهاتف تصير المواعيد نقاطًا. ومن مبدّل العرض في رأسه تنتقل إلى الأسبوع أو اليوم، فيقع كل موعد في ساعته بطول مدته. ويعرض الأسبوع واليوم ساعات الدوام وحدها، من 6:00 ص إلى 6:00 م، ومن زر «ساعات الدوام» في رأسه ترى اليوم كله. وتجد الخيارات كلها بشرحها في آخر الصفحة." />
    <pg:Playground Def="{x:Static pg:MonthPlay.Month}" />

    <TextBlock Classes="section" Text="الأحداث" />
    <pg:PlayText Classes="p" Markup="إذا انتقلت إلى شهر آخر أُطلق `MonthChanged` ومعه الشهر الجديد، فتضع الصفحة مواعيده في `Events`. وفي الأسبوع واليوم يُطلق `DateChanged` ومعه اليوم الجديد. وإذا نقرت على يوم في موضع خال من مواعيده أُطلق `DayInvoked` ومعه تاريخه، وساعته في الأسبوع واليوم." />
    <pg:PlayListing Code="{x:Static pg:MonthPlay.Code}" Margin="0,0,0,24" />

    <TextBlock Classes="section" Text="الخيارات" />
    <pg:PlayText Classes="p" Markup="كل ما في تقويم الشهر من خصائص وأحداث، في صندوق يفتح بالنقر." />
    <pg:OptionsList Defs="{x:Static pg:MonthPlay.All}" />
  </StackPanel>
</UserControl>
