<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ins="using:Insiyab.Avalonia.Controls"
             x:Class="Insiyab.Avalonia.Gallery.Pages.PaginationPage">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="DemoViewBd" Color="#1A0F172A" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="DemoViewBd" Color="#1AFFFFFF" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <SolidColorBrush x:Key="DemoViewBg" Color="{DynamicResource InsPrimaryColor}" Opacity="0.025" />
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Border.ex">
      <Setter Property="Padding" Value="24" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource DemoViewBd}" />
      <Setter Property="CornerRadius" Value="{DynamicResource InsRLg}" />
      <Setter Property="Background" Value="{DynamicResource DemoViewBg}" />
    </Style>
    <Style Selector="Border.ex.play">
      <Setter Property="Padding" Value="24,64" />
    </Style>
    <Style Selector="TextBlock.h3">
      <Setter Property="Margin" Value="0,24,0,0" />
    </Style>
    <Style Selector="TextBlock.variant">
      <Setter Property="FontSize" Value="{DynamicResource InsFsXs}" />
      <Setter Property="Foreground" Value="{DynamicResource InsText2}" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="12">

    <Border Classes="ex">
      <ins:Pagination PageCount="12" CurrentPage="3" />
    </Border>

    <TextBlock Classes="h3" Text="الترقيم" />
    <Border Classes="ex play">
      <ins:Pagination PageCount="12" CurrentPage="3" HorizontalAlignment="Center" />
    </Border>
    <Border Classes="ex">
      <StackPanel>
        <TextBlock Classes="variant" Text="الصفحة الحالية: الأولى" />
        <ins:Pagination PageCount="12" CurrentPage="1" />
      </StackPanel>
    </Border>
    <Border Classes="ex">
      <StackPanel>
        <TextBlock Classes="variant" Text="الصفحة الحالية: الأخيرة" />
        <ins:Pagination PageCount="12" CurrentPage="12" />
      </StackPanel>
    </Border>
    <Border Classes="ex">
      <StackPanel>
        <TextBlock Classes="variant" Text="مختصر" />
        <ins:Pagination PageCount="12" CurrentPage="3" IsCompact="True" />
      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>
