<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pg="using:Insiyab.Avalonia.Gallery.Playground"
             x:Class="Insiyab.Avalonia.Gallery.Pages.PaginationPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Playground/PlayFrames.axaml" />
  </UserControl.Styles>

  <StackPanel>
    <TextBlock Classes="intro" Text="أزرار للصفحات، وأسهمها تتبع اتجاه النص." />
    <pg:PlayExample Layout="Row" Code="{x:Static pg:PaginationPlay.Example}" />

    <TextBlock Classes="section" Text="الترقيم" />
    <pg:PlayText Classes="p" Markup="يبني `ins:Pagination` أزرار الصفحات من `PageCount` و`CurrentPage`، ويتبع السهمان اتجاه القراءة، فيشير «السابق» إلى اليمين في الواجهة العربية. وتجد الخيارات كلها بشرحها في آخر الصفحة." />
    <pg:Playground Def="{x:Static pg:PaginationPlay.Pages}" />

    <TextBlock Classes="section" Text="الخيارات" />
    <pg:PlayText Classes="p" Markup="كل ما في الترقيم من خصائص وأحداث، في صندوق يفتح بالنقر." />
    <pg:OptionsList Defs="{x:Static pg:PaginationPlay.All}" />
  </StackPanel>
</UserControl>
