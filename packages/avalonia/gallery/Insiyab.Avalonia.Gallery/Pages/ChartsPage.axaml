<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pg="using:Insiyab.Avalonia.Gallery.Playground"
             x:Class="Insiyab.Avalonia.Gallery.Pages.ChartsPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Playground/PlayFrames.axaml" />
  </UserControl.Styles>

  <StackPanel>
    <TextBlock Classes="intro" Text="أعمدة وخطوط وحلقات وتوزيعات ترسم من سلاسل أرقام، بألوان المكتبة واتجاه القراءة، وتبقى أرقامها مقروءة لقارئ الشاشة." />
    <pg:PlayExample Layout="Stack" Code="{x:Static pg:ChartsPlay.Example}" />

    <TextBlock Classes="section" Text="الرسم البياني" />
    <pg:PlayText Classes="p" Markup="ضع في `ins:Chart` سلاسل `ins:ChartSeries`، وأسماء الفئات في `Labels`، ونوع الرسم في `Type`. وتسير الفئات مع اتجاه القراءة، وتُنسق الأرقام بأرقام لاتينية. وارتفاع الرسم في `PlotHeight`، وألوان سلاسله في `Brush1` إلى `Brush6`." />
    <pg:Playground Def="{x:Static pg:ChartsPlay.Chart}" />

    <TextBlock Classes="section" Text="التحكم من الشيفرة" />
    <pg:PlayText Classes="p" Markup="تغير السلاسل وقيمها من الشيفرة، فيُعاد الرسم وحده، ويقرأ قارئ الشاشة الأرقام الجديدة." />
    <pg:PlayListing Code="{x:Static pg:ChartsPlay.Code}" Margin="0,0,0,24" />

    <TextBlock Classes="section" Text="الخيارات" />
    <pg:PlayText Classes="p" Markup="كل ما في الرسوم البيانية من عناصر وخصائص، في صندوق يفتح بالنقر." />
    <pg:OptionsList Defs="{x:Static pg:ChartsPlay.All}" />
  </StackPanel>
</UserControl>
