<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pg="using:Insiyab.Avalonia.Gallery.Playground"
             x:Class="Insiyab.Avalonia.Gallery.Pages.CommentsPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Playground/PlayFrames.axaml" />
  </UserControl.Styles>

  <StackPanel>
    <TextBlock Classes="intro" Text="كلام الناس في سلسلة: تعليق على سجل وردود عليه، أو رسائل محادثة." />
    <pg:PlayExample Layout="Stack" Code="{x:Static pg:CommentsPlay.Example}" />

    <TextBlock Classes="section" Text="التعليق" />
    <pg:PlayText Classes="p" Markup="يحمل `ins:Comment` كلام شخص واحد: صورته في `Avatar`، ثم اسمه ووقته في `Author` و`Time`، والنص في `Content`، وإن شئت أضفت إجراءات في `Actions`. وتجد الخيارات كلها بشرحها في آخر الصفحة." />
    <pg:Playground Def="{x:Static pg:CommentsPlay.Comment}" />

    <TextBlock Classes="section" Text="السلسلة والردود" />
    <pg:PlayText Classes="p" Markup="يرص الكلاس `thread` على `StackPanel` التعليقات بعضها فوق بعض، وإذا وضعت الردود في `Replies` أزاحها تحت التعليق إلى الداخل. وفي المحادثة تنتقل رسائلك بالكلاس `own` إلى الجهة المقابلة." />
    <pg:Playground Def="{x:Static pg:CommentsPlay.Thread}" />

    <TextBlock Classes="section" Text="الخيارات" />
    <pg:PlayText Classes="p" Markup="كل ما في التعليقات والرسائل من كلاسات وخصائص، لكل مكون صندوق يفتح بالنقر." />
    <pg:OptionsList Defs="{x:Static pg:CommentsPlay.All}" />
  </StackPanel>
</UserControl>
