<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pg="using:Insiyab.Avalonia.Gallery.Playground"
             x:Class="Insiyab.Avalonia.Gallery.Pages.PageHeadPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Playground/PlayFrames.axaml" />
  </UserControl.Styles>

  <StackPanel>
    <TextBlock Classes="intro" Text="عنوان الصفحة وسطر تحته وإجراءاتها، ومسار التنقل فوقها." />
    <pg:PlayExample Layout="Stack" Code="{x:Static pg:PageHeadPlay.Example}" />

    <TextBlock Classes="section" Text="رأس الصفحة" />
    <pg:PlayText Classes="p" Markup="يضم `ins:PageHead` العنوان وسطرًا تحته، ثم الإجراءات في آخره، وتنزل تحت العنوان إذا ضاق السطر. والمسار والإجراءات وسطر الوصف كلها اختيارية، وتجد الخيارات بشرحها في آخر الصفحة." />
    <pg:Playground Def="{x:Static pg:PageHeadPlay.Head}" />

    <TextBlock Classes="section" Text="مسار التنقل" />
    <pg:PlayText Classes="p" Markup="موضع `ins:Breadcrumb` الصفحات التي تقع على عمق ثلاثة مستويات فأكثر، أما الصفحة التي يبلغها الشريط الجانبي مباشرة فتستغني عنه، فالشريط يدل على مكانها. وإذا كان للصفحة مسار جاء في أول رأسها على سطر وحده." />
    <pg:Playground Def="{x:Static pg:PageHeadPlay.Crumbs}" />

    <TextBlock Classes="section" Text="الخيارات" />
    <pg:PlayText Classes="p" Markup="كل ما في رأس الصفحة ومسار التنقل من خصائص وأحداث، لكل مكون صندوق يفتح بالنقر." />
    <pg:OptionsList Defs="{x:Static pg:PageHeadPlay.All}" />
  </StackPanel>
</UserControl>
