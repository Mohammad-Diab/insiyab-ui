<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pg="using:Insiyab.Avalonia.Gallery.Playground"
             x:Class="Insiyab.Avalonia.Gallery.Pages.InputsPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Playground/PlayFrames.axaml" />
  </UserControl.Styles>

  <StackPanel>
    <TextBlock Classes="intro" Text="حقل النص والقائمة ومربع النص الطويل، بثلاثة مقاسات، ومعها التسمية والتلميح." />
    <pg:PlayExample Layout="Stack" Code="{x:Static pg:InputsPlay.Example}" />

    <TextBlock Classes="section" Text="الحقل" />
    <pg:PlayText Classes="p" Markup="يجمع `StackPanel` بالكلاس `field` التسمية والحقل والتلميح في عمود واحد. والحقل `TextBox` لكل ما يُكتب، ومعه `ComboBox` للقائمة، و`TextBox` بالخاصية `AcceptsReturn` للنص الطويل. وتجد الخيارات كلها بشرحها في آخر الصفحة." />
    <pg:Playground Def="{x:Static pg:InputsPlay.Field}" />

    <TextBlock Classes="section" Text="حقل البحث" />
    <pg:PlayText Classes="p" Markup="يضع الكلاس `search` أيقونة البحث داخل الحقل، فتأخذ لون الهوية إذا تركّز فيه." />
    <pg:Playground Def="{x:Static pg:InputsPlay.Search}" />

    <TextBlock Classes="section" Text="النموذج" />
    <pg:PlayText Classes="p" Markup="ترتب لوحات Avalonia الحقول في عمود أو سطر أو شبكة، ويجمع الكلاس `form-commit` أزرار الحفظ في آخر النموذج. أما التحقق من الحقول وإظهار رسائلها تحتها ففي صفحة التحقق." />
    <pg:Playground Def="{x:Static pg:InputsPlay.Form}" />

    <TextBlock Classes="section" Text="حقل بقناع" />
    <pg:PlayText Classes="p" Markup="يقبل `MaskedTextBox` قيمة بشكل ثابت، كرقم الجوال أو البطاقة، من عائلة حقلي الرمز وتاريخ الميلاد: أرقامه متساوية العرض، وأماكنه الفارغة باهتة حتى تمتلئ." />
    <pg:Playground Def="{x:Static pg:InputsPlay.Masked}" />

    <TextBlock Classes="section" Text="الخيارات" />
    <pg:PlayText Classes="p" Markup="كل ما في الحقول من عناصر وكلاسات وخصائص، لكل مكون صندوق يفتح بالنقر." />
    <pg:OptionsList Defs="{x:Static pg:InputsPlay.All}" />
  </StackPanel>
</UserControl>
