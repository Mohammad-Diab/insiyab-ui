<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ins="using:Insiyab.Avalonia.Controls"
             x:Class="Insiyab.Avalonia.Gallery.Pages.FilePage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Pages/PluginsFrames.axaml" />
  </UserControl.Styles>
  <ScrollViewer>
    <StackPanel>

      <TextBlock Classes="section" Text="منطقة السحب والإفلات" />
      <Border Classes="dx">
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="المرفقات" />
          <ins:FileUpload Multiple="True" Accept=".pdf,image/*" MaxSize="5MB" MaxCount="5" />
          <TextBlock Classes="hint" Text="ملفات PDF أو صور." />
        </StackPanel>
      </Border>

      <TextBlock Classes="section" Text="جرّب الحقل" />
      <Border Classes="stage wide">
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="المرفقات" />
          <ins:FileUpload Multiple="True" Accept=".pdf,image/*" MaxSize="5MB" MaxCount="5" />
          <TextBlock Classes="hint" Text="ملفات PDF أو صور." />
        </StackPanel>
      </Border>

      <TextBlock Classes="variant" Text="مضغوط" />
      <Border Classes="stage wide">
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="المرفقات" />
          <ins:FileUpload Multiple="True" Accept=".pdf,image/*" MaxSize="5MB" MaxCount="5" Classes="compact" />
          <TextBlock Classes="hint" Text="ملفات PDF أو صور." />
        </StackPanel>
      </Border>

      <TextBlock Classes="variant" Text="ملف واحد" />
      <Border Classes="stage wide">
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="المرفقات" />
          <ins:FileUpload Multiple="False" Accept=".pdf,image/*" MaxSize="5MB" />
          <TextBlock Classes="hint" Text="ملفات PDF أو صور." />
        </StackPanel>
      </Border>

      <TextBlock Classes="variant" Text="الأنواع المقبولة: كل الأنواع" />
      <Border Classes="stage wide">
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="المرفقات" />
          <ins:FileUpload Multiple="True" MaxSize="5MB" MaxCount="5" />
          <TextBlock Classes="hint" Text="أي نوع من الملفات." />
        </StackPanel>
      </Border>

      <TextBlock Classes="variant" Text="الأنواع المقبولة: صور فقط" />
      <Border Classes="stage wide">
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="المرفقات" />
          <ins:FileUpload Multiple="True" Accept="image/*" MaxSize="5MB" MaxCount="5" />
          <TextBlock Classes="hint" Text="صور فقط." />
        </StackPanel>
      </Border>

      <TextBlock Classes="variant" Text="أكبر حجم: 500KB" />
      <Border Classes="stage wide">
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="المرفقات" />
          <ins:FileUpload Multiple="True" Accept=".pdf,image/*" MaxSize="500KB" MaxCount="5" />
          <TextBlock Classes="hint" Text="ملفات PDF أو صور." />
        </StackPanel>
      </Border>

      <TextBlock Classes="variant" Text="أكبر حجم: بلا" />
      <Border Classes="stage wide">
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="المرفقات" />
          <ins:FileUpload Multiple="True" Accept=".pdf,image/*" MaxCount="5" />
          <TextBlock Classes="hint" Text="ملفات PDF أو صور." />
        </StackPanel>
      </Border>

      <TextBlock Classes="variant" Text="أكبر عدد: 2" />
      <Border Classes="stage wide">
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="المرفقات" />
          <ins:FileUpload Multiple="True" Accept=".pdf,image/*" MaxSize="5MB" MaxCount="2" />
          <TextBlock Classes="hint" Text="ملفات PDF أو صور." />
        </StackPanel>
      </Border>

      <TextBlock Classes="variant" Text="السطر الصغير" />
      <Border Classes="stage wide">
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="المرفقات" />
          <ins:FileUpload Multiple="True" Accept=".pdf,image/*" MaxSize="5MB" MaxCount="5" Note="ملفات PDF أو صور." />
          <TextBlock Classes="hint" Text="ملفات PDF أو صور." />
        </StackPanel>
      </Border>

      <TextBlock Classes="variant" Text="يُرفع فورًا" />
      <Border Classes="stage wide">
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="المرفقات" />
          <ins:FileUpload x:Name="PlayUpload" Multiple="True" Accept=".pdf,image/*" MaxSize="5MB" MaxCount="5" Upload="True" />
          <TextBlock Classes="hint" Text="ملفات PDF أو صور." />
        </StackPanel>
      </Border>

      <TextBlock Classes="variant" Text="معطل" />
      <Border Classes="stage wide">
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="المرفقات" />
          <ins:FileUpload Multiple="True" Accept=".pdf,image/*" MaxSize="5MB" MaxCount="5" IsEnabled="False" />
          <TextBlock Classes="hint" Text="ملفات PDF أو صور." />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
