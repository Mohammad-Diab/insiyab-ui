<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pg="using:Insiyab.Avalonia.Gallery.Playground"
             x:Class="Insiyab.Avalonia.Gallery.Pages.DropdownPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Playground/PlayFrames.axaml" />
  </UserControl.Styles>

  <StackPanel>
    <TextBlock Classes="intro" Text="قائمة منسدلة تتنقل فيها بالأسهم وتغلقها بـ Esc، وفيها عناصر يمكن تحديدها." />
    <pg:PlayExample Layout="Row" Code="{x:Static pg:DropdownPlay.Example}" />

    <TextBlock Classes="section" Text="القائمة المنسدلة" />
    <pg:PlayText Classes="p" Markup="تضع `ins:PopMenu` في `Button.Flyout`، فتنفتح القائمة تحت الزر، ويغلقها مفتاح `Esc` والنقر خارجها، وتتنقل الأسهم بين عناصرها `MenuItem`. وتجد الخيارات كلها بشرحها في آخر الصفحة." />
    <pg:Playground Def="{x:Static pg:DropdownPlay.Pop}" />

    <TextBlock Classes="section" Text="الخيارات" />
    <pg:PlayText Classes="p" Markup="كل ما في القائمة المنسدلة من كلاسات وخصائص وأحداث، في صندوق يفتح بالنقر." />
    <pg:OptionsList Defs="{x:Static pg:DropdownPlay.All}" />
  </StackPanel>
</UserControl>
