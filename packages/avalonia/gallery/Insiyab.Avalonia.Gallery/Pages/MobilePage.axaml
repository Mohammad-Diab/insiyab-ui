<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ins="using:Insiyab.Avalonia.Controls"
             xmlns:pg="using:Insiyab.Avalonia.Gallery.Playground"
             x:Class="Insiyab.Avalonia.Gallery.Pages.MobilePage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Playground/PlayFrames.axaml" />
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Pages/FoundationFrames.axaml" />
    <Style Selector="TextBlock.p">
      <Setter Property="FontSize" Value="{DynamicResource InsFsMd}" />
      <Setter Property="LineHeight" Value="25.9" />
      <Setter Property="Foreground" Value="{DynamicResource InsText1}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
  </UserControl.Styles>

  <StackPanel>

    <TextBlock Classes="p" Text="تعمل المكتبة على أندرويد في عرض واحد بالشكل نفسه: الزجاج والظلال والحركة. وتضيف ما يحتاجه الهاتف: إبعاد المحتوى عن أشرطة النظام ولوحة المفاتيح، وزر الرجوع، واللمس بالإصبع، ومؤثرات أخف للأجهزة الضعيفة، وقطعا تُبنى منها شاشات الهاتف: شريط تنقل سفلي، وورقة تخرج من الأسفل، والسحب للتحديث، ومكدس صفحات، وزرا عائما. وتتهيأ بعض عناصرها لعرض الهاتف: التقويم الشهري، ولوحة الأوامر، والإشعارات المنبثقة، والمقاطع، وصف شرائح التصفية." />

    <TextBlock Classes="section" Text="الحواف الآمنة" />
    <pg:PlayText Classes="p" Markup="يغطي شريط الحالة وشريط التنقل ونتوء الكاميرا أطراف الشاشة. ضع `ins:SafeArea.Edges` على عنصر فيبتعد محتواه عنها، وتبقى خلفيته ممتدة إلى حافة الشاشة. وتتغير المسافة وحدها حين يدور الهاتف." />
    <Border Classes="dx">
      <StackPanel Spacing="12" HorizontalAlignment="Center">
        <Border x:Name="SafeSample" Classes="card" ins:SafeArea.Edges="Left,Right" Padding="16" HorizontalAlignment="Center">
          <TextBlock Text="بطاقة تبتعد عن النتوء حين يكون الهاتف أفقيا" TextWrapping="Wrap" />
        </Border>
        <TextBlock x:Name="SafeNow" Classes="p" Margin="0" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>
    <pg:PlayListing Code="&lt;Border Classes=&quot;topbar&quot; ins:SafeArea.Edges=&quot;Top,Left,Right&quot;&gt;" Margin="0,0,0,24" />
    <pg:PlayListing Code="&lt;Border ins:SafeArea.Edges=&quot;Bottom,Keyboard&quot;&gt; &lt;TextBox /&gt; &lt;/Border&gt;" Margin="0,0,0,24" />
    <ins:ProseList>
      <pg:PlayText Classes="p" Margin="0" Markup="تضاف المسافة إلى `Padding` العنصر إن كان له، وإلا إلى `Margin`. والجهتان `Left` و`Right` على الشاشة نفسها في العربية والإنجليزية، كأشرطة النظام." />
      <pg:PlayText Classes="p" Margin="0" Markup="مع `Keyboard` يرتفع شريط في أسفل الصفحة فوق لوحة المفاتيح ما دامت مفتوحة، كخانة كتابة رسالة." />
      <TextBlock Classes="p" Margin="0" Text="الحوارات والأدراج والإشعارات المنبثقة ولوحة الأوامر والقوائم تبتعد عن هذه الحواف وعن لوحة المفاتيح وحدها، والحقل الذي فيه المؤشر داخل منطقة تمرير يتحرك إلى ما فوق لوحة المفاتيح." />
      <TextBlock Classes="p" Margin="0" Text="لا يتغير شيء في نوافذ سطح المكتب، فلا شيء يغطي حوافها." />
    </ins:ProseList>

    <TextBlock Classes="section" Text="زر الرجوع" />
    <TextBlock Classes="p" Text="يغلق زر الرجوع في أندرويد آخر ما فُتح من المكتبة، طبقة بعد طبقة: قائمة أو بطاقة منبثقة، أو قائمة اختيار، أو حوار أو درج، أو لوحة الأوامر، أو الشريط الجانبي حين يكون درجا. وإذا لم يكن شيء مفتوحا تركه للتطبيق وللنظام. وزر الرجوع في الفأرة يفعل الشيء نفسه." />
    <Border Classes="dx">
      <StackPanel Spacing="16" HorizontalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
          <Button x:Name="OpenLayers" Classes="secondary sm" Content="افتح حوارا" Click="OnOpenLayers" />
          <Button Classes="primary sm" Content="رجوع" Click="OnBack" />
        </StackPanel>
        <TextBlock x:Name="BackNote" Classes="p" Margin="0" HorizontalAlignment="Center" TextWrapping="Wrap" Text="على الهاتف: افتح الحوار ثم القائمة التي فيه، واضغط زر الرجوع مرة بعد مرة." />
      </StackPanel>
    </Border>
    <pg:PlayText Classes="p" Markup="يصل الرجوع إلى `TopLevel.BackRequested` في التطبيق حين لا يأخذه شيء من المكتبة، فينتقل به إلى الصفحة السابقة أو يتركه للنظام." />

    <TextBlock Classes="section" Text="اللمس" />
    <TextBlock Classes="p" Text="تعمل عناصر المكتبة بالإصبع كما تعمل بالفأرة، وتفرق بينهما في السلوك وحده، فالشكل والحركة كما هما." />
    <Border Classes="dx">
      <StackPanel Spacing="16" HorizontalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
          <Button Classes="ghost icon sm" ToolTip.Tip="مشاركة" AutomationProperties.Name="مشاركة" Click="OnTouchAction">
            <ins:Icon Data="{StaticResource IconShare}" />
          </Button>
          <Button Classes="ghost icon sm" ToolTip.Tip="نسخ" AutomationProperties.Name="نسخ" Click="OnTouchAction">
            <ins:Icon Data="{StaticResource IconCopy}" />
          </Button>
          <Button Classes="ghost icon sm" ToolTip.Tip="حذف" AutomationProperties.Name="حذف" Click="OnTouchAction">
            <ins:Icon Data="{StaticResource IconTrash}" />
          </Button>
          <Button Classes="close sm" ToolTip.Tip="إغلاق" AutomationProperties.Name="إغلاق" VerticalAlignment="Center" Click="OnTouchAction" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
          <ins:Pill Classes="ok dot peek" Content="تم الشحن" />
          <ToggleButton Classes="chip" Content="عاجل" />
          <ToggleButton Classes="chip" Content="مع صور" />
        </StackPanel>
        <SelectableTextBlock Text="اضغط مطولا على كلمة في هذا السطر لتحديدها ونسخها." TextWrapping="Wrap" HorizontalAlignment="Center" />
        <TextBlock x:Name="TouchNote" Classes="p" Margin="0" HorizontalAlignment="Center" TextWrapping="Wrap" Text="على الهاتف: المس بجانب زر صغير، واضغط مطولا على زر لترى اسمه." />
      </StackPanel>
    </Border>
    <ins:ProseList>
      <TextBlock Classes="p" Margin="0" Text="لا يبقى أثر المرور على شيء بعد رفع الإصبع، ويظهر بدلا منه أثر ضغط قصير ما دام الإصبع على العنصر." />
      <TextBlock Classes="p" Margin="0" Text="إذا تحرك الإصبع ليمرر الصفحة فلا يُضغط الصف أو البطاقة أو الشريحة أو الزر الذي بدأ عليه، ومنها أحداث التقويم الشهري." />
      <TextBlock Classes="p" Margin="0" Text="تتسع منطقة اللمس حول العناصر الصغيرة إلى 44 في 44 على الأقل دون أن يتغير شكلها: زر الإغلاق الصغير، والأزرار ذات الأيقونة، ونقطة الحالة، والشرائح، وأيام التقويم. وإذا تجاور زران فاللمسة للأقرب منهما إلى الإصبع، أما ما يقع فوق حقل مجاور فيبقى للحقل. ولا يتغير شيء مع الفأرة." />
      <TextBlock Classes="p" Margin="0" Text="الضغط المطول يفتح قائمة العنصر إن كانت له، ومنها قائمة النسخ واللصق في حقول النص، وإلا أظهر تلميحه، فهو الطريقة الوحيدة لمعرفة اسم الزر ذي الأيقونة باللمس. ولا يعد بعدها ضغطة على العنصر." />
      <TextBlock Classes="p" Margin="0" Text="يتبع شريط الوسائط والمنزلق ومقبض التقسيم وحافة عمود الجدول الإصبع إذا سُحب على امتدادها، أما السحب في الاتجاه الآخر فيمرر الصفحة." />
      <TextBlock Classes="p" Margin="0" Text="في النص القابل للتحديد يحدد الضغط المطول الكلمة ثم يمد السحب التحديد، أما السحب وحده فيمرر الصفحة. وتعرض حقول النص مقبضي التحديد كما يرسمهما Avalonia، ولا يوفر Avalonia هذين المقبضين للنص خارج الحقول." />
      <pg:PlayText Classes="p" Margin="0" Markup="تحمل النافذة `:ins-touch` ما دام آخر مؤشر عليها إصبعا، ومن البداية على الهاتف، لتغير أنماط التطبيق ما تريد عند اللمس." />
    </ins:ProseList>

    <TextBlock Classes="section" Text="المؤثرات الخفيفة" />
    <pg:PlayText Classes="p" Markup="على الأجهزة الضعيفة يخفف `InsiyabTheme.Effects = EffectsLevel.Light` ما يكلف الرسم: لا تموّه الصفحة خلف الحوار ولا تطلب النافذة خامة النظام، ويبقى لكل ظل طبقة واحدة أصغر. ويبقى التخطيط والألوان والحركة كما هي." />
    <Border Classes="dx">
      <StackPanel Spacing="16" HorizontalAlignment="Center">
        <ins:Segmented x:Name="EffectsSeg" HorizontalAlignment="Center">
          <ins:SegmentedItem Content="كاملة" />
          <ins:SegmentedItem Content="خفيفة" />
        </ins:Segmented>
        <Border Classes="card" Padding="20" Width="260">
          <StackPanel Spacing="6">
            <TextBlock Classes="h4" Text="ملف المشروع" />
            <TextBlock Classes="muted" Text="آخر تعديل قبل ساعتين" />
          </StackPanel>
        </Border>
        <Button Classes="secondary sm" Content="افتح حوارا لترى الخلفية" HorizontalAlignment="Center" Click="OnPlainDialog" />
      </StackPanel>
    </Border>
    <ins:ProseList>
      <TextBlock Classes="p" Margin="0" Text="يبدأ الهاتف الذي يبلغ النظام أن ذاكرته قليلة، أو ذاكرته 2 غيغابايت أو أقل، بالمؤثرات الخفيفة، ويستطيع التطبيق أن يختار غير ذلك في أي وقت." />
      <pg:PlayText Classes="p" Margin="0" Markup="تحمل النافذة `:ins-light` ما دامت المؤثرات خفيفة، لتخفف أنماط التطبيق ما عندها بالطريقة نفسها." />
    </ins:ProseList>

    <TextBlock Classes="section" Text="الحركة من إعدادات النظام" />
    <pg:PlayText Classes="p" Markup="خيار «إزالة الرسوم المتحركة» في أندرويد يجعل المكتبة ساكنة كما يفعل زر «تخفيف المؤثرات» في هذا المعرض، وكذلك إطفاء الحركة في ويندوز. يُقرأ الإعداد من جديد كلما عاد التطبيق إلى الواجهة." />
    <TextBlock x:Name="MotionNow" Classes="p" />

    <TextBlock Classes="section" Text="شريط التنقل السفلي" />
    <pg:PlayText Classes="p" Markup="يجمع `ins:BottomNav` صفحات التطبيق الرئيسية في أسفل الشاشة، من ثلاث إلى خمس، لكل منها أيقونة فوق اسمها. وخلف أيقونة المختارة شكل بلون العلامة ينتقل إلى ما تختاره بعدها، ويبتعد الشريط وحده عن شريط الإيماءات." />
    <Border Classes="dx">
      <Border Width="360" Height="300" HorizontalAlignment="Center" CornerRadius="24" ClipToBounds="True"
              BorderThickness="1" BorderBrush="{DynamicResource InsLine}" Background="{DynamicResource InsWash1}">
        <DockPanel>
          <ins:BottomNav x:Name="NavSample" DockPanel.Dock="Bottom" SelectedIndex="0" ins:SafeArea.Edges="None">
            <ins:BottomNavItem Icon="{StaticResource IconHome}" Label="الرئيسية" />
            <ins:BottomNavItem Icon="{StaticResource IconCart}" Label="الطلبات" Badge="3" />
            <ins:BottomNavItem Icon="{StaticResource IconFolder}" Label="الملفات" ShowDot="True" />
            <ins:BottomNavItem Icon="{StaticResource IconUser}" Label="الحساب" />
          </ins:BottomNav>
          <TextBlock x:Name="NavNote" Classes="p" Margin="24" TextAlignment="Center" VerticalAlignment="Center" Text="أنت في الرئيسية." />
        </DockPanel>
      </Border>
    </Border>
    <pg:PlayListing Code="&lt;ins:BottomNav SelectedIndex=&quot;{Binding Page}&quot; Reselected=&quot;OnReselected&quot;&gt;&#10;  &lt;ins:BottomNavItem Icon=&quot;{StaticResource IconHome}&quot; Label=&quot;الرئيسية&quot; /&gt;&#10;  &lt;ins:BottomNavItem Icon=&quot;{StaticResource IconCart}&quot; Label=&quot;الطلبات&quot; Badge=&quot;3&quot; /&gt;&#10;  &lt;ins:BottomNavItem Icon=&quot;{StaticResource IconFolder}&quot; Label=&quot;الملفات&quot; ShowDot=&quot;True&quot; /&gt;&#10;&lt;/ins:BottomNav&gt;" Margin="0,0,0,24" />
    <ins:ProseList>
      <pg:PlayText Classes="p" Margin="0" Markup="يُربط الاختيار بـ`SelectedIndex` أو `SelectedItem`، ويصل `Reselected` حين تُضغط الصفحة المختارة مرة أخرى، فيعيد التطبيق صفحتها إلى أعلاها." />
      <pg:PlayText Classes="p" Margin="0" Markup="`Badge` عدد فوق الأيقونة يصير 99+ بعد 99، و`ShowDot` نقطة لشيء جديد بلا عدد." />
      <TextBlock Classes="p" Margin="0" Text="سطحه زجاج يشف قليلا وفي أعلاه خط رفيع، ويصير مصمتا مع المؤثرات الخفيفة. وتنتقل الأسهم بين صفحاته في اتجاه القراءة، ويسمعه قارئ الشاشة تبويبات لكل منها اسمها وعددها." />
      <TextBlock Classes="p" Margin="0" Text="على الهاتف تظهر الإشعارات المنبثقة في وسط أسفل الشاشة فوق هذا الشريط إذا كان في أسفل الصفحة، وتنزل إلى مكانه إذا اختفى، كما تبتعد عن شريط الحالة في أسفل النافذة." />
    </ins:ProseList>

    <TextBlock Classes="section" Text="الزر العائم" />
    <pg:PlayText Classes="p" Markup="الصنف `fab` على `Button` زر مستدير بلون العلامة يطفو فوق الصفحة بظل يرفعه عنها، وفيه `ins:Icon`. يضعه التطبيق في `Panel` فوق صفحته، فيقف في زاوية النهاية من أسفلها، على اليسار في العربية وعلى اليمين في الإنجليزية." />
    <Border Classes="dx">
      <StackPanel Spacing="12" HorizontalAlignment="Center">
        <Border Width="360" Height="320" CornerRadius="24" ClipToBounds="True"
                BorderThickness="1" BorderBrush="{DynamicResource InsLine}" Background="{DynamicResource InsWash1}">
          <DockPanel>
            <ins:BottomNav DockPanel.Dock="Bottom" SelectedIndex="0" ins:SafeArea.Edges="None">
              <ins:BottomNavItem Icon="{StaticResource IconFolder}" Label="الملفات" />
              <ins:BottomNavItem Icon="{StaticResource IconShare}" Label="المشتركة" />
              <ins:BottomNavItem Icon="{StaticResource IconUser}" Label="الحساب" />
            </ins:BottomNav>
            <Panel>
              <ListBox x:Name="FabList" Classes="static" Background="Transparent" />
              <Button x:Name="FabSample" Classes="fab" ToolTip.Tip="مستند جديد" Click="OnFabSample">
                <ins:Icon Data="{StaticResource IconPlus}" />
              </Button>
            </Panel>
          </DockPanel>
        </Border>
        <TextBlock x:Name="FabNote" Classes="p" Margin="0" HorizontalAlignment="Center" Text="اضغط الزر العائم لتضيف مستندا." />
      </StackPanel>
    </Border>
    <pg:PlayListing Code="&lt;Panel&gt;&#10;  &lt;ListBox ItemsSource=&quot;{Binding Files}&quot; /&gt;&#10;  &lt;Button Classes=&quot;fab&quot; ToolTip.Tip=&quot;ملف جديد&quot; Click=&quot;OnNewFile&quot;&gt;&#10;    &lt;ins:Icon Data=&quot;{StaticResource IconPlus}&quot; /&gt;&#10;  &lt;/Button&gt;&#10;&lt;/Panel&gt;" Margin="0,0,0,24" />
    <ins:ProseList>
      <TextBlock Classes="p" Margin="0" Text="حين يكون في أسفل الشاشة يرتفع وحده فوق شريط الإيماءات، وفوق شريط التنقل السفلي أو شريط الحالة إذا كان أحدهما في أسفلها، وفوق لوحة المفاتيح حين تُفتح، ثم يعود إلى مكانه." />
      <pg:PlayText Classes="p" Margin="0" Markup="`fab sm` أصغر منه، 44 بكسلا. ويضغط وينخفض ظله كأي زر، ويصير ظله أبسط مع المؤثرات الخفيفة ويختفي مع تخفيف الحركة." />
      <TextBlock Classes="p" Margin="0" Text="يصل إليه التركيز بلوحة المفاتيح بحلقة التركيز المستديرة، ويسمعه قارئ الشاشة باسم تلميحه ما لم يُعطَ اسما آخر." />
    </ins:ProseList>

    <TextBlock Classes="section" Text="الورقة السفلية" />
    <pg:PlayText Classes="p" Markup="الدرج السفلي `drawer bottom` على الهاتف ورقة كاملة: مقبض في أعلاها، وزوايا علوية مستديرة، وطول يتبع المحتوى حتى تسعة أعشار الشاشة ثم يتمرر جسمها وحده. وفي نافذة سطح المكتب تأخذ هذا الشكل مع الصنف `sheet`، كما في الأمثلة هنا." />
    <Border Classes="dx">
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
        <Button x:Name="ShortSheet" Classes="secondary sm" Content="تفاصيل قصيرة" Click="OnShortSheet" />
        <Button x:Name="LongSheet" Classes="secondary sm" Content="قائمة طويلة" Click="OnLongSheet" />
        <Button x:Name="FormSheet" Classes="secondary sm" Content="نموذج" Click="OnFormSheet" />
      </StackPanel>
    </Border>
    <pg:PlayListing Code="&lt;ins:Dialog x:Key=&quot;Filters&quot; Title=&quot;التصفية&quot; Classes=&quot;drawer bottom sheet&quot;&gt; … &lt;/ins:Dialog&gt;" Margin="0,0,0,24" />
    <ins:ProseList>
      <TextBlock Classes="p" Margin="0" Text="اسحب المقبض أو رأس الورقة إلى الأسفل لتغلقها، أو اسحب جسمها بالإصبع حين يكون في أعلاه. فإن تجاوز السحب ثلث طولها أو كان سريعا أُغلقت، وإلا عادت إلى مكانها." />
      <TextBlock Classes="p" Margin="0" Text="تمتد خلفيتها تحت شريط الإيماءات ويبقى محتواها فوقه، وترتفع فوق لوحة المفاتيح حين تُفتح لحقل فيها." />
      <TextBlock Classes="p" Margin="0" Text="يغلقها زر الرجوع والضغط على ما حولها كما يغلقان الدرج، ولا تموّه الصفحة خلفها مع المؤثرات الخفيفة." />
    </ins:ProseList>

    <TextBlock Classes="section" Text="السحب للتحديث" />
    <pg:PlayText Classes="p" Markup="ضع `RefreshContainer` من Avalonia حول قائمة، فإذا سُحب أعلاها إلى الأسفل نزل من الأعلى قرص زجاجي صغير فيه حلقة الانتظار بلون العلامة، تكبر وتدور مع الإصبع، ثم يصل `RefreshRequested` إلى التطبيق." />
    <Border Classes="dx">
      <StackPanel Spacing="12" HorizontalAlignment="Center">
        <Border Width="360" Height="320" CornerRadius="24" ClipToBounds="True"
                BorderThickness="1" BorderBrush="{DynamicResource InsLine}" Background="{DynamicResource InsWash1}">
          <RefreshContainer x:Name="RefreshSample" IsMouseEnabled="True" RefreshRequested="OnRefresh">
            <ListBox x:Name="RefreshList" Classes="static" Background="Transparent" />
          </RefreshContainer>
        </Border>
        <TextBlock x:Name="RefreshNote" Classes="p" Margin="0" HorizontalAlignment="Center" Text="اسحب القائمة إلى الأسفل بالإصبع أو بالفأرة." />
      </StackPanel>
    </Border>
    <pg:PlayListing Code="&lt;RefreshContainer RefreshRequested=&quot;OnRefresh&quot;&gt;&#10;  &lt;ListBox ItemsSource=&quot;{Binding Files}&quot; /&gt;&#10;&lt;/RefreshContainer&gt;" Margin="0,0,0,24" />
    <ins:ProseList>
      <pg:PlayText Classes="p" Margin="0" Markup="يأخذ التطبيق `e.GetDeferral()` ثم يستدعي `Complete()` حين ينتهي، فيصعد القرص والقائمة إلى مكانهما. وتبقى الحلقة تدور ما دام التطبيق يعمل، كأي حلقة انتظار في المكتبة." />
      <pg:PlayText Classes="p" Margin="0" Markup="يحدّث F5 القائمة من لوحة المفاتيح، و`RequestRefresh()` من الشيفرة." />
    </ins:ProseList>

    <TextBlock Classes="section" Text="مكدس الصفحات" />
    <pg:PlayText Classes="p" Markup="يفتح `ins:PageStack` صفحة فوق الحالية تنزلق إليها من جهة النهاية، ويعود منها بزر الرجوع، أو بسحب الإصبع من حافة البداية، أو بـ`Pop()`. وتبقى الصفحات التي تحتها كما تُركت." />
    <Border Classes="dx">
      <Border Width="360" Height="380" HorizontalAlignment="Center" CornerRadius="24" ClipToBounds="True"
              BorderThickness="1" BorderBrush="{DynamicResource InsLine}">
        <ins:PageStack x:Name="PagesSample" />
      </Border>
    </Border>
    <pg:PlayListing Code="&lt;ins:PageStack x:Name=&quot;Pages&quot;&gt; &lt;local:PlacesPage /&gt; &lt;/ins:PageStack&gt;&#10;Pages.Push(new PlacePage(place));" Margin="0,0,0,24" />
    <ins:ProseList>
      <TextBlock Classes="p" Margin="0" Text="يرجع زر الرجوع صفحة واحدة بعد أن تُغلق كل الطبقات المفتوحة فوقها، ويُترك للتطبيق في الصفحة الأولى. وزر الرجوع في الفأرة يفعل الشيء نفسه على سطح المكتب." />
      <pg:PlayText Classes="p" Margin="0" Markup="`Current` و`Depth` و`CanGoBack` قابلة للربط، و`Changed` يخبر بكل تغيير، و`PopToRoot()` يعود إلى الصفحة الأولى." />
      <TextBlock Classes="p" Margin="0" Text="ينتقل التركيز إلى الصفحة الجديدة ويعود عند الرجوع إلى حيث كان، وتتبدل الصفحات فورا مع تخفيف المؤثرات." />
    </ins:ProseList>

    <TextBlock Classes="section" Text="التقويم على الهاتف" />
    <pg:PlayText Classes="p" Markup="يعرض `ins:MonthCalendar` على الهاتف شبكة كتقويم الهاتف: في كل يوم موعدان، كل منهما في سطر واحد يُقص بـ«…»، وتحتهما «+2» لما بقي، فإذا ضُغط فتح اليوم كما يفتحه الضغط عليه. ويكون الأسبوع سبعة أعمدة ضيقة تُقرأ، بجانب عمود ساعات ضيق. وهذا هو الأصل في العرض الواحد على الهاتف، وفي نافذة سطح المكتب تختاره بـ`NarrowLayout=&quot;Compact&quot;` كما هنا." />
    <Border Classes="dx">
      <StackPanel Spacing="12" HorizontalAlignment="Center">
        <Border Width="360" CornerRadius="24" ClipToBounds="True" Padding="8,12"
                BorderThickness="1" BorderBrush="{DynamicResource InsLine}" Background="{DynamicResource InsWash1}">
          <ins:MonthCalendar x:Name="PhoneMonth" NarrowLayout="Compact" DetailsPresentation="Sheet">
            <ins:MonthCalendar.EventDetails>
              <DataTemplate x:DataType="ins:MonthEvent">
                <StackPanel Spacing="6">
                  <TextBlock Classes="h4" Text="{Binding Title}" />
                  <TextBlock Classes="muted" Text="{Binding Tag}" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ins:MonthCalendar.EventDetails>
          </ins:MonthCalendar>
        </Border>
        <TextBlock x:Name="PhoneMonthNote" Classes="p" Margin="0" HorizontalAlignment="Center" TextWrapping="Wrap" Text="اسحب الأيام إلى الجانب بالإصبع، أو اضغط موعدا." />
      </StackPanel>
    </Border>
    <pg:PlayListing Code="&lt;ins:MonthCalendar NarrowLayout=&quot;Compact&quot; DetailsPresentation=&quot;Sheet&quot; EventDetails=&quot;{StaticResource EventCard}&quot; /&gt;" Margin="0,0,0,24" />
    <ins:ProseList>
      <TextBlock Classes="p" Margin="0" Text="يسحب الإصبع الأيام إلى الجانب فينتقل إلى الشهر أو الأسبوع أو اليوم التالي أو السابق بالانزلاق نفسه، وتميل الأيام مع الإصبع أثناء السحب. والسحب نحو بداية السطر يأتي بالتالي، فينعكس في العربية. ولا يفتح السحب موعدا ولا يوما، والسحب القصير يعيد الأيام إلى مكانها." />
      <pg:PlayText Classes="p" Margin="0" Markup="تفتح تفاصيل الموعد في ورقة سفلية بدل البطاقة التي بجانبه حين يكون `DetailsPresentation` على `Sheet`، أو على `Auto` وهو الأصل والتقويم بشكل الهاتف. وتغلقها بزر الرجوع أو بسحبها إلى الأسفل." />
      <TextBlock Classes="p" Margin="0" Text="إذا ضاق الرأس انتقل التاريخ بين سهميه إلى سطر تحت الأزرار، وإذا لم تتسع الأزرار نفسها لسطر واحد انتقل مبدّل العرض إلى سطر وحده. ولا يتغير شيء في التقويم على سطح المكتب." />
    </ins:ProseList>

    <TextBlock Classes="section" Text="البحث بملء الشاشة" />
    <pg:PlayText Classes="p" Markup="تفتح `ins:CommandPalette` على الهاتف بملء الشاشة ولوحة المفاتيح ظاهرة: الحقل في الأعلى وبجانبه زر للإغلاق، والنتائج تحته حتى لوحة المفاتيح، ويغلقها زر الرجوع. وفي نافذة سطح المكتب تبقى صندوقا في أعلى النافذة، إلا مع الصنف `full`، كما في هذا المثال." />
    <Border Classes="dx">
      <Button x:Name="FullSearch" Classes="secondary" HorizontalAlignment="Center" Content="ابحث في المتجر" Click="OnFullSearch" />
    </Border>
    <pg:PlayListing Code="&lt;ins:CommandPalette x:Name=&quot;Search&quot; Classes=&quot;full&quot; /&gt;&#10;Search.Open(this);" Margin="0,0,0,24" />

    <TextBlock Classes="section" Text="مقاطع لا يتسع لها السطر" />
    <pg:PlayText Classes="p" Markup="إذا لم يتسع السطر لمقاطع `ins:Segmented`، كأسماء عربية طويلة على الهاتف، مرّ الصف إلى الجانب بالإصبع بدل أن تُضغط الكلمات أو تُقص، ويبقى المقطع المختار ظاهرا ومعه طرف مما بعده. أما الصف الذي يتسع فيبقى كما هو." />
    <Border Classes="dx">
      <Border Width="360" HorizontalAlignment="Center" CornerRadius="24" Padding="16"
              BorderThickness="1" BorderBrush="{DynamicResource InsLine}" Background="{DynamicResource InsWash1}">
        <ins:Segmented x:Name="LongSeg" SelectedIndex="0">
          <ins:SegmentedItem Content="الطلبات الجديدة" />
          <ins:SegmentedItem Content="قيد التوصيل اليوم" />
          <ins:SegmentedItem Content="المسلّمة هذا الأسبوع" />
          <ins:SegmentedItem Content="الملغاة والمرتجعة" />
        </ins:Segmented>
      </Border>
    </Border>
    <ins:ProseList>
      <TextBlock Classes="p" Margin="0" Text="سحب الإصبع على الصف يمرره ولا يختار شيئا، واللمسة تختار. وتنتقل الأسهم بين المقاطع في اتجاه القراءة فيظهر المختار." />
    </ins:ProseList>

    <TextBlock Classes="section" Text="صف شرائح التصفية" />
    <pg:PlayText Classes="p" Markup="الصنف `chips` على `ins:Segmented` يجعله صفا من شرائح التصفية: اختيار واحد، لكل خيار شريحة بشكل الشرائح في المكتبة، والمختارة بلون العلامة. ويمر إلى الجانب إذا لم يتسع، ويبقى المختار ظاهرا، ويُربط اختياره بـ`SelectedItem` كأي مقاطع." />
    <Border Classes="dx">
      <StackPanel Spacing="12" HorizontalAlignment="Center">
        <Border Width="360" CornerRadius="24" Padding="12"
                BorderThickness="1" BorderBrush="{DynamicResource InsLine}" Background="{DynamicResource InsWash1}">
          <ins:Segmented x:Name="PlaceChips" Classes="chips" />
        </Border>
        <TextBlock x:Name="PlaceChipsNote" Classes="p" Margin="0" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>
    <pg:PlayListing Code="&lt;ins:Segmented Classes=&quot;chips&quot; ItemsSource=&quot;{Binding Kinds}&quot; SelectedItem=&quot;{Binding Kind}&quot; /&gt;" Margin="0,0,0,24" />
    <ins:ProseList>
      <TextBlock Classes="p" Margin="0" Text="سحب الإصبع على الصف يمرره ولا يختار، واللمسة تختار. وتنتقل الأسهم بين الشرائح في اتجاه القراءة، ويسمعه قارئ الشاشة قائمة يُختار منها شيء واحد." />
    </ins:ProseList>

  </StackPanel>
</UserControl>
