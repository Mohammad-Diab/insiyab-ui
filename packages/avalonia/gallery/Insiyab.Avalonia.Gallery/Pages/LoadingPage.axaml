<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ins="using:Insiyab.Avalonia.Controls"
             x:Class="Insiyab.Avalonia.Gallery.Pages.LoadingPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Pages/FeedbackFrames.axaml" />
  </UserControl.Styles>
  <ScrollViewer>
    <StackPanel>

      <Border Classes="dx">
        <StackPanel Spacing="12">
          <ins:Skeleton Classes="circle" />
          <ins:Skeleton Classes="title" />
          <ins:Skeleton Classes="block" />
          <ins:Skeleton Classes="text" />
          <ins:Skeleton Classes="text" />
        </StackPanel>
      </Border>

      <TextBlock Classes="section" Text="هيكل التحميل" />
      <Border Classes="stage wide">
        <StackPanel Spacing="12">
          <ins:Skeleton Classes="text" />
          <ins:Skeleton Classes="text" />
          <ins:Skeleton Classes="text" />
        </StackPanel>
      </Border>

      <TextBlock Classes="section" Text="مؤشر التحميل" />
      <Border Classes="stage">
        <ins:LoadingSpinner AutomationProperties.Name="جارٍ التحميل" />
      </Border>
      <TextBlock Classes="variant" Text="صغير" />
      <Border Classes="stage">
        <ins:LoadingSpinner Classes="sm" AutomationProperties.Name="جارٍ التحميل" />
      </Border>
      <TextBlock Classes="variant" Text="في زر" />
      <Border Classes="stage">
        <Button Classes="primary" IsEnabled="False">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ins:LoadingSpinner Classes="sm" />
            <TextBlock Text="جارٍ الحفظ…" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Border>
      <TextBlock Classes="variant" Text="في حاوية" />
      <Border Classes="stage wide">
        <Border Classes="loading">
          <ins:LoadingSpinner AutomationProperties.Name="جارٍ التحميل" />
        </Border>
      </Border>

      <TextBlock Classes="section" Text="الحالة الفارغة" />
      <Border Classes="stage wide">
        <ins:EmptyState Icon="{StaticResource IconFolder}" Title="لا ملفات بعد" Hint="أضف أول ملف ليظهر هنا.">
          <Button Classes="primary" Content="ملف جديد" />
        </ins:EmptyState>
      </Border>
      <TextBlock Classes="variant" Text="لا نتائج" />
      <Border Classes="stage wide">
        <ins:EmptyState Icon="{StaticResource IconSearch}" Title="لا نتائج" Hint="جرب كلمة أخرى.">
          <Button Classes="secondary" Content="امسح البحث" />
        </ins:EmptyState>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
