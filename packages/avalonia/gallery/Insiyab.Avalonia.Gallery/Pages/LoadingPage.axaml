<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pg="using:Insiyab.Avalonia.Gallery.Playground"
             x:Class="Insiyab.Avalonia.Gallery.Pages.LoadingPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Playground/PlayFrames.axaml" />
  </UserControl.Styles>

  <StackPanel>
    <TextBlock Classes="intro" Text="هيكل التحميل (skeleton) ومؤشر التحميل والحالة الفارغة: ما يراه المستخدم قبل وصول البيانات، أو حين لا تصل." />
    <pg:PlayExample Layout="Stack" Code="{x:Static pg:LoadingPlay.Example}" />

    <TextBlock Classes="section" Text="هيكل التحميل" />
    <pg:PlayText Classes="p" Markup="يرسم هيكل التحميل `ins:Skeleton` هيئة المحتوى قبل أن يصل، فإذا وصل أخذ مكانها ولم تقفز الشاشة. اختر الشكل الأقرب إلى ما سيصل، وتجد الخيارات كلها بشرحها في آخر الصفحة." />
    <pg:Playground Def="{x:Static pg:LoadingPlay.Skeleton}" />

    <TextBlock Classes="section" Text="مؤشر التحميل" />
    <pg:PlayText Classes="p" Markup="يصلح مؤشر التحميل `ins:LoadingSpinner` لانتظار قصير لا تُعرف هيئة ما يأتي بعده. أعطه اسمًا يقرؤه قارئ الشاشة، أو دعه بلا اسم إذا كان نص الزر يغني عنه." />
    <pg:Playground Def="{x:Static pg:LoadingPlay.Spinner}" />

    <TextBlock Classes="section" Text="الحالة الفارغة" />
    <pg:PlayText Classes="p" Markup="تجمع `ins:EmptyState` أيقونة وعنوانًا وتلميحًا، وزرًا إن كان للقارئ ما يفعله. ودعها تخبره بما سيظهر هنا، وبما يفعله بعد ذلك." />
    <pg:Playground Def="{x:Static pg:LoadingPlay.Empty}" />

    <TextBlock Classes="section" Text="الخيارات" />
    <pg:PlayText Classes="p" Markup="كل ما في هيكل التحميل ومؤشر التحميل والحالة الفارغة من عناصر وكلاسات وخصائص، لكل مكون صندوق يفتح بالنقر." />
    <pg:OptionsList Defs="{x:Static pg:LoadingPlay.All}" />
  </StackPanel>
</UserControl>
