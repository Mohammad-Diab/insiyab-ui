<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pg="using:Insiyab.Avalonia.Gallery.Playground"
             x:Class="Insiyab.Avalonia.Gallery.Pages.SurfacesPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Playground/PlayFrames.axaml" />
    <Style Selector="Border.radius">
      <Setter Property="Width" Value="72" />
      <Setter Property="Height" Value="72" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource InsToneBrandBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InsToneBrandBd}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource InsToneBrand}" />
      <Setter Property="TextElement.FontSize" Value="12" />
      <Setter Property="TextElement.FontWeight" Value="Bold" />
      <Setter Property="TextElement.FontFamily" Value="{DynamicResource InsFontBodyEn}" />
    </Style>
    <Style Selector="Border.radius > TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <StackPanel>
    <TextBlock Classes="intro" Text="الزجاج المصنفر بطبقاته الأربع، وما يبنى عليه من بطاقات وألواح." />
    <pg:PlayExample Layout="Stack" Code="{x:Static pg:SurfacesPlay.Example}" />

    <TextBlock Classes="section" Text="الزجاج" />
    <pg:PlayText Classes="p" Markup="الكلاس `glass` على `Border` هو السطح الأساسي، لا فراغ داخليًا فيه ولا سلوك، وعليه يبنى كل سطح في المكتبة. وتجد الخيارات كلها بشرحها في آخر الصفحة." />
    <pg:Playground Def="{x:Static pg:SurfacesPlay.Glass}" />

    <TextBlock Classes="section" Text="البطاقة" />
    <pg:PlayText Classes="p" Markup="الكلاس `card` زجاج بطبقاته نفسها، باسم يقول ما هو، ولا يرتفع تحت المؤشر إلا إذا كان يُنقر." />
    <pg:Playground Def="{x:Static pg:SurfacesPlay.Card}" />

    <TextBlock Classes="section" Text="اللوح" />
    <pg:PlayText Classes="p" Markup="الكلاس `panel` حاوية من ثلاثة أجزاء: رأس ثم جسم ثم تذييل، وهو السطح الذي تبنى منه أكثر الشاشات." />
    <pg:Playground Def="{x:Static pg:SurfacesPlay.Panel}" />

    <TextBlock Classes="section" Text="انحناء الزوايا" />
    <pg:PlayText Classes="p" Markup="تمتد قيم انحناء الزوايا من `InsRXs` إلى `InsRPill`، وقيمها 7 و10 و14 و22 و32 و999، والافتراضي منها 14." />
    <pg:PlayExample Layout="Row" ShowCode="False" Code="{x:Static pg:SurfacesPlay.RadiiExample}" />

    <TextBlock Classes="section" Text="الخيارات" />
    <pg:PlayText Classes="p" Markup="كل ما في الأسطح والألواح من كلاسات، لكل مكون صندوق يفتح بالنقر." />
    <pg:OptionsList Defs="{x:Static pg:SurfacesPlay.All}" />
  </StackPanel>
</UserControl>
