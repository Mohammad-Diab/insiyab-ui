<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pg="using:Insiyab.Avalonia.Gallery.Playground"
             x:Class="Insiyab.Avalonia.Gallery.Pages.TypographyPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Playground/PlayFrames.axaml" />
  </UserControl.Styles>

  <StackPanel>
    <TextBlock Classes="intro" Text="ثلاثة خطوط مضمنة في المكتبة، وسلم للعناوين، ونص طويل لا يتجاوز تنسيقه العنصر الذي يحمله." />
    <pg:PlayExample Layout="Stack" Code="{x:Static pg:TypographyPlay.Example}" />

    <TextBlock Classes="section" Text="الخطوط الثلاثة" />
    <pg:PlayText Classes="p" Markup="تُكتب العربية بخط تجوال ومعه حروفه اللاتينية، والأرقام والنص اللاتيني بخط Inter، أما العناوين في الواجهات التي تجري من اليسار إلى اليمين فبخط Cause." />
    <pg:PlayExample Layout="Stack" ShowCode="False" Code="{x:Static pg:TypographyPlay.FacesExample}" />

    <TextBlock Classes="section" Text="العناوين" />
    <pg:PlayText Classes="p" Markup="مظهر العنوان مستقل عن مستواه، فالمستوى في `AutomationProperties.HeadingLevel` يخدم بنية الصفحة وقارئ الشاشة، والكلاس يخدم التصميم. لذا لا غرابة في عنوان من المستوى الثاني بالكلاس `h4`. وتجد الخيارات كلها بشرحها في آخر الصفحة." />
    <pg:Playground Def="{x:Static pg:TypographyPlay.Heading}" />

    <TextBlock Classes="section" Text="النص الطويل" />
    <pg:PlayText Classes="p" Markup="ينسق `ins:Prose` ما في داخله من فقرات وقوائم واقتباسات وشيفرة وجداول، ولا يمس شيئًا خارجه. ولا يباعد بين الحروف العربية ولا يميلها، وإنما يكون التوكيد باللون." />
    <pg:Playground Def="{x:Static pg:TypographyPlay.Prose}" />

    <TextBlock Classes="section" Text="الفاصل" />
    <pg:PlayText Classes="p" Markup="يفصل `ins:Divider` بين قسمين بخطين بينهما كلمة، و`Separator` بخط وحسب، أو بين عناصر صف بخط عمودي." />
    <pg:Playground Def="{x:Static pg:TypographyPlay.Divider}" />

    <TextBlock Classes="section" Text="المفاتيح" />
    <pg:PlayText Classes="p" Markup="يرسم `Border.kbd` اسم المفتاح في هيئة زر من لوحة المفاتيح، لاختصار في قائمة أو تلميح." />
    <pg:Playground Def="{x:Static pg:TypographyPlay.Kbd}" />

    <TextBlock Classes="section" Text="البحث في الصفحة" />
    <pg:PlayText Classes="p" Markup="علّم الحاوية التي يُبحث فيها بـ`ins:Find.IsSearchable`، وضع `ins:FindBar` في أعلى الصفحة، فيفتحه `Ctrl+F` ويظلل ما يجد في نصوصها دون أن يمس النص نفسه." />
    <pg:Playground Def="{x:Static pg:TypographyPlay.Search}" />

    <TextBlock Classes="section" Text="الخيارات" />
    <pg:PlayText Classes="p" Markup="كل ما في الخطوط والنصوص من كلاسات وعناصر وخصائص، لكل مكون صندوق يفتح بالنقر." />
    <pg:OptionsList Defs="{x:Static pg:TypographyPlay.All}" />
  </StackPanel>
</UserControl>
