<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pg="using:Insiyab.Avalonia.Gallery.Playground"
             x:Class="Insiyab.Avalonia.Gallery.Pages.ToolbarPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Playground/PlayFrames.axaml" />
  </UserControl.Styles>

  <StackPanel>
    <TextBlock Classes="intro" Text="شريط أوامر لتطبيقات سطح المكتب: أزرار برموز، ومفاتيح تبديل، وقوائم منسدلة، وما لا يتسع له الصف ينتقل إلى زر «المزيد»." />
    <pg:PlayExample Layout="Stack" Code="{x:Static pg:ToolbarPlay.Example}" />

    <TextBlock Classes="section" Text="شريط الأدوات" />
    <pg:PlayText Classes="p" Markup="يضم `ins:Toolbar` أوامر من `ins:ToolbarButton` و`ins:ToolbarToggleButton` و`ins:ToolbarSplitButton`، بينها فواصل `Separator`. ولكل أمر رمز في `Icon` واسم في `Label`، يظهر الاسم في التلميح، أو بجانب الرمز مع `ShowLabel`. ضيّق الشريط فتنتقل الأوامر من آخره إلى «المزيد»." />
    <pg:Playground Def="{x:Static pg:ToolbarPlay.Toolbar}" />

    <TextBlock Classes="section" Text="لوحة المفاتيح" />
    <pg:PlayText Classes="p" Markup="الشريط كله محطة واحدة لمفتاح Tab، والأسهم تنقل التركيز بين أوامره في اتجاه الواجهة، و`Home` و`End` إلى أوله وآخره. وإذا خرجت منه ثم عدت إليه رجع التركيز إلى آخر أمر كنت عليه. وتظهر الأوامر المعطلة باهتة وتتخطاها الأسهم." />

    <TextBlock Classes="section" Text="الخيارات" />
    <pg:PlayText Classes="p" Markup="كل ما في شريط الأدوات من عناصر وكلاسات وخصائص وأحداث، في صندوق يفتح بالنقر." />
    <pg:OptionsList Defs="{x:Static pg:ToolbarPlay.All}" />
  </StackPanel>
</UserControl>
