<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pg="using:Insiyab.Avalonia.Gallery.Playground"
             x:Class="Insiyab.Avalonia.Gallery.Pages.ChecksPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Playground/PlayFrames.axaml" />
  </UserControl.Styles>

  <StackPanel>
    <TextBlock Classes="intro" Text="مربعات ودوائر ومفاتيح وبطاقات اختيار، وكلها عناصر Avalonia الأصلية بمظهر المكتبة." />
    <pg:PlayExample Layout="Row" Code="{x:Static pg:ChecksPlay.Example}" />

    <TextBlock Classes="section" Text="مربعات الاختيار وأزراره" />
    <pg:PlayText Classes="p" Markup="المربع `CheckBox` والدائرة `RadioButton`، فإذا نقرت النص تبدلت حالته، وتبقى لوحة المفاتيح من شأن Avalonia. وتجد الخيارات كلها بشرحها في آخر الصفحة." />
    <pg:Playground Def="{x:Static pg:ChecksPlay.Check}" />

    <TextBlock Classes="section" Text="المفتاح" />
    <pg:PlayText Classes="p" Markup="يصلح `ToggleSwitch` لكل إعداد له حالتان، فحالته ظاهرة دون أن يُفتح شيء." />
    <pg:Playground Def="{x:Static pg:ChecksPlay.Toggle}" />

    <TextBlock Classes="section" Text="بطاقات الاختيار" />
    <pg:PlayText Classes="p" Markup="إذا احتاج الخيار إلى أكثر من سطر فضع الكلاس `tile` على زر الاختيار أو مربع الاختيار نفسه، وما البطاقة إلا مظهر لحالته." />
    <pg:Playground Def="{x:Static pg:ChecksPlay.Tile}" />

    <TextBlock Classes="section" Text="الشريط المقسم" />
    <pg:PlayText Classes="p" Markup="الشريط المقسم `ins:Segmented` يختار منه المستخدم بديلًا واحدًا من بدائل قليلة قصيرة." />
    <pg:Playground Def="{x:Static pg:ChecksPlay.SegBar}" />

    <TextBlock Classes="section" Text="الخيارات" />
    <pg:PlayText Classes="p" Markup="كل ما في الاختيار والمفاتيح من عناصر وكلاسات وخصائص وأحداث، لكل مكون صندوق يفتح بالنقر." />
    <pg:OptionsList Defs="{x:Static pg:ChecksPlay.All}" />
  </StackPanel>
</UserControl>
