<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ins="using:Insiyab.Avalonia.Controls"
             x:Class="Insiyab.Avalonia.Gallery.Pages.PickersPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Pages/PickersFrames.axaml" />
  </UserControl.Styles>
  <ScrollViewer>
    <StackPanel>

      <Border Classes="dx">
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
          <StackPanel Classes="field">
            <TextBlock Classes="label" Text="المدينة" />
            <AutoCompleteBox x:Name="MainCity" />
          </StackPanel>
          <StackPanel Classes="field" Grid.Column="1">
            <TextBlock Classes="label" Text="التاريخ" />
            <ins:DateField x:Name="MainDate" />
          </StackPanel>
          <StackPanel Classes="field" Grid.Column="2">
            <TextBlock Classes="label" Text="الوقت" />
            <ins:TimeField x:Name="MainTime" />
          </StackPanel>
        </Grid>
      </Border>

      <TextBlock Classes="section" Text="الإكمال التلقائي" />
      <Border Classes="stage wide">
        <AutoCompleteBox x:Name="ComboPlay" />
      </Border>

      <TextBlock Classes="section" Text="التاريخ" />
      <Border Classes="stage wide">
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="التاريخ" />
          <ins:DateField x:Name="DatePlay" />
        </StackPanel>
      </Border>

      <TextBlock Classes="variant" Text="فترة بين تاريخين" />
      <Border Classes="stage wide">
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="الفترة" />
          <ins:DateField x:Name="RangePlay" Mode="Range" />
        </StackPanel>
      </Border>

      <TextBlock Classes="variant" Text="تاريخ ووقت" />
      <Border Classes="stage wide">
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="الموعد" />
          <ins:DateField x:Name="DateTimePlay" Mode="DateTime" MinuteStep="15" />
        </StackPanel>
      </Border>

      <TextBlock Classes="variant" Text="تاريخ ووقت في حقلين" />
      <Border Classes="stage wide">
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="الموعد" />
          <ins:DateTimeGroup x:Name="GroupPlay" />
        </StackPanel>
      </Border>

      <TextBlock Classes="variant" Text="حدود للتاريخ" />
      <Border Classes="stage wide">
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="التاريخ" />
          <ins:DateField x:Name="BoundedPlay" />
        </StackPanel>
      </Border>

      <TextBlock Classes="variant" Text="التقويم" />
      <Border Classes="stage">
        <FlyoutPresenter Classes="picker" HorizontalAlignment="Center" ClipToBounds="False">
          <ins:DateCalendar x:Name="StillSingle" />
        </FlyoutPresenter>
      </Border>

      <TextBlock Classes="variant" Text="التقويم: فترة" />
      <Border Classes="stage">
        <FlyoutPresenter Classes="picker" HorizontalAlignment="Center" ClipToBounds="False">
          <ins:DateCalendar x:Name="StillRange" Mode="Range" IsDual="True" />
        </FlyoutPresenter>
      </Border>

      <TextBlock Classes="variant" Text="التقويم: تاريخ ووقت" />
      <Border Classes="stage">
        <FlyoutPresenter Classes="picker" HorizontalAlignment="Center" ClipToBounds="False">
          <ins:DateCalendar x:Name="StillDateTime" Mode="DateTime" MinuteStep="15" />
        </FlyoutPresenter>
      </Border>

      <TextBlock Classes="section" Text="الوقت" />
      <Border Classes="stage wide">
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="الموعد" />
          <ins:TimeField x:Name="TimePlay" />
        </StackPanel>
      </Border>

      <TextBlock Classes="variant" Text="الخطوة بالدقائق: 15" />
      <Border Classes="stage wide">
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="الموعد" />
          <ins:TimeField x:Name="Step15" MinuteStep="15" />
        </StackPanel>
      </Border>

      <TextBlock Classes="variant" Text="الخطوة بالدقائق: 60" />
      <Border Classes="stage wide">
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="الموعد" />
          <ins:TimeField x:Name="Step60" MinuteStep="60" />
        </StackPanel>
      </Border>

      <TextBlock Classes="variant" Text="حدود للوقت" />
      <Border Classes="stage wide">
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="الموعد" />
          <ins:TimeField x:Name="BoundedTime" />
        </StackPanel>
      </Border>

      <TextBlock Classes="variant" Text="الأعمدة" />
      <Border Classes="stage">
        <FlyoutPresenter Classes="picker" HorizontalAlignment="Center" ClipToBounds="False">
          <Panel>
            <Border Classes="picker-glass" />
            <ins:TimeDrum x:Name="StillDrum" Margin="8" MinuteStep="30" />
          </Panel>
        </FlyoutPresenter>
      </Border>

      <TextBlock Classes="section" Text="المنزلق" />
      <Border Classes="stage">
        <Slider Minimum="0" Maximum="50" TickFrequency="5" IsSnapToTickEnabled="True" Value="25" Width="480" />
      </Border>

      <TextBlock Classes="variant" Text="الخطوة: 1" />
      <Border Classes="stage">
        <Slider Minimum="0" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True" Value="21" Width="480" />
      </Border>

      <TextBlock Classes="variant" Text="الخطوة: 10" />
      <Border Classes="stage">
        <Slider Minimum="0" Maximum="50" TickFrequency="10" IsSnapToTickEnabled="True" Value="30" Width="480" />
      </Border>

      <TextBlock Classes="variant" Text="معطل" />
      <Border Classes="stage">
        <Slider Minimum="0" Maximum="50" TickFrequency="5" IsSnapToTickEnabled="True" Value="25" Width="480" IsEnabled="False" />
      </Border>

      <TextBlock Classes="section" Text="العداد" />
      <Border Classes="stage">
        <NumericUpDown Value="6" Minimum="0" Maximum="20" Width="137" />
      </Border>

      <TextBlock Classes="variant" Text="الخطوة: 5" />
      <Border Classes="stage">
        <NumericUpDown Value="10" Minimum="0" Maximum="20" Increment="5" Width="137" />
      </Border>

      <TextBlock Classes="variant" Text="معطل" />
      <Border Classes="stage">
        <NumericUpDown Value="6" Minimum="0" Maximum="20" Width="137" IsEnabled="False" />
      </Border>

      <TextBlock Classes="section" Text="الأدوات الأصلية" />
      <Border Classes="stage">
        <CalendarDatePicker x:Name="NativeDatePicker" Width="300" />
      </Border>

      <Border Classes="stage">
        <DatePicker x:Name="NativeDate" />
      </Border>

      <Border Classes="stage">
        <TimePicker x:Name="NativeTime" />
      </Border>

      <Border Classes="stage">
        <Calendar x:Name="NativeCalendar" />
      </Border>

      <Border Classes="stage">
        <DatePickerPresenter x:Name="StillDatePresenter" HorizontalAlignment="Center" />
      </Border>

      <Border Classes="stage">
        <TimePickerPresenter x:Name="StillTimePresenter" HorizontalAlignment="Center" />
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
