<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pg="using:Insiyab.Avalonia.Gallery.Playground"
             x:Class="Insiyab.Avalonia.Gallery.Pages.PickersPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Playground/PlayFrames.axaml" />
  </UserControl.Styles>

  <StackPanel>
    <TextBlock Classes="intro" Text="الإكمال التلقائي والتاريخ والوقت والمنزلق والعداد، أدوات لا يستغني عنها نموذج جاد." />
    <pg:PlayExample Layout="Stack" Code="{x:Static pg:PickersPlay.Example}" />

    <TextBlock Classes="section" Text="الإكمال التلقائي" />
    <pg:PlayText Classes="p" Markup="يضم `AutoCompleteBox` حقلًا وقائمة خيارات تنفتح وهو يكتب، تتنقل فيها الأسهم، و`Enter` للاختيار و`Esc` للإغلاق. ومعه `ArabicMatch.Contains` تفهم مطابقته العربية، فلا تلتفت إلى التشكيل ولا إلى صور الهمزة. وتجد الخيارات كلها بشرحها في آخر الصفحة." />
    <pg:Playground Def="{x:Static pg:PickersPlay.Combo}" />

    <TextBlock Classes="section" Text="التاريخ" />
    <pg:PlayText Classes="p" Markup="يكتب `ins:DateField` التاريخ بلغة الواجهة، ويفتح تقويمًا يبدأ أسبوعه يوم السبت في الواجهة العربية، وتتنقل فيه الأسهم بين الأيام مع اتجاهها. ويبقى ما في `Value` بالصيغة `2026-09-23`، كما يتلقاه الخادم." />
    <pg:Playground Def="{x:Static pg:PickersPlay.Date}" />
    <pg:PlayText Classes="p" Markup="أما تاريخ الميلاد، فلا يبحث عنه صاحبه في تقويم، ولذا له حقل خاص يُكتب ويُختار بالأعمدة، في صفحة تاريخ الميلاد." />

    <TextBlock Classes="section" Text="الوقت" />
    <pg:PlayText Classes="p" Markup="يعرض `ins:TimeField` الوقت كما تكتبه لغة الواجهة، وتظهر تحته أعمدة للساعة والدقيقة والفترة (ص/م)، ويقبل الكتابة أيضًا، مثل «14:30» و«2:30 م»." />
    <pg:Playground Def="{x:Static pg:PickersPlay.Time}" />

    <TextBlock Classes="section" Text="المنزلق" />
    <pg:PlayText Classes="p" Markup="المنزلق `Slider` الأصلي بمظهر المكتبة، فلوحة المفاتيح وما يسمعه قارئ الشاشة من شأن Avalonia، وكذلك اتجاهه، ففي الواجهة العربية يقع الحد الأدنى على اليمين." />
    <pg:Playground Def="{x:Static pg:PickersPlay.Range}" />

    <TextBlock Classes="section" Text="العداد" />
    <pg:PlayText Classes="p" Markup="حقل `NumericUpDown` رقمي بين زرين، يزيدانه وينقصانه بخطوة `Increment` ولا يتجاوزان `Minimum` و`Maximum`." />
    <pg:Playground Def="{x:Static pg:PickersPlay.Stepper}" />

    <TextBlock Classes="section" Text="الأدوات الأصلية" />
    <pg:PlayText Classes="p" Markup="وأدوات Avalonia الأصلية للتاريخ والوقت تأخذ مظهر المكتبة أيضًا، إن احتجت إليها." />
    <pg:PlayExample Layout="Stack" Code="{x:Static pg:PickersPlay.NativeExample}" />

    <TextBlock Classes="section" Text="الخيارات" />
    <pg:PlayText Classes="p" Markup="كل ما في أدوات الاختيار من عناصر وخصائص وأحداث، لكل أداة صندوق يفتح بالنقر." />
    <pg:OptionsList Defs="{x:Static pg:PickersPlay.All}" />
  </StackPanel>
</UserControl>
