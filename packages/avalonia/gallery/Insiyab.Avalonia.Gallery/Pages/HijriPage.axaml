<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ins="using:Insiyab.Avalonia.Controls"
             x:Class="Insiyab.Avalonia.Gallery.Pages.HijriPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Pages/PickersFrames.axaml" />
  </UserControl.Styles>
  <ScrollViewer>
    <StackPanel>

      <Border Classes="dx">
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="التاريخ" />
          <ins:DateField x:Name="Demo" CalendarKind="Hijri" />
        </StackPanel>
      </Border>

      <TextBlock Classes="section" Text="حقل هجري" />
      <Border Classes="stage wide">
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="التاريخ" />
          <ins:DateField x:Name="Play" CalendarKind="Hijri" />
        </StackPanel>
      </Border>

      <TextBlock Classes="variant" Text="فترة بين تاريخين" />
      <Border Classes="stage wide">
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="الفترة" />
          <ins:DateField x:Name="PlayRange" CalendarKind="Hijri" Mode="Range" />
        </StackPanel>
      </Border>

      <TextBlock Classes="variant" Text="الحسابي" />
      <Border Classes="stage wide">
        <StackPanel Classes="field">
          <TextBlock Classes="label" Text="التاريخ" />
          <ins:DateField x:Name="PlayCivil" CalendarKind="HijriCivil" />
        </StackPanel>
      </Border>

      <TextBlock Classes="variant" Text="التقويم" />
      <Border Classes="stage">
        <FlyoutPresenter Classes="picker" HorizontalAlignment="Center" ClipToBounds="False">
          <ins:DateCalendar x:Name="StillHijri" CalendarKind="Hijri" />
        </FlyoutPresenter>
      </Border>

      <TextBlock Classes="variant" Text="بعد قلبه إلى الميلادي" />
      <Border Classes="stage">
        <FlyoutPresenter Classes="picker" HorizontalAlignment="Center" ClipToBounds="False">
          <ins:DateCalendar x:Name="StillGregorian" CalendarKind="Hijri" ShowGregorian="True" />
        </FlyoutPresenter>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
