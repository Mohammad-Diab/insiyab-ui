<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ins="using:Insiyab.Avalonia.Controls"
             xmlns:pg="using:Insiyab.Avalonia.Gallery.Playground"
             x:Class="Insiyab.Avalonia.Gallery.Pages.ScrollspyPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Playground/PlayFrames.axaml" />
  </UserControl.Styles>

  <StackPanel>
    <TextBlock Classes="intro" Text="قائمة محتويات تتبع القارئ، فتبرز رابط القسم الذي يقرؤه، في الصفحة أو في صندوق له تمريره الخاص." />
    <pg:PlayExample Layout="Stack" Code="{x:Static pg:ScrollspyPlay.Example}" Stage="{x:Static pg:ScrollspyPlay.ExampleStage}" />

    <TextBlock Classes="section" Text="قائمة تتبع القراءة" />
    <pg:PlayText Classes="p" Markup="ضع في `ins:Toc` روابط `ins:TocLink` يشير كل منها إلى قسم في `Section`، فيتميز رابط القسم الذي يُقرأ بعلامة من لون الهوية تنتقل من رابط إلى آخر كما في الشريط الجانبي. وتجد الخيارات بشرحها في آخر الصفحة." />
    <pg:Playground Def="{x:Static pg:ScrollspyPlay.Toc}" />

    <TextBlock Classes="section" Text="كيف يُعرف القسم الحالي" />
    <ins:ProseList>
      <TextBlock Classes="p" Margin="0"><Bold>القسم الحالي</Bold> هو آخر قسم عبر أعلاه خطًا يقع على ثلث منطقة التمرير من أعلاها، أو على بعد Offset بكسلًا منه إذا كان الشريط العلوي الثابت طويلًا.</TextBlock>
      <TextBlock Classes="p" Margin="0"><Bold>في آخر التمرير</Bold> يصير القسم الأخير هو الحالي مهما قصر، ولو لم يبلغ الخط قط.</TextBlock>
      <TextBlock Classes="p" Margin="0"><Bold>منطقة التمرير</Bold> يعرفها المكون بنفسه: أقرب ScrollViewer حول القسم الأول، أو ما تضعه في ScrollViewer.</TextBlock>
      <TextBlock Classes="p" Margin="0"><Bold>النقر على رابط</Bold> يجعله الحالي في الحال، ولا تنتقل العلامة عنه في أثناء التمرير الذي أحدثه النقر.</TextBlock>
    </ins:ProseList>

    <TextBlock Classes="section" Text="التحكم من الشيفرة" />
    <pg:PlayListing Code="{x:Static pg:ScrollspyPlay.Code}" Margin="0,0,0,24" />

    <TextBlock Classes="section" Text="الخيارات" />
    <pg:PlayText Classes="p" Markup="كل ما في قائمة المحتويات من كلاسات وخصائص وأحداث، في صندوق يفتح بالنقر." />
    <pg:OptionsList Defs="{x:Static pg:ScrollspyPlay.All}" />
  </StackPanel>
</UserControl>
