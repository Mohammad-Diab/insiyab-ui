<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="InsPluginsViewBd" Color="#1A0F172A" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="InsPluginsViewBd" Color="#1AFFFFFF" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <SolidColorBrush x:Key="InsPluginsViewBg" Color="{DynamicResource InsPrimaryColor}" Opacity="0.025" />
    </ResourceDictionary>
  </Styles.Resources>

  <!-- The docs page frames for the plugin pages: a section heading, an example view, a playground stage and its variant label. -->
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="{DynamicResource InsFsH3}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource InsText1}" />
    <Setter Property="Margin" Value="0,48,0,12" />
  </Style>
  <Style Selector="TextBlock.section:nth-child(1)">
    <Setter Property="Margin" Value="0,0,0,12" />
  </Style>
  <Style Selector="Border.dx, Border.stage">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource InsPluginsViewBd}" />
    <Setter Property="Background" Value="{DynamicResource InsPluginsViewBg}" />
    <Setter Property="CornerRadius" Value="{DynamicResource InsRLg}" />
    <Setter Property="Padding" Value="24" />
    <Setter Property="Margin" Value="0,0,0,24" />
  </Style>
  <Style Selector="Border.stage">
    <Setter Property="Padding" Value="24,64" />
    <Setter Property="MinHeight" Value="208" />
  </Style>
  <Style Selector="Border.stage > :is(Control)">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.stage.wide > :is(Control)">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="TextBlock.variant">
    <Setter Property="FontSize" Value="{DynamicResource InsFsXs}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource InsText2}" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <!-- The docs' .ins-field: a label, the control and a hint, 6px apart. -->
  <Style Selector="StackPanel.field">
    <Setter Property="Spacing" Value="6" />
  </Style>

</Styles>
