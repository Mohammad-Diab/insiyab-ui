<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pg="using:Insiyab.Avalonia.Gallery.Playground"
             x:Class="Insiyab.Avalonia.Gallery.Pages.CarouselPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Playground/PlayFrames.axaml" />
    <!-- The docs' coloured slides, for the examples only -->
    <Style Selector="Border.car">
      <Setter Property="Height" Value="240" />
      <Setter Property="Padding" Value="24,20" />
      <Setter Property="CornerRadius" Value="{DynamicResource InsRLg}" />
    </Style>
    <Style Selector="Border.car > TextBlock">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>
    <Style Selector="Border.car1">
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="33%,0%" EndPoint="67%,100%">
          <GradientStop Offset="0" Color="#0f766e" />
          <GradientStop Offset="1" Color="#134e4a" />
        </LinearGradientBrush>
      </Setter>
    </Style>
    <Style Selector="Border.car2">
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="33%,0%" EndPoint="67%,100%">
          <GradientStop Offset="0" Color="#4c1d95" />
          <GradientStop Offset="1" Color="#2e1065" />
        </LinearGradientBrush>
      </Setter>
    </Style>
    <Style Selector="Border.car3">
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="33%,0%" EndPoint="67%,100%">
          <GradientStop Offset="0" Color="#1d4ed8" />
          <GradientStop Offset="1" Color="#1e1b4b" />
        </LinearGradientBrush>
      </Setter>
    </Style>
    <Style Selector="Border.car4">
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="33%,0%" EndPoint="67%,100%">
          <GradientStop Offset="0" Color="#b45309" />
          <GradientStop Offset="1" Color="#451a03" />
        </LinearGradientBrush>
      </Setter>
    </Style>
  </UserControl.Styles>

  <StackPanel>
    <TextBlock Classes="intro" Text="عرض شرائح في صف تسحبه بإصبعك، وأزرار ونقاط وأسهم تتبع اتجاه القراءة، ولا يتحرك من تلقاء نفسه." />
    <pg:PlayExample Layout="Stack" Code="{x:Static pg:CarouselPlay.Example}" />

    <TextBlock Classes="section" Text="عرض الشرائح" />
    <pg:PlayText Classes="p" Markup="كل عنصر في `Carousel` شريحة، تسحب صفها بإصبعك، ويضيف العرض زري السابق والتالي، ونقطة لكل موضع، وأسهم لوحة المفاتيح تسير مع اتجاه القراءة، ويخبر قارئ الشاشة عند كل شريحة أنها «2 من 4». وتجد الخيارات كلها بشرحها في آخر الصفحة." />
    <pg:Playground Def="{x:Static pg:CarouselPlay.Carousel}" />

    <TextBlock Classes="section" Text="بلا تشغيل تلقائي" />
    <TextBlock Classes="p" Text="لا يدور العرض من تلقاء نفسه، فلا تنتقل الشرائح إلا بيد المستخدم. ومن أطفأ المؤثرات انتقل عنده الصف فورًا بلا انزلاق." />

    <TextBlock Classes="section" Text="التحكم من الشيفرة" />
    <pg:PlayListing Code="{x:Static pg:CarouselPlay.Code}" Margin="0,0,0,24" />

    <TextBlock Classes="section" Text="الخيارات" />
    <pg:PlayText Classes="p" Markup="كل ما في عرض الشرائح من كلاسات وخصائص وأحداث، في صندوق يفتح بالنقر." />
    <pg:OptionsList Defs="{x:Static pg:CarouselPlay.All}" />
  </StackPanel>
</UserControl>
