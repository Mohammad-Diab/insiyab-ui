<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pg="using:Insiyab.Avalonia.Gallery.Playground"
             x:Class="Insiyab.Avalonia.Gallery.Pages.ButtonsPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Playground/PlayFrames.axaml" />
  </UserControl.Styles>

  <StackPanel>
    <TextBlock Classes="intro" Text="ألوان وأنماط ومقاسات، وأزرار تبديل ومجموعات، وزر للإغلاق، وأزرار تفتح قوائم." />
    <pg:PlayExample Layout="Row" Code="{x:Static pg:ButtonsPlay.Example}" />

    <TextBlock Classes="section" Text="الزر" />
    <pg:PlayText Classes="p" Markup="اختر من الخيارات، فيتغير الزر وشيفرته معًا. واجعل `primary` للإجراء الرئيسي في الشاشة، و`secondary` لما يجاوره، والهادئ لما هو أقل منهما. وتجد الخيارات كلها بشرحها في آخر الصفحة." />
    <pg:Playground Def="{x:Static pg:ButtonsPlay.Button}" />

    <TextBlock Classes="section" Text="مجموعة الأزرار" />
    <pg:PlayText Classes="p" Markup="يضم الكلاس `btn-group` على `StackPanel` الأزرار المتجاورة في قطعة واحدة." />
    <pg:Playground Def="{x:Static pg:ButtonsPlay.Group}" />

    <TextBlock Classes="section" Text="زر الإغلاق" />
    <pg:PlayText Classes="p" Markup="يرسم الكلاس `close` علامة الإغلاق بنفسه، فيغنيك عن الأيقونة." />
    <pg:Playground Def="{x:Static pg:ButtonsPlay.Close}" />

      <TextBlock Classes="h3" Text="زر الإغلاق" />

    <TextBlock Classes="section" Text="الخيارات" />
    <pg:PlayText Classes="p" Markup="كل ما في الأزرار من كلاسات وخصائص وأحداث، لكل مكون صندوق يفتح بالنقر." />
    <pg:OptionsList Defs="{x:Static pg:ButtonsPlay.All}" />
  </StackPanel>
</UserControl>
