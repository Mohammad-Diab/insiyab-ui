<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ins="using:Insiyab.Avalonia.Controls"
             xmlns:pg="using:Insiyab.Avalonia.Gallery.Playground"
             x:Class="Insiyab.Avalonia.Gallery.Pages.DrawerPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Playground/PlayFrames.axaml" />
  </UserControl.Styles>

  <StackPanel>
    <TextBlock Classes="intro" Text="الدرج هو مربع الحوار نفسه ملتصقًا بحافة: البداية أو النهاية أو الأسفل." />
    <pg:PlayExample Layout="Row" Code="{x:Static pg:DrawerPlay.Example}" />

    <TextBlock Classes="section" Text="الدرج" />
    <pg:PlayText Classes="p" Markup="الدرج `ins:Dialog` بالكلاس `drawer`، مربع حوار ملتصق بإحدى الحواف، له أجزاؤه وسلوكه، ويزيد عليه أن النقر خارجه يغلقه. وتجد الخيارات كلها بشرحها في آخر الصفحة." />
    <pg:Playground Def="{x:Static pg:DrawerPlay.Drawer}" />

    <TextBlock Classes="section" Text="الدرج المثبّت" />
    <pg:PlayText Classes="p" Markup="يضع `ins:DrawerHost` الدرج بجوار المحتوى، فيأخذ عمودًا يدفع الصفحة، أو يطفو فوقها إذا ضاقت النافذة." />
    <pg:Playground Def="{x:Static pg:DrawerPlay.Host}" />

    <TextBlock Classes="section" Text="الحوار أم الدرج؟" />
    <ins:ProseList>
      <TextBlock Classes="p" Margin="0"><Bold>الحوار</Bold> لسؤال أو نموذج يستوقفك عما كنت فيه.</TextBlock>
      <TextBlock Classes="p" Margin="0"><Bold>الدرج</Bold> لما تطالعه والصفحة ما زالت أمامك، كتصفية قائمة أو تفاصيل صف.</TextBlock>
      <TextBlock Classes="p" Margin="0"><Bold>اللوح السفلي</Bold> لقائمة قصيرة من الإجراءات على الهاتف.</TextBlock>
    </ins:ProseList>

    <TextBlock Classes="section" Text="الخيارات" />
    <pg:PlayText Classes="p" Markup="كل ما في الدرج من كلاسات وخصائص وأحداث، لكل مكون صندوق يفتح بالنقر." />
    <pg:OptionsList Defs="{x:Static pg:DrawerPlay.All}" />
  </StackPanel>
</UserControl>
