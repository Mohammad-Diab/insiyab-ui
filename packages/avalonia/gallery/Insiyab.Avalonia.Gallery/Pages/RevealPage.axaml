<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pg="using:Insiyab.Avalonia.Gallery.Playground"
             x:Class="Insiyab.Avalonia.Gallery.Pages.RevealPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Playground/PlayFrames.axaml" />
    <!-- The docs' dashed placeholder box, for the examples only -->
    <Style Selector="ContentControl.demo-box">
      <Setter Property="Padding" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="{DynamicResource InsFontBodyEn}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource InsToneBrand}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <Rectangle Fill="{DynamicResource InsToneBrandBg}" Stroke="{DynamicResource InsToneBrandBd}" StrokeThickness="1"
                       StrokeDashArray="3,3" RadiusX="10" RadiusY="10" />
            <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="Center" />
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>
  </UserControl.Styles>

  <StackPanel>
    <TextBlock Classes="intro" Text="أبناء لوح يدخلون تباعًا حين يظهر، وثلاث حركات تمنح عنصرًا واحدًا حركة دخول." />
    <pg:PlayExample x:Name="Example" Layout="Stack" Code="{x:Static pg:RevealPlay.Example}" />
    <Button x:Name="Replay" Classes="secondary" Content="أعد" HorizontalAlignment="Left" />

    <TextBlock Classes="section" Text="دخول الأبناء متتابعين" />
    <pg:PlayText Classes="p" Markup="ضع `ins:Entrance.Reveal` على لوح فيدخل أبناؤه متتابعين. واضغط «أعد» تحت المثال أعلاه لتراه مرة أخرى. وتجد الخيارات كلها بشرحها في آخر الصفحة." />
    <pg:Playground Def="{x:Static pg:RevealPlay.Reveal}" />

    <TextBlock Classes="section" Text="حركة لعنصر بمفرده" />
    <pg:PlayText Classes="p" Markup="تمنح `ins:Entrance.Effect` عنصرًا بمفرده حركة دخول من ثلاث." />
    <pg:Playground Def="{x:Static pg:RevealPlay.Anim}" />

    <TextBlock Classes="section" Text="الخيارات" />
    <pg:PlayText Classes="p" Markup="كل ما في حركات الدخول من خصائص، لكل منها صندوق يفتح بالنقر." />
    <pg:OptionsList Defs="{x:Static pg:RevealPlay.All}" />
  </StackPanel>
</UserControl>
