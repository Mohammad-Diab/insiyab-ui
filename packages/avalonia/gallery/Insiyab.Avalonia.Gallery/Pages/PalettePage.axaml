<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ins="using:Insiyab.Avalonia.Controls"
             x:Class="Insiyab.Avalonia.Gallery.Pages.PalettePage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Pages/MenusFrames.axaml" />
  </UserControl.Styles>
  <UserControl.Resources>
    <ins:CommandPalette x:Key="DemoPalette">
      <ins:PaletteItem Label="الأزرار" Group="الصفحات" Keywords="buttons" />
      <ins:PaletteItem Label="الجداول" Group="الصفحات" Keywords="tables" />
      <ins:PaletteItem Label="الحوار" Group="الصفحات" Keywords="dialog" />
      <ins:PaletteItem Label="حفظ" Group="إجراءات" Keywords="save" Hint="Ctrl S" />
    </ins:CommandPalette>
  </UserControl.Resources>
  <StackPanel>

    <Border Classes="dx">
      <Button x:Name="OpenDemo" Classes="secondary" Content="فتح" />
    </Border>

    <TextBlock Classes="section" Text="لوحة تبنيها بـ HTML" />
    <Border Classes="stage">
      <Button x:Name="OpenPlay" Classes="secondary" Content="فتح" />
    </Border>

    <TextBlock Classes="variant" Text="لوحة الأوامر" />
    <Border Classes="dx" Padding="0" Height="560" ClipToBounds="True">
      <ins:CommandPalette x:Name="Still" />
    </Border>

    <TextBlock Classes="variant" Text="اختصار اللوحة: Alt+K" />
    <Border Classes="stage">
      <Button x:Name="OpenAltK" Classes="secondary">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="فتح" VerticalAlignment="Center" />
          <Border Classes="kbd"><TextBlock Text="Alt K" /></Border>
        </StackPanel>
      </Button>
    </Border>

    <TextBlock Classes="section" Text="التحكم بـ JavaScript" />
    <Border Classes="dx">
      <Button x:Name="AddCommand" Classes="secondary" Content="إضافة أمر" />
    </Border>

  </StackPanel>
</UserControl>
