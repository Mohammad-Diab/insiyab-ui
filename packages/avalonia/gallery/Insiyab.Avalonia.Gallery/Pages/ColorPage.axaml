<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Insiyab.Avalonia.Gallery.Pages.ColorPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Pages/FoundationFrames.axaml" />
    <!-- The docs' brand swatch: a pill with the colour's dot at its start and its hex after it -->
    <Style Selector="Button.brand-swatch">
      <Setter Property="Padding" Value="6,6,14,6" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource InsRPill}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource InsLine}" />
      <Setter Property="Background" Value="{DynamicResource InsCtlBg}" />
      <Setter Property="Foreground" Value="{DynamicResource InsText2}" />
      <Setter Property="FontFamily" Value="{DynamicResource InsFontBodyEn}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
        </Transitions>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.brand-swatch:pointerover">
      <Setter Property="RenderTransform" Value="translateY(-2px)" />
      <Setter Property="Background" Value="{DynamicResource InsCtlBgHover}" />
    </Style>
    <Style Selector="Button.brand-swatch Border.dot">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#14000000" />
    </Style>
    <Style Selector="Button.brand-swatch StackPanel">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="8" />
    </Style>
    <Style Selector="Button.brand-swatch TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FlowDirection" Value="LeftToRight" />
    </Style>
    <Style Selector="Border.token">
      <Setter Property="Padding" Value="8" />
      <Setter Property="CornerRadius" Value="{DynamicResource InsRSm}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource InsLine}" />
      <Setter Property="Background" Value="{DynamicResource InsCtlBg}" />
      <Setter Property="FlowDirection" Value="LeftToRight" />
      <Setter Property="TextElement.FontFamily" Value="{DynamicResource InsFontMono}" />
      <Setter Property="TextElement.FontSize" Value="12" />
      <Setter Property="TextElement.FontWeight" Value="SemiBold" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource InsText2}" />
    </Style>
    <Style Selector="Border.token Border.chip">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="{DynamicResource InsRXs}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#14000000" />
    </Style>
    <Style Selector="StackPanel.tone > Border">
      <Setter Property="Height" Value="44" />
      <Setter Property="CornerRadius" Value="{DynamicResource InsRXs}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="StackPanel.tone > TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
  </UserControl.Styles>
  <StackPanel>

    <TextBlock Classes="section" Text="جرب لونًا" />
    <Border Classes="dx">
      <StackPanel Spacing="12">
        <WrapPanel ItemSpacing="10" LineSpacing="10">
          <Button Classes="brand-swatch" Tag="#0F766E" Click="OnSwatch"><StackPanel><Border Classes="dot" Background="#0F766E" /><TextBlock Text="#0F766E" /></StackPanel></Button>
          <Button Classes="brand-swatch" Tag="#1D4ED8" Click="OnSwatch"><StackPanel><Border Classes="dot" Background="#1D4ED8" /><TextBlock Text="#1D4ED8" /></StackPanel></Button>
          <Button Classes="brand-swatch" Tag="#9B2C5E" Click="OnSwatch"><StackPanel><Border Classes="dot" Background="#9B2C5E" /><TextBlock Text="#9B2C5E" /></StackPanel></Button>
          <Button Classes="brand-swatch" Tag="#4C1D95" Click="OnSwatch"><StackPanel><Border Classes="dot" Background="#4C1D95" /><TextBlock Text="#4C1D95" /></StackPanel></Button>
          <Button Classes="brand-swatch" Tag="#B45309" Click="OnSwatch"><StackPanel><Border Classes="dot" Background="#B45309" /><TextBlock Text="#B45309" /></StackPanel></Button>
          <Button Classes="brand-swatch" Tag="#C9A063" Click="OnSwatch"><StackPanel><Border Classes="dot" Background="#C9A063" /><TextBlock Text="#C9A063" /></StackPanel></Button>
          <Button Classes="brand-swatch" AutomationProperties.Name="لون مخصص">
            <StackPanel>
              <Border x:Name="CustomDot" Classes="dot" Background="#0F766E" CornerRadius="3" />
              <TextBlock Text="لون آخر" FlowDirection="RightToLeft" FontFamily="{DynamicResource InsFontArabic}" />
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="Bottom">
                <TextBox x:Name="CustomHex" Width="160" Text="#0F766E" FlowDirection="LeftToRight" KeyDown="OnCustomKey"
                         AutomationProperties.Name="لون مخصص" />
              </Flyout>
            </Button.Flyout>
          </Button>
        </WrapPanel>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="primary" Content="حفظ" />
          <ToggleSwitch Content="مفعل" IsChecked="True" VerticalAlignment="Center" />
        </StackPanel>
        <ProgressBar Value="62" AutomationProperties.Name="62%" />
        <TextBox PlaceholderText="حلقة التركيز" AutomationProperties.Name="حقل" />
        <UniformGrid x:Name="Tokens" Columns="3" ColumnSpacing="8" RowSpacing="8" />
        <TextBlock x:Name="LabelNote" Classes="muted" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <TextBlock Classes="section" Text="النبرات" />
    <Border Classes="dx">
      <UniformGrid Columns="5" ColumnSpacing="10" RowSpacing="10">
        <StackPanel Classes="tone"><Border Background="{DynamicResource InsToneOkBg}" BorderBrush="{DynamicResource InsToneOkBd}" /><TextBlock Foreground="{DynamicResource InsToneOk}" Text="ok · نجاح" /></StackPanel>
        <StackPanel Classes="tone"><Border Background="{DynamicResource InsToneWarnBg}" BorderBrush="{DynamicResource InsToneWarnBd}" /><TextBlock Foreground="{DynamicResource InsToneWarn}" Text="warn · تحذير" /></StackPanel>
        <StackPanel Classes="tone"><Border Background="{DynamicResource InsToneBadBg}" BorderBrush="{DynamicResource InsToneBadBd}" /><TextBlock Foreground="{DynamicResource InsToneBad}" Text="bad · خطأ" /></StackPanel>
        <StackPanel Classes="tone"><Border Background="{DynamicResource InsToneInfoBg}" BorderBrush="{DynamicResource InsToneInfoBd}" /><TextBlock Foreground="{DynamicResource InsToneInfo}" Text="info · معلومة" /></StackPanel>
        <StackPanel Classes="tone"><Border Background="{DynamicResource InsToneMuteBg}" BorderBrush="{DynamicResource InsToneMuteBd}" /><TextBlock Foreground="{DynamicResource InsToneMute}" Text="mute · خافت" /></StackPanel>
        <StackPanel Classes="tone"><Border Background="{DynamicResource InsToneBrandBg}" BorderBrush="{DynamicResource InsToneBrandBd}" /><TextBlock Foreground="{DynamicResource InsToneBrand}" Text="brand · الهوية" /></StackPanel>
      </UniformGrid>
    </Border>

  </StackPanel>
</UserControl>
