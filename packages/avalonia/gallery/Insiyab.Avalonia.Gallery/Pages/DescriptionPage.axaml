<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pg="using:Insiyab.Avalonia.Gallery.Playground"
             x:Class="Insiyab.Avalonia.Gallery.Pages.DescriptionPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Playground/PlayFrames.axaml" />
  </UserControl.Styles>

  <StackPanel>
    <TextBlock Classes="intro" Text="تفاصيل سجل واحد، تسمية وقيمة: صف لكل زوج، أو أعمدة لملخص قصير." />
    <pg:PlayExample Layout="Stack" Code="{x:Static pg:DescriptionPlay.Example}" />

    <TextBlock Classes="section" Text="قائمة الوصف" />
    <pg:PlayText Classes="p" Markup="ضع `ins:DescriptionList` لتعرض تفاصيل سجل واحد، وفيه `ins:DescriptionItem` لكل زوج من تسمية وقيمة. وتجد الخيارات كلها بشرحها في آخر الصفحة." />
    <pg:Playground Def="{x:Static pg:DescriptionPlay.List}" />

    <TextBlock Classes="section" Text="الخيارات" />
    <pg:PlayText Classes="p" Markup="كل ما في قائمة الوصف من عناصر وكلاسات." />
    <pg:OptionsList Defs="{x:Static pg:DescriptionPlay.All}" />
  </StackPanel>
</UserControl>
