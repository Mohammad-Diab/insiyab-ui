<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pg="using:Insiyab.Avalonia.Gallery.Playground"
             x:Class="Insiyab.Avalonia.Gallery.Pages.AlertsPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Playground/PlayFrames.axaml" />
  </UserControl.Styles>

  <StackPanel>
    <TextBlock Classes="intro" Text="رسالة تستقر في الصفحة بأربع نبرات، ويمكن إغلاقها." />
    <pg:PlayExample Layout="Stack" Code="{x:Static pg:AlertsPlay.Example}" />

    <TextBlock Classes="section" Text="التنبيه" />
    <pg:PlayText Classes="p" Markup="في التنبيه `ins:Alert` دائرة تحمل رمزه، ورسالة يسكنها النص من `Content`. اختر من الخيارات فيتغير التنبيه وشيفرته معًا، وتجد الخيارات كلها بشرحها في آخر الصفحة." />
    <pg:Playground Def="{x:Static pg:AlertsPlay.Alert}" />

    <TextBlock Classes="section" Text="الخيارات" />
    <pg:PlayText Classes="p" Markup="كل ما في التنبيه من عناصر وكلاسات وخصائص وأحداث، في صندوق يفتح بالنقر." />
    <pg:OptionsList Defs="{x:Static pg:AlertsPlay.All}" />
  </StackPanel>
</UserControl>
