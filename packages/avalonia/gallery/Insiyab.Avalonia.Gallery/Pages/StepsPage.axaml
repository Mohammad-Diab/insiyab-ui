<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pg="using:Insiyab.Avalonia.Gallery.Playground"
             x:Class="Insiyab.Avalonia.Gallery.Pages.StepsPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Playground/PlayFrames.axaml" />
  </UserControl.Styles>

  <StackPanel>
    <TextBlock Classes="intro" Text="المعالج نموذج مقسم إلى خطوات، لا يغادر خطوة حتى يتحقق منها." />
    <pg:PlayExample Layout="Stack" Code="{x:Static pg:StepsPlay.Example}" />

    <TextBlock Classes="section" Text="الخطوات" />
    <pg:PlayText Classes="p" Markup="`ins:Steps` خطوات مرقمة، تميز فيها الخطوة المنجزة بـ `IsDone` والحالية بـ `IsCurrent`. وتصلح وحدها لمسار موزع على عدة شاشات، وتجد الخيارات كلها بشرحها في آخر الصفحة." />
    <pg:Playground Def="{x:Static pg:StepsPlay.Steps}" />

    <TextBlock Classes="section" Text="المعالج" />
    <pg:PlayText Classes="p" Markup="يُظهر `ins:Wizard` لوحًا واحدًا من ألواحه `ins:WizardPanel` في كل مرة، ويقود الخطوات فوقه. ولا ينتقل «التالي» حتى يتحقق من حقول الخطوة الحالية، ومفتاح `Enter` داخل الحقل يعمل عمل «التالي»، ثم ينتقل التركيز إلى الخطوة الجديدة." />
    <pg:Playground Def="{x:Static pg:StepsPlay.Wizard}" />

    <TextBlock Classes="section" Text="خطوة تنتظر الخادم" />
    <pg:PlayText Classes="p" Markup="يُطلق «التالي» الحدث `Leaving` قبل أن ينتقل، فإذا استدعى مستمعك `e.Wait()` انتظر المعالج مشغولًا، يدور في زره مؤشر التحميل ولا يقبل ضغطة ثانية. فإذا قبل الخادم استدعيت `Proceed()`، وإلا عرضت الخطأ على الحقل نفسه ثم استدعيت `Stay()`. وتجد مثالًا حيًا في معالج تسجيل الدخول." />
    <pg:PlayListing Code="{x:Static pg:StepsPlay.Server}" Margin="0,0,0,24" />

    <TextBlock Classes="section" Text="التحكم من الشيفرة" />
    <pg:PlayListing Code="{x:Static pg:StepsPlay.Code}" Margin="0,0,0,24" />

    <TextBlock Classes="section" Text="الخيارات" />
    <pg:PlayText Classes="p" Markup="كل ما في الخطوات والمعالج من كلاسات وخصائص وأحداث، لكل مكون صندوق يفتح بالنقر." />
    <pg:OptionsList Defs="{x:Static pg:StepsPlay.All}" />
  </StackPanel>
</UserControl>
