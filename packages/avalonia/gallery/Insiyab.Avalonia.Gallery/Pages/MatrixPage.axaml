<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pg="using:Insiyab.Avalonia.Gallery.Playground"
             x:Class="Insiyab.Avalonia.Gallery.Pages.MatrixPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Playground/PlayFrames.axaml" />
  </UserControl.Styles>

  <StackPanel>
    <TextBlock Classes="intro" Text="أسئلة في صفوف تتشارك الإجابات نفسها: استبيان، أو معايير لكل مستوى منها وصف ودرجة." />
    <pg:PlayExample Layout="Stack" Code="{x:Static pg:MatrixPlay.Example}" />

    <TextBlock Classes="section" Text="مصفوفة الاختيار" />
    <pg:PlayText Classes="p" Markup="تعرض `ins:ChoiceMatrix` صفوفًا من الأسئلة تشترك في إجابات واحدة، كما في الاستبيان. لكل صف فيها مجموعة أزرار اختيار تتنقل بينها بالأسهم، ولكل زر اسم لقارئ الشاشة من اسم صفه وعموده، وتتلون الخلية المختارة. وتجد الخيارات كلها بشرحها في آخر الصفحة." />
    <pg:Playground Def="{x:Static pg:MatrixPlay.Matrix}" />

    <TextBlock Classes="section" Text="الخيارات" />
    <pg:PlayText Classes="p" Markup="كل ما في مصفوفة الاختيار من عناصر وكلاسات وخصائص وأحداث." />
    <pg:OptionsList Defs="{x:Static pg:MatrixPlay.All}" />
  </StackPanel>
</UserControl>
