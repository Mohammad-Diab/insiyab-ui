<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ins="using:Insiyab.Avalonia.Controls"
             x:Class="Insiyab.Avalonia.Gallery.Pages.MatrixPage">
  <UserControl.Resources>
    <SolidColorBrush x:Key="ExampleTint" Color="{DynamicResource InsPrimaryColor}" Opacity="0.025" />
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Border.example">
      <Setter Property="Padding" Value="24" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource InsCtlBd}" />
      <Setter Property="CornerRadius" Value="{DynamicResource InsRLg}" />
      <Setter Property="Background" Value="{StaticResource ExampleTint}" />
    </Style>
    <Style Selector="TextBlock.cap">
      <Setter Property="FontSize" Value="{DynamicResource InsFsXs}" />
      <Setter Property="Foreground" Value="{DynamicResource InsText2}" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="TextBlock.h3">
      <Setter Property="Margin" Value="0,24,0,0" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Spacing="16" MaxWidth="832" HorizontalAlignment="Stretch">
      <Border Classes="example">
        <ins:ChoiceMatrix>
          <ins:ChoiceMatrix.Columns>
            <ins:MatrixColumn Header="ضعيف" Value="1" />
            <ins:MatrixColumn Header="مقبول" Value="2" />
            <ins:MatrixColumn Header="جيد" Value="3" />
            <ins:MatrixColumn Header="ممتاز" Value="4" />
          </ins:ChoiceMatrix.Columns>
          <ins:MatrixRow Header="السعر" SelectedIndex="2" />
          <ins:MatrixRow Header="الجودة" SelectedIndex="-1" />
          <ins:MatrixRow Header="التوصيل" SelectedIndex="-1" />
        </ins:ChoiceMatrix>
      </Border>

      <TextBlock Classes="h3" Text="مصفوفة الاختيار" />
      <Border Classes="example">
        <StackPanel Spacing="24">
          <ins:ChoiceMatrix>
          <ins:ChoiceMatrix.Columns>
            <ins:MatrixColumn Header="ضعيف" Value="1" />
            <ins:MatrixColumn Header="مقبول" Value="2" />
            <ins:MatrixColumn Header="جيد" Value="3" />
            <ins:MatrixColumn Header="ممتاز" Value="4" />
          </ins:ChoiceMatrix.Columns>
          <ins:MatrixRow Header="الأول" SelectedIndex="1" />
          <ins:MatrixRow Header="الثاني" SelectedIndex="-1" />
        </ins:ChoiceMatrix>
          <StackPanel Spacing="8">
            <TextBlock Classes="cap" Text="بطاقات بوصف ودرجات، والمجموع، والإجابة لازمة، والإلغاء بنقرة ثانية" />
            <TextBlock Classes="hint" Text="أجب عن كل صف." />
          <ins:ChoiceMatrix x:Name="Scored" Classes="cards deselect">
          <ins:ChoiceMatrix.Columns>
            <ins:MatrixColumn Header="ضعيف" Value="1" Description="وصف قصير للمستوى." Points="1" />
            <ins:MatrixColumn Header="جيد" Value="3" Description="وصف قصير للمستوى." Points="3" />
            <ins:MatrixColumn Header="ممتاز" Value="5" Description="وصف قصير للمستوى." Points="5" />
          </ins:ChoiceMatrix.Columns>
          <ins:MatrixRow Header="الأول" SelectedIndex="1" />
          <ins:MatrixRow Header="الثاني" SelectedIndex="-1" />
        </ins:ChoiceMatrix>
            <TextBlock>
              <Run Text="المجموع: " /><Run FontWeight="Bold" Text="{Binding #Scored.Sum}" />
            </TextBlock>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
