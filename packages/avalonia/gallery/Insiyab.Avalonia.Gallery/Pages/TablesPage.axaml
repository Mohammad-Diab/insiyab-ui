<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pg="using:Insiyab.Avalonia.Gallery.Playground"
             x:Class="Insiyab.Avalonia.Gallery.Pages.TablesPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Playground/PlayFrames.axaml" />
  </UserControl.Styles>

  <StackPanel>
    <TextBlock Classes="intro" Text="جدول بيانات تصطف أرقامه، ويتمرر عرضًا داخل حاويته فلا تتسع الصفحة معه." />
    <pg:PlayExample Layout="Stack" Code="{x:Static pg:TablesPlay.Example}" />

    <TextBlock Classes="section" Text="الجدول" />
    <pg:PlayText Classes="p" Markup="يكتب `ins:Table` أعمدته في `Columns` وصفوفه بعدها، فإذا ضاقت الحاوية عن الجدول تمرر أفقيًا وبقيت الصفحة على عرضها. واختر من الخيارات، فيتغير الجدول وشيفرته معًا، وتجدها كلها بشرحها في آخر الصفحة." />
    <pg:Playground Def="{x:Static pg:TablesPlay.Table}" />

    <TextBlock Classes="section" Text="تثبيت رأس الجدول وعموده الأول" />
    <pg:PlayText Classes="p" Markup="للجدول الطويل أو العريض: يبقى رأسه أو أعمدته الأولى ظاهرة وهو يتمرر داخل صندوقه. ويغير المستخدم عرض العمود بسحب حافة عنوانه." />
    <pg:Playground Def="{x:Static pg:TablesPlay.Wrap}" />

    <TextBlock Classes="section" Text="الترتيب" />
    <pg:PlayText Classes="p" Markup="إذا وضعت `Sort=&quot;Auto&quot;` على عمود صار عنوانه زرًا يرتب الصفوف تصاعديًا ثم تنازليًا. وترتب الأرقام بقيمها والنصوص بحسب اللغة." />
    <pg:Playground Def="{x:Static pg:TablesPlay.Sort}" />
    <pg:PlayText Classes="p" Markup="ويُطلق حدث `Sorting` قبل الترتيب، فإذا كان الترتيب على الخادم فألغه، ليتحرك السهم وحده وتجلب أنت الصفوف مرتبة." />

    <TextBlock Classes="section" Text="تحديد الصفوف" />
    <pg:PlayText Classes="p" Markup="عمود من المربعات يحدد الصفوف، وشريط يعرض عدد المحدد منها وما يمكن فعله بها. وتعيد لك `SelectedRows` الصفوف المحددة." />
    <pg:Playground Def="{x:Static pg:TablesPlay.Select}" />

    <TextBlock Classes="section" Text="التعديل في مكانه" />
    <pg:PlayText Classes="p" Markup="خلية تصير حقلًا إذا نقرتها مرتين، فيعدل المستخدم القيمة دون أن يغادر الجدول." />
    <pg:Playground Def="{x:Static pg:TablesPlay.Edit}" />
    <pg:PlayText Classes="p" Markup="ويُطلق حدث `CellEditing` قبل حفظ التغيير، فألغه إن أردت رفض القيمة، أو احفظها على الخادم واستدع `Revert()` إذا فشل الحفظ." />

    <TextBlock Classes="section" Text="التنقل بين الخلايا" />
    <pg:PlayText Classes="p" Markup="مع `IsCellNavigation` تقف لوحة المفاتيح على خلية لا على صف، وتتنقل بين الخلايا كما في جداول البيانات، ويبدأ التعديل بالكتابة على الخلية مباشرة." />
    <pg:Playground Def="{x:Static pg:TablesPlay.Sheet}" />

    <TextBlock Classes="section" Text="الخيارات" />
    <pg:PlayText Classes="p" Markup="كل ما في الجداول من عناصر وخصائص وأحداث، لكل مكون صندوق يفتح بالنقر." />
    <pg:OptionsList Defs="{x:Static pg:TablesPlay.All}" />
  </StackPanel>
</UserControl>
