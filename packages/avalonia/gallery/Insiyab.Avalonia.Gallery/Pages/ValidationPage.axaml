<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pg="using:Insiyab.Avalonia.Gallery.Playground"
             x:Class="Insiyab.Avalonia.Gallery.Pages.ValidationPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Playground/PlayFrames.axaml" />
  </UserControl.Styles>

  <StackPanel>
    <TextBlock Classes="intro" Text="قيود على الحقول، ورسائلها تحت الحقل لا في فقاعة، دون مكتبة تحقق." />
    <pg:PlayExample Layout="Stack" Code="{x:Static pg:ValidationPlay.Example}" />

    <TextBlock Classes="section" Text="قيود الحقول" />
    <pg:PlayText Classes="p" Markup="ضع `ins:Validate.Form` على الحاوية، وقيودًا على الحقول: `Required` و`Email` و`MinLength` و`Pattern`، و`ins:Validate.Submit` على زر الإرسال. فتكتب المكتبة رسالة كل حقل تحته. وتجد الخيارات كلها بشرحها في آخر الصفحة." />
    <pg:Playground Def="{x:Static pg:ValidationPlay.Rules}" />

    <TextBlock Classes="section" Text="أخطاء من الخادم" />
    <pg:PlayText Classes="p" Markup="أما الخطأ الذي لا تعرفه القيود، كاسم مستخدم محجوز أو رمز انتهت صلاحيته، فتضعه أنت: الكلاس `bad` على الحقل، ونص في `ContentControl.error`. وتدل على القبول بالكلاس `ok` و`ContentControl.success`." />
    <pg:Playground Def="{x:Static pg:ValidationPlay.Server}" />

    <TextBlock Classes="section" Text="الخيارات" />
    <pg:PlayText Classes="p" Markup="كل ما في التحقق من عناصر وكلاسات وخصائص وأحداث، لكل مكون صندوق يفتح بالنقر." />
    <pg:OptionsList Defs="{x:Static pg:ValidationPlay.All}" />
  </StackPanel>
</UserControl>
