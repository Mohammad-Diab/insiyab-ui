<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pg="using:Insiyab.Avalonia.Gallery.Playground"
             x:Class="Insiyab.Avalonia.Gallery.Pages.ChipsPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Playground/PlayFrames.axaml" />
  </UserControl.Styles>

  <StackPanel>
    <TextBlock Classes="intro" Text="الرقاقات (Chips) قيم صغيرة تُزال أو تُضغط، وحقل يجمع عدة قيم: اختيار متعدد من قائمة، أو وسوم تكتبها بنفسك." />
    <pg:PlayExample Layout="Row" Code="{x:Static pg:ChipsPlay.Example}" />

    <TextBlock Classes="section" Text="الرقاقة" />
    <pg:PlayText Classes="p" Markup="الرقاقة `ins:Chip` قيمة صغيرة يتصرف فيها المستخدم، أما الشارة فللقراءة وحدها. وقد تكون الرقاقة فلترًا تزيله، أو خيارًا تشغله وتطفئه، أو وسمًا. وتجد الخيارات كلها بشرحها في آخر الصفحة." />
    <pg:Playground Def="{x:Static pg:ChipsPlay.Chip}" />

    <TextBlock Classes="section" Text="الاختيار المتعدد" />
    <pg:PlayText Classes="p" Markup="يجمع `ins:TagsInput` قيمًا عدة في حقل واحد. فإذا وضعت فيه خيارات `ins:TagsOption` صار اختيارًا متعددًا يطابق كما يطابق الإكمال التلقائي، وكلما اخترت خيارًا صار رقاقة وخرج من القائمة. وتجد القيم كلها في `Values`." />
    <pg:Playground Def="{x:Static pg:ChipsPlay.Tags}" />

    <TextBlock Classes="section" Text="الخيارات" />
    <pg:PlayText Classes="p" Markup="كل ما في الرقاقات والوسوم من عناصر وكلاسات وخصائص وأحداث، لكل مكون صندوق يفتح بالنقر." />
    <pg:OptionsList Defs="{x:Static pg:ChipsPlay.All}" />
  </StackPanel>
</UserControl>
