<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pg="using:Insiyab.Avalonia.Gallery.Playground"
             x:Class="Insiyab.Avalonia.Gallery.Pages.CountdownPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Playground/PlayFrames.axaml" />
  </UserControl.Styles>

  <StackPanel>
    <TextBlock Classes="intro" Text="كم بقي من الوقت، ثانية بعد ثانية، بلون ينبه حين يقترب الصفر." />
    <pg:PlayExample Layout="Row" Code="{x:Static pg:CountdownPlay.Example}" />

    <TextBlock Classes="section" Text="العد التنازلي" />
    <pg:PlayText Classes="p" Markup="أعط `ins:Countdown` ثوانيه في `Seconds`، فيعد الوقت الباقي ثانية بعد ثانية، ويتلون بالأصفر حين يقترب الصفر ثم بالأحمر عنده. اختر من الخيارات فيتغير العداد وشيفرته معًا، وتجد الخيارات كلها بشرحها في آخر الصفحة." />
    <pg:Playground Def="{x:Static pg:CountdownPlay.Countdown}" />

    <TextBlock Classes="section" Text="الخيارات" />
    <pg:PlayText Classes="p" Markup="كل ما في العد التنازلي من عناصر وكلاسات وخصائص وأحداث، في صندوق يفتح بالنقر." />
    <pg:OptionsList Defs="{x:Static pg:CountdownPlay.All}" />
  </StackPanel>
</UserControl>
