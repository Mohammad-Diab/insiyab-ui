<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ins="using:Insiyab.Avalonia.Controls"
             x:Class="Insiyab.Avalonia.Gallery.Pages.BadgesPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Pages/FeedbackFrames.axaml" />
  </UserControl.Styles>
  <ScrollViewer>
    <StackPanel>

      <Border Classes="dx">
        <WrapPanel ItemSpacing="10" LineSpacing="10">
          <ins:Pill Classes="ok dot" Content="مكتمل" />
          <ins:Pill Classes="warn dot" Content="معلق" />
          <ins:Pill Classes="bad dot" Content="ملغى" />
          <ins:Pill Classes="info dot" Content="جارٍ" />
          <ins:Pill Classes="brand dot" Content="مميز" />
          <ins:Pill Classes="dot" Content="مسودة" />
        </WrapPanel>
      </Border>

      <TextBlock Classes="section" Text="شارات الحالة" />
      <Border Classes="stage">
        <ins:Pill Classes="ok dot" Content="مكتمل" />
      </Border>
      <TextBlock Classes="variant" Text="بلا نقطة" />
      <Border Classes="stage">
        <ins:Pill Classes="ok" Content="مكتمل" />
      </Border>
      <TextBlock Classes="variant" Text="قابلة للنقر" />
      <Border Classes="stage">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="pill ok dot" Content="مكتمل" />
          <Button Classes="pill dot" Content="الأول" />
          <Button Classes="pill dot" Content="الثاني" />
        </StackPanel>
      </Border>

      <TextBlock Classes="section" Text="شارات العدد" />
      <Border Classes="stage">
        <ins:Badge Content="12" />
      </Border>
      <TextBlock Classes="variant" Text="النبرة" />
      <Border Classes="stage">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <ins:Badge Content="12" />
          <ins:Badge Classes="ok" Content="12" />
          <ins:Badge Classes="warn" Content="12" />
          <ins:Badge Classes="bad" Content="12" />
          <ins:Badge Classes="mute" Content="12" />
        </StackPanel>
      </Border>

      <TextBlock Classes="section" Text="الصورة الرمزية" />
      <Border Classes="stage">
        <ins:Avatar Content="ل ح" />
      </Border>
      <TextBlock Classes="variant" Text="المقاس" />
      <Border Classes="stage">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <ins:Avatar Classes="sm" Content="ل ح" />
          <ins:Avatar Content="ل ح" />
          <ins:Avatar Classes="lg" Content="ل ح" />
        </StackPanel>
      </Border>
      <TextBlock Classes="variant" Text="مجموعة صور" />
      <Border Classes="stage">
        <ins:AvatarGroup AutomationProperties.Name="المشاركون: 7">
          <ins:Avatar Content="ل" />
          <ins:Avatar Content="ع" />
          <ins:Avatar Content="س" />
          <ins:Avatar Classes="more" Content="+4" />
        </ins:AvatarGroup>
      </Border>

      <TextBlock Classes="section" Text="المبالغ" />
      <Border Classes="stage">
        <ins:Money Value="1,249.00" Currency="ر.س" />
      </Border>
      <TextBlock Classes="variant" Text="زيادة" />
      <Border Classes="stage">
        <ins:Money Classes="pos" Value="1,249.00" Currency="ر.س" />
      </Border>
      <TextBlock Classes="variant" Text="نقص" />
      <Border Classes="stage">
        <ins:Money Classes="neg" Value="-1,500.00" Currency="ر.س" />
      </Border>

      <TextBlock Classes="section" Text="الأرقام" />
      <Border Classes="stage">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Text="رقم المرجع" />
          <TextBlock Classes="num" Text="#40218" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
