<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pg="using:Insiyab.Avalonia.Gallery.Playground"
             x:Class="Insiyab.Avalonia.Gallery.Pages.BadgesPage">
  <UserControl.Styles>
    <StyleInclude Source="avares://Insiyab.Avalonia.Gallery/Playground/PlayFrames.axaml" />
  </UserControl.Styles>

  <StackPanel>
    <TextBlock Classes="intro" Text="شارات للحالة وللعدد، وصور رمزية، ومبالغ وأرقام لا تضطرب في السطر العربي." />
    <pg:PlayExample Layout="Row" Code="{x:Static pg:BadgesPlay.Example}" />

    <TextBlock Classes="section" Text="شارات الحالة" />
    <pg:PlayText Classes="p" Markup="تجمع `ins:Pill` نقطة ونصًا، وتأتي بست نبرات. اختر من الخيارات فتتغير الشارة وشيفرتها معًا، وتجد الخيارات كلها بشرحها في آخر الصفحة." />
    <pg:Playground Def="{x:Static pg:BadgesPlay.Pill}" />

    <TextBlock Classes="section" Text="شارات العدد" />
    <pg:PlayText Classes="p" Markup="تحمل `ins:Badge` عددًا صغيرًا، فهي للعدد لا للحالة: بلا حد ولا نقطة، وتسكن على شيء آخر." />
    <pg:Playground Def="{x:Static pg:BadgesPlay.Count}" />

    <TextBlock Classes="section" Text="الصورة الرمزية" />
    <pg:PlayText Classes="p" Markup="تحمل `ins:Avatar` حرفين أو صورة، ويرص `ins:AvatarGroup` عدة صور يتداخل بعضها في بعض." />
    <pg:Playground Def="{x:Static pg:BadgesPlay.Avatar}" />

    <TextBlock Classes="section" Text="المبالغ" />
    <pg:PlayText Classes="p" Markup="يكتب `ins:Money` القيمة من `Value` وتليها العملة من `Currency`. ولأن اتجاه القيمة معزول عما حولها تبقى إشارة السالب في مكانها." />
    <pg:Playground Def="{x:Static pg:BadgesPlay.Money}" />

    <TextBlock Classes="section" Text="الأرقام" />
    <pg:PlayText Classes="p" Markup="أما ما ليس مبلغًا من الأرقام، كرقم المرجع والهاتف والتاريخ، فضعه في `TextBlock` بالكلاس `num` ليُعزل اتجاهه كذلك." />
    <pg:Playground Def="{x:Static pg:BadgesPlay.Num}" />

    <TextBlock Classes="section" Text="الخيارات" />
    <pg:PlayText Classes="p" Markup="كل ما في الشارات والصور الرمزية والأرقام من كلاسات وخصائص، لكل مكون صندوق يفتح بالنقر." />
    <pg:OptionsList Defs="{x:Static pg:BadgesPlay.All}" />
  </StackPanel>
</UserControl>
