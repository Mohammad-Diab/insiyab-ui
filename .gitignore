# Visual reference — 12 MB of screenshots, kept locally as the extraction target.
# See reference/README.md for how they were produced and how to re-shoot them.
reference/

# Scratch work
scratchpad/
*.log

# Dependencies and build output
node_modules/
build/
.vite/
coverage/
*.tgz

# dist/ is deliberately NOT ignored. It is generated, but committing it means a
# clone can open the demo without running the build, and a CDN can serve the
# library straight from a git tag before anything reaches npm -- both of which
# matter for a library whose whole pitch is that no build step is needed.

# Python (the Jinja package and its tests)
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Environment
.env
.env.*
!.env.example

# Editors and OS
.idea/
.DS_Store
Thumbs.db
desktop.ini
