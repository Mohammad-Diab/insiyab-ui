{
  "name": "insiyab",
  "version": "0.6.0",
  "description": "RTL-first UI library with a frosted-glass design language. One CSS file, one JS file, no build step.",
  "keywords": [
    "css",
    "ui",
    "rtl",
    "arabic",
    "glassmorphism",
    "design-system",
    "no-build",
    "components",
    "dark-mode"
  ],
  "license": "MIT",
  "author": "Mohammad Diab",
  "homepage": "https://github.com/Mohammad-Diab/insiyab-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mohammad-Diab/insiyab-ui.git"
  },
  "bugs": {
    "url": "https://github.com/Mohammad-Diab/insiyab-ui/issues"
  },
  "type": "module",
  "main": "dist/insiyab.js",
  "style": "dist/insiyab.css",
  "sideEffects": true,
  "exports": {
    ".": "./dist/insiyab.js",
    "./boot": "./dist/insiyab-boot.js",
    "./insiyab-boot.js": "./dist/insiyab-boot.js",
    "./css": "./dist/insiyab.css",
    "./insiyab.css": "./dist/insiyab.css",
    "./insiyab.min.css": "./dist/insiyab.min.css",
    "./plugins/*": "./dist/plugins/*",
    "./fonts/*": "./dist/fonts/*"
  },
  "files": [
    "dist",
    "src",
    "fonts",
    "IDEA.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "check": "node build.mjs --check",
    "demo": "node build.mjs && node serve.mjs",
    "test": "node test/run.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
